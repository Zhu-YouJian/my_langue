// Token definitions — v0.3.1 with enum TokenKind

struct Span {
    line: i64,
    col: i64,
}

enum TokenKind {
    // Literals
    IntLiteral(value: i64),
    FloatLiteral(value: f64),
    StringLiteral(value: str),
    Identifier(name: str),

    // Keywords
    Fn,
    Let,
    Mut,
    If,
    Else,
    Match,
    Return,
    While,
    For,
    Loop,
    Break,
    Continue,
    Struct,
    Enum,
    Impl,
    Trait,
    Use,
    Mod,
    True,
    False,
    Move,
    Self_,

    // Operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    EqEq,
    NotEq,
    Lt,
    Gt,
    LtEq,
    GtEq,
    AndAnd,
    OrOr,
    Not,
    Ampersand,
    Pipe,

    // Assignments
    Assign,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,

    // Delimiters
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Semicolon,
    Colon,
    Dot,
    DotDot,
    Arrow,
    FatArrow,
    ColonColon,

    Eof,
}

struct Token {
    kind: TokenKind,
    span: Span,
    disc: i64,
    ival: i64,
    sval: str,
}

// Self-hosting Lexer — v0.3.1 enum-based

struct Lexer {
    source: str,
    pos: i64,
    line: i64,
    col: i64,
}

fn lexer_new(source: str) -> Lexer {
    Lexer { source: source, pos: 0, line: 1, col: 1 }
}

fn is_digit(ch: str) -> bool { (ch >= "0") && (ch <= "9") }
fn is_alpha(ch: str) -> bool { ((ch >= "a") && (ch <= "z")) || ((ch >= "A") && (ch <= "Z")) || (ch == "_") }
fn is_alnum(ch: str) -> bool { is_alpha(ch) || is_digit(ch) }
