// tenth-lens · 入口 + 调度（多文件拆分后的 main.th，2026-09-17 W6-lens P1）
//
// 本项目是**首个官方 Tenth 项目**，用 Tenth 语言写成。分层见 README.md §二：
//   记录（证据）→ 观察（显微镜）→ 守卫（判决书）。
//
// 目录（`use` 的搜索路径含脚本自身所在目录 ⇒ 可用 `use src::模块::名字`）：
//   main.th            本文件：入口 + 模式调度（**只有调度，没有实现**）
//   src/util.th        通用纯函数（无全局状态）
//   src/record.th      P0 记录层：PERF| / PERF-NA| 解析 + 清单加载（全局前缀 REC_）
//   src/observe.th     P0 观察层：归集查询 + 两两比较（纯函数）
//   src/guard.th       P0 守卫层：判决 / 报告 / 退出码（全局前缀 GRD_）
//   src/runner.th      P1 进程侧：一次 spawn 同源取三轴（command_output_ex 封装）
//   src/diff.th        P1 差分检查器：两阶段双路径 + 判决（全局前缀 DIF_）
//
// 两个模式（都在本文件调度；各自的用法/退出码见各自模块头注释）：
//   P0 跨来源差分守卫   tenth.exe run tenth-lens\main.th --manifest <清单> [...]
//   P1 跨路径差分检查器 tenth.exe run tenth-lens\main.th --diff <清单> [...]
//
// 工作规则（README §四）：写不出来的地方**不许绕过**，留 `NEED:` stub + 追加 GAPS.md。

use std::cli::cli::flag_value
use std::cli::cli::has_flag

use src::guard::grd_run
use src::guard::grd_usage
use src::diff::dif_run
use src::diff::dif_usage

fn usage() {
    println("tenth-lens · Tenth 编译器可观测性工具链（首个官方 Tenth 项目，用 Tenth 写）");
    println("两种模式：--manifest（P0 跨来源差分守卫）| --diff（P1 跨路径差分检查器）");
    println("");
    grd_usage();
    println("");
    dif_usage();
}

fn main() {
    if has_flag("--help") {
        usage();
        exit(0);
    };

    let diff_manifest = flag_value("--diff");
    if !diff_manifest.is_empty() {
        dif_run();
        exit(2);
    };

    let p0_manifest = flag_value("--manifest");
    if !p0_manifest.is_empty() {
        grd_run();
        exit(2);
    };

    usage();
    exit(2);
}
