// tenth-lens · P0 差分型守卫 v0
//
// 核心断言（一句话）：同一个 (group, scenario, path, metric) 在**不同来源日志之间必须一致**；
// 超出容差即判红。
//
// 层次（章程 README §二 的三层；因 `use` 路径段不能含 `-`（见 GAPS.md GAP-011），
// 本项目 P0 阶段是**单文件**实现，三层用文件内的分节 + 命名约定表达）：
//   记录层  rec_*（解析 PERF| / PERF-NA|，字段级校验）＋ 清单加载 load_manifest  —— 证据
//   观察层  rows_of / na_of / rec_of_label / count_numeric / dev_between / ratio_between  —— 显微镜
//   守卫层  judge_key / push_red / sort_reds_desc / main 的判决与退出码  —— 判决书
//
// 跑法（项目根目录）：
//   tenth\target\release\tenth.exe run tenth-lens\main.th --manifest tenth-lens\corpus\manifest_vm_diff.txt
//   TENTH_NO_VM=1 亦可（本工具只用 fs/native + cli，无子进程、不碰 VM/JIT 分歧面）
//
// 输入格式（一份日志可含多段）：
//   PERF|<group>|<scenario>|<path>|<metric>|<value>|<unit>        数据行
//   PERF-NA|<group>|<scenario>|<path>|<reason>                    不可用 + 原因（无 metric 字段）
//   PERF-NOTE|...                                                 口径说明 —— **不是数据**
//   其余行视为噪声（计数，不参与判决）
//
// 红线（章程 §四）：判不出来就响亮失败，不静默跳过、不放宽容差。
//   一律判红（宁可红，不可假绿）：
//     - 两来源同一 key 相对偏离 > 容差
//     - 同一 key 的两来源单位不同（不可比）
//     - 同一来源同一 key 出现多条数值（自相矛盾）
//     - 某来源有数值、另一来源声明该 metric 不可用（PERF-NA）—— 口径分歧
//     - 清单里声明的来源文件读不到
//     - `PERF|` / `PERF-NA|` 行字段数不符（格式漂移）
//   如实标注但**不判红**（无法比较，非不一致）：
//     - 某来源根本没有该 key（MISSING）
//     - 只有 1 个来源有该 key（ONE，无可比对象；在汇总里单独计数，防「静默假绿」）

use std::fs::fs::read_text
use std::cli::cli::flag_value
use std::cli::cli::has_flag

// ───────────────────────── 全局状态 ─────────────────────────

let mut SRC_LABELS: Vec = Vec::new()        // 来源标签（清单顺序）
let mut SRC_PATHS: Vec = Vec::new()         // 来源路径（与标签同序）
let mut SRC_ROWS: HashMap = HashMap::new()  // label -> 数据行数
let mut SRC_NOTES: HashMap = HashMap::new() // label -> PERF-NOTE 行数
let mut SRC_NOISE: HashMap = HashMap::new() // label -> 噪声行数
let mut KEYS: Vec = Vec::new()              // key 插入序
let mut KEY_ROWS: HashMap = HashMap::new()  // key -> Vec of [label, record]
let mut NA_MAP: HashMap = HashMap::new()    // "g|s|p" -> Vec of [label, reason]
let mut MALFORMED: Vec = Vec::new()         // [label, line]
let mut UNREADABLE: Vec = Vec::new()        // [label, path]
let mut HEAD: Vec = Vec::new()              // 报告头
let mut PASSES: Vec = Vec::new()            // 非红判决行（OK / ONE / NA）
let mut REDS: Vec = Vec::new()              // [dev, line]（用于排序，判红优先输出）

// 注：**刻意不设全局标量计数器**。VM 路径下「同一全局标量既在 main 写、又在函数里写」会
// **静默丢失函数侧写入**（探针 tenth-lens/probes/vm_probe5.th：VM 得 N3=1/N5=2，解释器得 2/4，
// 两路径退出码都是 0；本工具第一版即因此崩在 `N_RED = N_RED + 1`）。
// 故计数一律由 judge_key 返回状态标签、在 main 的**局部**变量里累加。见 GAPS.md GAP-012。

// ───────────────────── 记录层：编码与解析 ─────────────────────
// record 编码：Vec = [group, scenario, path, metric, value_raw, unit, value_f64, is_numeric]

fn rec_make(g: String, s: String, p: String, m: String, raw: String, u: String) -> Vec {
    let mut r = Vec::new();
    r.push(g);
    r.push(s);
    r.push(p);
    r.push(m);
    r.push(raw);
    r.push(u);
    let mut isnum = true;
    let mut v = 0.0;
    if raw.is_empty() {
        isnum = false;
    } else {
        let low = raw.to_lower();
        if low.starts_with("n/a") {
            isnum = false;
        } else {
            if low.starts_with("na") {
                isnum = false;
            } else {
                v = parse_float(raw);
            };
        };
    };
    r.push(v);
    r.push(isnum);
    r
}

fn rec_key(r: Vec) -> String {
    r.get(0) + "|" + r.get(1) + "|" + r.get(2) + "|" + r.get(3)
}

fn rec_span(r: Vec) -> String {
    r.get(0) + "|" + r.get(1) + "|" + r.get(2)
}

// 解析一行数据行；字段数不符 → 记入 MALFORMED（不静默跳过）
fn rec_parse_perf(label: String, ln: String) {
    let f = ln.split("|");
    if f.len() != 7 {
        let mut m = Vec::new();
        m.push(label);
        m.push(ln);
        MALFORMED.push(m);
        return;
    };
    let r = rec_make(f.get(1).trim(), f.get(2).trim(), f.get(3).trim(), f.get(4).trim(), f.get(5).trim(), f.get(6).trim());
    let key = rec_key(r);
    if !KEY_ROWS.contains_key(key) {
        KEY_ROWS.insert(key, Vec::new());
        KEYS.push(key);
    };
    let mut row = Vec::new();
    row.push(label);
    row.push(r);
    KEY_ROWS.get(key).push(row);
    SRC_ROWS.insert(label, SRC_ROWS.get(label) + 1);
}

// 解析 PERF-NA 行：按 (group, scenario, path) 记「不可用 + 原因」
fn rec_parse_na(label: String, ln: String) {
    let f = ln.split("|");
    if f.len() != 5 {
        let mut m = Vec::new();
        m.push(label);
        m.push(ln);
        MALFORMED.push(m);
        return;
    };
    let span = f.get(1).trim() + "|" + f.get(2).trim() + "|" + f.get(3).trim();
    if !NA_MAP.contains_key(span) {
        NA_MAP.insert(span, Vec::new());
    };
    let mut row = Vec::new();
    row.push(label);
    row.push(f.get(4).trim());
    NA_MAP.get(span).push(row);
}

fn rec_load(label: String, path: String) {
    if !path_exists(path) {
        let mut u = Vec::new();
        u.push(label);
        u.push(path);
        UNREADABLE.push(u);
        return;
    };
    SRC_LABELS.push(label);
    SRC_PATHS.push(path);
    SRC_ROWS.insert(label, 0);
    SRC_NOTES.insert(label, 0);
    SRC_NOISE.insert(label, 0);

    let lines = read_text(path).split("\n");
    let mut i = 0;
    while i < lines.len() {
        let ln = lines.get(i).trim();
        if ln.starts_with("PERF-NOTE|") {
            SRC_NOTES.insert(label, SRC_NOTES.get(label) + 1);
        } else {
            if ln.starts_with("PERF-NA|") {
                rec_parse_na(label, ln);
            } else {
                if ln.starts_with("PERF|") {
                    rec_parse_perf(label, ln);
                } else {
                    if ln.len() > 0 {
                        SRC_NOISE.insert(label, SRC_NOISE.get(label) + 1);
                    };
                };
            };
        };
        i = i + 1;
    };
}

// ─────────────────── 清单解析（每行 `标签|路径`） ───────────────────

fn load_manifest(path: String) -> bool {
    if !path_exists(path) {
        println("用法错误：清单文件不存在：" + path);
        return false;
    };
    let lines = read_text(path).split("\n");
    let mut i = 0;
    let mut bad = 0;
    while i < lines.len() {
        let ln = lines.get(i).trim();
        let mut skip = false;
        if ln.is_empty() {
            skip = true;
        } else {
            if ln.starts_with("#") {
                skip = true;
            };
        };
        if !skip {
            let f = ln.split("|");
            if f.len() != 2 {
                println("清单格式错误（应为 `标签|路径`）：" + ln);
                bad = bad + 1;
            } else {
                rec_load(f.get(0).trim(), f.get(1).trim());
            };
        };
        i = i + 1;
    };
    bad == 0
}

// ─────────────────── 观察层：归集 + 两两比较 ───────────────────

fn rows_of(key: String) -> Vec {
    if KEY_ROWS.contains_key(key) {
        KEY_ROWS.get(key)
    } else {
        Vec::new()
    }
}

fn na_of(span: String) -> Vec {
    if NA_MAP.contains_key(span) {
        NA_MAP.get(span)
    } else {
        Vec::new()
    }
}

fn span_of_key(key: String) -> String {
    let f = key.split("|");
    if f.len() < 3 {
        key
    } else {
        f.get(0) + "|" + f.get(1) + "|" + f.get(2)
    }
}

fn rec_of_label(rows: Vec, label: String) -> Vec {
    let mut i = 0;
    while i < rows.len() {
        if rows.get(i).get(0) == label {
            return rows.get(i).get(1);
        };
        i = i + 1;
    };
    let mut empty = Vec::new();
    empty.push("");
    empty.push("");
    empty.push("");
    empty.push("");
    empty.push("");
    empty.push("");
    empty.push(0.0);
    empty.push(false);
    empty
}

fn reason_of_label(na_rows: Vec, label: String) -> String {
    let mut i = 0;
    while i < na_rows.len() {
        if na_rows.get(i).get(0) == label {
            return na_rows.get(i).get(1);
        };
        i = i + 1;
    };
    ""
}

fn label_has_row(rows: Vec, label: String) -> bool {
    let mut i = 0;
    while i < rows.len() {
        if rows.get(i).get(0) == label {
            return true;
        };
        i = i + 1;
    };
    false
}

// 某来源的数值条数（>1 → 自相矛盾）
fn count_numeric(rows: Vec, label: String) -> i32 {
    let mut n = 0;
    let mut i = 0;
    while i < rows.len() {
        if rows.get(i).get(0) == label {
            if rows.get(i).get(1).get(7) {
                n = n + 1;
            };
        };
        i = i + 1;
    };
    n
}

fn dev_between(a: f64, b: f64) -> f64 {
    let mut lo = a;
    let mut hi = a;
    if b > a {
        hi = b;
    } else {
        lo = b;
    };
    if lo == hi {
        return 0.0;
    };
    if lo <= 0.0 {
        return 999999.0;
    };
    (hi - lo) / lo * 100.0
}

fn ratio_between(a: f64, b: f64) -> f64 {
    let mut lo = a;
    let mut hi = a;
    if b > a {
        hi = b;
    } else {
        lo = b;
    };
    if lo <= 0.0 {
        return 0.0;
    };
    hi / lo
}

// ─────────────────── 守卫层：判决 + 渲染 ───────────────────

fn emit(s: String) {
    HEAD.push(s);
}

fn fmt_dev(v: f64) -> String {
    format("{:.2f}", v)
}

fn push_red(dev: f64, line: String) {
    let mut r = Vec::new();
    r.push(dev);
    r.push(line);
    REDS.push(r);
}

// 判红行按偏离降序（插入排序；内建 sort 无比较器形式）
fn sort_reds_desc() {
    let n = REDS.len();
    let mut i = 1;
    while i < n {
        let cur = REDS.get(i);
        let curdev = cur.get(0);
        let mut j = i;
        while j > 0 {
            let prev = REDS.get(j - 1);
            if prev.get(0) < curdev {
                REDS.set(j, prev);
                j = j - 1;
            } else {
                break;
            };
        };
        REDS.set(j, cur);
        i = i + 1;
    };
}

// 单 key 判决（每个 key 恰一行）：返回状态标签 "RED"/"OK"/"NA"/"ONE"（计数在 main 的局部累加）
fn judge_key(key: String, tol: f64) -> String {
    let rows = rows_of(key);
    let na_rows = na_of(span_of_key(key));

    let mut desc = "";
    let mut units = Vec::new();
    let mut num_vals = Vec::new();
    let mut num_labels = Vec::new();
    let mut dup_label = "";
    let mut has_na_other = false;
    let mut present = 0;
    let mut i = 0;
    while i < SRC_LABELS.len() {
        let label = SRC_LABELS.get(i);
        let any_row = label_has_row(rows, label);
        let na_reason = reason_of_label(na_rows, label);
        let mut piece = "";
        if any_row {
            present = present + 1;
            let r = rec_of_label(rows, label);
            if r.get(7) {
                if count_numeric(rows, label) > 1 {
                    dup_label = label;
                };
                num_vals.push(r.get(6));
                num_labels.push(label);
                units.push(r.get(5));
                piece = label + "=" + r.get(4) + " " + r.get(5);
            } else {
                has_na_other = true;
                piece = label + "=NA(值=" + r.get(4) + ")";
            };
        } else {
            if na_reason.len() > 0 {
                has_na_other = true;
                piece = label + "=NA(" + na_reason + ")";
            } else {
                piece = label + "=MISSING";
            };
        };
        if desc.len() > 0 {
            desc = desc + " | " + piece;
        } else {
            desc = piece;
        };
        i = i + 1;
    };

    // 单位一致性
    let mut unit_bad = "";
    i = 1;
    while i < units.len() {
        if units.get(i) != units.get(0) {
            unit_bad = units.get(0) + " vs " + units.get(i);
        };
        i = i + 1;
    };

    // 数值两两比较（相对偏离以较小值为基准 = 「大的是小的几倍」）
    let mut dev = 0.0;
    let mut ratio = 1.0;
    let mut worst_a = "";
    let mut worst_b = "";
    i = 0;
    while i < num_vals.len() {
        let mut j = i + 1;
        while j < num_vals.len() {
            let d = dev_between(num_vals.get(i), num_vals.get(j));
            if d > dev {
                dev = d;
                ratio = ratio_between(num_vals.get(i), num_vals.get(j));
                worst_a = num_labels.get(i);
                worst_b = num_labels.get(j);
            };
            j = j + 1;
        };
        i = i + 1;
    };

    let n_num = num_vals.len();

    // 单出口：先定状态与行文本，再统一落盘（红行入 REDS 待排序，其余入 PASSES）
    let mut status = "OK";
    let mut line = "";
    let mut sort_dev = 0.0;

    if dup_label.len() > 0 {
        status = "RED";
        sort_dev = 999999.0;
        line = "[RED] " + key + "  why=DUP_IN_SOURCE(" + dup_label + ")  " + desc;
    } else {
        if n_num >= 2 {
            if unit_bad.len() > 0 {
                status = "RED";
                sort_dev = 999998.0;
                line = "[RED] " + key + "  why=UNIT_MISMATCH(" + unit_bad + ")  " + desc;
            } else {
                if has_na_other {
                    status = "RED";
                    sort_dev = 999997.0;
                    line = "[RED] " + key + "  why=NA_DIVERGE(有数值来源 vs 声明不可用来源)  dev=" + fmt_dev(dev) + "% (" + format("{:.2f}", ratio) + "x)  " + desc;
                } else {
                    if dev > tol {
                        status = "RED";
                        sort_dev = dev;
                        line = "[RED] " + key + "  dev=" + fmt_dev(dev) + "% (" + format("{:.2f}", ratio) + "x)  tol=±" + fmt_dev(tol) + "%  worst=" + worst_a + " vs " + worst_b + "  " + desc;
                    } else {
                        line = "[OK ] " + key + "  dev=" + fmt_dev(dev) + "% (" + format("{:.2f}", ratio) + "x)  tol=±" + fmt_dev(tol) + "%  " + desc;
                    };
                };
            };
        } else {
            if n_num == 1 {
                if has_na_other {
                    status = "RED";
                    sort_dev = 999997.0;
                    line = "[RED] " + key + "  why=NA_DIVERGE(有数值来源 vs 声明不可用来源)  " + desc;
                } else {
                    status = "ONE";
                    line = "[ONE] " + key + "  无可比对象（仅 " + format("{}", present) + "/" + format("{}", SRC_LABELS.len()) + " 来源有该 key）  " + desc;
                };
            } else {
                status = "NA";
                line = "[NA ] " + key + "  各来源一致不可用  " + desc;
            };
        };
    };

    if status == "RED" {
        push_red(sort_dev, line);
    } else {
        PASSES.push(line);
    };
    status
}

// 过滤：--only <group:scenario>（支持 *）、--metric <name>
fn key_match(key: String, only_g: String, only_s: String, only_metric: String) -> bool {
    let f = key.split("|");
    if f.len() != 4 {
        return false;
    };
    if only_metric != "*" {
        if f.get(3) != only_metric {
            return false;
        };
    };
    if only_g != "*" {
        if f.get(0) != only_g {
            return false;
        };
    };
    if only_s != "*" {
        if f.get(1) != only_s {
            return false;
        };
    };
    true
}

fn total_notes() -> i32 {
    let mut t = 0;
    let mut i = 0;
    while i < SRC_LABELS.len() {
        // 注：必须先绑定到局部再当 HashMap 键——解释器路径下 `Vec.get()` 的临时值丢类型标签
        //（type_name→unknown）会被 HashMap 键校验拒绝；VM 正常。见 GAPS.md GAP-011。
        let l = SRC_LABELS.get(i);
        t = t + SRC_NOTES.get(l);
        i = i + 1;
    };
    t
}

fn total_noise() -> i32 {
    let mut t = 0;
    let mut i = 0;
    while i < SRC_LABELS.len() {
        let l = SRC_LABELS.get(i);
        t = t + SRC_NOISE.get(l);
        i = i + 1;
    };
    t
}

fn usage() {
    println("tenth-lens 差分型守卫 v0（缺 --manifest 时为用法提示）");
    println("用法：tenth.exe run tenth-lens\\main.th --manifest <清单> [--tolerance <百分比>] [--only <group:scenario>] [--metric <名>] [--out <报告路径>]");
    println("  清单格式：每行 `标签|路径`；`#` 开头为注释；空行忽略");
    println("  默认容差 ±20%；--only 支持 `*`（如 `G2:*` / `G2:matmul_512`）；--metric 可只比可比统计量（如 min）");
    println("  有任何红 → 退出码 1；用法错误 → 退出码 2；全绿 → 退出码 0");
    println("  报告产物请用 --out .agents/tmp/xxx.txt（不得写进 tenth-lens/）");
}

fn main() {
    if has_flag("--help") {
        usage();
        exit(0);
    };
    let manifest = flag_value("--manifest");
    if manifest.is_empty() {
        usage();
        exit(2);
    };

    // 容差（默认 20%；非正数 → 响亮失败，绝不静默取 0）
    let tol_raw = flag_value("--tolerance");
    let mut tol = 20.0;
    if !tol_raw.is_empty() {
        tol = parse_float(tol_raw);
        if tol <= 0.0 {
            println("用法错误：--tolerance 必须是正数，收到 [" + tol_raw + "]");
            exit(2);
        };
    };

    // 过滤
    let only_raw = flag_value("--only");
    let mut only_g = "*";
    let mut only_s = "*";
    if !only_raw.is_empty() {
        let of = only_raw.split(":");
        if of.len() != 2 {
            println("用法错误：--only 需为 <group:scenario>，收到 [" + only_raw + "]");
            exit(2);
        };
        only_g = of.get(0).trim();
        only_s = of.get(1).trim();
    };
    let metric_raw = flag_value("--metric");
    let mut only_metric = "*";
    if !metric_raw.is_empty() {
        only_metric = metric_raw.trim();
    };
    let mut scope_note = "full（未用 --only/--metric，结论覆盖全部 key）";
    if only_g != "*" {
        scope_note = "narrowed(only=" + only_g + ":" + only_s + ",metric=" + only_metric + ")——绿灯不能当作全量结论";
    } else {
        if only_s != "*" {
            scope_note = "narrowed(only=" + only_g + ":" + only_s + ",metric=" + only_metric + ")——绿灯不能当作全量结论";
        } else {
            if only_metric != "*" {
                scope_note = "narrowed(metric=" + only_metric + ")——绿灯不能当作全量结论";
            };
        };
    };

    // 清单
    if !load_manifest(manifest) {
        exit(2);
    };
    if SRC_LABELS.len() == 0 {
        println("用法错误：清单未解析出任何来源：" + manifest);
        exit(2);
    };

    // 报告头
    emit("tenth-lens 差分型守卫 v0（断言：同一 (group,scenario,path,metric) 跨来源必须一致）");
    emit("MANIFEST|" + manifest + "  TOLERANCE|±" + fmt_dev(tol) + "%  SCOPE|" + scope_note);
    let mut src_line = "SOURCES|" + format("{}", SRC_LABELS.len());
    let mut i = 0;
    while i < SRC_LABELS.len() {
        let l = SRC_LABELS.get(i);
        src_line = src_line + "  [" + l + "=" + SRC_PATHS.get(i) + " rows=" + format("{}", SRC_ROWS.get(l)) + " notes=" + format("{}", SRC_NOTES.get(l)) + " noise=" + format("{}", SRC_NOISE.get(l)) + "]";
        i = i + 1;
    };
    emit(src_line);

    // 计数一律用 main 的局部变量（不写成全局标量：见文件头 GAP-012 说明）
    let mut n_keys = 0;
    let mut n_red = 0;
    let mut n_ok = 0;
    let mut n_na = 0;
    let mut n_one = 0;

    // 不可读来源 → 判红（清单声明了却读不到，不许静默当它不存在）
    i = 0;
    while i < UNREADABLE.len() {
        n_red = n_red + 1;
        n_keys = n_keys + 1;
        push_red(999996.0, "[RED] SOURCE_UNREADABLE(" + UNREADABLE.get(i).get(0) + "=" + UNREADABLE.get(i).get(1) + ")");
        i = i + 1;
    };

    // 判决
    i = 0;
    while i < KEYS.len() {
        let k = KEYS.get(i);
        if key_match(k, only_g, only_s, only_metric) {
            let st = judge_key(k, tol);
            n_keys = n_keys + 1;
            if st == "RED" {
                n_red = n_red + 1;
            } else {
                if st == "OK" {
                    n_ok = n_ok + 1;
                } else {
                    if st == "ONE" {
                        n_one = n_one + 1;
                    } else {
                        n_na = n_na + 1;
                    };
                };
            };
        };
        i = i + 1;
    };

    // 格式漂移 → 判红
    i = 0;
    while i < MALFORMED.len() {
        n_red = n_red + 1;
        n_keys = n_keys + 1;
        push_red(999995.0, "[RED] MALFORMED_PERF_LINE(" + MALFORMED.get(i).get(0) + ") :: " + MALFORMED.get(i).get(1));
        i = i + 1;
    };

    // 判红优先（按偏离降序），其后是非红判决行（按 key 插入序）—— 汇总之前先排好
    sort_reds_desc();
    let mut all = Vec::new();
    i = 0;
    while i < HEAD.len() {
        all.push(HEAD.get(i));
        i = i + 1;
    };
    i = 0;
    while i < REDS.len() {
        all.push(REDS.get(i).get(1));
        i = i + 1;
    };
    i = 0;
    while i < PASSES.len() {
        all.push(PASSES.get(i));
        i = i + 1;
    };

    // 汇总（先算再打印，保证报告文件与 stdout 同源）
    let mut tail = "";
    tail = tail + "---- 汇总 ----\n";
    tail = tail + "KEYS|" + format("{}", n_keys) + "  RED|" + format("{}", n_red) + "  OK|" + format("{}", n_ok) + "  NA(一致不可用)|" + format("{}", n_na) + "  ONE(仅单来源)|" + format("{}", n_one) + "\n";
    tail = tail + "TOLERANCE|±" + fmt_dev(tol) + "%  SCOPE|" + scope_note + "\n";
    tail = tail + "NOTE_LINES_IGNORED(非数据)|" + format("{}", total_notes()) + "  NOISE_LINES|" + format("{}", total_noise()) + "  MALFORMED|" + format("{}", MALFORMED.len()) + "  UNREADABLE_SOURCES|" + format("{}", UNREADABLE.len()) + "\n";
    if n_red > 0 {
        tail = tail + "VERDICT|RED（" + format("{}", n_red) + " 项不一致）→ 退出码 1\n";
    } else {
        if n_one > 0 {
            tail = tail + "VERDICT|GREEN（无红；但有 " + format("{}", n_one) + " 个 key 只有单一来源，未做比较——不等于「已验证一致」）\n";
        } else {
            tail = tail + "VERDICT|GREEN（全部可比 key 均在容差内）\n";
        };
    };

    let mut full = tail;
    i = 0;
    while i < all.len() {
        println(all.get(i));
        i = i + 1;
    };
    print(full);

    // 可选报告落盘（红线：运行产物只写 .agents/tmp/，不得写 tenth-lens/）
    let out_path = flag_value("--out");
    if !out_path.is_empty() {
        if out_path.starts_with("tenth-lens") {
            println("用法错误：运行产物不得写进 tenth-lens/（章程红线），请写到 .agents/tmp/");
            exit(2);
        };
        let mut text = "";
        i = 0;
        while i < all.len() {
            text = text + all.get(i) + "\n";
            i = i + 1;
        };
        write_file(out_path, text + tail);
        println("REPORT_WRITTEN|" + out_path);
    };

    if n_red > 0 {
        exit(1);
    };
    exit(0);
}
