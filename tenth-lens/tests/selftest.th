// tenth-lens 自检：用**合成夹具/真实语料**证明守卫与差分检查器的判决、标注、容差、退出码行为
//
// 跑法（项目根；**env 必须干净**——本自检最后一项会故意污染 TENTH_NO_VM 来验防假绿）：
//   tenth\target\release\tenth.exe run tenth-lens\tests\selftest.th
// 通过标准：末行 `SELFTEST|n|PASS|n 项全过`，退出码 0；任一 FAIL → 退出码 1。
//
// 为什么自检要 spawn 子进程：判决是**进程级**的（报告 + 退出码），只能在进程边界上断言。
// 旧写法（P0）：`command_output` 取文本 + `command_run` 取退出码 ⇒ 两次 spawn，且 run 阶段
//   子进程输出会**泄漏到本进程 stdout**（GAP-010 时期的已知代价）。
// 新写法（P1）：`command_output_ex` **一次 spawn 同源取四元**（stdout/stderr/退出码/超时）
//   ⇒ 新增断言一律走 spawn_full()，不再泄漏、不再两次 spawn。
//
// 断言集见下方 assert_* 调用；FAIL 时打印期望的原文片段，便于直接定位。

// 结果用容器累积（不用全局标量计数器：VM 对「main 与函数同时写的全局标量」会静默丢失函数侧写入，
// 该缺陷 GAP-012 / AUDIT-11.4.55 已于 2026-09-17 修复，但此处保持既有写法，避免制造新依赖）
let mut RESULTS: Vec = Vec::new()

fn exe() -> String {
    "tenth/target/release/tenth.exe"
}

fn guard_args(tail: Vec) -> Vec {
    // 固定前缀：run tenth-lens/main.th
    let mut a = Vec::new();
    a.push("run");
    a.push("tenth-lens/main.th");
    let mut i = 0;
    while i < tail.len() {
        // 先绑局部：解释器路径下「容器取出的临时值」丢类型标签，直接当 native 实参会被忽略
        //（GAP-013，已修；保留写法零成本）
        let tv = tail.get(i);
        a.push(tv);
        i = i + 1;
    };
    a
}

fn spawn_capture(tail: Vec) -> String {
    let h = command_new(exe());
    match h {
        Result::Ok(hh) => {
            let a = guard_args(tail);
            let mut i = 0;
            while i < a.len() {
                let av = a.get(i);
                command_arg(hh, av);
                i = i + 1;
            };
            match command_output(hh) {
                Result::Ok(s) => s,
                Result::Err(e) => "SPAWN_ERR:" + e,
            }
        },
        Result::Err(e) => "SPAWN_ERR:" + e,
    }
}

fn spawn_code(tail: Vec) -> i32 {
    let h = command_new(exe());
    match h {
        Result::Ok(hh) => {
            let a = guard_args(tail);
            let mut i = 0;
            while i < a.len() {
                let av = a.get(i);
                command_arg(hh, av);
                i = i + 1;
            };
            match command_run(hh) {
                Result::Ok(c) => c,
                Result::Err(e) => -1,
            }
        },
        Result::Err(e) => -1,
    }
}

// ── P1 新增：一次 spawn 同源取四元 Vec = [stdout, stderr, exit_code, timed_out] ──
fn spawn_full(tail: Vec) -> Vec {
    let mut r = Vec::new();
    let h = command_new(exe());
    match h {
        Result::Ok(hh) => {
            let a = guard_args(tail);
            let mut i = 0;
            while i < a.len() {
                let av = a.get(i);
                command_arg(hh, av);
                i = i + 1;
            };
            let (out, err, code, timed) = command_output_ex(hh, 60000);
            r.push(out);
            r.push(err);
            r.push(code);
            r.push(timed);
        },
        Result::Err(e) => {
            r.push("");
            r.push("SPAWN_FAIL:" + e);
            r.push(-1);
            r.push(true);
        },
    };
    r
}

fn full_out(r: Vec) -> String {
    let x = r.get(0);
    x
}

fn full_err(r: Vec) -> String {
    let x = r.get(1);
    x
}

fn full_code(r: Vec) -> i32 {
    let x = r.get(2);
    x
}

fn args1(k: String, v: String) -> Vec {
    let mut a = Vec::new();
    a.push(k);
    a.push(v);
    a
}

fn assert_has(tag: String, text: String, needle: String) {
    if text.contains(needle) {
        RESULTS.push("PASS|" + tag + "|" + needle);
    } else {
        RESULTS.push("FAIL|" + tag + "|未找到: " + needle);
    };
}

fn assert_absent(tag: String, text: String, needle: String) {
    if text.contains(needle) {
        RESULTS.push("FAIL|" + tag + "|不应出现: " + needle);
    } else {
        RESULTS.push("PASS|" + tag + "|确实不含 " + needle);
    };
}

fn assert_code(tag: String, code: i32, expect: i32) {
    if code == expect {
        RESULTS.push("PASS|" + tag + "|退出码=" + format("{}", code));
    } else {
        RESULTS.push("FAIL|" + tag + "|退出码=" + format("{}", code) + " 期望=" + format("{}", expect));
    };
}

// 判红必须排在非红之前
fn assert_red_first(tag: String, text: String) {
    let pr = text.find("[RED]");
    let po = text.find("[OK ]");
    if pr < 0 {
        RESULTS.push("FAIL|" + tag + "|报告里没有 [RED] 行");
    } else {
        if po < 0 {
            RESULTS.push("PASS|" + tag + "|有红行；无 [OK ] 行可比（视为通过）");
        } else {
            if pr < po {
                RESULTS.push("PASS|" + tag + "|红行位置 " + format("{}", pr) + " < 绿行位置 " + format("{}", po));
            } else {
                RESULTS.push("FAIL|" + tag + "|红行位置 " + format("{}", pr) + " 不早于绿行 " + format("{}", po));
            };
        };
    };
}

fn main() {
    // ── 夹具集（合成，见 tests/fixtures/）──
    let fixman = "tenth-lens/tests/fixtures/manifest_selftest.txt";
    let repman = "tenth-lens/corpus/manifest_g2_repeat.txt";
    let vmdif = "tenth-lens/corpus/manifest_vm_diff.txt";

    let rep = spawn_capture(args1("--manifest", fixman));
    assert_has("A01_超容差判红", rep, "[RED] X2|s2|jit|min  dev=50.00%");
    assert_has("A02_单位不一致判红", rep, "why=UNIT_MISMATCH(ms vs s)");
    assert_has("A03_NA口径分歧判红", rep, "why=NA_DIVERGE");
    assert_has("A04_同源重复数值判红", rep, "why=DUP_IN_SOURCE(gamma)");
    assert_has("A05_格式漂移判红", rep, "[RED] MALFORMED_PERF_LINE(beta)");
    assert_has("A06_单来源如实标注", rep, "[ONE] X7|s7|jit|min");
    assert_has("A07_缺key如实标注", rep, "alpha=MISSING");
    assert_has("A08_一致不可用标注", rep, "[NA ] X8|s8|jit|min");
    assert_has("A09_汇总计数", rep, "KEYS|11  RED|5  OK|3  NA(一致不可用)|1  ONE(仅单来源)|2");
    assert_has("A10_汇总含NOTE忽略数", rep, "NOTE_LINES_IGNORED(非数据)|3");
    assert_has("A11_结论为红", rep, "VERDICT|RED");
    assert_red_first("A12_红行优先", rep);
    assert_code("A13_红时退出码", spawn_code(args1("--manifest", fixman)), 1);

    // ── 同会话重复：默认容差应全绿；收紧到 ±1% 应变红（证明容差真的被使用）──
    let r20 = spawn_capture(args1("--manifest", repman));
    assert_has("A14_同会话重复默认容差全绿", r20, "VERDICT|GREEN（全部可比 key 均在容差内）");
    assert_has("A15_同会话重复14键全OK", r20, "KEYS|14  RED|0  OK|14");
    assert_code("A16_绿时退出码", spawn_code(args1("--manifest", repman)), 0);

    let mut t1 = Vec::new();
    t1.push("--manifest");
    t1.push(repman);
    t1.push("--tolerance");
    t1.push("1");
    let r1 = spawn_capture(t1);
    assert_has("A17_容差收紧后判红", r1, "VERDICT|RED");
    assert_has("A18_容差生效(tol=±1)", r1, "tol=±1.00%");

    // ── 已知污染源 vs 干净源：G2|matmul_512|vm|min 必须判红（验收 1 的核心断言）──
    let mut v1 = Vec::new();
    v1.push("--manifest");
    v1.push(vmdif);
    v1.push("--only");
    v1.push("G2:matmul_512");
    let rv = spawn_capture(v1);
    assert_has("A19_污染源判红", rv, "[RED] G2|matmul_512|vm|min");
    assert_has("A20_偏离量约1.7倍", rv, "dev=174.64% (2.75x)");
    assert_has("A21_窄范围自我标注", rv, "SCOPE|narrowed");
    assert_absent("A22_不静默跳过", rv, "MISSING|SKIP");

    // ══════════════════════════════════════════════════════════════════
    // P1 段（2026-09-17 W6-lens）：跨路径差分检查器
    // ══════════════════════════════════════════════════════════════════
    let dprobes = "tenth-lens/corpus/diff_probes.txt";
    // 分歧阳性对照清单：**不能用** `corpus/diff_divergence.txt`（GAP-018 夹具）——
    // `AUDIT-11.4.85` 修复后它两路径一致、不再 DIVERGE（该清单保留为历史证据）。
    // 自检要证明的是「检查器判红是活的」，故改用**仍分歧**的 `diffctl_backend_split.th`
    // （`AUDIT-11.4.56`，也是差分检查器的内建阳性对照）。夹具清单见
    // `tests/fixtures/diff_divergence_control.txt`（2 条：1 DIVERGE + 1 PASS）。
    let ddiv = "tenth-lens/tests/fixtures/diff_divergence_control.txt";
    let dtimeout = "tenth-lens/corpus/diff_timeout.txt";
    let dnondet = "tenth-lens/corpus/diff_nondet.txt";
    let dbadexp = "tenth-lens/tests/fixtures/diff_bad_expect.txt";
    let dmiss = "tenth-lens/tests/fixtures/diff_missing_script.txt";
    let mmiss = "tenth-lens/tests/fixtures/manifest_missing_log.txt";

    // ── ① 正例：probes 全量两路径一致 ⇒ 全绿 + 退出码 0 ──
    let rp = spawn_full(args1("--diff", dprobes));
    assert_has("B01_正例全绿", full_out(rp), "VERDICT|GREEN（10 条两路径一致）");
    assert_code("B02_正例退出码0", full_code(rp), 0);
    assert_has("B03_诚实声明PASS不等于正确", full_out(rp), "CLAIM|PASS ＝ 两路径一致");
    assert_has("B04_防假绿_父环境干净已核", full_out(rp), "BACKEND-GUARD|parent-env-clean");
    assert_has("B05_后端阳性对照已分离", full_out(rp), "CONTROL|DIVERGED");
    assert_has("B06_汇总无静默跳过", full_out(rp), "SKIPPED|0");
    assert_absent("B07_正例里没有DIVERGE", full_out(rp), "[DIVERGE]");

    // ── ② 真分歧（对照夹具 `diffctl_backend_split.th`，见上方 ddiv 注释）⇒ 判红 + 退出码 1；
    //      同清单里的 `callsite_controls` 仍应 PASS（不误判）──
    let rd = spawn_full(args1("--diff", ddiv));
    assert_has("B08_真分歧判红", full_out(rd), "[DIVERGE] split_control");
    assert_has("B09_分歧给出退出码对照", full_out(rd), "exit(A/B)=0/0");
    assert_has("B10_对照组不误判", full_out(rd), "[PASS] callsite_controls");
    assert_code("B11_分歧退出码1", full_code(rd), 1);

    // ── ③ 注入错期望：故意把金标准写错 ⇒ 必须判红（判决是活的，不是装饰）──
    //    ★本波退出码三态化：`EXPECT_FAIL` 属「无法判定」⇒ `VERDICT|UNVERIFIED` + **退出码 3**，
    //      不是 1——它**不是**两路径分歧（"不冒充绿，也不冒充分歧"）。
    let rb = spawn_full(args1("--diff", dbadexp));
    assert_has("B12_注入错期望判红", full_out(rb), "[EXPECT_FAIL] injected_wrong_expect");
    assert_has("B13_注入错期望给VERDICT_UNVERIFIED", full_out(rb), "VERDICT|UNVERIFIED");
    assert_code("B14_注入错期望退出码3", full_code(rb), 3);

    // ── ④ 超时用例：卡死程序必须被明确标注（不许静默）──
    let mut tt = Vec::new();
    tt.push("--diff");
    tt.push(dtimeout);
    tt.push("--timeout-ms");
    tt.push("1200");
    let rt = spawn_full(tt);
    assert_has("B15_超时明确标注", full_out(rt), "[TIMEOUT] hang");
    assert_has("B16_超时标出哪一侧", full_out(rt), "side=默认路径");
    assert_has("B17_超时给部分输出与退出码", full_out(rt), "partial_out_bytes=11");
    // ★三态：只有 TIMEOUT（无 DIVERGE）⇒ 退出码 3
    assert_code("B18_超时退出码3", full_code(rt), 3);

    // ── ⑤ 非确定输出：同侧复跑就不同 ⇒ 判 NONDET（不冒充后端分歧、不判绿）──
    let mut rn = Vec::new();
    rn.push("--diff");
    rn.push(dnondet);
    rn.push("--repeat");
    rn.push("2");
    let rr = spawn_full(rn);
    assert_has("B19_非确定判NONDET", full_out(rr), "[NONDET] json_demo");
    assert_has("B20_非确定说明归因不了", full_out(rr), "无法把差异归因于后端");
    // ★三态：只有 NONDET（无 DIVERGE）⇒ 退出码 3
    assert_code("B21_非确定退出码3", full_code(rr), 3);
    assert_has("B22_重复次数入报告", full_out(rr), "REPEAT|2");

    // ── ⑥ 输入错误一律响亮（清单缺失 / 脚本缺失 / P0 日志缺失）──
    let rmn = spawn_full(args1("--diff", "tenth-lens/corpus/NO_SUCH_MANIFEST.txt"));
    assert_has("B23_清单不存在明确报错", full_out(rmn), "用法错误：差分清单不存在");
    assert_code("B24_清单不存在退出码2", full_code(rmn), 2);

    let rm = spawn_full(args1("--diff", dmiss));
    assert_has("B25_脚本缺失FATAL", full_out(rm), "[FATAL] SCRIPT_MISSING|ghost_script");
    assert_code("B26_脚本缺失退出码2", full_code(rm), 2);

    let rml = spawn_full(args1("--manifest", mmiss));
    assert_has("B27_P0日志缺失FATAL", full_out(rml), "[FATAL] SOURCE_MISSING|ghost-source");
    assert_has("B28_P0日志缺失给重生成指针", full_out(rml), "corpus/README.md");
    assert_code("B29_P0日志缺失退出码2", full_code(rml), 2);

    // ── ⑦ 关掉后端对照 ⇒ 如实降级标注（不假装仍有证据）──
    let mut nc = Vec::new();
    nc.push("--diff");
    nc.push(ddiv);
    nc.push("--no-control");
    let rc2 = spawn_full(nc);
    assert_has("B30_关对照如实降级", full_out(rc2), "CONTROL|DISABLED");

    // ── ⑧ --stderr-contains 关键字缺失也要判红 ──
    let mut sc = Vec::new();
    sc.push("--diff");
    sc.push(ddiv);
    sc.push("--stderr-contains");
    sc.push("ZZ_NO_SUCH_TOKEN");
    let rs = spawn_full(sc);
    assert_has("B31_stderr关键字缺失判红", full_out(rs), "why=STDERR_CONTAINS_MISS");
    assert_code("B32_stderr关键字退出码1", full_code(rs), 1);

    // ══════════════════════════════════════════════════════════════════
    // 本波新增（方法论级默认缺陷"假红"修复）：
    //   ① 默认 `--repeat 2`（确定性复核是**默认步骤**，不是可选优化）
    //   ② 显式降级 `--repeat 1` 必须打 WARN 且留痕 `REPEAT|1`
    //   ③ 退出码**三态**：0=全 PASS / 1=有 DIVERGE / 2=输入错误 / 3=无分歧但有「无法判定」
    //   ④ 首个 DIVERGE 自动复跑确认（REPEAT=1 时补跑解释器侧；不一致 ⇒ 降级 NONDET）
    // ══════════════════════════════════════════════════════════════════

    // ── ⑨ 显式降级 --repeat 1：必须 WARN + 留痕（"喊狼来了"的病根在这里留证据）──
    let mut r1x = Vec::new();
    r1x.push("--diff");
    r1x.push(dprobes);
    r1x.push("--repeat");
    r1x.push("1");
    let r1o = spawn_full(r1x);
    assert_has("C01_REPEAT1打警告", full_out(r1o), "WARN|REPEAT=1：未做确定性复核");
    assert_has("C02_REPEAT1留痕", full_out(r1o), "REPEAT|1");
    assert_has("C03_REPEAT1说明后果", full_out(r1o), "可能来自被测程序自身的随机性，不是后端分歧");
    assert_code("C04_REPEAT1全PASS仍退0", full_code(r1o), 0);

    // ── ⑩ 默认不传 --repeat 即为 REPEAT=2：非确定程序必须判 NONDET，**不许**判 DIVERGE ──
    let rdef = spawn_full(args1("--diff", dnondet));
    assert_has("C05_默认即REPEAT2", full_out(rdef), "REPEAT|2");
    assert_has("C06_默认下非确定判NONDET", full_out(rdef), "[NONDET] json_demo");
    assert_absent("C07_NONDET不被判DIVERGE", full_out(rdef), "[DIVERGE]");
    assert_has("C08_NONDET终态UNVERIFIED", full_out(rdef), "VERDICT|UNVERIFIED");
    assert_code("C09_无分歧只有无法判定退3", full_code(rdef), 3);

    // ── ⑪ 三态退出码：有 DIVERGE ⇒ 1；全 PASS ⇒ 0（2 = 输入错误，见 B24/B26/B29/B36）──
    let rdiv = spawn_full(args1("--diff", ddiv));
    assert_has("C10_分歧VERDICT_RED", full_out(rdiv), "VERDICT|RED（1 条两路径分歧）");
    assert_code("C11_有真分歧退1", full_code(rdiv), 1);
    assert_code("C12_全PASS退0", full_code(spawn_full(args1("--diff", dprobes))), 0);

    // ── ⑫ 可选加分开关 --fail-on-unverified：把「无法判定」抬成失败（CI 严格门）──
    let mut rfu = Vec::new();
    rfu.push("--diff");
    rfu.push(dnondet);
    rfu.push("--fail-on-unverified");
    let rfuo = spawn_full(rfu);
    assert_has("C13_开关下终态仍UNVERIFIED", full_out(rfuo), "VERDICT|UNVERIFIED");
    assert_has("C14_开关在VERDICT里留痕", full_out(rfuo), "--fail-on-unverified 已启用");
    assert_code("C15_开关把无法判定抬成1", full_code(rfuo), 1);

    // ── ⑬ 首个 DIVERGE 的自动复跑确认（确定性夹具应复现 ⇒ 维持 DIVERGE 与退出码 1）──
    let mut rcf = Vec::new();
    rcf.push("--diff");
    rcf.push(ddiv);
    rcf.push("--repeat");
    rcf.push("1");
    let rcfo = spawn_full(rcf);
    assert_has("C16_确认轮有留痕", full_out(rcfo), "CONFIRM|首个 DIVERGE");
    assert_has("C17_确定性分歧复现后维持DIVERGE", full_out(rcfo), "[DIVERGE] split_control");
    assert_has("C18_确认轮如实标注只覆盖解释器侧", full_out(rcfo), "GAP-008：env_set 后无法再跑默认路径");
    assert_code("C19_维持分歧仍退1", full_code(rcfo), 1);

    // ── ⑭ ★防假绿实测：父进程设 TENTH_NO_VM=0（`is_ok()` 判定 ⇒ 设 0 也算已设置）──
    //     必须**硬失败**：否则两次 spawn 都跑解释器 ⇒ 报告"全一致"实为双解释器自比自。
    //     **本组必须是最后一项**：env_set 污染本进程 env，之后任何 spawn 都会带上它。
    env_set("TENTH_NO_VM", "0");
    let rg = spawn_full(args1("--diff", dprobes));
    assert_has("B33_父进程env脏硬失败", full_out(rg), "[FATAL] PARENT_ENV_DIRTY");
    assert_has("B34_硬失败点明假绿风险", full_out(rg), "假绿");
    assert_has("B35_硬失败不给任何PASS", full_out(rg), "TENTH_NO_VM 已被设置");
    assert_code("B36_env脏退出码2", full_code(rg), 2);
    assert_absent("B37_env脏时不产出报告", full_out(rg), "VERDICT|GREEN");

    // ── 汇总 ──
    let mut n_pass = 0;
    let mut n_fail = 0;
    let mut i = 0;
    while i < RESULTS.len() {
        let r = RESULTS.get(i);
        println("SELFTEST-CASE|" + r);
        if r.starts_with("PASS|") {
            n_pass = n_pass + 1;
        } else {
            n_fail = n_fail + 1;
        };
        i = i + 1;
    };
    println("SELFTEST|" + format("{}", RESULTS.len()) + "|PASS|" + format("{}", n_pass) + "|FAIL|" + format("{}", n_fail));
    if n_fail > 0 {
        println("SELFTEST-VERDICT|FAIL");
        exit(1);
    };
    println("SELFTEST-VERDICT|PASS|" + format("{}", n_pass) + " 项全过");
    exit(0);
}
