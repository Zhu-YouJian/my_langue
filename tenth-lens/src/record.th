// tenth-lens/src/record.th —— **记录层**（证据）：解析 PERF| / PERF-NA| / PERF-NOTE| + 清单加载
//
// 拆自 P0 单文件 main.th 的「记录层」分节；行格式、字段校验、诊断文案**逐字未改**
//（P0 自检 asserts 的是报告原文，改字即回归）。
//
// 输入格式（一份日志可含多段）：
//   PERF|<group>|<scenario>|<path>|<metric>|<value>|<unit>        数据行
//   PERF-NA|<group>|<scenario>|<path>|<reason>                    不可用 + 原因（无 metric 字段）
//   PERF-NOTE|...                                                 口径说明 —— **不是数据**
//   其余行视为噪声（计数，不参与判决）
//
// 全局命名约定：本模块顶层 `let` 一律 `REC_` 前缀——因为模块级顶层 `let` **不按模块
// 隔离**（同名会静默别名，见 GAPS.md GAP-015），前缀是当前唯一可用的绕行。
//
// 导入方式：`use src::record::<函数名>`

use std::fs::fs::read_text

// ───────────────────────── 记录层状态 ─────────────────────────

let mut REC_LABELS: Vec = Vec::new()        // 来源标签（清单顺序）
let mut REC_PATHS: Vec = Vec::new()         // 来源路径（与标签同序）
let mut REC_ROWS: HashMap = HashMap::new()  // label -> 数据行数
let mut REC_NOTES: HashMap = HashMap::new() // label -> PERF-NOTE 行数
let mut REC_NOISE: HashMap = HashMap::new() // label -> 噪声行数
let mut REC_KEYS: Vec = Vec::new()          // key 插入序
let mut REC_KEY_ROWS: HashMap = HashMap::new() // key -> Vec of [label, record]
let mut REC_NA: HashMap = HashMap::new()    // "g|s|p" -> Vec of [label, reason]
let mut REC_MALFORMED: Vec = Vec::new()     // [label, line]
let mut REC_UNREADABLE: Vec = Vec::new()    // [label, path]
let mut REC_MANIFEST_BAD: i32 = 0           // 清单格式错误行数

// 注：**刻意不设全局标量计数器**（P0 立项时的理由：VM 曾静默丢「main 与函数同写的全局标量」
// 写入，GAP-012 / AUDIT-11.4.55）。该缺陷已于 2026-09-17 修复，本轮探针复验两路径一致
// （`N3=2 N5=4`）——但计数仍由调用方局部累加，不改回全局标量以免制造新依赖。

// ───────────────────── 记录层：编码与解析 ─────────────────────
// record 编码：Vec = [group, scenario, path, metric, value_raw, unit, value_f64, is_numeric]

fn rec_make(g: String, s: String, p: String, m: String, raw: String, u: String) -> Vec {
    let mut r = Vec::new();
    r.push(g);
    r.push(s);
    r.push(p);
    r.push(m);
    r.push(raw);
    r.push(u);
    let mut isnum = true;
    let mut v = 0.0;
    if raw.is_empty() {
        isnum = false;
    } else {
        let low = raw.to_lower();
        if low.starts_with("n/a") {
            isnum = false;
        } else {
            if low.starts_with("na") {
                isnum = false;
            } else {
                v = parse_float(raw);
            };
        };
    };
    r.push(v);
    r.push(isnum);
    r
}

fn rec_key(r: Vec) -> String {
    r.get(0) + "|" + r.get(1) + "|" + r.get(2) + "|" + r.get(3)
}

fn rec_span(r: Vec) -> String {
    r.get(0) + "|" + r.get(1) + "|" + r.get(2)
}

// 解析一行数据行；字段数不符 → 记入 REC_MALFORMED（不静默跳过）
fn rec_parse_perf(label: String, ln: String) {
    let f = ln.split("|");
    if f.len() != 7 {
        let mut m = Vec::new();
        m.push(label);
        m.push(ln);
        REC_MALFORMED.push(m);
        return;
    };
    let r = rec_make(f.get(1).trim(), f.get(2).trim(), f.get(3).trim(), f.get(4).trim(), f.get(5).trim(), f.get(6).trim());
    let key = rec_key(r);
    if !REC_KEY_ROWS.contains_key(key) {
        REC_KEY_ROWS.insert(key, Vec::new());
        REC_KEYS.push(key);
    };
    let mut row = Vec::new();
    row.push(label);
    row.push(r);
    REC_KEY_ROWS.get(key).push(row);
    REC_ROWS.insert(label, REC_ROWS.get(label) + 1);
}

// 解析 PERF-NA 行：按 (group, scenario, path) 记「不可用 + 原因」
fn rec_parse_na(label: String, ln: String) {
    let f = ln.split("|");
    if f.len() != 5 {
        let mut m = Vec::new();
        m.push(label);
        m.push(ln);
        REC_MALFORMED.push(m);
        return;
    };
    let span = f.get(1).trim() + "|" + f.get(2).trim() + "|" + f.get(3).trim();
    if !REC_NA.contains_key(span) {
        REC_NA.insert(span, Vec::new());
    };
    let mut row = Vec::new();
    row.push(label);
    row.push(f.get(4).trim());
    REC_NA.get(span).push(row);
}

fn rec_load(label: String, path: String) {
    if !path_exists(path) {
        let mut u = Vec::new();
        u.push(label);
        u.push(path);
        REC_UNREADABLE.push(u);
        return;
    };
    REC_LABELS.push(label);
    REC_PATHS.push(path);
    REC_ROWS.insert(label, 0);
    REC_NOTES.insert(label, 0);
    REC_NOISE.insert(label, 0);

    let lines = read_text(path).split("\n");
    let mut i = 0;
    while i < lines.len() {
        let ln = lines.get(i).trim();
        if ln.starts_with("PERF-NOTE|") {
            REC_NOTES.insert(label, REC_NOTES.get(label) + 1);
        } else {
            if ln.starts_with("PERF-NA|") {
                rec_parse_na(label, ln);
            } else {
                if ln.starts_with("PERF|") {
                    rec_parse_perf(label, ln);
                } else {
                    if ln.len() > 0 {
                        REC_NOISE.insert(label, REC_NOISE.get(label) + 1);
                    };
                };
            };
        };
        i = i + 1;
    };
}

// ─────────────────── 清单解析（每行 `标签|路径`） ───────────────────
// 返回 true = 清单可解析（逐行诊断已打印）；false = 用法/输入错误（调用方 exit 2）
fn rec_load_manifest(path: String) -> bool {
    if !path_exists(path) {
        println("用法错误：清单文件不存在：" + path);
        return false;
    };
    let lines = read_text(path).split("\n");
    let mut i = 0;
    while i < lines.len() {
        let ln = lines.get(i).trim();
        let mut skip = false;
        if ln.is_empty() {
            skip = true;
        } else {
            if ln.starts_with("#") {
                skip = true;
            };
        };
        if !skip {
            let f = ln.split("|");
            if f.len() != 2 {
                println("清单格式错误（应为 `标签|路径`）：" + ln);
                REC_MANIFEST_BAD = REC_MANIFEST_BAD + 1;
            } else {
                rec_load(f.get(0).trim(), f.get(1).trim());
            };
        };
        i = i + 1;
    };
    REC_MANIFEST_BAD == 0
}

// ───────────────────── 记录层：只读访问器 ─────────────────────

fn rec_src_count() -> i32 {
    REC_LABELS.len()
}

fn rec_label_at(i: i32) -> String {
    REC_LABELS.get(i)
}

fn rec_path_at(i: i32) -> String {
    REC_PATHS.get(i)
}

fn rec_rows(label: String) -> i32 {
    if REC_ROWS.contains_key(label) {
        return REC_ROWS.get(label);
    };
    0
}

fn rec_notes(label: String) -> i32 {
    if REC_NOTES.contains_key(label) {
        return REC_NOTES.get(label);
    };
    0
}

fn rec_noise(label: String) -> i32 {
    if REC_NOISE.contains_key(label) {
        return REC_NOISE.get(label);
    };
    0
}

fn rec_notes_total() -> i32 {
    let mut t = 0;
    let mut i = 0;
    while i < REC_LABELS.len() {
        // 先绑局部再当 HashMap 键（GAP-013 的历史绕行；该缺陷已修，保留写法零成本）
        let l = REC_LABELS.get(i);
        t = t + rec_notes(l);
        i = i + 1;
    };
    t
}

fn rec_noise_total() -> i32 {
    let mut t = 0;
    let mut i = 0;
    while i < REC_LABELS.len() {
        let l = REC_LABELS.get(i);
        t = t + rec_noise(l);
        i = i + 1;
    };
    t
}

fn rec_key_count() -> i32 {
    REC_KEYS.len()
}

fn rec_key_at(i: i32) -> String {
    REC_KEYS.get(i)
}

fn rec_rows_of(key: String) -> Vec {
    if REC_KEY_ROWS.contains_key(key) {
        REC_KEY_ROWS.get(key)
    } else {
        Vec::new()
    }
}

fn rec_na_of(span: String) -> Vec {
    if REC_NA.contains_key(span) {
        REC_NA.get(span)
    } else {
        Vec::new()
    }
}

fn rec_malformed_count() -> i32 {
    REC_MALFORMED.len()
}

fn rec_malformed_at(i: i32) -> Vec {
    REC_MALFORMED.get(i)
}

fn rec_unreadable_count() -> i32 {
    REC_UNREADABLE.len()
}

fn rec_unreadable_at(i: i32) -> Vec {
    REC_UNREADABLE.get(i)
}
