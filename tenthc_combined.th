// Token definitions — v0.3.1 with struct defaults

struct Span {
    line: i64,
    col: i64,
}

struct Token {
    kind: str,      // "Int", "Ident", "Fn", "Let", "Plus", ...
    value: str,     // lexeme text
    span: Span,
}

fn KIND_EOF() -> str { "Eof" }
fn KIND_INT() -> str { "Int" }
fn KIND_IDENT() -> str { "Ident" }
fn KIND_FN() -> str { "Fn" }
fn KIND_LET() -> str { "Let" }
fn KIND_IF() -> str { "If" }
fn KIND_ELSE() -> str { "Else" }
fn KIND_RETURN() -> str { "Return" }
fn KIND_STRUCT() -> str { "Struct" }
fn KIND_PLUS() -> str { "Plus" }
fn KIND_MINUS() -> str { "Minus" }
fn KIND_STAR() -> str { "Star" }
fn KIND_SLASH() -> str { "Slash" }
fn KIND_ASSIGN() -> str { "Assign" }
fn KIND_EQEQ() -> str { "EqEq" }
fn KIND_LPAREN() -> str { "LParen" }
fn KIND_RPAREN() -> str { "RParen" }
fn KIND_LBRACE() -> str { "LBrace" }
fn KIND_RBRACE() -> str { "RBrace" }
fn KIND_COLON() -> str { "Colon" }
fn KIND_COMMA() -> str { "Comma" }
fn KIND_SEMICOLON() -> str { "Semicolon" }
fn KIND_ARROW() -> str { "Arrow" }
fn KIND_COLON2() -> str { "Colon2" }
fn KIND_DOT() -> str { "Dot" }
fn KIND_LBRACKET() -> str { "LBracket" }
fn KIND_RBRACKET() -> str { "RBracket" }
fn KIND_ANDAND() -> str { "AndAnd" }
fn KIND_LT() -> str { "Lt" }
fn KIND_GT() -> str { "Gt" }
fn KIND_GTEQ() -> str { "GtEq" }
fn KIND_LTEQ() -> str { "LtEq" }
fn KIND_NOTEQ() -> str { "NotEq" }
fn KIND_STRING() -> str { "String" }
fn KIND_BANG() -> str { "Bang" }
fn KIND_LOOP() -> str { "Loop" }
fn KIND_BREAK() -> str { "Break" }
fn KIND_CONTINUE() -> str { "Continue" }
fn KIND_WHILE() -> str { "While" }
fn KIND_OROR() -> str { "OrOr" }

// Self-hosting Lexer — v0.3.1

struct Lexer {
    source: str,
    pos: i64,
    line: i64,
    col: i64,
}

fn lexer_new(source: str) -> Lexer {
    Lexer { source: source, pos: 0, line: 1, col: 1 }
}

fn is_digit(ch: str) -> bool { (ch >= "0") && (ch <= "9") }
fn is_alpha(ch: str) -> bool { ((ch >= "a") && (ch <= "z")) || ((ch >= "A") && (ch <= "Z")) || (ch == "_") }
fn is_alnum(ch: str) -> bool { is_alpha(ch) || is_digit(ch) }
fn is_ws(ch: str) -> bool { (ch == " ") || (ch == "\n") || (ch == "\t") || (ch == "\r") }

fn lexer_peek(lexer: &Lexer) -> str {
    if lexer.pos < lexer.source.len() { lexer.source[lexer.pos] } else { "" }
}

fn lexer_advance(lexer: &mut Lexer) -> str {
    let ch = lexer_peek(lexer);
    if ch == "" { return ""; };
    lexer.pos = lexer.pos + 1;
    if ch == "\n" { lexer.line = lexer.line + 1; lexer.col = 1; }
    else { lexer.col = lexer.col + 1; };
    ch
}

fn make_span(line: i64, col: i64) -> Span { Span { line: line, col: col } }

fn make_token(kind: str, value: str, line: i64, col: i64) -> Token {
    let span = make_span(line, col);
    Token { kind: kind, value: value, span: span }
}

fn lexer_next(lexer: &mut Lexer) -> Token {
    let mut ch = lexer_peek(lexer);

    // Skip whitespace and comments
    while ch != "" {
        if is_ws(ch) { ch = lexer_advance(lexer); ch = lexer_peek(lexer); }
        else if ch == "/" {
            let next_pos = lexer.pos + 1;
            if (next_pos < lexer.source.len()) && (lexer.source[next_pos] == "/") {
                lexer_advance(lexer); lexer_advance(lexer);
                ch = lexer_peek(lexer);
                while (ch != "") && (ch != "\n") { ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
            } else { break; };
        } else { break; };
        ch = lexer_peek(lexer);
    };

    let line = lexer.line;
    let col = lexer.col;

    if ch == "" { return make_token(KIND_EOF(), "", line, col); };

    // Numbers
    if is_digit(ch) {
        let mut num_str = "";
        while is_digit(ch) {
            num_str = num_str + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };
        return make_token(KIND_INT(), num_str, line, col);
    };

    // Identifiers
    if is_alpha(ch) {
        let mut ident = "";
        while (ch != "") && is_alnum(ch) {
            ident = ident + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };

        // Keywords
        if ident == "fn" { return make_token(KIND_FN(), ident, line, col); };
        if ident == "let" { return make_token(KIND_LET(), ident, line, col); };
        if ident == "if" { return make_token(KIND_IF(), ident, line, col); };
        if ident == "else" { return make_token(KIND_ELSE(), ident, line, col); };
        if ident == "return" { return make_token(KIND_RETURN(), ident, line, col); };
        if ident == "struct" { return make_token(KIND_STRUCT(), ident, line, col); };
        if ident == "while" { return make_token(KIND_WHILE(), ident, line, col); };
        if ident == "loop" { return make_token(KIND_LOOP(), ident, line, col); };
        if ident == "break" { return make_token(KIND_BREAK(), ident, line, col); };
        if ident == "continue" { return make_token(KIND_CONTINUE(), ident, line, col); };

        return make_token(KIND_IDENT(), ident, line, col);
    };

    // Strings
    if ch == "\"" {
        lexer_advance(lexer);
        let mut s = "";
        ch = lexer_peek(lexer);
        while (ch != "") && (ch != "\"") { s = s + ch; ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
        if ch == "\"" { lexer_advance(lexer); };
        return make_token(KIND_STRING(), s, line, col);
    };

    // Single-char tokens
    lexer_advance(lexer);

    if ch == "(" { return make_token(KIND_LPAREN(), "(", line, col); };
    if ch == ")" { return make_token(KIND_RPAREN(), ")", line, col); };
    if ch == "{" { return make_token(KIND_LBRACE(), "{", line, col); };
    if ch == "}" { return make_token(KIND_RBRACE(), "}", line, col); };
    if ch == "+" { return make_token(KIND_PLUS(), "+", line, col); };
    if ch == "-" { if lexer_peek(lexer) == ">" { lexer_advance(lexer); return make_token(KIND_ARROW(), "->", line, col); }; return make_token(KIND_MINUS(), "-", line, col); };
    if ch == "*" { return make_token(KIND_STAR(), "*", line, col); };
    if ch == "/" { return make_token(KIND_SLASH(), "/", line, col); };
    if ch == ";" { return make_token(KIND_SEMICOLON(), ";", line, col); };
    if ch == ":" { if lexer_peek(lexer) == ":" { lexer_advance(lexer); return make_token(KIND_COLON2(), "::", line, col); }; return make_token(KIND_COLON(), ":", line, col); };
    if ch == "," { return make_token(KIND_COMMA(), ",", line, col); };
    if ch == "=" { if lexer_peek(lexer) == "=" { lexer_advance(lexer); return make_token(KIND_EQEQ(), "==", line, col); }; return make_token(KIND_ASSIGN(), "=", line, col); };
    if ch == "." { return make_token(KIND_DOT(), ".", line, col); };
    if ch == "[" { return make_token(KIND_LBRACKET(), "[", line, col); };
    if ch == "]" { return make_token(KIND_RBRACKET(), "]", line, col); };
    if ch == "<" { if lexer_peek(lexer) == "=" { lexer_advance(lexer); return make_token(KIND_LTEQ(), "<=", line, col); }; return make_token(KIND_LT(), "<", line, col); };
    if ch == ">" { if lexer_peek(lexer) == "=" { lexer_advance(lexer); return make_token(KIND_GTEQ(), ">=", line, col); }; return make_token(KIND_GT(), ">", line, col); };
    if ch == "!" { if lexer_peek(lexer) == "=" { lexer_advance(lexer); return make_token(KIND_NOTEQ(), "!=", line, col); }; return make_token(KIND_BANG(), "!", line, col); };
    if ch == "&" { if lexer_peek(lexer) == "&" { lexer_advance(lexer); return make_token(KIND_ANDAND(), "&&", line, col); }; };
    if ch == "|" { if lexer_peek(lexer) == "|" { lexer_advance(lexer); return make_token(KIND_OROR(), "||", line, col); }; };

    make_token(KIND_IDENT(), ch, line, col)
}

fn lexer_tokenize(lexer: &mut Lexer) -> Vec<Token> {
    let mut tokens = Vec::new();
    let mut done = false;
    while !done {
        let t = lexer_next(lexer);
        if t.kind == KIND_EOF() { tokens.push(t); done = true; }
        else { tokens.push(t); };
    };
    tokens
}

// Self-hosting Parser — v0.3.1 simplified: no peek, advance-only

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
}

struct Expr { kind: str, ival: i64, sval: str, op: str, left: i64, right: i64, right_sval: str }
struct Stmt { kind: str, name: str, ival: i64, sval: str, op: str, left: i64, right: i64, right_sval: str }
struct Param { name: str, type_ann: str }
struct FnDef { name: str, params: Vec<Param>, return_type: str, body: str }
struct StructDef { name: str, fields: Vec<Param> }
struct Program { structs: Vec<StructDef>, fns: Vec<FnDef>, main_stmts: Vec<Stmt> }

fn parser_new(tokens: Vec<Token>) -> Parser { Parser { tokens: tokens, pos: 0 } }

fn parser_next(p: &mut Parser) -> Token {
    if p.pos < p.tokens.len() { let t = p.tokens[p.pos]; p.pos = p.pos + 1; t }
    else { make_token(KIND_EOF(), "", 0, 0) }
}

fn make_int_expr(v: str) -> Expr { Expr { kind: "int", ival: 0, sval: v, op: "", left: 0, right: 0, right_sval: "" } }
fn make_ident_expr(n: str) -> Expr { Expr { kind: "ident", ival: 0, sval: n, op: "", left: 0, right: 0, right_sval: "" } }
fn make_binary_expr(l: Expr, o: str, r: Expr) -> Expr {
    let r_str_flag = if r.kind == "str" { 1 } else { 0 };
    let rsval = if r.kind == "call" { r.sval + "()" } else { r.sval };
    Expr { kind: "binary", ival: 0, sval: l.sval, op: o, left: r_str_flag, right: r.ival, right_sval: rsval }
}
fn make_assign_expr(target: str, value: Expr) -> Expr {
    Expr { kind: "assign", ival: 0, sval: target, op: "=", left: 0, right: value.ival, right_sval: value.sval }
}
fn make_call_expr(func: str, args: str) -> Expr {
    Expr { kind: "call", ival: 0, sval: func, op: "", left: 0, right: 0, right_sval: args }
}

fn cur_tok(p: &Parser) -> Token { p.tokens[p.pos] }

fn parse_primary(p: &mut Parser) -> Expr {
    if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_RBRACE() { return make_int_expr("0"); }
    if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_LBRACE() { return make_int_expr("0"); }
    if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_SEMICOLON() { parser_next(p); return make_int_expr("0"); }
    let t = parser_next(p);
    if t.kind == KIND_INT() { make_int_expr(t.value) }
    else if t.kind == KIND_STRING() { Expr { kind: "str", ival: 0, sval: t.value, op: "", left: 0, right: 0, right_sval: "" } }
    else if t.kind == KIND_BANG() {
        let inner = parse_primary(p);
        Expr { kind: "unary", ival: 0, sval: inner.sval, op: "!", left: 0, right: 0, right_sval: "" }
    }
    else if t.kind == KIND_IDENT() {
        let name = t.value;
        if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_LPAREN() {
            parser_next(p); // (
            let mut args = "";
            while p.pos < p.tokens.len() && p.tokens[p.pos].kind != KIND_RPAREN() {
                let a = parse_expr(p);
                if args != "" { args = args + ", "; };
                if a.kind == "str" { args = args + "\"" + a.sval + "\""; }
                else if a.kind == "call" { args = args + a.sval + "()"; }
                else { args = args + a.sval; };
                if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_COMMA() { parser_next(p); };
            };
            parser_next(p); // )
            make_call_expr(name, args)
        } else if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_LBRACE() {
            parser_next(p); // {
            let mut fields = "";
            while p.pos < p.tokens.len() && p.tokens[p.pos].kind != KIND_RBRACE() {
                let fname = parser_next(p).value;
                parser_next(p); // :
                let fval = parse_expr(p);
                if fields != "" { fields = fields + ", "; };
                fields = fields + "." + fname + " = ";
                if fval.kind == "str" { fields = fields + "\"" + fval.sval + "\""; }
                else if fval.kind == "call" { fields = fields + fval.sval + "()"; }
                else { fields = fields + fval.sval; };
                if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_COMMA() { parser_next(p); };
            };
            parser_next(p); // }
            Expr { kind: "struct", ival: 0, sval: name, op: "", left: 0, right: 0, right_sval: fields }
        } else { make_ident_expr(name) }
    }
    else if t.kind == KIND_LPAREN() { let e = parse_expr(p); parser_next(p); e }
    else if t.kind == KIND_SEMICOLON() || t.kind == KIND_RBRACE() || t.kind == KIND_EOF() { make_int_expr("0") }
    else { make_int_expr("0") }
}

fn parse_postfix(p: &mut Parser) -> Expr {
    let mut expr = parse_primary(p);
    while p.pos < p.tokens.len() {
        let k = p.tokens[p.pos].kind;
        if k == KIND_DOT() {
            parser_next(p);
            let field = parser_next(p).value;
            expr.sval = expr.sval + "." + field;
        } else if k == KIND_LBRACKET() {
            parser_next(p);
            let idx = parse_expr(p);
            parser_next(p); // ]
            expr.sval = expr.sval + "[" + idx.sval + "]";
        } else { break; };
    };
    expr
}

fn prec_of(k: str) -> i64 {
    if k == KIND_STAR() || k == KIND_SLASH() { 2 }
    else if k == KIND_PLUS() || k == KIND_MINUS() { 1 }
    else if k == KIND_EQEQ() || k == KIND_NOTEQ() || k == KIND_LT() || k == KIND_GT() || k == KIND_LTEQ() || k == KIND_GTEQ() { 0 }
    else if k == KIND_ANDAND() { -1 }
    else if k == KIND_OROR() { -2 }
    else { -1 }
}

fn parse_binary(p: &mut Parser, min_prec: i64) -> Expr {
    let mut left = parse_postfix(p);
    while p.pos < p.tokens.len() {
        let k = p.tokens[p.pos].kind;
        let prec = prec_of(k);
        if prec < min_prec { break; };
        let op_token = parser_next(p);
        let op_str = op_token.value;
        let right = parse_binary(p, prec + 1);
        left = make_binary_expr(left, op_str, right);
    };
    left
}

fn parse_expr(p: &mut Parser) -> Expr {
    let left = parse_binary(p, 0);
    if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_ASSIGN() {
        parser_next(p);
        let right = parse_expr(p);
        make_assign_expr(left.sval, right)
    } else { left }
}

fn parse_block_body(p: &mut Parser) -> str {
    parser_next(p); // {
    let mut out = "";
    let mut depth = 1;
    while p.pos < p.tokens.len() && depth > 0 {
        let v = p.tokens[p.pos].value;
        if v == "{" { depth = depth + 1; parser_next(p); 0 }
        else if v == "}" { depth = depth - 1; if depth > 0 { parser_next(p); 0 } else { 0 }; 0 }
        else { out = out + cgen_stmt(&parse_stmt(p)); 0 };
    };
    if p.pos < p.tokens.len() && p.tokens[p.pos].value == "}" { parser_next(p); };
    out
}

fn parse_stmt(p: &mut Parser) -> Stmt {
    if p.pos >= p.tokens.len() { return Stmt { kind: "expr", name: "", ival: 0, sval: "", op: "", left: 0, right: 0, right_sval: "" }; };
    let k = p.tokens[p.pos].kind;
    if k == KIND_LET() {
        parser_next(p); // let
        let name = parser_next(p).value;
        parser_next(p); // =
        let val = parse_expr(p);
        parser_next(p); // ;
        Stmt { kind: "let", name: name, ival: val.ival, sval: val.sval, op: val.kind, left: val.left, right: val.right, right_sval: val.right_sval }
    } else if k == KIND_IF() {
        parser_next(p); // if
        let cond = parse_expr(p);
        let then_body = parse_block_body(p);
        let mut else_body = "";
        if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_ELSE() {
            parser_next(p); // else
            if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_IF() {
                let nested = parse_stmt(p);
                else_body = cgen_stmt(&nested);
            } else if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_LBRACE() {
                else_body = parse_block_body(p);
            };
        };
        Stmt { kind: "if", name: then_body, ival: 0, sval: cgen_expr(&cond), op: else_body, left: 0, right: 0, right_sval: "" }
    } else if k == KIND_WHILE() {
        parser_next(p); // while
        let cond = parse_expr(p);
        let body = parse_block_body(p);
        Stmt { kind: "while", name: body, ival: 0, sval: cgen_expr(&cond), op: "", left: 0, right: 0, right_sval: "" }
    } else if k == KIND_LOOP() {
        parser_next(p); // loop
        let body = parse_block_body(p);
        Stmt { kind: "loop", name: body, ival: 0, sval: "", op: "", left: 0, right: 0, right_sval: "" }
    } else if k == KIND_BREAK() {
        parser_next(p); // break
        parser_next(p); // ;
        Stmt { kind: "break", name: "", ival: 0, sval: "", op: "", left: 0, right: 0, right_sval: "" }
    } else if k == KIND_CONTINUE() {
        parser_next(p); // continue
        parser_next(p); // ;
        Stmt { kind: "continue", name: "", ival: 0, sval: "", op: "", left: 0, right: 0, right_sval: "" }
    } else if k == KIND_RETURN() {
        parser_next(p); // return
        let val = parse_expr(p);
        parser_next(p); // ;
        Stmt { kind: "return", name: val.op, ival: val.ival, sval: val.sval, op: val.kind, left: val.left, right: val.right, right_sval: val.right_sval }
    } else if k == KIND_SEMICOLON() {
        parser_next(p); // ;
        Stmt { kind: "expr", name: "", ival: 0, sval: "", op: "", left: 0, right: 0, right_sval: "" }
    } else {
        let val = parse_expr(p);
        if p.pos < p.tokens.len() && p.tokens[p.pos].kind == KIND_SEMICOLON() { parser_next(p); };
        Stmt { kind: "expr", name: val.op, ival: val.ival, sval: val.sval, op: val.kind, left: val.left, right: val.right, right_sval: val.right_sval }
    }
}

fn parse_fn(p: &mut Parser) -> FnDef {
    parser_next(p); // skip 'fn' keyword
    let name = parser_next(p).value;
    parser_next(p); // (
    let mut params = Vec::new();
    let mut tok = parser_next(p);
    while tok.kind != KIND_RPAREN() {
        let pname = tok.value;
        parser_next(p); // :
        let ptype = parser_next(p).value;
        params.push(Param { name: pname, type_ann: ptype });
        tok = parser_next(p);
        if tok.kind == KIND_COMMA() { tok = parser_next(p); };
    };
    // parse -> return type if present
    let mut ret_type = "";
    tok = parser_next(p);
    if tok.kind == KIND_ARROW() { ret_type = parser_next(p).value; };
    // body is { ... } — parse_block_body consumes the {
    let body = parse_block_body(p);
    FnDef { name: name, params: params, return_type: ret_type, body: body }
}

fn parse_struct(p: &mut Parser) -> StructDef {
    parser_next(p); // skip 'struct' keyword
    let name = parser_next(p).value;
    parser_next(p); // {
    let mut fields = Vec::new();
    let mut tok = parser_next(p);
    while tok.kind != KIND_RBRACE() {
        let fname = tok.value;
        parser_next(p); // :
        let ftype = parser_next(p).value;
        fields.push(Param { name: fname, type_ann: ftype });
        tok = parser_next(p);
        if tok.kind == KIND_COMMA() { tok = parser_next(p); };
    };
    StructDef { name: name, fields: fields }
}

fn parse_program(tokens: Vec<Token>) -> Program {
    let mut p = parser_new(tokens);
    let mut structs = Vec::new();
    let mut fns = Vec::new();
    let mut main_stmts = Vec::new();
    loop {
        if p.pos >= p.tokens.len() { break; };
        if p.tokens[p.pos].kind == KIND_EOF() { break; };
        if p.tokens[p.pos].kind == KIND_STRUCT() { structs.push(parse_struct(&mut p)); }
        else if p.tokens[p.pos].kind == KIND_FN() { fns.push(parse_fn(&mut p)); }
        else { main_stmts.push(parse_stmt(&mut p)); };
    }
    Program { structs: structs, fns: fns, main_stmts: main_stmts }
}

// Self-hosting Codegen — v0.3.1
// Program → C code

fn stmt_to_expr(stmt: &Stmt) -> Expr {
    Expr { kind: stmt.op, ival: stmt.ival, sval: stmt.sval, op: stmt.name, left: stmt.left, right: stmt.right, right_sval: stmt.right_sval }
}

fn cgen_binary_op(expr: &Expr) -> str {
    let r = if expr.left != 0 { "\"" + expr.right_sval + "\"" } else { expr.right_sval };
    if r == "" { r = "" + expr.right; };
    if expr.op == "==" { "(strcmp(" + expr.sval + ", " + r + ") == 0)" }
    else if expr.op == "!=" { "(strcmp(" + expr.sval + ", " + r + ") != 0)" }
    else { "(" + expr.sval + " " + expr.op + " " + r + ")" }
}

fn cgen_expr(expr: &Expr) -> str {
    if expr.kind == "int" { expr.sval }
    else if expr.kind == "str" { "\"" + expr.sval + "\"" }
    else if expr.kind == "ident" { expr.sval }
    else if expr.kind == "unary" { expr.op + expr.sval }
    else if expr.kind == "binary" { cgen_binary_op(expr) }
    else if expr.kind == "assign" { expr.sval + " = " + expr.right_sval }
    else if expr.kind == "struct" { "(" + expr.sval + "){" + expr.right_sval + "}" }
    else if expr.kind == "call" { expr.sval + "(" + expr.right_sval + ")" }
    else { "0" }
}

fn cgen_stmt(stmt: &Stmt) -> str {
    if stmt.kind == "let" {
        "int64_t " + stmt.name + " = " + cgen_expr(&stmt_to_expr(stmt)) + ";\n"
    } else if stmt.kind == "if" {
        let mut out = "if (" + stmt.sval + ") {\n" + stmt.name + "}";
        if stmt.op != "" { out = out + " else {\n" + stmt.op + "}"; };
        out + "\n"
    } else if stmt.kind == "while" {
        "while (" + stmt.sval + ") {\n" + stmt.name + "}\n"
    } else if stmt.kind == "loop" {
        "while (1) {\n" + stmt.name + "}\n"
    } else if stmt.kind == "break" {
        "break;\n"
    } else if stmt.kind == "continue" {
        "continue;\n"
    } else if stmt.kind == "return" {
        "return " + cgen_expr(&stmt_to_expr(stmt)) + ";\n"
    } else {
        cgen_expr(&stmt_to_expr(stmt)) + ";\n"
    }
}

fn type_to_c(t: str) -> str {
    if t == "i64" { "int64_t" }
    else if t == "str" { "const char*" }
    else if t == "bool" { "bool" }
    else if t == "f64" { "double" }
    else if t == "i32" { "int32_t" }
    else { t }
}

fn cgen_struct(s: &StructDef) -> str {
    let mut out = "typedef struct {\n";
    let mut i = 0;
    while i < s.fields.len() {
        let f = s.fields[i];
        out = out + "    " + type_to_c(f.type_ann) + " " + f.name + ";\n";
        i = i + 1;
    };
    out = out + "} " + s.name + ";\n\n";
    out
}

fn cgen_fn(f: &FnDef) -> str {
    let ret_c = if f.return_type == "" { "void" } else { type_to_c(f.return_type) };
    let mut out = ret_c + " " + f.name + "(";
    let mut i = 0;
    while i < f.params.len() {
        let p = f.params[i];
        if i > 0 { out = out + ", "; };
        out = out + type_to_c(p.type_ann) + " " + p.name;
        i = i + 1;
    };
    out + ") {\n" + f.body + "}\n\n"
}

fn cgen_program(prog: &Program) -> str {
    let mut out = "#include <stdio.h>\n#include <string.h>\n#include <stdint.h>\n#include <stdbool.h>\n\n";
    let mut i = 0;
    while i < prog.structs.len() { out = out + cgen_struct(&prog.structs[i]); i = i + 1; };
    i = 0;
    while i < prog.fns.len() { out = out + cgen_fn(&prog.fns[i]); i = i + 1; };
    out = out + "int main(void) {\n";
    i = 0;
    while i < prog.main_stmts.len() { out = out + "    " + cgen_stmt(&prog.main_stmts[i]); i = i + 1; };
    out = out + "    return 0;\n}\n";
    out
}

// Self-hosting Tenth compiler — bootstrap

fn compile(src: str) -> str {
    let mut lex = lexer_new(src);
    let tokens = lexer_tokenize(&mut lex);
    let prog = parse_program(tokens);
    cgen_program(&prog)
}

fn main() -> i64 {
    let src = read_file("tenthc_combined.th");
    let c = compile(src);
    write_file("tenthc_output.c", c);
    0
}
