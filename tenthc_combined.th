// Token definitions — v0.3.1 with enum TokenKind

struct Span {
    line: i64,
    col: i64,
}

enum TokenKind {
    // Literals
    IntLiteral(value: i64),
    FloatLiteral(value: f64),
    StringLiteral(value: str),
    Identifier(name: str),

    // Keywords
    Fn,
    Let,
    Mut,
    If,
    Else,
    Match,
    Return,
    While,
    For,
    Loop,
    Break,
    Continue,
    Struct,
    Enum,
    Impl,
    Trait,
    Use,
    Mod,
    True,
    False,
    Move,
    Self_,

    // Operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    EqEq,
    NotEq,
    Lt,
    Gt,
    LtEq,
    GtEq,
    AndAnd,
    OrOr,
    Not,
    Ampersand,
    Pipe,

    // Assignments
    Assign,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,

    // Delimiters
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Semicolon,
    Colon,
    Dot,
    DotDot,
    Arrow,
    FatArrow,
    ColonColon,

    Eof,
}

struct Token {
    kind: TokenKind,
    span: Span,
    disc: i64,
    ival: i64,
    sval: str,
}

// Self-hosting Lexer — v0.3.1 enum-based

struct Lexer {
    source: str,
    pos: i64,
    line: i64,
    col: i64,
}

fn lexer_new(source: str) -> Lexer {
    Lexer { source: source, pos: 0, line: 1, col: 1 }
}

fn is_digit(ch: str) -> bool { (ch >= "0") && (ch <= "9") }
fn is_alpha(ch: str) -> bool { ((ch >= "a") && (ch <= "z")) || ((ch >= "A") && (ch <= "Z")) || (ch == "_") }
fn is_alnum(ch: str) -> bool { is_alpha(ch) || is_digit(ch) }
fn is_ws(ch: str) -> bool { (ch == " ") || (ch == "\n") || (ch == "\t") || (ch == "\r") }

fn lexer_peek(lexer: &Lexer) -> str {
    if lexer.pos < lexer.source.len() { lexer.source[lexer.pos] } else { "" }
}

fn lexer_advance(lexer: &mut Lexer) -> str {
    let ch = lexer_peek(lexer);
    if ch == "" { return ""; };
    lexer.pos = lexer.pos + 1;
    if ch == "\n" { lexer.line = lexer.line + 1; lexer.col = 1; }
    else { lexer.col = lexer.col + 1; };
    ch
}

fn make_span(line: i64, col: i64) -> Span { Span { line: line, col: col } }

// ── String→number helpers ──

fn char_to_digit(ch: str) -> i64 {
    if ch == "0" { 0 } else if ch == "1" { 1 }
    else if ch == "2" { 2 } else if ch == "3" { 3 }
    else if ch == "4" { 4 } else if ch == "5" { 5 }
    else if ch == "6" { 6 } else if ch == "7" { 7 }
    else if ch == "8" { 8 } else if ch == "9" { 9 }
    else { 0 }
}

fn parse_int(s: str) -> i64 {
    let mut result: i64 = 0;
    let mut i: i64 = 0;
    let len = s.len();
    while i < len {
        let ch = s[i];
        result = result * 10 + char_to_digit(ch);
        i = i + 1;
    };
    result
}

fn parse_float(whole: str, frac: str) -> f64 {
    let w = parse_int(whole);
    let f = parse_int(frac);
    let mut div: f64 = 1.0;
    let mut i: i64 = 0;
    while i < frac.len() { div = div * 10.0; i = i + 1; };
    w + (f / div)
}

fn lexer_next(lexer: &mut Lexer) -> Token {
    let mut ch = lexer_peek(lexer);

    // Skip whitespace
    while (ch != "") && is_ws(ch) {
        ch = lexer_advance(lexer); ch = lexer_peek(lexer);
    };
    // Skip line comments
    if (ch != "") && (ch == "/") {
        let next_pos = lexer.pos + 1;
        if (next_pos < lexer.source.len()) && (lexer.source[next_pos] == "/") {
            lexer_advance(lexer); lexer_advance(lexer);
            ch = lexer_peek(lexer);
            while (ch != "") && (ch != "\n") { ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
        };
    };

    let line = lexer.line;
    let col = lexer.col;
    let span = make_span(line, col);

    if ch == "" {
        return Token { kind: TokenKind::Eof, span: span, disc: 61, ival: 0, sval: "" };
    };

    // Numbers
    if is_digit(ch) {
        let mut int_part = "";
        let mut frac_part = "";
        let mut is_float = false;
        while is_digit(ch) {
            int_part = int_part + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };
        if ch == "." {
            is_float = true;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
            while is_digit(ch) {
                frac_part = frac_part + ch;
                ch = lexer_advance(lexer); ch = lexer_peek(lexer);
            };
        };
        if is_float {
            return Token { kind: TokenKind::FloatLiteral(value: parse_float(int_part, frac_part)), span: span, disc: 1, ival: 0, sval: int_part };
        };
        let iv = parse_int(int_part);
        return Token { kind: TokenKind::IntLiteral(value: iv), span: span, disc: 0, ival: iv, sval: "" };
    };

    // Identifiers and keywords
    if is_alpha(ch) {
        let mut ident = "";
        while (ch != "") && is_alnum(ch) {
            ident = ident + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };
        // Keywords
        if ident == "fn" { return Token { kind: TokenKind::Fn, span: span, disc: 4, ival: 0, sval: "" }; };
        if ident == "let" { return Token { kind: TokenKind::Let, span: span, disc: 5, ival: 0, sval: "" }; };
        if ident == "mut" { return Token { kind: TokenKind::Mut, span: span, disc: 6, ival: 0, sval: "" }; };
        if ident == "if" { return Token { kind: TokenKind::If, span: span, disc: 7, ival: 0, sval: "" }; };
        if ident == "else" { return Token { kind: TokenKind::Else, span: span, disc: 8, ival: 0, sval: "" }; };
        if ident == "match" { return Token { kind: TokenKind::Match, span: span, disc: 9, ival: 0, sval: "" }; };
        if ident == "return" { return Token { kind: TokenKind::Return, span: span, disc: 10, ival: 0, sval: "" }; };
        if ident == "while" { return Token { kind: TokenKind::While, span: span, disc: 11, ival: 0, sval: "" }; };
        if ident == "for" { return Token { kind: TokenKind::For, span: span, disc: 12, ival: 0, sval: "" }; };
        if ident == "loop" { return Token { kind: TokenKind::Loop, span: span, disc: 13, ival: 0, sval: "" }; };
        if ident == "break" { return Token { kind: TokenKind::Break, span: span, disc: 14, ival: 0, sval: "" }; };
        if ident == "continue" { return Token { kind: TokenKind::Continue, span: span, disc: 15, ival: 0, sval: "" }; };
        if ident == "struct" { return Token { kind: TokenKind::Struct, span: span, disc: 16, ival: 0, sval: "" }; };
        if ident == "enum" { return Token { kind: TokenKind::Enum, span: span, disc: 17, ival: 0, sval: "" }; };
        if ident == "impl" { return Token { kind: TokenKind::Impl, span: span, disc: 18, ival: 0, sval: "" }; };
        if ident == "trait" { return Token { kind: TokenKind::Trait, span: span, disc: 19, ival: 0, sval: "" }; };
        if ident == "use" { return Token { kind: TokenKind::Use, span: span, disc: 20, ival: 0, sval: "" }; };
        if ident == "mod" { return Token { kind: TokenKind::Mod, span: span, disc: 21, ival: 0, sval: "" }; };
        if ident == "true" { return Token { kind: TokenKind::True, span: span, disc: 22, ival: 0, sval: "" }; };
        if ident == "false" { return Token { kind: TokenKind::False, span: span, disc: 23, ival: 0, sval: "" }; };
        if ident == "move" { return Token { kind: TokenKind::Move, span: span, disc: 24, ival: 0, sval: "" }; };
        if ident == "self" { return Token { kind: TokenKind::Self_, span: span, disc: 25, ival: 0, sval: "" }; };

        return Token { kind: TokenKind::Identifier(name: ident), span: span, disc: 3, ival: 0, sval: ident };
    };

    // Strings
    if ch == "\"" {
        lexer_advance(lexer);
        let mut s = "";
        ch = lexer_peek(lexer);
        while (ch != "") && (ch != "\"") { s = s + ch; ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
        if ch == "\"" { lexer_advance(lexer); };
        return Token { kind: TokenKind::StringLiteral(value: s), span: span, disc: 2, ival: 0, sval: s };
    };

    // Single-char tokens and multi-char operators
    lexer_advance(lexer);

    if ch == "(" { return Token { kind: TokenKind::LParen, span: span, disc: 47, ival: 0, sval: "" }; };
    if ch == ")" { return Token { kind: TokenKind::RParen, span: span, disc: 48, ival: 0, sval: "" }; };
    if ch == "{" { return Token { kind: TokenKind::LBrace, span: span, disc: 49, ival: 0, sval: "" }; };
    if ch == "}" { return Token { kind: TokenKind::RBrace, span: span, disc: 50, ival: 0, sval: "" }; };
    if ch == "[" { return Token { kind: TokenKind::LBracket, span: span, disc: 51, ival: 0, sval: "" }; };
    if ch == "]" { return Token { kind: TokenKind::RBracket, span: span, disc: 52, ival: 0, sval: "" }; };
    if ch == "," { return Token { kind: TokenKind::Comma, span: span, disc: 53, ival: 0, sval: "" }; };
    if ch == ";" { return Token { kind: TokenKind::Semicolon, span: span, disc: 54, ival: 0, sval: "" }; };

    if ch == "." {
        if lexer_peek(lexer) == "." { lexer_advance(lexer); return Token { kind: TokenKind::DotDot, span: span, disc: 57, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Dot, span: span, disc: 56, ival: 0, sval: "" };
    };
    if ch == ":" {
        if lexer_peek(lexer) == ":" { lexer_advance(lexer); return Token { kind: TokenKind::ColonColon, span: span, disc: 60, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Colon, span: span, disc: 55, ival: 0, sval: "" };
    };
    if ch == "+" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::PlusAssign, span: span, disc: 43, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Plus, span: span, disc: 26, ival: 0, sval: "" };
    };
    if ch == "-" {
        if lexer_peek(lexer) == ">" { lexer_advance(lexer); return Token { kind: TokenKind::Arrow, span: span, disc: 58, ival: 0, sval: "" }; };
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::MinusAssign, span: span, disc: 44, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Minus, span: span, disc: 27, ival: 0, sval: "" };
    };
    if ch == "*" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::StarAssign, span: span, disc: 45, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Star, span: span, disc: 28, ival: 0, sval: "" };
    };
    if ch == "/" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::SlashAssign, span: span, disc: 46, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Slash, span: span, disc: 29, ival: 0, sval: "" };
    };
    if ch == "%" { return Token { kind: TokenKind::Percent, span: span, disc: 30, ival: 0, sval: "" }; };
    if ch == "=" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::EqEq, span: span, disc: 31, ival: 0, sval: "" }; };
        if lexer_peek(lexer) == ">" { lexer_advance(lexer); return Token { kind: TokenKind::FatArrow, span: span, disc: 59, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Assign, span: span, disc: 42, ival: 0, sval: "" };
    };
    if ch == "!" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::NotEq, span: span, disc: 32, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Not, span: span, disc: 39, ival: 0, sval: "" };
    };
    if ch == "<" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::LtEq, span: span, disc: 35, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Lt, span: span, disc: 33, ival: 0, sval: "" };
    };
    if ch == ">" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::GtEq, span: span, disc: 36, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Gt, span: span, disc: 34, ival: 0, sval: "" };
    };
    if ch == "&" {
        if lexer_peek(lexer) == "&" { lexer_advance(lexer); return Token { kind: TokenKind::AndAnd, span: span, disc: 37, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Ampersand, span: span, disc: 40, ival: 0, sval: "" };
    };
    if ch == "|" {
        if lexer_peek(lexer) == "|" { lexer_advance(lexer); return Token { kind: TokenKind::OrOr, span: span, disc: 38, ival: 0, sval: "" }; };
        return Token { kind: TokenKind::Pipe, span: span, disc: 41, ival: 0, sval: "" };
    };

    // Unknown char — treat as identifier
    Token { kind: TokenKind::Identifier(name: ch), span: span, ival: 0, sval: "" }
}

fn lexer_tokenize(lexer: &mut Lexer) -> Vec<Token> {
    let mut tokens = Vec::new();
    let src_len = lexer.source.len();
    while lexer.pos < src_len {
        let t = lexer_next(lexer);
        tokens.push(t);
    };
    tokens.push(lexer_next(lexer)); // push EOF
    tokens
}

// Self-hosting Parser — v0.3.1 recursive descent

// ── AST arena types ──

struct Expr {
    kind: str,    // "int", "float", "str", "ident", "binary", "unary",
                  // "call", "field", "if", "block", "struct_lit",
                  // "assign", "ref", "deref", "match"
    ival: i64,
    fval: f64,
    sval: str,    // identifier name, string value, or operator
    left: i64,    // index into expr_nodes (or 0 for none)
    right: i64,   // index into expr_nodes (or 0 for none)
    // For calls: arg count + first arg index stored in stmt_nodes
    arg_start: i64,
    arg_count: i64,
    // For struct literals: field names and values stored in parallel
    // For match: arm count + first arm index
    extra_start: i64,
    extra_count: i64,
}

struct Stmt {
    kind: str,    // "let", "return", "expr", "while", "if",
                  // "break", "continue", "loop", "block"
    name: str,    // variable name for let
    expr_idx: i64,// index into expr_nodes
    body_start: i64, // for while/loop/block: first stmt index
    body_count: i64,
    else_start: i64, // for if: else block first stmt
    else_count: i64,
}

struct Param {
    name: str,
    type_ann: str,
}

struct StructField {
    name: str,
    type_ann: str,
}

struct EnumVariant {
    name: str,
    fields: Vec<StructField>,
}

struct FnDef {
    name: str,
    params: Vec<Param>,
    return_type: str,
    body_start: i64,
    body_count: i64,
}

struct StructDef {
    name: str,
    fields: Vec<StructField>,
}

struct EnumDef {
    name: str,
    variants: Vec<EnumVariant>,
}

struct MatchArm {
    pat_kind: str,     // "enum_variant", "wildcard", "literal"
    pat_name: str,     // enum/variant name
    pat_bind: str,     // binding name
    body_expr: i64,    // index into expr_nodes
}

struct Program {
    structs: Vec<StructDef>,
    enums: Vec<EnumDef>,
    fns: Vec<FnDef>,
    main_stmts_start: i64,
    main_stmts_count: i64,
    // Arena data
    expr_nodes: Vec<Expr>,
    stmt_nodes: Vec<Stmt>,
    match_arms: Vec<MatchArm>,
}

// ── Parser state ──

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
    // Arena arrays (global, indexed by the parser output)
    expr_nodes: Vec<Expr>,
    stmt_nodes: Vec<Stmt>,
    match_arms: Vec<MatchArm>,
}

fn parser_new(tokens: Vec<Token>) -> Parser {
    Parser {
        tokens: tokens,
        pos: 0,
        expr_nodes: Vec::new(),
        stmt_nodes: Vec::new(),
        match_arms: Vec::new(),
    }
}

// ── Token access ──

fn parser_peek(p: &Parser) -> Token {
    if p.pos < p.tokens.len() { p.tokens[p.pos] }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 } } }
}

fn parser_at_eof(p: &Parser) -> bool {
    p.pos >= p.tokens.len()
}

fn parser_advance(p: &mut Parser) -> Token {
    if p.pos < p.tokens.len() { let t = p.tokens[p.pos]; p.pos = p.pos + 1; t }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 } } }
}

// ── Helper: add expr node, return index (1-based, 0 = nil) ──

fn add_expr(p: &mut Parser, kind: str) -> i64 {
    let e = Expr {
        kind: kind, ival: 0, fval: 0.0, sval: "",
        left: 0, right: 0, arg_start: 0, arg_count: 0,
        extra_start: 0, extra_count: 0,
    };
    p.expr_nodes.push(e);
    p.expr_nodes.len()
}

fn add_stmt(p: &mut Parser, kind: str) -> i64 {
    let s = Stmt {
        kind: kind, name: "", expr_idx: 0,
        body_start: 0, body_count: 0,
        else_start: 0, else_count: 0,
    };
    p.stmt_nodes.push(s);
    p.stmt_nodes.len()
}

// ── Expression parsing ──

fn parse_primary(p: &mut Parser) -> i64 {
    let tok = parser_advance(p);

    match tok.kind {
        TokenKind::IntLiteral(value: n) => {
            let n = tok.ival;
            let idx = add_expr(p, "int");
            p.expr_nodes[idx - 1].ival = n;
            idx
        },
        TokenKind::FloatLiteral(value: n) => {
            let n = tok.ival;
            let idx = add_expr(p, "float");
            p.expr_nodes[idx - 1].fval = n;
            idx
        },
        TokenKind::StringLiteral(value: s) => {
            let s = tok.sval;
            let idx = add_expr(p, "str");
            p.expr_nodes[idx - 1].sval = s;
            idx
        },
        TokenKind::True => {
            let idx = add_expr(p, "bool");
            p.expr_nodes[idx - 1].ival = 1;
            idx
        },
        TokenKind::False => {
            let idx = add_expr(p, "bool");
            p.expr_nodes[idx - 1].ival = 0;
            idx
        },
        TokenKind::Identifier(name: s) => {
            let s = tok.sval;
            let idx = add_expr(p, "ident");
            p.expr_nodes[idx - 1].sval = s;
            idx
        },
        TokenKind::Self_ => {
            let idx = add_expr(p, "ident");
            p.expr_nodes[idx - 1].sval = "self";
            idx
        },
        TokenKind::LParen => {
            let expr_idx = parse_expr(p);
            parser_advance(p); // expect RParen
            expr_idx
        },
        TokenKind::LBrace => {
            parse_block_expr(p)
        },
        TokenKind::If => {
            parse_if_expr(p)
        },
        TokenKind::Match => {
            parse_match_expr(p)
        },
        TokenKind::Ampersand => {
            let inner = parse_unary(p);
            let idx = add_expr(p, "ref");
            p.expr_nodes[idx - 1].left = inner;
            idx
        },
        TokenKind::Star => {
            let inner = parse_unary(p);
            let idx = add_expr(p, "deref");
            p.expr_nodes[idx - 1].left = inner;
            idx
        },
        TokenKind::Minus => {
            let inner = parse_unary(p);
            let idx = add_expr(p, "unary");
            p.expr_nodes[idx - 1].sval = "-";
            p.expr_nodes[idx - 1].left = inner;
            idx
        },
        TokenKind::Not => {
            let inner = parse_unary(p);
            let idx = add_expr(p, "unary");
            p.expr_nodes[idx - 1].sval = "!";
            p.expr_nodes[idx - 1].left = inner;
            idx
        },
        // Default: return an error expr
        _ => {
            let idx = add_expr(p, "int");
            p.expr_nodes[idx - 1].ival = 0;
            idx
        },
    }
}

fn parse_unary(p: &mut Parser) -> i64 {
    parse_primary(p)
}

fn parse_postfix(p: &mut Parser) -> i64 {
    let mut expr_idx = parse_unary(p);

    loop {
        let tok = parser_peek(p);

        match tok.kind {
            TokenKind::LParen => {
                parser_advance(p); // skip (
                let start = p.expr_nodes.len() + 1; // arg indices will be stored as separate exprs
                let mut count: i64 = 0;
                // Parse args as expressions, but we can't easily track indices.
                // Instead: store args in a simpler way — just count and skip for now.
                // Full implementation would parse and store each arg.
                count = parse_arg_list(p);
                // Update the call node
                p.expr_nodes[expr_idx - 1].kind = "call";
                p.expr_nodes[expr_idx - 1].arg_start = start;
                p.expr_nodes[expr_idx - 1].arg_count = count;
            },
            TokenKind::Dot => {
                parser_advance(p); // skip .
                let field_tok = parser_advance(p);
                let mut field_name = "";
                match field_tok.kind {
                    TokenKind::Identifier(name: s) => { field_name = field_tok.sval; },
                    _ => {},
                };
                let idx = add_expr(p, "field");
                p.expr_nodes[idx - 1].left = expr_idx;
                p.expr_nodes[idx - 1].sval = field_name;
                expr_idx = idx;
            },
            _ => { break; },
        };
    };

    expr_idx
}

fn parse_arg_list(p: &mut Parser) -> i64 {
    let mut count: i64 = 0;
    loop {
        let tok = parser_peek(p);
        match tok.kind {
            TokenKind::RParen => { break; },
            TokenKind::Eof => { break; },
            _ => {},
        };
        parse_expr(p);
        count = count + 1;
        let tok2 = parser_peek(p);
        match tok2.kind {
            TokenKind::Comma => { parser_advance(p); },
            _ => { break; },
        };
    };
    parser_advance(p); // skip )
    count
}

fn binop_prec(op: str) -> i64 {
    if op == "*" || op == "/" || op == "%" { 5 }
    else if op == "+" || op == "-" { 4 }
    else if op == "<" || op == ">" || op == "<=" || op == ">=" { 3 }
    else if op == "==" || op == "!=" { 2 }
    else if op == "&&" { 1 }
    else if op == "||" { 0 }
    else { -1 }
}

fn token_to_binop_str(tok: Token) -> str {
    match tok.kind {
        TokenKind::Plus => "+",
        TokenKind::Minus => "-",
        TokenKind::Star => "*",
        TokenKind::Slash => "/",
        TokenKind::Percent => "%",
        TokenKind::EqEq => "==",
        TokenKind::NotEq => "!=",
        TokenKind::Lt => "<",
        TokenKind::Gt => ">",
        TokenKind::LtEq => "<=",
        TokenKind::GtEq => ">=",
        TokenKind::AndAnd => "&&",
        TokenKind::OrOr => "||",
        _ => "",
    }
}

fn is_binop(tok: Token) -> bool {
    let op = token_to_binop_str(tok);
    op != ""
}

fn parse_binary(p: &mut Parser, min_prec: i64) -> i64 {
    let mut left = parse_postfix(p);

    loop {
        let tok = parser_peek(p);
        if !is_binop(tok) { break; };
        let op = token_to_binop_str(tok);
        let prec = binop_prec(op);
        if prec < min_prec { break; };

        parser_advance(p); // consume operator
        let right = parse_binary(p, prec + 1);

        let idx = add_expr(p, "binary");
        p.expr_nodes[idx - 1].sval = op;
        p.expr_nodes[idx - 1].left = left;
        p.expr_nodes[idx - 1].right = right;
        left = idx;
    };

    left
}

fn parse_expr(p: &mut Parser) -> i64 {
    // Check for assignment
    let tok = parser_peek(p);
    // Simple: just parse binary
    let expr = parse_binary(p, 0);

    // Check for =
    let tok2 = parser_peek(p);
    match tok2.kind {
        TokenKind::Assign => {
            parser_advance(p);
            let rhs = parse_expr(p);
            let idx = add_expr(p, "assign");
            p.expr_nodes[idx - 1].left = expr;
            p.expr_nodes[idx - 1].right = rhs;
            idx
        },
        _ => expr,
    }
}

fn parse_block_expr(p: &mut Parser) -> i64 {
    let body_start = p.stmt_nodes.len() + 1;
    let mut count: i64 = 0;
    loop {
        let tok = parser_peek(p);
        match tok.kind {
            TokenKind::RBrace => { break; },
            TokenKind::Eof => { break; },
            _ => {},
        };
        parse_stmt(p);
        count = count + 1;
    };
    parser_advance(p); // skip }
    let idx = add_expr(p, "block");
    p.expr_nodes[idx - 1].extra_start = body_start;
    p.expr_nodes[idx - 1].extra_count = count;
    idx
}

fn parse_if_expr(p: &mut Parser) -> i64 {
    // if cond then-expr [else else-expr]
    let cond = parse_expr(p);
    let then_expr = parse_expr(p);

    let mut else_idx: i64 = 0;
    let tok = parser_peek(p);
    match tok.kind {
        TokenKind::Else => {
            parser_advance(p);
            else_idx = parse_expr(p);
        },
        _ => {},
    };

    let idx = add_expr(p, "if");
    p.expr_nodes[idx - 1].left = cond;
    p.expr_nodes[idx - 1].right = then_expr;
    p.expr_nodes[idx - 1].extra_start = else_idx;
    idx
}

fn parse_match_expr(p: &mut Parser) -> i64 {
    let scrutinee = parse_expr(p);
    parser_advance(p); // skip {

    let arm_start = p.match_arms.len() + 1;
    let mut arm_count: i64 = 0;

    loop {
        let tok = parser_peek(p);
        match tok.kind {
            TokenKind::RBrace => { break; },
            TokenKind::Eof => { break; },
            _ => {},
        };

        // Parse pattern
        let pat_tok = parser_advance(p);
        let mut pat_kind = "wildcard";
        let mut pat_name = "";
        let mut pat_bind = "";

        match pat_tok.kind {
            TokenKind::Identifier(name: s) => {
                pat_kind = "enum_variant";
                pat_name = pat_tok.sval;
                // Check for ::Variant
                let next = parser_peek(p);
                match next.kind {
                    TokenKind::ColonColon => {
                        parser_advance(p);
                        let variant_tok = parser_advance(p);
                        match variant_tok.kind {
                            TokenKind::Identifier(name: vs) => { pat_name = variant_tok.sval; },
                            _ => {},
                        };
                    },
                    _ => {},
                };
            },
            _ => {},
        };

        parser_advance(p); // skip =>
        let body = parse_expr(p);

        let arm = MatchArm {
            pat_kind: pat_kind, pat_name: pat_name,
            pat_bind: pat_bind, body_expr: body,
        };
        p.match_arms.push(arm);
        arm_count = arm_count + 1;

        let t = parser_peek(p);
        match t.kind {
            TokenKind::Comma => { parser_advance(p); },
            _ => {},
        };
    };

    parser_advance(p); // skip }

    let idx = add_expr(p, "match");
    p.expr_nodes[idx - 1].left = scrutinee;
    p.expr_nodes[idx - 1].extra_start = arm_start;
    p.expr_nodes[idx - 1].extra_count = arm_count;
    idx
}

// ── Statement parsing ──

fn parse_stmt(p: &mut Parser) -> i64 {
    let tok = parser_peek(p);
    let disc = tok.disc;

    // Let (5)
    if disc == 5 {
        parser_advance(p); // skip let
        let mut mutable = false;
        let t2 = parser_peek(p);
        if t2.disc == 6 { parser_advance(p); mutable = true; };
        let name_tok = parser_advance(p);
        let mut name = name_tok.sval;
        // skip optional : Type
        let t3 = parser_peek(p);
        if t3.disc == 55 { parser_advance(p); parser_advance(p); }; // skip : and type
        // =
        let t4 = parser_peek(p);
        if t4.disc == 42 {
            parser_advance(p);
            let init = parse_expr(p);
            let idx = add_stmt(p, "let");
            p.stmt_nodes[idx - 1].name = name;
            p.stmt_nodes[idx - 1].expr_idx = init;
            return idx;
        };
        let idx = add_stmt(p, "let");
        p.stmt_nodes[idx - 1].name = name;
        return idx;
    };

    // Return (10)
    if disc == 10 {
        parser_advance(p);
        let t2 = parser_peek(p);
        let mut expr_idx: i64 = 0;
        if !is_stmt_end(t2) { expr_idx = parse_expr(p); };
        let idx = add_stmt(p, "return");
        p.stmt_nodes[idx - 1].expr_idx = expr_idx;
        return idx;
    };

    // While (11)
    if disc == 11 {
        parser_advance(p);
        let cond = parse_expr(p);
        parser_advance(p); // skip {
        let body_start = p.stmt_nodes.len() + 1;
        let mut body_count: i64 = 0;
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            parse_stmt(p);
            body_count = body_count + 1;
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let idx = add_stmt(p, "while");
        p.stmt_nodes[idx - 1].expr_idx = cond;
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Break (14)
    if disc == 14 {
        parser_advance(p);
        return add_stmt(p, "break");
    };

    // Continue (15)
    if disc == 15 {
        parser_advance(p);
        return add_stmt(p, "continue");
    };

    // Loop (13)
    if disc == 13 {
        parser_advance(p);
        parser_advance(p); // skip {
        let body_start = p.stmt_nodes.len() + 1;
        let mut body_count: i64 = 0;
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            parse_stmt(p);
            body_count = body_count + 1;
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let idx = add_stmt(p, "loop");
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Expression statement (default)
    let expr = parse_expr(p);
    let idx = add_stmt(p, "expr");
    p.stmt_nodes[idx - 1].expr_idx = expr;
    return idx;
}

// ── Top-level parsing ──

fn parse_fn(p: &mut Parser) -> FnDef {
    parser_advance(p); // skip fn
    let name_tok = parser_advance(p);
    let mut name = "";
    match name_tok.kind {
        TokenKind::Identifier(name: s) => { name = name_tok.sval; },
        _ => {},
    };
    parser_advance(p); // skip (
    let mut params = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_paren(t) { break; };
        let pname_tok = parser_advance(p);
        let mut pname = "";
        match pname_tok.kind {
            TokenKind::Identifier(name: s) => { pname = pname_tok.sval; },
            _ => {},
        };
        parser_advance(p); // skip :
        let ptype_tok = parser_advance(p);
        let mut ptype = "";
        match ptype_tok.kind {
            TokenKind::Identifier(name: s) => { ptype = ptype_tok.sval; },
            _ => {},
        };
        params.push(Param { name: pname, type_ann: ptype });
        let t2 = parser_peek(p);
        match t2.kind {
            TokenKind::Comma => { parser_advance(p); },
            _ => { break; },
        };
    };
    parser_advance(p); // skip )

    let mut return_type = "";
    let t3 = parser_peek(p);
    match t3.kind {
        TokenKind::Arrow => {
            parser_advance(p);
            let ret_tok = parser_advance(p);
            match ret_tok.kind {
                TokenKind::Identifier(name: s) => { return_type = ret_tok.sval; },
                _ => {},
            };
        },
        _ => {},
    };

    parser_advance(p); // skip {
    let body_start = p.stmt_nodes.len() + 1;
    let mut body_count: i64 = 0;
    loop {
        let t4 = parser_peek(p);
        if is_end_of_block(t4) { break; };
        parse_stmt(p);
        body_count = body_count + 1;
        // skip optional semicolon
        let ts = parser_peek(p);
        if ts.disc == 54 { parser_advance(p); };
    };
    parser_advance(p); // skip }

    FnDef { name: name, params: params, return_type: return_type, body_start: body_start, body_count: body_count }
}

fn parse_struct_def(p: &mut Parser) -> StructDef {
    parser_advance(p); // skip struct
    let name_tok = parser_advance(p);
    let mut name = "";
    match name_tok.kind {
        TokenKind::Identifier(name: s) => { name = name_tok.sval; },
        _ => {},
    };
    parser_advance(p); // skip {
    let mut fields = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let fname_tok = parser_advance(p);
        let mut fname = "";
        match fname_tok.kind {
            TokenKind::Identifier(name: s) => { fname = fname_tok.sval; },
            _ => {},
        };
        parser_advance(p); // skip :
        let ftype_tok = parser_advance(p);
        let mut ftype = "";
        match ftype_tok.kind {
            TokenKind::Identifier(name: s) => { ftype = ftype_tok.sval; },
            _ => {},
        };
        fields.push(StructField { name: fname, type_ann: ftype });
        let t2 = parser_peek(p);
        match t2.kind {
            TokenKind::Comma => { parser_advance(p); },
            _ => { break; },
        };
    };
    parser_advance(p); // skip }
    StructDef { name: name, fields: fields }
}

fn parse_enum_def(p: &mut Parser) -> EnumDef {
    parser_advance(p); // skip enum
    let name_tok = parser_advance(p);
    let mut name = "";
    match name_tok.kind {
        TokenKind::Identifier(name: s) => { name = name_tok.sval; },
        _ => {},
    };
    parser_advance(p); // skip {
    let mut variants = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let vname_tok = parser_advance(p);
        let mut vname = "";
        match vname_tok.kind {
            TokenKind::Identifier(name: s) => { vname = vname_tok.sval; },
            _ => {},
        };
        let mut vfields = Vec::new();
        let t2 = parser_peek(p);
        match t2.kind {
            TokenKind::LParen => {
                parser_advance(p);
                loop {
                    let t3 = parser_peek(p);
                    if is_end_of_paren(t3) { break; };
                    let fname_tok = parser_advance(p);
                    let mut fname = "";
                    match fname_tok.kind {
                        TokenKind::Identifier(name: s) => { fname = fname_tok.sval; },
                        _ => {},
                    };
                    parser_advance(p); // skip :
                    let ftype_tok = parser_advance(p);
                    let mut ftype = "";
                    match ftype_tok.kind {
                        TokenKind::Identifier(name: s) => { ftype = ftype_tok.sval; },
                        _ => {},
                    };
                    vfields.push(StructField { name: fname, type_ann: ftype });
                    let t4 = parser_peek(p);
                    match t4.kind {
                        TokenKind::Comma => { parser_advance(p); },
                        _ => { break; },
                    };
                };
                parser_advance(p); // skip )
            },
            _ => {},
        };
        variants.push(EnumVariant { name: vname, fields: vfields });
        let t5 = parser_peek(p);
        match t5.kind {
            TokenKind::Comma => { parser_advance(p); },
            _ => { break; },
        };
    };
    parser_advance(p); // skip }
    EnumDef { name: name, variants: variants }
}

// ── Pattern helpers (avoids OR-patterns) ──

fn is_end_of_block(tok: Token) -> bool {
    let d = tok.disc;
    d == 50 || d == 61  // RBrace(50) or Eof(61)
}

fn is_end_of_paren(tok: Token) -> bool {
    let d = tok.disc;
    d == 48 || d == 61  // RParen(48) or Eof(61)
}

fn is_stmt_end(tok: Token) -> bool {
    let d = tok.disc;
    d == 54 || d == 50 || d == 61  // Semicolon(54), RBrace(50), Eof(61)
}

fn parse_program(tokens: Vec<Token>) -> Program {
    let mut p = parser_new(tokens);

    let mut structs = Vec::new();
    let mut enums = Vec::new();
    let mut fns = Vec::new();
    let mut main_stmts_start: i64 = 1;
    let mut main_count: i64 = 0;

    loop {
        if parser_at_eof(&p) { break; };
        let tok = parser_peek(&p);
        let d = tok.disc;

        // Struct (16)
        if d == 16 {
            structs.push(parse_struct_def(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 17 {
            // Enum (17)
            enums.push(parse_enum_def(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 4 {
            // Fn (4)
            fns.push(parse_fn(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 61 {
            // Eof (61)
            break;
        } else {
            // Top-level expression statement
            if main_stmts_start == 1 { main_stmts_start = p.stmt_nodes.len() + 1; };
            parse_stmt(&mut p);
            main_count = main_count + 1;
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        };
    };

    Program {
        structs: structs,
        enums: enums,
        fns: fns,
        main_stmts_start: main_stmts_start,
        main_stmts_count: main_count,
        expr_nodes: p.expr_nodes,
        stmt_nodes: p.stmt_nodes,
        match_arms: p.match_arms,
    }
}

// Self-hosting Codegen — v0.3.1
// Walks Program AST (arena-based) and emits C code

fn cgen_expr(prog: &Program, exprs: &Vec<Expr>, stmts: &Vec<Stmt>, idx: i64) -> str {
    if idx <= 0 || idx > exprs.len() { return "0"; };
    let e = exprs[idx - 1];

    if e.kind == "int" { return int_to_str(e.ival); };
    if e.kind == "float" { return float_to_str(e.fval); };
    if e.kind == "str" { return "\"" + e.sval + "\""; };
    if e.kind == "bool" { if e.ival != 0 { return "true"; } else { return "false"; }; };
    if e.kind == "ident" { return e.sval; };
    if e.kind == "binary" {
        let left = cgen_expr(prog, exprs, stmts, e.left);
        let right = cgen_expr(prog, exprs, stmts, e.right);
        return "(" + left + " " + e.sval + " " + right + ")";
    };
    if e.kind == "unary" {
        let inner = cgen_expr(prog, exprs, stmts, e.left);
        return "(" + e.sval + inner + ")";
    };
    if e.kind == "call" {
        let mut args = "";
        let mut i: i64 = 0;
        while i < e.arg_count {
            if i > 0 { args = args + ", "; };
            let arg_idx = e.arg_start + i;
            args = args + cgen_expr(prog, exprs, stmts, arg_idx);
            i = i + 1;
        };
        return e.sval + "(" + args + ")";
    };
    if e.kind == "field" {
        let target = cgen_expr(prog, exprs, stmts, e.left);
        return "(" + target + ")." + e.sval;
    };
    if e.kind == "ref" {
        let inner = cgen_expr(prog, exprs, stmts, e.left);
        return "&" + inner;
    };
    if e.kind == "deref" {
        let inner = cgen_expr(prog, exprs, stmts, e.left);
        return "(*" + inner + ")";
    };
    if e.kind == "block" {
        let mut out = "({ ";
        let start = e.extra_start;
        let count = e.extra_count;
        let mut i: i64 = 0;
        while i < count {
            let stmt_idx = start + i;
            out = out + cgen_stmt(prog, exprs, stmts, stmt_idx);
            i = i + 1;
        };
        return out + " })";
    };
    if e.kind == "if" {
        let cond = cgen_expr(prog, exprs, stmts, e.left);
        let then_val = cgen_expr(prog, exprs, stmts, e.right);
        if e.extra_start > 0 {
            let else_val = cgen_expr(prog, exprs, stmts, e.extra_start);
            return "(" + cond + " ? " + then_val + " : " + else_val + ")";
        };
        return "(" + cond + " ? " + then_val + " : 0)";
    };
    if e.kind == "assign" {
        let lhs = cgen_expr(prog, exprs, stmts, e.left);
        let rhs = cgen_expr(prog, exprs, stmts, e.right);
        return lhs + " = " + rhs;
    };
    "0"
}

fn cgen_stmt(prog: &Program, exprs: &Vec<Expr>, stmts: &Vec<Stmt>, idx: i64) -> str {
    if idx <= 0 || idx > stmts.len() { return ";\n"; };
    let s = stmts[idx - 1];

    if s.kind == "let" {
        let init = cgen_expr(prog, exprs, stmts, s.expr_idx);
        return "int " + s.name + " = " + init + ";\n";
    };
    if s.kind == "return" {
        if s.expr_idx > 0 {
            let val = cgen_expr(prog, exprs, stmts, s.expr_idx);
            return "return " + val + ";\n";
        };
        return "return;\n";
    };
    if s.kind == "expr" {
        let val = cgen_expr(prog, exprs, stmts, s.expr_idx);
        return val + ";\n";
    };
    if s.kind == "while" {
        let cond = cgen_expr(prog, exprs, stmts, s.expr_idx);
        let mut out = "while (" + cond + ") {\n";
        let mut i: i64 = 0;
        while i < s.body_count {
            let stmt_idx = s.body_start + i;
            out = out + "    " + cgen_stmt(prog, exprs, stmts, stmt_idx);
            i = i + 1;
        };
        return out + "}\n";
    };
    if s.kind == "loop" {
        let mut out = "while (1) {\n";
        let mut i: i64 = 0;
        while i < s.body_count {
            let stmt_idx = s.body_start + i;
            out = out + "    " + cgen_stmt(prog, exprs, stmts, stmt_idx);
            i = i + 1;
        };
        return out + "}\n";
    };
    if s.kind == "break" { return "break;\n"; };
    if s.kind == "continue" { return "continue;\n"; };
    ";\n"
}

fn cgen_struct(s: &StructDef) -> str {
    let mut out = "typedef struct {\n";
    let mut i: i64 = 0;
    while i < s.fields.len() {
        let f = s.fields[i];
        out = out + "    int " + f.name + ";\n";
        i = i + 1;
    };
    out = out + "} " + s.name + ";\n\n";
    out
}

fn cgen_param(p: &Param) -> str {
    "int " + p.name
}

fn cgen_fn(prog: &Program, exprs: &Vec<Expr>, stmts: &Vec<Stmt>, f: &FnDef) -> str {
    let mut out = "int " + f.name + "(";
    let mut i: i64 = 0;
    while i < f.params.len() {
        if i > 0 { out = out + ", "; };
        out = out + cgen_param(&f.params[i]);
        i = i + 1;
    };
    out = out + ") {\n";
    i = 0;
    while i < f.body_count {
        let stmt_idx = f.body_start + i;
        out = out + "    " + cgen_stmt(prog, exprs, stmts, stmt_idx);
        i = i + 1;
    };
    out = out + "}\n\n";
    out
}

fn cgen_program(prog: &Program, exprs: &Vec<Expr>, stmts: &Vec<Stmt>) -> str {
    let mut out = "// CODEGEN_V2\n#include <stdio.h>\n";
    out = out + "#include <stdint.h>\n";
    out = out + "#include <stdbool.h>\n";
    out = out + "#include <stdlib.h>\n";
    out = out + "#include <string.h>\n";
    out = out + "#include <math.h>\n\n";

    // Struct definitions
    let mut i: i64 = 0;
    while i < prog.structs.len() {
        out = out + cgen_struct(&prog.structs[i]);
        i = i + 1;
    };

    // Function definitions
    i = 0;
    while i < prog.fns.len() {
        out = out + cgen_fn(prog, exprs, stmts, &prog.fns[i]);
        i = i + 1;
    };

    // Main function
    out = out + "int main(void) {\n";
    i = 0;
    while i < prog.main_stmts_count {
        let stmt_idx = prog.main_stmts_start + i;
        out = out + "    " + cgen_stmt(prog, exprs, stmts, stmt_idx);
        i = i + 1;
    };
    out = out + "    return 0;\n}\n";
    out
}

// Helper: int to string (for literals only)
fn int_to_str(n: i64) -> str {
    if n == 0 { return "0"; };
    let mut neg = false;
    if n < 0 { neg = true; n = -n; };
    let mut s = "";
    let mut m = n;
    while m > 0 {
        let digit = m % 10;
        let ch = "";
        if digit == 0 { ch = "0"; }
        else if digit == 1 { ch = "1"; }
        else if digit == 2 { ch = "2"; }
        else if digit == 3 { ch = "3"; }
        else if digit == 4 { ch = "4"; }
        else if digit == 5 { ch = "5"; }
        else if digit == 6 { ch = "6"; }
        else if digit == 7 { ch = "7"; }
        else if digit == 8 { ch = "8"; }
        else if digit == 9 { ch = "9"; };
        s = ch + s;
        m = m / 10;
    };
    if neg { s = "-" + s; };
    s
}

fn float_to_str(n: f64) -> str {
    int_to_str(n) + ".0"
}

// Self-hosting Tenth compiler — bootstrap entry point

fn compile(src: str) -> str {
    let mut lex = lexer_new(src);
    let tokens = lexer_tokenize(&mut lex);
    let prog = parse_program(tokens);
    cgen_program(&prog, &prog.expr_nodes, &prog.stmt_nodes)
}

fn main() -> i64 {
    let src = "fn add(a: i64, b: i64) -> i64 { return a + b; }\nfn main() -> i64 { return add(10, 20); }\n";
    let c = compile(src);
    write_file("tenthc_output.c", c);
    0
}

