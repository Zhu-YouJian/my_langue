// 语言核心新特性（M1-M4 补全成果）综合演示
//
// 覆盖特性（全部已实现、有测试、自举 OK，2026-08-01/02）：
//    1. Box / Rc / Arc / Pin 智能指针
//    2. Union tagged 类型
//    3. dyn Trait 动态分发
//    4. 泛型枚举 <T>
//    5. Newtype（元组结构体）
//    6. 标签 break / continue
//    7. 自定义运算符
//    8. 声明式宏
//    9. Weak 弱引用
//   10. Phantom 类型（未使用类型参数）
//   11. Drop trait / RAII
//   12. Copy trait（自动派生，赋值不移动）
//
// 第 13 项（struct 上的自定义运算符重载 impl Add）见同目录
// operator_overload.th（该特性在 VM 的「具体值 trait 方法分派」上有缺口，
// 需解释器路径运行）。
//
// 运行：tenth run lang_core_features.th
//   默认 VM/JIT 路径即可。注意：每个特性演示放在独立顶层函数中——
//   VM 字节码对「同一函数内连续多个带标签循环」（AUDIT #17）与
//   「同一函数内多个泛型枚举 match 解构」（AUDIT #18）有既有缺陷，
//   拆分到独立函数可完全规避，全文件在默认路径输出正确。
//   若日后 VM 修复，本结构依旧有效（解释器路径始终正确：
//   TENTH_NO_VM=1 tenth run lang_core_features.th）。

// ═══════════════ 类型与声明区（Tenth 的类型/宏/运算符声明位于顶层） ═══════════════

// ── 2. Union tagged 类型 ──
union U { a: i32, b: f64 }

// ── 3. dyn Trait 动态分发 ──
trait Draw {
    fn area(self) -> f64;
    fn name(self) -> str;
}
struct Circle { radius: f64 }
struct Square { side: f64 }
impl Draw for Circle {
    fn area(self) -> f64 { 3.14159 * self.radius * self.radius }
    fn name(self) -> str { "Circle" }
}
impl Draw for Square {
    fn area(self) -> f64 { self.side * self.side }
    fn name(self) -> str { "Square" }
}

// ── 4. 泛型枚举 <T> ──
// 经典示例为 enum Box<T> { Value(T), Empty }；此处为避免与智能指针 Box 冲突改名
enum Maybe<T> { Just(T), Nothing }

// ── 5. Newtype（元组结构体）──
struct Meters(f64)
struct Pair(i64, str)

// ── 7. 自定义运算符（@ $ ~ 字符集）──
operator @@ = fn(a: i64, b: i64) -> i64 { a + b }
operator @~ = fn(a: f64, b: f64) -> f64 { a * b + 1.0 }

// ── 8. 声明式宏（编译期展开）──
macro twice(x) { x + x }
macro sq(x) { x * x }
macro sum_sq(a, b) { sq(a) + sq(b) }   // 宏体内可调用其他宏

// ── 10. Phantom 类型（未使用类型参数）──
struct Marker<T> { x: i64 }

// ── 11. Drop trait / RAII ──
struct Res { id: i64 }
impl Drop for Res {
    fn drop(self) { println("  [drop] Res " + to_string(self.id) + " 作用域退出时释放") }
}

// ── 12. Copy trait（自动派生）──
struct Point { x: i64, y: i64 }

// ═══════════════ 各特性演示函数（每特性独立函数，规避 VM 标签循环组合缺陷） ═══════════════

// ── 1. Box / Rc / Arc / Pin 智能指针 ──
fn demo_smart_ptr() {
    let b: Box<i64> = Box::new(42);
    println("  Box::new(42).deref()    = ", b.deref());

    let r = Rc::new(7);
    let r2 = r.clone();                 // Rc::clone：共享同一内部值
    println("  Rc::new(7) 克隆后 .deref() = ", r2.deref());

    let a = Arc::new(10);
    println("  Arc::new(10).deref()    = ", a.deref());

    let p = Pin::new(5);
    println("  Pin::new(5).deref()     = ", p.deref());
}

// ── 2. Union tagged 类型 ──
fn demo_union() {
    let u = U { a: 42 };
    println("  U { a: 42 }，u.a = ", u.a);
    let mut u2 = U { b: 2.5 };
    u2.b = 3.5;                         // 仅 active 字段可修改
    println("  u2.b 修改为 3.5 = ", u2.b);
}

// ── 3. dyn Trait 动态分发 ──
fn demo_dyn() {
    let c = Circle { radius: 2.0 };
    let s = Square { side: 3.0 };
    let dc: dyn Draw = c;               // 类型注解驱动升级为动态分发
    let ds: dyn Draw = s;
    println("  dyn Draw(Circle) 面积 = ", dc.area());
    println("  dyn Draw(Square) 面积 = ", ds.area());
}

// ── 4. 泛型枚举 <T>（i64 与 str 实例化拆两个函数，规避 AUDIT #18：
//        同函数两个泛型枚举 match 时第二个（str 绑定）取值错误）──
fn demo_generic_enum_int() {
    let mb = Maybe<i64>::Just(42);
    let v = match mb {
        Maybe::Just(x) => x,
        Maybe::Nothing => -1,
    };
    println("  Maybe<i64>::Just(42) 解构 = ", v);
}

fn demo_generic_enum_str() {
    let ms = Maybe<str>::Just("hi");
    let vs = match ms {
        Maybe::Just(x) => x,
        Maybe::Nothing => "empty",
    };
    println("  Maybe<str>::Just(\"hi\") 解构 = ", vs);
}

// ── 5. Newtype（元组结构体）──
fn demo_newtype() {
    let m = Meters(3.5);
    println("  Meters(3.5)._0 = ", m._0);
    let pp = Pair(3, "km");
    println("  Pair(3, \"km\")._0 = ", pp._0, "，._1 = ", pp._1);
}

// ── 6. 标签 break / continue（拆两个函数，规避 AUDIT #17：VM 同函数多标签循环缺陷）──
fn demo_labeled_break() {
    // break 'outer：内层满足条件直接跳出两层
    let mut i = 0;
    let mut s = 0;
    'outer: while i < 10 {
        let mut j = 0;
        while j < 10 {
            if j == 3 { break 'outer; }   // 跳出两层循环
            s = s + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    println("  break 'outer 后 s = ", s, "（期望 3）");
}

fn demo_labeled_continue() {
    // continue 'outer：内层 continue 外层循环
    let mut s2 = 0;
    'outer: for k in 0..5 {
        let mut j = 0;
        while j < 3 {
            j = j + 1;
            if k % 2 == 0 { continue 'outer; }  // 偶数 k 跳过外层体
            s2 = s2 + 1;
        }
        s2 = s2 + 10;
    }
    println("  continue 'outer 后 s2 = ", s2, "（期望 26）");
}

// ── 7. 自定义运算符 ──
fn demo_custom_op() {
    println("  1 @@ 2 = ", 1 @@ 2);            // 3
    println("  2.0 @~ 3.0 = ", 2.0 @~ 3.0);    // 7.0（2*3+1）
}

// ── 8. 声明式宏 ──
fn demo_macro() {
    println("  twice(21) = ", twice(21));          // 42
    println("  sum_sq(3, 4) = ", sum_sq(3, 4));    // 25
}

// ── 9. Weak 弱引用 ──
fn demo_weak() {
    let r = Rc::new(42);
    let w = Weak::new(r);                 // 不增加强引用计数
    let o = weak_upgrade(w);              // 原 Rc 存活 → Option::Some
    match o {
        Option::Some(rc) => println("  weak_upgrade 成功 = ", rc.deref()),
        Option::None => println("  weak_upgrade 失败（原 Rc 已释放）"),
    }
}

// ── 10. Phantom 类型（未使用类型参数）──
fn demo_phantom() {
    let m10 = Marker<i64> { x: 42 };      // T 未被字段使用，仅参与类型区分
    println("  Marker<i64> { x: 42 }，m10.x = ", m10.x);
}

// ── 11. Drop trait / RAII ──
fn demo_drop() {
    {
        let r11 = Res { id: 7 };
        println("  [inside] 进入块作用域，创建 Res 7");
    }
    println("  [outside] 块作用域已退出（上方应已打印 drop）");
}

// ── 12. Copy trait（自动派生）──
fn demo_copy() {
    let p12 = Point { x: 3, y: 4 };
    let q12 = p12;                        // 全字段 Copy → p12 不失效
    println("  p12.x = ", p12.x, "，q12.x = ", q12.x, "（p12 仍可用）");
}

// ═══════════════ 主程序 ═══════════════

fn main() {
    println("========================================");
    println("  Tenth 语言核心新特性（M1-M4）综合演示");
    println("========================================");
    println("");

    println("── 1. 智能指针 Box / Rc / Arc / Pin ──");
    demo_smart_ptr();
    println("");

    println("── 2. Union tagged 类型 ──");
    demo_union();
    println("");

    println("── 3. dyn Trait 动态分发 ──");
    demo_dyn();
    println("");

    println("── 4. 泛型枚举 <T> ──");
    demo_generic_enum_int();
    demo_generic_enum_str();
    println("");

    println("── 5. Newtype（元组结构体）──");
    demo_newtype();
    println("");

    println("── 6. 标签 break / continue ──");
    demo_labeled_break();
    demo_labeled_continue();
    println("");

    println("── 7. 自定义运算符（@ $ ~ 组合）──");
    demo_custom_op();
    println("");

    println("── 8. 声明式宏（编译期展开）──");
    demo_macro();
    println("");

    println("── 9. Weak 弱引用 ──");
    demo_weak();
    println("");

    println("── 10. Phantom 类型 ──");
    demo_phantom();
    println("");

    println("── 11. Drop trait / RAII ──");
    demo_drop();
    println("");

    println("── 12. Copy trait（自动派生，赋值不移动）──");
    demo_copy();
    println("");
}
