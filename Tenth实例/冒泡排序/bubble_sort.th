// 冒泡排序 — 不可变风格实现

fn bubble_sort(arr: Vec<i64>) -> Vec<i64> {
    let n = arr.len();
    if n <= 1 { return arr; };
    let mut result = copy(arr);
    for i in 0..n {
        for j in 0..(n - i - 1) {
            let a = result[j];
            let b = result[j + 1];
            if a > b {
                result = swap(result, j, j + 1);
            };
        };
    };
    result
}

fn copy(v: Vec<i64>) -> Vec<i64> {
    let mut r = Vec::new();
    for i in 0..v.len() { r.push(v[i]); };
    r
}

fn swap(v: Vec<i64>, x: i64, y: i64) -> Vec<i64> {
    let mut r = Vec::new();
    for i in 0..v.len() {
        if i == x { r.push(v[y]); }
        else if i == y { r.push(v[x]); }
        else { r.push(v[i]); };
    };
    r
}

fn main() {
    let mut arr = Vec::new();
    arr.push(5); arr.push(3); arr.push(8);
    arr.push(1); arr.push(2);

    println("Input: 5 3 8 1 2");
    let sorted = bubble_sort(arr);
    println("Sorted:");
    for i in 0..sorted.len() { println(sorted[i]); };
}
