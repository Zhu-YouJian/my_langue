// 冒泡排序 — 不可变风格实现

fn bubble_sort(arr: Vec<i64>) -> Vec<i64> {
    let n = arr.len();
    if n <= 1 { return arr; };
    let mut result = copy(arr);
    let mut i: i64 = 0;
    while i < n {
        let mut j: i64 = 0;
        while j < n - i - 1 {
            let a = result[j];
            let b = result[j + 1];
            if a > b {
                result = swap(result, j, j + 1);
            };
            j = j + 1;
        };
        i = i + 1;
    };
    result
}

fn copy(v: Vec<i64>) -> Vec<i64> {
    let mut r = Vec::new();
    let mut i: i64 = 0;
    while i < v.len() { r.push(v[i]); i = i + 1; };
    r
}

fn swap(v: Vec<i64>, x: i64, y: i64) -> Vec<i64> {
    let mut r = Vec::new();
    let mut i: i64 = 0;
    while i < v.len() {
        if i == x { r.push(v[y]); }
        else if i == y { r.push(v[x]); }
        else { r.push(v[i]); };
        i = i + 1;
    };
    r
}

fn main() {
    let mut arr = Vec::new();
    arr.push(5); arr.push(3); arr.push(8);
    arr.push(1); arr.push(2);

    println("Input: 5 3 8 1 2");
    let sorted = bubble_sort(arr);
    println("Sorted:");
    let mut i: i64 = 0;
    while i < sorted.len() { println(sorted[i]); i = i + 1; };
}
