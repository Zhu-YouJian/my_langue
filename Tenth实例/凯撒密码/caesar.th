// 凯撒密码 — 查表法

fn shift_char(ch: str, offset: i64) -> str {
    let lower = "abcdefghijklmnopqrstuvwxyz";
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    // 在小写字母表中查找
    for i in 0..lower.len() {
        if lower[i] == ch {
            let new_idx = (i + offset) % 26;
            return lower[new_idx];
        };
    };

    // 在大写字母表中查找
    for i in 0..upper.len() {
        if upper[i] == ch {
            let new_idx = (i + offset) % 26;
            return upper[new_idx];
        };
    };

    ch  // 非字母原样返回
}

fn caesar(text: str, offset: i64) -> str {
    let mut result = "";
    for i in 0..text.len() {
        let ch = text[i];
        result = result + shift_char(ch, offset);
    };
    result
}

fn main() {
    let plain = "hello";
    let enc = caesar(plain, 3);
    println("Caesar('hello', 3):");
    println(enc);

    let dec = caesar(enc, 26 - 3);
    println("Decrypt back:");
    println(dec);

    // 测试大写
    println("Caesar('XYZ', 3):");
    println(caesar("XYZ", 3));
}
