// 埃拉托色尼筛法 — 求 N 以内的质数（试除法版本）

fn is_prime(n: i64) -> bool {
    if n < 2 { return false; };
    let mut i: i64 = 2;
    while i * i <= n {
        if n % i == 0 { return false; };
        i = i + 1;
    };
    true
}

fn sieve(n: i64) -> Vec<i64> {
    let mut result = Vec::new();
    let mut i: i64 = 2;
    while i <= n {
        if is_prime(i) { result.push(i); };
        i = i + 1;
    };
    result
}

fn main() {
    println("Primes up to 30:");
    let primes = sieve(30);
    let mut i: i64 = 0;
    while i < primes.len() {
        println(primes[i]);
        i = i + 1;
    };
}
