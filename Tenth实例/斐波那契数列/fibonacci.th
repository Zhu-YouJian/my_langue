// 斐波那契数列 — 递归 + 迭代

// 递归版
fn fib_rec(n: i64) -> i64 {
    if n <= 1 { n }
    else { fib_rec(n - 1) + fib_rec(n - 2) }
}

// 迭代版
fn fib_iter(n: i64) -> i64 {
    if n <= 1 { return n; };
    let mut a: i64 = 0;
    let mut b: i64 = 1;
    let mut i: i64 = 2;
    while i <= n {
        let c = a + b;
        a = b;
        b = c;
        i = i + 1;
    };
    b
}

fn main() {
    println("Fibonacci(10):");
    println("  recursive:");
    println(fib_rec(10));
    println("  iterative:");
    println(fib_iter(10));
}
