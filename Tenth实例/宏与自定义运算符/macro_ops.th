// 声明式宏 + 自定义运算符 专题演示（"新语言"味道最浓的两个特性）
//
// 覆盖特性（M3.1 / M3.3，2026-08-02）：
//   声明式宏（编译期展开）：
//     - 基础展开、宏嵌套调用（宏体内调用宏）、0 参宏
//     - 实参重复使用（无 hygiene，C 宏风格）
//     - 宏体为任意表达式（if 表达式）、宏在函数/循环中调用
//     - 宏 + 自定义运算符组合
//   自定义运算符：
//     - @ $ ~ 字符集组合（@@、@~、$$、$@、~~、@$@）
//     - 优先级（与 + - 同级，低于 * / %）、与内置运算符混用
//     - 在函数内使用（绑定函数以合成名注册，经普通函数间接调用）
//
// 运行：tenth run macro_ops.th
//   宏在 parse 阶段展开为普通 AST，自定义运算符降级为普通函数调用，
//   默认 VM/JIT 路径原生支持（无需 TENTH_NO_VM）。

// ═══════════════ 声明区 ═══════════════

// ── 声明式宏 ──
macro twice(x) { x + x }
macro sq(x) { x * x }
macro cube(x) { x * x * x }
macro sum_sq(a, b) { sq(a) + sq(b) }      // 宏体内调用其他宏
macro quad(a, b) { (a + b) + (a + b) }    // 实参重复使用（无 hygiene）
macro seven { 7 }                         // 0 参宏可省略括号
macro max2(a, b) { if a > b { a } else { b } }   // 宏体可为 if 表达式
macro avg2(a, b) { a ~~ b }               // 宏体引用自定义运算符（展开后正常解析）

// ── 自定义运算符（@ $ ~ 组合）──
operator @@ = fn(a: i64, b: i64) -> i64 { a + b }
operator @~ = fn(a: i64, b: i64) -> i64 { a * b }
operator $$ = fn(a: i64, b: i64) -> i64 { a - b }
operator $@ = fn(a: str, b: str) -> str { a + "-" + b }
operator ~~ = fn(a: f64, b: f64) -> f64 { (a + b) / 2.0 }
operator @$@ = fn(a: i64, b: i64) -> i64 { a * a + b * b }

// 普通函数（顶层定义）
fn apply_macro(n: i64) -> i64 { twice(n) + sq(n) }
fn score(x: i64, y: i64) -> i64 { x @@ y }

// ═══════════════ 主程序 ═══════════════

fn main() {
    println("========================================");
    println("  声明式宏 + 自定义运算符 专题演示");
    println("========================================");
    println("");

    // ── 一、声明式宏 ──
    println("── 一、声明式宏（编译期展开）──");
    println("  twice(21)   = ", twice(21));          // 21+21 = 42
    println("  sq(9)       = ", sq(9));              // 81
    println("  cube(3)     = ", cube(3));            // 27
    println("  sum_sq(3,4) = ", sum_sq(3, 4));       // 9+16 = 25（宏内调宏）
    println("  quad(2,3)   = ", quad(2, 3));         // (2+3)+(2+3) = 10
    println("  seven()     = ", seven());            // 7（0 参宏）
    println("  max2(7,3)   = ", max2(7, 3));         // 7（if 表达式）
    println("  avg2(3.0,7.0) = ", avg2(3.0, 7.0));   // 5.0（宏 + 自定义运算符）
    println("");

    // 宏在普通函数中调用
    println("  apply_macro(3) = ", apply_macro(3));  // twice(3)+sq(3) = 6+9 = 15
    // 宏在循环中调用
    let mut acc = 0;
    for i in 0..5 {
        acc = acc + twice(i);                       // 0+2+4+6+8
    }
    println("  for 中累计 twice(i) = ", acc);        // 20
    println("");

    // ── 二、自定义运算符 ──
    println("── 二、自定义运算符（@ $ ~ 组合）──");
    println("  10 @@ 4 = ", 10 @@ 4);                // 14（加）
    println("  10 @~ 4 = ", 10 @~ 4);               // 40（乘）
    println("  10 $$ 4 = ", 10 $$ 4);               // 6（减）
    println("  \"a\" $@ \"b\" = ", "a" $@ "b");      // "a-b"（字符串）
    println("  3.0 ~~ 7.0 = ", 3.0 ~~ 7.0);         // 5.0（平均）
    println("  3 @$@ 4 = ", 3 @$@ 4);               // 9+16 = 25（三字符组合）
    println("");

    // 优先级：自定义运算符与 + - 同级（左结合）、低于 * / %
    println("── 三、优先级演示 ──");
    println("  1 + 2 @@ 3 = ", 1 + 2 @@ 3);          // (1+2)@@3 = 3+3 = 6
    println("  2 @@ 3 * 4 = ", 2 @@ 3 * 4);         // 2@@(3*4) = 2+12 = 14
    println("  20 $$ 4 @@ 2 = ", 20 $$ 4 @@ 2);     // (20-4)@@2 = 16+2 = 18
    println("  2 @@ 3 @~ 4 = ", 2 @@ 3 @~ 4);       // (2@@3)@~4 = 5*4 = 20
    println("");

    // 自定义运算符在函数内使用（绑定函数以合成名 __custom_op_<op> 注册，
    // 但含运算符字符无法作为标识符直接书写，故通过普通函数间接调用）
    println("── 四、函数内使用 ──");
    println("  score(6, 7) = ", score(6, 7));       // 6@@7 = 13
    println("");

    // 综合：宏 + 自定义运算符做一个小计算
    println!("── 五、综合小计算 ──");
    // 用自定义运算符实现"加权"：w1 @@ w2 然后 @~ 系数
    let w = (2 @@ 3) @~ 4;                           // (2+3)*4 = 20
    println!("  (2 @@ 3) @~ 4 = ", w);
    println("  总分 = ", sum_sq(3, 4) @@ twice(5));  // 25 @@ 10 = 35
    println("");
}
