// 泛型示例

// 泛型 identity
fn id<T>(x: T) -> T { x }

// 泛型结构体
struct Pair<T> { first: T, second: T }

// 泛型 swap
fn swap_pair<T>(p: Pair<T>) -> Pair<T> {
    Pair { first: p.second, second: p.first }
}

fn main() {
    // identity — 泛型函数需要显式类型参数: id<i64>(42)
    println("id<i64>(42):");
    println(id<i64>(42));

    println("id<str>(\"hello\"):");
    println(id<str>("hello"));

    // Pair — 泛型结构体同样需要显式类型参数
    let p = Pair<i64> { first: 1, second: 2 };
    let swapped = swap_pair<i64>(p);
    println("swapped pair first:");
    println(swapped.first);
    println("swapped pair second:");
    println(swapped.second);
}
