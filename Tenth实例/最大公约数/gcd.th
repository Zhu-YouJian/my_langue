// 最大公约数 — 辗转相除法（欧几里得算法）

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a }
    else { gcd(b, a % b) }
}

// 迭代版
fn gcd_iter(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let tmp = y;
        y = x % y;
        x = tmp;
    };
    x
}

fn main() {
    println("gcd(48, 18):");
    println(gcd(48, 18));

    println("gcd(17, 13):");
    println(gcd_iter(17, 13));

    println("gcd(1071, 462):");
    println(gcd(1071, 462));
}
