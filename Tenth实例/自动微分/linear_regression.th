// 自动微分示例：用 SGD 学习 y = 2x + 1
// 使用 for-in 循环 + mean() loss

fn main() {
    let x = tensor[[1.0, 2.0, 3.0, 4.0]];
    let target = tensor[[3.0, 5.0, 7.0, 9.0]];

    let mut w = tensor[[0.0]];
    let mut b = tensor[[0.0]];
    let lr = 0.02;

    for epoch in 0..500 {
        new_grad();
        zero_grad();
        w = param(w);
        b = param(b);

        let pred = w * x + b;
        let loss = ((pred - target) * (pred - target)).mean();

        backward(loss);

        stop_grad();
        w = w - lr * grad(w);
        b = b - lr * grad(b);
    };

    println("w (should be ~2):");
    println(w.sum());
    println("b (should be ~1):");
    println(b.sum());
    println("predict x=5 (should be ~11):");
    stop_grad();
    println((w * 5.0 + b).sum());
}
