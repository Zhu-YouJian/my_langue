// 自动微分示例：用 SGD 学习 y = 2x + 1
// 展示 new_grad / stop_grad / zero_grad / mean() 的标准化用法

fn main() {
    let x = tensor[[1.0, 2.0, 3.0, 4.0]];
    let target = tensor[[3.0, 5.0, 7.0, 9.0]];

    let mut w = tensor[[0.0]];
    let mut b = tensor[[0.0]];
    let lr = 0.08;  // mean() 缩小了梯度，用更大的 lr
    let mut epoch: i64 = 0;

    while epoch < 500 {
        new_grad();
        zero_grad();
        w = param(w);
        b = param(b);

        let pred = w * x + b;
        let loss = ((pred - target) * (pred - target)).mean();

        backward(loss);

        stop_grad();
        w = w - lr * grad(w);
        b = b - lr * grad(b);

        epoch = epoch + 1;
    };

    println("Learned w (should be ~2):");
    println(w.sum());
    println("Learned b (should be ~1):");
    println(b.sum());

    stop_grad();
    println("Predict x=5 (should be ~11):");
    let pred = w * 5.0 + b;
    println(pred.sum());
}
