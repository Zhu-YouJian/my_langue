// 标签循环：break 'outer / continue 'outer
//
// 给循环加标签，从内层直接跳出 / 继续指定层（M2.3 补全）：
//   'outer: while ... { while ... { break 'outer; } }
//   - break 'outer     跳出外层循环
//   - continue 'outer  继续外层循环的下一轮
//
// 运行：tenth run labeled_loop.th（默认 VM/JIT 路径即可）
//
// 注：AUDIT #17（同一函数内多个标签循环的字节码槽污染）已于 2026-08-02
// 修复，break 与 continue 的演示合并到同一函数（demo_labeled）验证。

fn demo_labeled() {
    // 1) break 'outer：内层 j == 3 时，直接跳出两层循环
    let mut s = 0;
    'outer: while true {
        let mut j = 0;
        while j < 10 {
            if j == 3 { break 'outer; }
            s = s + 1;
            j = j + 1;
        }
    }
    println("  break 'outer 后 s = ", s, "（期望 3）");

    // 2) continue 'outer：偶数 k 时跳过外层循环体的剩余部分
    //    （与上面同一函数、同名标签、共用变量名 j —— 原缺陷场景）
    let mut s2 = 0;
    'outer: for k in 0..5 {
        let mut j = 0;
        while j < 3 {
            j = j + 1;
            if k % 2 == 0 { continue 'outer; }
            s2 = s2 + 1;
        }
        s2 = s2 + 10;
    }
    println("  continue 'outer 后 s2 = ", s2, "（期望 26）");
}

fn main() {
    println("=== 标签循环 ===\n");
    demo_labeled();
    println("");
}
