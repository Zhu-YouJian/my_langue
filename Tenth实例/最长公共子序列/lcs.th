// 最长公共子序列（LCS）— 力扣 1143 题等价
// 给定两个字符串，求最长公共子序列的长度
// 使用空间优化 DP（只保留两行）

fn max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn lcs(s1: str, s2: str) -> i64 {
    let m = s1.len();
    let n = s2.len();
    if m == 0 || n == 0 { return 0; };

    // prev 行（初始为全 0）
    let mut prev = Vec::new();
    let mut j: i64 = 0;
    while j <= n {
        prev.push(0);
        j = j + 1;
    };

    let mut i: i64 = 1;
    while i <= m {
        let mut curr = Vec::new();
        curr.push(0);  // curr[0] = 0

        j = 1;
        while j <= n {
            if s1[i - 1] == s2[j - 1] {
                curr.push(prev[j - 1] + 1);
            } else {
                curr.push(max(prev[j], curr[j - 1]));
            };
            j = j + 1;
        };

        prev = curr;
        i = i + 1;
    };

    prev[n]
}

fn main() {
    // 示例 1
    let s1 = "abcde";
    let s2 = "ace";
    println("LCS('abcde', 'ace') = 3:");
    println(lcs(s1, s2));

    // 示例 2
    println("LCS('abc', 'abc') = 3:");
    println(lcs("abc", "abc"));

    // 示例 3
    println("LCS('abc', 'def') = 0:");
    println(lcs("abc", "def"));

    // 复杂示例
    println("LCS('AGGTAB', 'GXTXAYB') = 4:");
    println(lcs("AGGTAB", "GXTXAYB"));
}
