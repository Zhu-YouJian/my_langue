// 闭包合集 — 演示 Tenth 闭包功能（含变量捕获）
//
// ⚠️ 需解释器路径运行（VM 路径会报“未定义的函数 'compute'”）：
//   TENTH_NO_VM=1 tenth.exe run "Tenth实例/闭包合集/closures.th"
// 根因：VM 缺少闭包值的间接调用（CallIndirect）——`let f = |x| ...; f(2)`
// 按函数名查找 f 失败；解释器路径支持闭包值调用。待总师单独排期修复 VM。

fn main() {
    // 简单闭包
    let double = |x| x * 2;
    println("double(21):");
    println(double(21));

    let square = |x| x * x;
    println("square(7):");
    println(square(7));

    // 嵌套调用
    let triple = |x| x * 3;
    println("triple(9):");
    println(triple(9));

    // 闭包类型: 可作为变量传递
    let op = double;
    println("op(50):");
    println(op(50));

    // 闭包捕获环境变量
    let factor = 3;
    let multiply = |x| x * factor;
    println("multiply(7) with factor=3:");
    println(multiply(7));

    // 闭包捕获多个变量
    let base = 10;
    let offset = 5;
    let compute = |x| x * base + offset;
    println("compute(2) with base=10, offset=5:");
    println(compute(2));
}
