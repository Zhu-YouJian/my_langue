// Self-hosting Tenth compiler — lexer/parser demo entry point
// (C codegen removed; compiler runs via Rust interpreter)

fn main() -> i64 {
    let src = read_file("tenthc/lexer/token.th");
    let mut lex = lexer_new(src);
    let tokens = lexer_tokenize(&mut lex);
    println("Lexer tokenized token.th successfully");
    return 0;
}
