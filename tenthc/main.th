// Self-hosting Tenth compiler — bootstrap entry point

fn compile(src: str) -> str {
    let mut lex = lexer_new(src);
    let tokens = lexer_tokenize(&mut lex);
    let prog = parse_program(tokens);
    cgen_program(&prog, &prog.expr_nodes, &prog.stmt_nodes)
}

fn main() -> i64 {
    let src = read_file("test_fn7.th");
    let mut lex = lexer_new(src);
    let tokens = lexer_tokenize(&mut lex);
    let prog = parse_program(tokens);
    let c = cgen_program(&prog, &prog.expr_nodes, &prog.stmt_nodes);
    write_file("tenthc_output.c", c);
    return 0;
}
