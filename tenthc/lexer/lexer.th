// Self-hosting Lexer — v0.3.1 enum-based

struct Lexer {
    source: str,
    pos: i64,
    line: i64,
    col: i64,
}

fn lexer_new(source: str) -> Lexer {
    Lexer { source: source, pos: 0, line: 1, col: 1 }
}

fn is_digit(ch: str) -> bool { (ch >= "0") && (ch <= "9") }
fn is_alpha(ch: str) -> bool { ((ch >= "a") && (ch <= "z")) || ((ch >= "A") && (ch <= "Z")) || (ch == "_") }
fn is_alnum(ch: str) -> bool { is_alpha(ch) || is_digit(ch) }
fn is_ws(ch: str) -> bool { (ch == " ") || (ch == "\n") || (ch == "\t") || (ch == "\r") }

fn lexer_peek(lexer: &Lexer) -> str {
    if lexer.pos < lexer.source.len() { lexer.source[lexer.pos] } else { "" }
}

fn lexer_advance(lexer: &mut Lexer) -> str {
    let ch = lexer_peek(lexer);
    if ch == "" { return ""; };
    lexer.pos = lexer.pos + 1;
    if ch == "\n" { lexer.line = lexer.line + 1; lexer.col = 1; }
    else { lexer.col = lexer.col + 1; };
    ch
}

fn make_span(line: i64, col: i64) -> Span { Span { line: line, col: col } }

fn lexer_next(lexer: &mut Lexer) -> Token {
    let mut ch = lexer_peek(lexer);

    // Skip whitespace and comments
    while ch != "" {
        if is_ws(ch) { ch = lexer_advance(lexer); ch = lexer_peek(lexer); }
        else if ch == "/" {
            let next_pos = lexer.pos + 1;
            if (next_pos < lexer.source.len()) && (lexer.source[next_pos] == "/") {
                lexer_advance(lexer); lexer_advance(lexer);
                ch = lexer_peek(lexer);
                while (ch != "") && (ch != "\n") { ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
            } else { break; };
        } else { break; };
        ch = lexer_peek(lexer);
    };

    let line = lexer.line;
    let col = lexer.col;
    let span = make_span(line, col);

    if ch == "" {
        return Token { kind: TokenKind::Eof, span: span };
    };

    // Numbers
    if is_digit(ch) {
        let mut num_str = "";
        let mut is_float = false;
        while is_digit(ch) {
            num_str = num_str + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };
        if ch == "." {
            is_float = true;
            num_str = num_str + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
            while is_digit(ch) {
                num_str = num_str + ch;
                ch = lexer_advance(lexer); ch = lexer_peek(lexer);
            };
        };
        if is_float {
            return Token { kind: TokenKind::FloatLiteral(value: 0.0), span: span };
        };
        return Token { kind: TokenKind::IntLiteral(value: 0), span: span };
    };

    // Identifiers and keywords
    if is_alpha(ch) {
        let mut ident = "";
        while (ch != "") && is_alnum(ch) {
            ident = ident + ch;
            ch = lexer_advance(lexer); ch = lexer_peek(lexer);
        };

        if ident == "fn" { return Token { kind: TokenKind::Fn, span: span }; };
        if ident == "let" { return Token { kind: TokenKind::Let, span: span }; };
        if ident == "mut" { return Token { kind: TokenKind::Mut, span: span }; };
        if ident == "if" { return Token { kind: TokenKind::If, span: span }; };
        if ident == "else" { return Token { kind: TokenKind::Else, span: span }; };
        if ident == "match" { return Token { kind: TokenKind::Match, span: span }; };
        if ident == "return" { return Token { kind: TokenKind::Return, span: span }; };
        if ident == "while" { return Token { kind: TokenKind::While, span: span }; };
        if ident == "for" { return Token { kind: TokenKind::For, span: span }; };
        if ident == "loop" { return Token { kind: TokenKind::Loop, span: span }; };
        if ident == "break" { return Token { kind: TokenKind::Break, span: span }; };
        if ident == "continue" { return Token { kind: TokenKind::Continue, span: span }; };
        if ident == "struct" { return Token { kind: TokenKind::Struct, span: span }; };
        if ident == "enum" { return Token { kind: TokenKind::Enum, span: span }; };
        if ident == "impl" { return Token { kind: TokenKind::Impl, span: span }; };
        if ident == "trait" { return Token { kind: TokenKind::Trait, span: span }; };
        if ident == "use" { return Token { kind: TokenKind::Use, span: span }; };
        if ident == "mod" { return Token { kind: TokenKind::Mod, span: span }; };
        if ident == "true" { return Token { kind: TokenKind::True, span: span }; };
        if ident == "false" { return Token { kind: TokenKind::False, span: span }; };
        if ident == "move" { return Token { kind: TokenKind::Move, span: span }; };
        if ident == "self" { return Token { kind: TokenKind::Self_, span: span }; };

        return Token { kind: TokenKind::Identifier(name: ident), span: span };
    };

    // Strings
    if ch == "\"" {
        lexer_advance(lexer);
        let mut s = "";
        ch = lexer_peek(lexer);
        while (ch != "") && (ch != "\"") { s = s + ch; ch = lexer_advance(lexer); ch = lexer_peek(lexer); };
        if ch == "\"" { lexer_advance(lexer); };
        return Token { kind: TokenKind::StringLiteral(value: s), span: span };
    };

    // Single-char tokens and multi-char operators
    lexer_advance(lexer);

    if ch == "(" { return Token { kind: TokenKind::LParen, span: span }; };
    if ch == ")" { return Token { kind: TokenKind::RParen, span: span }; };
    if ch == "{" { return Token { kind: TokenKind::LBrace, span: span }; };
    if ch == "}" { return Token { kind: TokenKind::RBrace, span: span }; };
    if ch == "[" { return Token { kind: TokenKind::LBracket, span: span }; };
    if ch == "]" { return Token { kind: TokenKind::RBracket, span: span }; };
    if ch == "," { return Token { kind: TokenKind::Comma, span: span }; };
    if ch == ";" { return Token { kind: TokenKind::Semicolon, span: span }; };

    if ch == "." {
        if lexer_peek(lexer) == "." { lexer_advance(lexer); return Token { kind: TokenKind::DotDot, span: span }; };
        return Token { kind: TokenKind::Dot, span: span };
    };
    if ch == ":" {
        if lexer_peek(lexer) == ":" { lexer_advance(lexer); return Token { kind: TokenKind::ColonColon, span: span }; };
        return Token { kind: TokenKind::Colon, span: span };
    };
    if ch == "+" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::PlusAssign, span: span }; };
        return Token { kind: TokenKind::Plus, span: span };
    };
    if ch == "-" {
        if lexer_peek(lexer) == ">" { lexer_advance(lexer); return Token { kind: TokenKind::Arrow, span: span }; };
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::MinusAssign, span: span }; };
        return Token { kind: TokenKind::Minus, span: span };
    };
    if ch == "*" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::StarAssign, span: span }; };
        return Token { kind: TokenKind::Star, span: span };
    };
    if ch == "/" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::SlashAssign, span: span }; };
        return Token { kind: TokenKind::Slash, span: span };
    };
    if ch == "%" { return Token { kind: TokenKind::Percent, span: span }; };
    if ch == "=" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::EqEq, span: span }; };
        if lexer_peek(lexer) == ">" { lexer_advance(lexer); return Token { kind: TokenKind::FatArrow, span: span }; };
        return Token { kind: TokenKind::Assign, span: span };
    };
    if ch == "!" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::NotEq, span: span }; };
        return Token { kind: TokenKind::Not, span: span };
    };
    if ch == "<" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::LtEq, span: span }; };
        return Token { kind: TokenKind::Lt, span: span };
    };
    if ch == ">" {
        if lexer_peek(lexer) == "=" { lexer_advance(lexer); return Token { kind: TokenKind::GtEq, span: span }; };
        return Token { kind: TokenKind::Gt, span: span };
    };
    if ch == "&" {
        if lexer_peek(lexer) == "&" { lexer_advance(lexer); return Token { kind: TokenKind::AndAnd, span: span }; };
        return Token { kind: TokenKind::Ampersand, span: span };
    };
    if ch == "|" {
        if lexer_peek(lexer) == "|" { lexer_advance(lexer); return Token { kind: TokenKind::OrOr, span: span }; };
        return Token { kind: TokenKind::Pipe, span: span };
    };

    // Unknown char — treat as identifier
    Token { kind: TokenKind::Identifier(name: ch), span: span }
}

fn lexer_tokenize(lexer: &mut Lexer) -> Vec<Token> {
    let mut tokens = Vec::new();
    let src_len = lexer.source.len();
    while lexer.pos < src_len {
        let t = lexer_next(lexer);
        tokens.push(t);
    };
    tokens.push(lexer_next(lexer)); // push EOF
    tokens
}
