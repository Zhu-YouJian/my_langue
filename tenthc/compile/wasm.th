// Minimal WASM emitter — v0.3.3 idioms: for-in, `..` defaults, generic returns
// Compiles HirProgram to WASM binary bytes
// Output: Vec<i64> where each element is a byte (0-255)

// ── LEB128 encoding ──

fn leb128_u(value: i64, out: &mut Vec<i64>) {
    let mut v = value;
    loop {
        let mut byte = v % 128;
        v = v / 128;
        if v != 0 { byte = byte + 128; };
        out.push(byte);
        if v == 0 { break; };
    };
}

fn leb128_s(value: i64, out: &mut Vec<i64>) {
    let mut v = value;
    loop {
        let mut byte = v % 128;
        v = v / 128;
        if (v == 0) && (byte < 64) { out.push(byte); break; };
        if (v == -1) && (byte >= 64) { out.push(byte); break; };
        byte = byte + 128;
        out.push(byte);
    };
}

// ── Section helpers ──

fn emit_section(out: &mut Vec<i64>, section_id: i64, body: Vec<i64>) {
    out.push(section_id);
    leb128_u(body.len(), out);
    for i in 0..body.len() { out.push(body.get(i)); };
}

// ── WASM opcodes ──

fn wasm_unreachable(out: &mut Vec<i64>) { out.push(0); }
fn wasm_nop(out: &mut Vec<i64>) { out.push(1); }
fn wasm_end(out: &mut Vec<i64>) { out.push(11); }
fn wasm_return(out: &mut Vec<i64>) { out.push(15); }
fn wasm_local_get(out: &mut Vec<i64>, idx: i64) { out.push(32); leb128_u(idx, out); }
fn wasm_local_set(out: &mut Vec<i64>, idx: i64) { out.push(33); leb128_u(idx, out); }
fn wasm_i64_const(out: &mut Vec<i64>, val: i64) {
    out.push(66);
    leb128_s(val, out);
}
fn wasm_i64_add(out: &mut Vec<i64>) { out.push(124); }
fn wasm_i64_sub(out: &mut Vec<i64>) { out.push(125); }
fn wasm_i64_mul(out: &mut Vec<i64>) { out.push(126); }
fn wasm_i64_div_s(out: &mut Vec<i64>) { out.push(127); }
fn wasm_i64_eq(out: &mut Vec<i64>) { out.push(81); }
fn wasm_i64_ne(out: &mut Vec<i64>) { out.push(82); }
fn wasm_i64_lt_s(out: &mut Vec<i64>) { out.push(83); }
fn wasm_i64_gt_s(out: &mut Vec<i64>) { out.push(85); }
fn wasm_i64_le_s(out: &mut Vec<i64>) { out.push(87); }
fn wasm_i64_ge_s(out: &mut Vec<i64>) { out.push(89); }
fn wasm_call(out: &mut Vec<i64>, func_idx: i64) { out.push(16); leb128_u(func_idx, out); }
fn wasm_block(out: &mut Vec<i64>, blocktype: i64) { out.push(2); out.push(blocktype); }
fn wasm_loop(out: &mut Vec<i64>, blocktype: i64) { out.push(3); out.push(blocktype); }
fn wasm_if(out: &mut Vec<i64>, blocktype: i64) { out.push(4); out.push(blocktype); }
fn wasm_else(out: &mut Vec<i64>) { out.push(5); }
fn wasm_br(out: &mut Vec<i64>, idx: i64) { out.push(12); leb128_u(idx, out); }
fn wasm_br_if(out: &mut Vec<i64>, idx: i64) { out.push(13); leb128_u(idx, out); }
fn wasm_i32_eqz(out: &mut Vec<i64>) { out.push(69); }
fn wasm_i64_eqz(out: &mut Vec<i64>) { out.push(80); }
fn wasm_i32_wrap_i64(out: &mut Vec<i64>) { out.push(167); }
fn wasm_i32_const(out: &mut Vec<i64>, val: i64) { out.push(65); leb128_s(val, out); }
fn wasm_i32_add(out: &mut Vec<i64>) { out.push(106); }
fn wasm_i64_load(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(41); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i64_store(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(55); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i32_load(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(40); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i32_store(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(54); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i64_extend_i32_u(out: &mut Vec<i64>) { out.push(173); }
fn wasm_drop(out: &mut Vec<i64>) { out.push(26); }
fn wasm_local_tee(out: &mut Vec<i64>, idx: i64) { out.push(34); leb128_u(idx, out); }
fn wasm_global_get(out: &mut Vec<i64>, idx: i64) { out.push(35); leb128_u(idx, out); }
fn wasm_global_set(out: &mut Vec<i64>, idx: i64) { out.push(36); leb128_u(idx, out); }

// ── Compiler state ──

struct WasmCtx {
    out: Vec<i64>,       // final output bytes
    code_out: Vec<i64>,  // code section body
    func_count: i64,     // number of functions
    temp_local: i64,     // index of temp local slot
}

fn ctx_new() -> WasmCtx {
    WasmCtx { out: Vec::new(), code_out: Vec::new(), func_count: 0, temp_local: 0 }
}

// ── Compile one function body ──

fn compile_fn_body(ctx: &mut WasmCtx, hir: HirProgram, fn_idx: i64) {
    let f = hir.fns[fn_idx];

    // Count locals (params + let bindings)
    let num_params = f.params.len();

    // Function body header
    let mut body: Vec<i64> = Vec::new();

    // Local declaration count: 16 temp locals (i64)
    leb128_u(1, &mut body); // 1 group
    leb128_u(16, &mut body); // 16 locals
    body.push(126); // i64

    // Set temp local index
    ctx.temp_local = num_params;

    // Compile body expression
    compile_expr(ctx, &mut body, hir, f.body);

    wasm_end(&mut body);

    // Emit function body size + body
    leb128_u(body.len(), &mut ctx.code_out);
    for i in 0..body.len() { ctx.code_out.push(body[i]); };
}

// ── Struct offset lookup ──

fn type_struct_name(hir: HirProgram, ty_idx: i64) -> str {
    if ty_idx <= 0 || ty_idx > hir.type_nodes.len() { return ""; };
    let t = hir.type_nodes[ty_idx - 1];
    if t.disc == 4 || t.disc == 8 { return t.name; }; // TypeParam or Struct
    ""
}

fn struct_field_offset(hir: HirProgram, struct_name: str, field_name: str) -> i64 {
    for si in 0..hir.structs.len() {
        let sd = hir.structs[si];
        if sd.name == struct_name {
            let mut offset: i64 = 0;
            for fi in 0..sd.fields.len() {
                if sd.fields[fi].name == field_name { return offset; };
                offset = offset + 8; // each i64 field is 8 bytes
            };
            return offset; // field not found, return end offset
        };
    };
    0
}

// ── ASCII encoding helper ──

fn char_to_ascii(ch: str) -> i64 {
    // 大写字母 A-Z
    if ch == "A" { return 65; }
    if ch == "B" { return 66; }
    if ch == "C" { return 67; }
    if ch == "D" { return 68; }
    if ch == "E" { return 69; }
    if ch == "F" { return 70; }
    if ch == "G" { return 71; }
    if ch == "H" { return 72; }
    if ch == "I" { return 73; }
    if ch == "J" { return 74; }
    if ch == "K" { return 75; }
    if ch == "L" { return 76; }
    if ch == "M" { return 77; }
    if ch == "N" { return 78; }
    if ch == "O" { return 79; }
    if ch == "P" { return 80; }
    if ch == "Q" { return 81; }
    if ch == "R" { return 82; }
    if ch == "S" { return 83; }
    if ch == "T" { return 84; }
    if ch == "U" { return 85; }
    if ch == "V" { return 86; }
    if ch == "W" { return 87; }
    if ch == "X" { return 88; }
    if ch == "Y" { return 89; }
    if ch == "Z" { return 90; }
    // 小写字母 a-z
    if ch == "a" { return 97; }
    if ch == "b" { return 98; }
    if ch == "c" { return 99; }
    if ch == "d" { return 100; }
    if ch == "e" { return 101; }
    if ch == "f" { return 102; }
    if ch == "g" { return 103; }
    if ch == "h" { return 104; }
    if ch == "i" { return 105; }
    if ch == "j" { return 106; }
    if ch == "k" { return 107; }
    if ch == "l" { return 108; }
    if ch == "m" { return 109; }
    if ch == "n" { return 110; }
    if ch == "o" { return 111; }
    if ch == "p" { return 112; }
    if ch == "q" { return 113; }
    if ch == "r" { return 114; }
    if ch == "s" { return 115; }
    if ch == "t" { return 116; }
    if ch == "u" { return 117; }
    if ch == "v" { return 118; }
    if ch == "w" { return 119; }
    if ch == "x" { return 120; }
    if ch == "y" { return 121; }
    if ch == "z" { return 122; }
    // 数字 0-9
    if ch == "0" { return 48; }
    if ch == "1" { return 49; }
    if ch == "2" { return 50; }
    if ch == "3" { return 51; }
    if ch == "4" { return 52; }
    if ch == "5" { return 53; }
    if ch == "6" { return 54; }
    if ch == "7" { return 55; }
    if ch == "8" { return 56; }
    if ch == "9" { return 57; }
    // 特殊字符
    if ch == "_" { return 95; }
    if ch == ":" { return 58; }
    if ch == "!" { return 33; }
    if ch == "?" { return 63; }
    if ch == "." { return 46; }
    if ch == "-" { return 45; }
    63 // 默认 '?' for unknown chars
}

fn compile_expr(ctx: &mut WasmCtx, out: &mut Vec<i64>, hir: HirProgram, idx: i64) {
    if idx <= 0 || idx > hir.expr_nodes.len() { return; };
    let e = hir.expr_nodes[idx - 1];
    let d = e.disc;

    if d == 0 {
        // IntLiteral
        wasm_i64_const(out, e.lit_ival);
        return;
    };
    if d == 4 {
        // Var — look up local index by name
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        for fi in 0..hir.fns.len() {
            let func = hir.fns[fi];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
            if found { break; };
        };
        wasm_local_get(out, local_idx);
        return;
    };
    if d == 5 {
        // Binary
        compile_expr(ctx, out, hir, e.left);
        compile_expr(ctx, out, hir, e.right);
        let op = e.op;
        if op == "+" { wasm_i64_add(out); return; };
        if op == "-" { wasm_i64_sub(out); return; };
        if op == "*" { wasm_i64_mul(out); return; };
        if op == "/" { wasm_i64_div_s(out); return; };
        if op == "==" { wasm_i64_eq(out); return; };
        if op == "!=" { wasm_i64_ne(out); return; };
        if op == "<" { wasm_i64_lt_s(out); return; };
        if op == ">" { wasm_i64_gt_s(out); return; };
        if op == "<=" { wasm_i64_le_s(out); return; };
        if op == ">=" { wasm_i64_ge_s(out); return; };
        return;
    };
    if d == 6 {
        // Unary
        compile_expr(ctx, out, hir, e.left);
        let op = e.op;
        if op == "-" {
            wasm_i64_const(out, 0);
            wasm_i64_sub(out);
        } else {
            // ! or other: eqz
            wasm_i64_eqz(out);
        };
        return;
    };
    if d == 14 {
        // Assign — target is a variable name, value is compiled
        compile_expr(ctx, out, hir, e.right);
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        for fi in 0..hir.fns.len() {
            let func = hir.fns[fi];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
            if found { break; };
        };
        wasm_local_set(out, local_idx);
        return;
    };
    if d == 15 {
        // StructLiteral — allocate using global bump pointer
        let sname = e.name;
        let mut size: i64 = 0;
        for si in 0..hir.structs.len() {
            if hir.structs[si].name == sname {
                size = hir.structs[si].fields.len() * 8;
                break;
            };
        };
        // global.get $bump (idx 0) → local.tee $temp (idx = num_params)
        wasm_global_get(out, 0);
        let temp_idx = ctx.temp_local;
        wasm_local_tee(out, temp_idx);
        // i32.const size → i32.add → global.set $bump
        wasm_i32_const(out, size);
        wasm_i32_add(out);
        wasm_global_set(out, 0);
        // Return allocated address as i64
        wasm_local_get(out, temp_idx);
        wasm_i64_extend_i32_u(out);
        return;
    };
    if d == 18 || d == 19 {
        // Ref / MutRef — pass through pointer
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    if d == 20 {
        // Deref — pass through (subsequent Field adds offset)
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    if d == 8 {
        // MethodCall — route Vec/String methods to imports
        let method = e.name;
        if e.left > 0 { compile_expr(ctx, out, hir, e.left); };
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, ai);
            };
        };
        if method == "len" {
            wasm_call(out, 2); // import 2: env.vec_len
            return;
        };
        if method == "push" {
            wasm_call(out, 3); // import 3: env.vec_push
            return;
        };
        if method == "get" {
            wasm_call(out, 4); // import 4: env.vec_get
            return;
        };
        // Unknown method: drop everything, return 0
        let mut dc = e.args_count;
        while dc > 0 { wasm_drop(out); dc = dc - 1; };
        wasm_drop(out);
        wasm_i64_const(out, 0);
        return;
    };
    if d == 10 {
        // Field access
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        let sname = type_struct_name(hir, e.ty);
        let offset = struct_field_offset(hir, sname, e.name);
        wasm_i32_const(out, offset);
        wasm_i32_add(out);
        wasm_i64_load(out, 3, 0);
        return;
    };
    if d == 11 {
        // FieldAssign
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        let sname = type_struct_name(hir, e.ty);
        let offset = struct_field_offset(hir, sname, e.name);
        wasm_i32_const(out, offset);
        wasm_i32_add(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 12 {
        // If
        compile_expr(ctx, out, hir, e.cond);
        wasm_if(out, 64); // i64 result type (0x40 = empty, 0x7E = i64)
        compile_expr(ctx, out, hir, e.body);
        if e.alt > 0 {
            wasm_else(out);
            compile_expr(ctx, out, hir, e.alt);
        };
        wasm_end(out);
        return;
    };
    if d == 13 {
        // Block — compile statements, then final expr
        if e.stmts_count > 0 {
            for s in e.stmts_start..(e.stmts_start + e.stmts_count) {
                compile_stmt(ctx, out, hir, s);
            };
        };
        return;
    };
    if d == 21 {
        // Return
        if e.left > 0 { compile_expr(ctx, out, hir, e.left); }
        else { wasm_i64_const(out, 0); };
        wasm_return(out);
        return;
    };
    if d == 7 {
        // Call — route to import or local function
        let func_name = hir.expr_nodes[e.left - 1].name;
        if func_name == "println" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, ai);
                };
            };
            wasm_call(out, 0); // import 0: env.println
            return;
        };
        if func_name == "Vec::new" || func_name == "HashMap::new" {
            wasm_call(out, 1); // import 1: env.vec_new
            return;
        };
        if func_name == "read_file" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, ai);
                };
            };
            wasm_call(out, 5); // import 5: env.read_file
            return;
        };
        if func_name == "write_bytes" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, ai);
                };
            };
            wasm_call(out, 6); // import 6: env.write_bytes
            return;
        };
        // Regular function call (indices offset by 7 imports)
        let mut call_idx: i64 = 7;
        for fi in 0..hir.fns.len() {
            if hir.fns[fi].name == func_name { call_idx = 7 + fi; break; };
        };
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, ai);
            };
        };
        wasm_call(out, call_idx);
        return;
    };
    if d == 22 {
        // ArrayLiteral — compile elements and drop, return 0
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, ai);
                wasm_drop(out);
            };
        };
        wasm_i64_const(out, 0);
        return;
    };
    if d == 23 {
        // Closure — not representable in WASM, push 0 placeholder
        wasm_i64_const(out, 0);
        return;
    };
    if d == 24 {
        // AssignOp — compile right side, then local.set (same as disc 14)
        compile_expr(ctx, out, hir, e.right);
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        for fi in 0..hir.fns.len() {
            let func = hir.fns[fi];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
            if found { break; };
        };
        wasm_local_set(out, local_idx);
        return;
    };
    if d == 26 {
        // DerefAssign — compile target address, compile value, i64.store (same as disc 11)
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 27 {
        // DerefAssignOp — same as DerefAssign for now
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 29 {
        // TensorLiteral — not representable in WASM, push 0
        wasm_i64_const(out, 0);
        return;
    };
    if d == 30 {
        // Move — pass through (same as disc 18/19/20)
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    // Default: unreachable
    wasm_unreachable(out);
}

fn compile_stmt(ctx: &mut WasmCtx, out: &mut Vec<i64>, hir: HirProgram, idx: i64) {
    if idx <= 0 || idx > hir.stmt_nodes.len() { return; };
    let s = hir.stmt_nodes[idx - 1];
    let d = s.disc;

    if d == 2 {
        // Return
        if s.expr > 0 { compile_expr(ctx, out, hir, s.expr); }
        else { wasm_i64_const(out, 0); };
        wasm_return(out);
        return;
    };
    if d == 3 {
        // While — WASM: block $break { loop $continue { cond; i64.eqz; br_if $break; body; br $continue; } }
        wasm_block(out, 64);
        wasm_loop(out, 64);
        if s.cond > 0 {
            compile_expr(ctx, out, hir, s.cond);
            wasm_i64_eqz(out);
            wasm_br_if(out, 1); // break to block (label idx 1 = outer block)
        };
        if s.body_count > 0 {
            for bi in s.body_start..(s.body_start + s.body_count) {
                compile_stmt(ctx, out, hir, bi);
            };
        };
        wasm_br(out, 0); // continue loop
        wasm_end(out);   // end loop
        wasm_end(out);   // end block
        return;
    };
    if d == 0 {
        // Let — store init value to a temp local
        if s.init > 0 {
            compile_expr(ctx, out, hir, s.init);
            // Store to next available local slot
            let slot = ctx.temp_local + 1; // after temp
            wasm_local_set(out, slot);
            // Track in temp_local for now (single-let support)
            ctx.temp_local = slot;
        };
        return;
    };
    if d == 5 {
        // Break — branch to enclosing block
        wasm_br(out, 1);
        return;
    };
    if d == 6 {
        // Continue — branch to enclosing loop
        wasm_br(out, 0);
        return;
    };
    if d == 1 {
        // Expr statement
        if s.expr > 0 { compile_expr(ctx, out, hir, s.expr); };
        return;
    };
}

// ── Main compilation entry ──

fn compile_to_wasm(hir: HirProgram) -> Vec<i64> {
    let mut ctx = ctx_new();
    let num_funcs = hir.fns.len();
    ctx.func_count = num_funcs;

    // Import count
    let num_imports: i64 = 7;

    // ---- Build type section ----
    // Import types come first: 5 signatures
    // Type 0: (i64) -> ()    — println
    // Type 1: () -> i64      — read_file, Vec::new
    // Type 2: (i64) -> i64   — vec_len, str_len
    // Type 3: (i64,i64) -> () — vec_push
    // Type 4: (i64,i64) -> i64 — vec_get, write_bytes
    let mut types: Vec<i64> = Vec::new();
    leb128_u(5 + num_funcs, &mut types); // total type count

    // Type 0: (i64) -> ()
    types.push(96); leb128_u(1, &mut types); types.push(126); // params
    leb128_u(0, &mut types); // results

    // Type 1: () -> i64
    types.push(96); leb128_u(0, &mut types); // params
    leb128_u(1, &mut types); types.push(126); // results

    // Type 2: (i64) -> i64
    types.push(96); leb128_u(1, &mut types); types.push(126);
    leb128_u(1, &mut types); types.push(126);

    // Type 3: (i64,i64) -> ()
    types.push(96); leb128_u(2, &mut types); types.push(126); types.push(126);
    leb128_u(0, &mut types);

    // Type 4: (i64,i64) -> i64
    types.push(96); leb128_u(2, &mut types); types.push(126); types.push(126);
    leb128_u(1, &mut types); types.push(126);

    // Function types (type index 5+)
    for fi in 0..num_funcs {
        let f = hir.fns[fi];
        types.push(96);
        leb128_u(f.params.len(), &mut types);
        for pi in 0..f.params.len() { types.push(126); };
        leb128_u(1, &mut types); types.push(126); // 1 result: i64
    };
    let mut type_sec: Vec<i64> = Vec::new();
    for ti in 0..types.len() { type_sec.push(types[ti]); };

    // ---- Build import section ----
    let mut import_sec: Vec<i64> = Vec::new();
    leb128_u(num_imports, &mut import_sec);

    // Import 0: env.println (type 0)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(112);import_sec.push(114);import_sec.push(105);import_sec.push(110);import_sec.push(116);import_sec.push(108);import_sec.push(110);
    import_sec.push(0); leb128_u(0, &mut import_sec); // func, type 0

    // Import 1: env.vec_new (type 1)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(110);import_sec.push(101);import_sec.push(119);
    import_sec.push(0); leb128_u(1, &mut import_sec);

    // Import 2: env.vec_len (type 2)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(108);import_sec.push(101);import_sec.push(110);
    import_sec.push(0); leb128_u(2, &mut import_sec);

    // Import 3: env.vec_push (type 3)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(8);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(112);import_sec.push(117);import_sec.push(115);import_sec.push(104);
    import_sec.push(0); leb128_u(3, &mut import_sec);

    // Import 4: env.vec_get (type 4)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(103);import_sec.push(101);import_sec.push(116);
    import_sec.push(0); leb128_u(4, &mut import_sec);

    // Import 5: env.read_file (type 2 — same as vec_len: (i64)->i64)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(9);
    import_sec.push(114);import_sec.push(101);import_sec.push(97);import_sec.push(100);import_sec.push(95);import_sec.push(102);import_sec.push(105);import_sec.push(108);import_sec.push(101);
    import_sec.push(0); leb128_u(2, &mut import_sec);

    // Import 6: env.write_bytes (type 4 — same as vec_get: (i64,i64)->i64)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(11);
    import_sec.push(119);import_sec.push(114);import_sec.push(105);import_sec.push(116);import_sec.push(101);import_sec.push(95);import_sec.push(98);import_sec.push(121);import_sec.push(116);import_sec.push(101);import_sec.push(115);
    import_sec.push(0); leb128_u(4, &mut import_sec);

    // ---- Build function section ----
    let mut func_sec: Vec<i64> = Vec::new();
    leb128_u(num_funcs, &mut func_sec);
    for idx in 0..num_funcs { leb128_u(idx + 5, &mut func_sec); };

    // ---- Build global section ----
    let mut glob_sec: Vec<i64> = Vec::new();
    leb128_u(1, &mut glob_sec); // 1 global
    glob_sec.push(127); // type: i32
    glob_sec.push(1); // mutable: true
    // init: i32.const 4
    glob_sec.push(65); // i32.const
    leb128_s(4, &mut glob_sec);
    glob_sec.push(11); // end

    // ---- Build memory section ----
    let mut mem_sec: Vec<i64> = Vec::new();
    leb128_u(1, &mut mem_sec); // 1 memory
    mem_sec.push(0); // flags: no max
    leb128_u(1, &mut mem_sec); // min: 1 page (64KB)

    // ---- Build code section ----
    leb128_u(num_funcs, &mut ctx.code_out);
    for fi in 0..num_funcs {
        compile_fn_body(&mut ctx, hir, fi);
    };

    // ---- Build export section ----
    let mut export_sec: Vec<i64> = Vec::new();
    leb128_u(num_funcs, &mut export_sec);
    for fi in 0..num_funcs {
        let f = hir.fns[fi];
        // Export name — use char_to_ascii for full A-Z, a-z, 0-9, _ support
        leb128_u(f.name.len(), &mut export_sec);
        for ci in 0..f.name.len() {
            export_sec.push(char_to_ascii(f.name[ci]));
        };
        export_sec.push(0); // export kind: function
        leb128_u(fi + 7, &mut export_sec);
    };

    // ---- Assemble module ----
    // Magic header
    ctx.out.push(0); ctx.out.push(97); ctx.out.push(115); ctx.out.push(109);
    // Version
    ctx.out.push(1); ctx.out.push(0); ctx.out.push(0); ctx.out.push(0);

    // Type section (1)
    emit_section(&mut ctx.out, 1, type_sec);
    // Import section (2)
    emit_section(&mut ctx.out, 2, import_sec);
    // Function section (3)
    emit_section(&mut ctx.out, 3, func_sec);
    // Memory section (5)
    emit_section(&mut ctx.out, 5, mem_sec);
    // Global section (6)
    emit_section(&mut ctx.out, 6, glob_sec);
    // Export section (7)
    emit_section(&mut ctx.out, 7, export_sec);
    // Code section (10)
    emit_section(&mut ctx.out, 10, ctx.code_out);

    ctx.out
}
