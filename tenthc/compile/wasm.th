// Minimal WASM emitter — v0.3.3 idioms: for-in, `..` defaults, generic returns
// Compiles HirProgram to WASM binary bytes
// Output: Vec<i64> where each element is a byte (0-255)

// ── LEB128 encoding ──

fn leb128_u(value: i64, out: &mut Vec<i64>) {
    let mut v = value;
    loop {
        let mut byte = v % 128;
        v = v / 128;
        if v != 0 { byte = byte + 128; };
        out.push(byte);
        if v == 0 { break; };
    };
}

fn leb128_s(value: i64, out: &mut Vec<i64>) {
    let mut v = value;
    loop {
        let mut byte = v % 128;
        v = v / 128;
        if (v == 0) && (byte < 64) { out.push(byte); break; };
        if (v == -1) && (byte >= 64) { out.push(byte); break; };
        byte = byte + 128;
        out.push(byte);
    };
}

// ── Section helpers ──

fn emit_section(out: &mut Vec<i64>, section_id: i64, body: Vec<i64>) {
    out.push(section_id);
    leb128_u(body.len(), out);
    for i in 0..body.len() { out.push(body.get(i)); };
}

// ── WASM opcodes ──

fn wasm_unreachable(out: &mut Vec<i64>) { out.push(0); }
fn wasm_nop(out: &mut Vec<i64>) { out.push(1); }
fn wasm_end(out: &mut Vec<i64>) { out.push(11); }
fn wasm_return(out: &mut Vec<i64>) { out.push(15); }
fn wasm_local_get(out: &mut Vec<i64>, idx: i64) { out.push(32); leb128_u(idx, out); }
fn wasm_local_set(out: &mut Vec<i64>, idx: i64) { out.push(33); leb128_u(idx, out); }
fn wasm_i64_const(out: &mut Vec<i64>, val: i64) {
    out.push(66);
    leb128_s(val, out);
}
fn wasm_i64_add(out: &mut Vec<i64>) { out.push(124); }
fn wasm_i64_sub(out: &mut Vec<i64>) { out.push(125); }
fn wasm_i64_mul(out: &mut Vec<i64>) { out.push(126); }
fn wasm_i64_div_s(out: &mut Vec<i64>) { out.push(127); }
fn wasm_i64_rem_s(out: &mut Vec<i64>) { out.push(129); }
fn wasm_i64_and(out: &mut Vec<i64>) { out.push(113); }
fn wasm_i64_or(out: &mut Vec<i64>) { out.push(114); }
fn wasm_i64_eq(out: &mut Vec<i64>) { out.push(81); }
fn wasm_i64_ne(out: &mut Vec<i64>) { out.push(82); }
fn wasm_i64_lt_s(out: &mut Vec<i64>) { out.push(83); }
fn wasm_i64_gt_s(out: &mut Vec<i64>) { out.push(85); }
fn wasm_i64_le_s(out: &mut Vec<i64>) { out.push(87); }
fn wasm_i64_ge_s(out: &mut Vec<i64>) { out.push(89); }
fn wasm_call(out: &mut Vec<i64>, func_idx: i64) { out.push(16); leb128_u(func_idx, out); }
fn wasm_block(out: &mut Vec<i64>, blocktype: i64) { out.push(2); out.push(blocktype); }
fn wasm_loop(out: &mut Vec<i64>, blocktype: i64) { out.push(3); out.push(blocktype); }
fn wasm_if(out: &mut Vec<i64>, blocktype: i64) { out.push(4); out.push(blocktype); }
fn wasm_else(out: &mut Vec<i64>) { out.push(5); }
fn wasm_br(out: &mut Vec<i64>, idx: i64) { out.push(12); leb128_u(idx, out); }
fn wasm_br_if(out: &mut Vec<i64>, idx: i64) { out.push(13); leb128_u(idx, out); }
fn wasm_i32_eqz(out: &mut Vec<i64>) { out.push(69); }
fn wasm_i64_eqz(out: &mut Vec<i64>) { out.push(80); }
fn wasm_i32_wrap_i64(out: &mut Vec<i64>) { out.push(167); }
fn wasm_i32_const(out: &mut Vec<i64>, val: i64) { out.push(65); leb128_s(val, out); }
fn wasm_i32_add(out: &mut Vec<i64>) { out.push(106); }
fn wasm_i64_load(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(41); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i64_store(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(55); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i32_load(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(40); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i32_store(out: &mut Vec<i64>, align: i64, offset: i64) { out.push(54); leb128_u(align, out); leb128_u(offset, out); }
fn wasm_i64_extend_i32_u(out: &mut Vec<i64>) { out.push(173); }
fn wasm_drop(out: &mut Vec<i64>) { out.push(26); }
fn wasm_local_tee(out: &mut Vec<i64>, idx: i64) { out.push(34); leb128_u(idx, out); }
fn wasm_global_get(out: &mut Vec<i64>, idx: i64) { out.push(35); leb128_u(idx, out); }
fn wasm_global_set(out: &mut Vec<i64>, idx: i64) { out.push(36); leb128_u(idx, out); }

// ── f64 opcodes ──

fn wasm_f64_const(out: &mut Vec<i64>, val: f64) {
    out.push(68); // f64.const
    // 用 f64_bits 将 f64 转为 i64 位表示，然后按小端拆字节
    let bits = f64_bits(val);
    let mut i: i64 = 0;
    while i < 8 {
        out.push(bits % 256);
        bits = bits / 256;
        i = i + 1;
    };
}
fn wasm_f64_add(out: &mut Vec<i64>) { out.push(160); }
fn wasm_f64_sub(out: &mut Vec<i64>) { out.push(161); }
fn wasm_f64_mul(out: &mut Vec<i64>) { out.push(162); }
fn wasm_f64_div(out: &mut Vec<i64>) { out.push(163); }
fn wasm_f64_eq(out: &mut Vec<i64>) { out.push(99); }
fn wasm_f64_ne(out: &mut Vec<i64>) { out.push(100); }
fn wasm_f64_lt(out: &mut Vec<i64>) { out.push(101); }
fn wasm_f64_gt(out: &mut Vec<i64>) { out.push(102); }
fn wasm_f64_le(out: &mut Vec<i64>) { out.push(103); }
fn wasm_f64_ge(out: &mut Vec<i64>) { out.push(104); }

// ── Compiler state ──

struct WasmCtx {
    out: Vec<i64>,       // final output bytes
    code_out: Vec<i64>,  // code section body
    func_count: i64,     // number of functions
    temp_local: i64,     // index of temp local slot (for StructLiteral)
    local_names: Vec<str>,    // let 绑定的变量名
    local_indices: Vec<i64>,  // 对应的 local index
    local_count: i64,    // 当前函数的 let local 数量
    string_data: Vec<i64>,    // 字符串数据段（字节数组）
    string_names: Vec<str>,   // 已驻留的字符串内容
    string_addrs: Vec<i64>,   // 对应的内存偏移
    if_depth: i64,            // if-block depth within innermost loop (for break/continue)
    in_loop: i64,             // 1 if inside a loop, 0 otherwise
    current_fn_idx: i64,      // index of the function currently being compiled
}

fn ctx_new() -> WasmCtx {
    WasmCtx { out: Vec::new(), code_out: Vec::new(), func_count: 0, temp_local: 0, local_names: Vec::new(), local_indices: Vec::new(), local_count: 0, string_data: Vec::new(), string_names: Vec::new(), string_addrs: Vec::new(), if_depth: 0, in_loop: 0, current_fn_idx: 0 }
}

// ── String interning ──

fn intern_string(ctx: &mut WasmCtx, s: str) -> i64 {
    // 查找已驻留的字符串
    let mut i: i64 = 0;
    while i < ctx.string_names.len() {
        if ctx.string_names[i] == s {
            return ctx.string_addrs[i];
        };
        i = i + 1;
    };
    // 未命中：追加到 string_data，偏移 = string_data.len() + 4（跳过 bump pointer global）
    let addr = ctx.string_data.len() + 4;
    let mut j: i64 = 0;
    while j < s.len() {
        ctx.string_data.push(char_to_ascii(s[j]));
        j = j + 1;
    };
    ctx.string_data.push(0); // 终止符
    ctx.string_names.push(s);
    ctx.string_addrs.push(addr);
    addr
}

// ── Compile one function body ──

fn compile_fn_body(ctx: &mut WasmCtx, hir: HirProgram, fn_idx: i64) {
    let f = hir.fns[fn_idx];

    // Count locals (params + let bindings)
    let num_params = f.params.len();

    // 重置 local 信息（每个函数独立）
    ctx.local_names = Vec::new();
    ctx.local_indices = Vec::new();
    ctx.local_count = 0;
    ctx.temp_local = num_params; // temp_local 用于 StructLiteral 的临时槽
    ctx.if_depth = 0;
    ctx.in_loop = 0;
    ctx.current_fn_idx = fn_idx;

    // 先编译 body 到临时 Vec（不含 local 声明）
    let mut body_code: Vec<i64> = Vec::new();
    compile_expr(ctx, &mut body_code, hir, f.body);
    wasm_end(&mut body_code);

    // 构建 local 声明：local_count 个 let local + 1 个 temp local
    let total_locals = ctx.local_count + 1;
    let mut body: Vec<i64> = Vec::new();
    leb128_u(1, &mut body); // 1 group
    leb128_u(total_locals, &mut body);
    body.push(126); // i64

    // 拼接 body_code
    for i in 0..body_code.len() { body.push(body_code[i]); };

    // Emit function body size + body
    leb128_u(body.len(), &mut ctx.code_out);
    for i in 0..body.len() { ctx.code_out.push(body[i]); };
}

// ── Struct offset lookup ──

fn type_struct_name(hir: HirProgram, ty_idx: i64) -> str {
    if ty_idx <= 0 || ty_idx > hir.type_nodes.len() { return ""; };
    let t = hir.type_nodes[ty_idx - 1];
    if t.disc == 4 || t.disc == 8 { return t.name; }; // TypeParam or Struct
    ""
}

fn struct_field_offset(hir: HirProgram, struct_name: str, field_name: str) -> i64 {
    for si in 0..hir.structs.len() {
        let sd = hir.structs[si];
        if sd.name == struct_name {
            let mut offset: i64 = 0;
            for fi in 0..sd.fields.len() {
                if sd.fields[fi].name == field_name { return offset; };
                offset = offset + 8; // each i64 field is 8 bytes
            };
            return offset; // field not found, return end offset
        };
    };
    0
}

// ── ASCII encoding helper ──

fn char_to_ascii(ch: str) -> i64 {
    // 大写字母 A-Z
    if ch == "A" { return 65; }
    if ch == "B" { return 66; }
    if ch == "C" { return 67; }
    if ch == "D" { return 68; }
    if ch == "E" { return 69; }
    if ch == "F" { return 70; }
    if ch == "G" { return 71; }
    if ch == "H" { return 72; }
    if ch == "I" { return 73; }
    if ch == "J" { return 74; }
    if ch == "K" { return 75; }
    if ch == "L" { return 76; }
    if ch == "M" { return 77; }
    if ch == "N" { return 78; }
    if ch == "O" { return 79; }
    if ch == "P" { return 80; }
    if ch == "Q" { return 81; }
    if ch == "R" { return 82; }
    if ch == "S" { return 83; }
    if ch == "T" { return 84; }
    if ch == "U" { return 85; }
    if ch == "V" { return 86; }
    if ch == "W" { return 87; }
    if ch == "X" { return 88; }
    if ch == "Y" { return 89; }
    if ch == "Z" { return 90; }
    // 小写字母 a-z
    if ch == "a" { return 97; }
    if ch == "b" { return 98; }
    if ch == "c" { return 99; }
    if ch == "d" { return 100; }
    if ch == "e" { return 101; }
    if ch == "f" { return 102; }
    if ch == "g" { return 103; }
    if ch == "h" { return 104; }
    if ch == "i" { return 105; }
    if ch == "j" { return 106; }
    if ch == "k" { return 107; }
    if ch == "l" { return 108; }
    if ch == "m" { return 109; }
    if ch == "n" { return 110; }
    if ch == "o" { return 111; }
    if ch == "p" { return 112; }
    if ch == "q" { return 113; }
    if ch == "r" { return 114; }
    if ch == "s" { return 115; }
    if ch == "t" { return 116; }
    if ch == "u" { return 117; }
    if ch == "v" { return 118; }
    if ch == "w" { return 119; }
    if ch == "x" { return 120; }
    if ch == "y" { return 121; }
    if ch == "z" { return 122; }
    // 数字 0-9
    if ch == "0" { return 48; }
    if ch == "1" { return 49; }
    if ch == "2" { return 50; }
    if ch == "3" { return 51; }
    if ch == "4" { return 52; }
    if ch == "5" { return 53; }
    if ch == "6" { return 54; }
    if ch == "7" { return 55; }
    if ch == "8" { return 56; }
    if ch == "9" { return 57; }
    // 特殊字符
    if ch == "_" { return 95; }
    if ch == ":" { return 58; }
    if ch == "!" { return 33; }
    if ch == "?" { return 63; }
    if ch == "." { return 46; }
    if ch == "-" { return 45; }
    63 // 默认 '?' for unknown chars
}

// 将字符串的 ASCII 字节推入 Vec
fn push_str_bytes(out: &mut Vec<i64>, s: str) {
    let mut i: i64 = 0;
    while i < s.len() {
        out.push(char_to_ascii(s[i]));
        i = i + 1;
    };
}

// ── Type helper: 判断表达式是否为 f64 类型 ──

fn is_expr_float(hir: HirProgram, idx: i64) -> bool {
    if idx <= 0 || idx > hir.expr_nodes.len() { return false; };
    let e = hir.expr_nodes[idx - 1];
    // FloatLiteral 直接是 f64
    if e.disc == 1 { return true; };
    // 检查 ty 字段：查 type_nodes 的 sub == 2 表示 f64
    if e.ty > 0 && e.ty <= hir.type_nodes.len() {
        if hir.type_nodes[e.ty - 1].sub == 2 { return true; };
    };
    // Binary 表达式：递归检查左操作数
    if e.disc == 5 { return is_expr_float(hir, e.left); };
    false
}

// Check if an expression's inferred type is str (sub == 5)
fn is_expr_str(hir: HirProgram, idx: i64) -> bool {
    if idx <= 0 || idx > hir.expr_nodes.len() { return false; };
    let e = hir.expr_nodes[idx - 1];
    // StringLiteral 直接是 str
    if e.disc == 3 { return true; };
    // 检查 ty 字段：查 type_nodes 的 sub == 5 表示 str
    if e.ty > 0 && e.ty <= hir.type_nodes.len() {
        if hir.type_nodes[e.ty - 1].sub == 5 { return true; };
    };
    false
}

fn compile_expr(ctx: &mut WasmCtx, out: &mut Vec<i64>, hir: HirProgram, idx: i64) {
    if idx <= 0 || idx > hir.expr_nodes.len() { return; };
    let e = hir.expr_nodes[idx - 1];
    let d = e.disc;

    if d == 0 {
        // IntLiteral
        wasm_i64_const(out, e.lit_ival);
        return;
    };
    if d == 1 {
        // FloatLiteral
        wasm_f64_const(out, e.lit_fval);
        return;
    };
    if d == 2 {
        // BoolLiteral — true=1, false=0 (as i64)
        if e.lit_bval { wasm_i64_const(out, 1); } else { wasm_i64_const(out, 0); };
        return;
    };
    if d == 3 {
        // StringLiteral — 驻留字符串，返回内存偏移作为 i32
        let addr = intern_string(ctx, e.lit_sval);
        wasm_i32_const(out, addr);
        return;
    };
    if d == 4 {
        // Var — 先查 let 绑定的 local（倒序，支持 shadowing），再查 current fn params
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        // Search let bindings first (backward for shadowing)
        let mut li: i64 = ctx.local_names.len() - 1;
        while li >= 0 {
            if ctx.local_names[li] == name {
                local_idx = ctx.local_indices[li];
                found = true;
                break;
            };
            li = li - 1;
        };
        // Fall back to current function's params
        if !found {
            let func = hir.fns[ctx.current_fn_idx];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
        };
        wasm_local_get(out, local_idx);
        return;
    };
    if d == 5 {
        // Binary — 根据操作数类型选 i64 / f64 / str 操作码
        let op = e.op;
        // 字符串拼接：str + str → 调用 str_add (import 7)
        if op == "+" && (is_expr_str(hir, e.left) || is_expr_str(hir, e.right)) {
            compile_expr(ctx, out, hir, e.left);
            compile_expr(ctx, out, hir, e.right);
            wasm_call(out, 7);
            return;
        };
        compile_expr(ctx, out, hir, e.left);
        compile_expr(ctx, out, hir, e.right);
        // 启发式：检查左操作数类型（后续 A11 类型推断会改进）
        let is_float = is_expr_float(hir, e.left);
        if is_float {
            if op == "+" { wasm_f64_add(out); return; };
            if op == "-" { wasm_f64_sub(out); return; };
            if op == "*" { wasm_f64_mul(out); return; };
            if op == "/" { wasm_f64_div(out); return; };
            if op == "==" { wasm_f64_eq(out); return; };
            if op == "!=" { wasm_f64_ne(out); return; };
            if op == "<" { wasm_f64_lt(out); return; };
            if op == ">" { wasm_f64_gt(out); return; };
            if op == "<=" { wasm_f64_le(out); return; };
            if op == ">=" { wasm_f64_ge(out); return; };
            return;
        };
        if op == "+" { wasm_i64_add(out); return; };
        if op == "-" { wasm_i64_sub(out); return; };
        if op == "*" { wasm_i64_mul(out); return; };
        if op == "/" { wasm_i64_div_s(out); return; };
        if op == "%" { wasm_i64_rem_s(out); return; };
        if op == "&&" { wasm_i64_and(out); return; };
        if op == "||" { wasm_i64_or(out); return; };
        if op == "==" { wasm_i64_eq(out); return; };
        if op == "!=" { wasm_i64_ne(out); return; };
        if op == "<" { wasm_i64_lt_s(out); return; };
        if op == ">" { wasm_i64_gt_s(out); return; };
        if op == "<=" { wasm_i64_le_s(out); return; };
        if op == ">=" { wasm_i64_ge_s(out); return; };
        return;
    };
    if d == 6 {
        // Unary
        let op = e.op;
        if op == "-" {
            // Negation: 0 - n. Push 0 FIRST, then inner, then sub.
            // WASM i64.sub pops b then a, computes a - b.
            // Stack: [0, n] → 0 - n = -n
            wasm_i64_const(out, 0);
            compile_expr(ctx, out, hir, e.left);
            wasm_i64_sub(out);
        } else {
            // ! or other: eqz
            compile_expr(ctx, out, hir, e.left);
            wasm_i64_eqz(out);
        };
        return;
    };
    if d == 14 {
        // Assign — target is a variable name, value is compiled
        compile_expr(ctx, out, hir, e.right);
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        // Search let bindings first (backward for shadowing)
        let mut li: i64 = ctx.local_names.len() - 1;
        while li >= 0 {
            if ctx.local_names[li] == name {
                local_idx = ctx.local_indices[li];
                found = true;
                break;
            };
            li = li - 1;
        };
        // Fall back to current function's params
        if !found {
            let func = hir.fns[ctx.current_fn_idx];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
        };
        wasm_local_set(out, local_idx);
        return;
    };
    if d == 15 {
        // StructLiteral — allocate using global bump pointer, then write fields
        // Note: all locals are i64, so temp stores the pointer as i64
        let sname = e.name;
        let mut size: i64 = 0;
        for si in 0..hir.structs.len() {
            if hir.structs[si].name == sname {
                size = hir.structs[si].fields.len() * 8;
                break;
            };
        };
        // global.get $bump (i32) → i64.extend_i32_u → local.tee $temp (i64)
        wasm_global_get(out, 0);
        wasm_i64_extend_i32_u(out);
        let temp_idx = ctx.temp_local;
        wasm_local_tee(out, temp_idx);
        // i32.const size → i64.extend_i32_u → i64.add → i32.wrap_i64 → global.set $bump
        wasm_i32_const(out, size);
        wasm_i64_extend_i32_u(out);
        wasm_i64_add(out);
        wasm_i32_wrap_i64(out);
        wasm_global_set(out, 0);
        // Write each field value at offset = field_index * 8
        // args_start..args_start+args_count contains field values in struct definition order
        if e.args_count > 0 {
            let mut fi: i64 = 0;
            while fi < e.args_count {
                // address: local.get $temp (i64) → i32.wrap_i64
                wasm_local_get(out, temp_idx);
                wasm_i32_wrap_i64(out);
                // value: compile field expression (i64)
                compile_expr(ctx, out, hir, hir.arg_list[e.args_start + fi - 1]);
                // i64.store at offset fi*8
                wasm_i64_store(out, 3, fi * 8);
                fi = fi + 1;
            };
        };
        // Return allocated address as i64 (already i64 in temp)
        wasm_local_get(out, temp_idx);
        return;
    };
    if d == 16 {
        // EnumLiteral — allocate using global bump pointer, write tuple fields
        // Note: all locals are i64, so temp stores the pointer as i64
        let ename = e.name;
        let vname = e.variant;
        // Determine size from enum variant definition
        let mut size: i64 = 8; // default: at least 8 bytes
        for ei in 0..hir.enums.len() {
            if hir.enums[ei].name == ename {
                for vi in 0..hir.enums[ei].variants.len() {
                    if hir.enums[ei].variants[vi].name == vname {
                        let nf = hir.enums[ei].variants[vi].fields.len();
                        if nf > 0 { size = nf * 8; };
                        break;
                    };
                };
                break;
            };
        };
        // global.get $bump (i32) → i64.extend_i32_u → local.tee $temp (i64)
        wasm_global_get(out, 0);
        wasm_i64_extend_i32_u(out);
        let temp_idx = ctx.temp_local;
        wasm_local_tee(out, temp_idx);
        // i32.const size → i64.extend_i32_u → i64.add → i32.wrap_i64 → global.set $bump
        wasm_i32_const(out, size);
        wasm_i64_extend_i32_u(out);
        wasm_i64_add(out);
        wasm_i32_wrap_i64(out);
        wasm_global_set(out, 0);
        // Write each tuple field value at offset = index * 8
        if e.args_count > 0 {
            let mut fi: i64 = 0;
            while fi < e.args_count {
                wasm_local_get(out, temp_idx);
                wasm_i32_wrap_i64(out);
                compile_expr(ctx, out, hir, hir.arg_list[e.args_start + fi - 1]);
                wasm_i64_store(out, 3, fi * 8);
                fi = fi + 1;
            };
        };
        // Return allocated address as i64 (already i64 in temp)
        wasm_local_get(out, temp_idx);
        return;
    };
    if d == 18 || d == 19 {
        // Ref / MutRef — pass through pointer
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    if d == 20 {
        // Deref — pass through (subsequent Field adds offset)
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    if d == 8 {
        // MethodCall — route Vec/String methods to imports
        let method = e.name;
        if e.left > 0 { compile_expr(ctx, out, hir, e.left); };
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
            };
        };
        if method == "len" {
            wasm_call(out, 2); // import 2: env.vec_len
            return;
        };
        if method == "push" {
            wasm_call(out, 3); // import 3: env.vec_push
            return;
        };
        if method == "get" {
            wasm_call(out, 4); // import 4: env.vec_get
            return;
        };
        // Unknown method: drop everything, return 0
        let mut dc = e.args_count;
        while dc > 0 { wasm_drop(out); dc = dc - 1; };
        wasm_drop(out);
        wasm_i64_const(out, 0);
        return;
    };
    if d == 9 {
        // Index — s[i] or v[i]
        // For Vec: compile target (vec_id as i64), compile index (i64), call vec_get (import 4)
        // For str: compile target (str_ptr as i32), compile index (i64), call str_at (import 13)
        // Heuristic: if target is StringLiteral or has str type, use str_at; else vec_get
        let target_is_str = is_expr_str(hir, e.left);
        compile_expr(ctx, out, hir, e.left);
        compile_expr(ctx, out, hir, e.right);
        if target_is_str {
            // str_at(str_ptr: i32, idx: i64) -> i32
            // target is i32 on stack (from StringLiteral), index is i64
            wasm_call(out, 13);
            wasm_i64_extend_i32_u(out); // promote i32 result to i64
        } else {
            // vec_get(vec_id: i64, idx: i64) -> i64
            wasm_call(out, 4);
        };
        return;
    };
    if d == 10 {
        // Field access
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        let sname = type_struct_name(hir, e.ty);
        let offset = struct_field_offset(hir, sname, e.name);
        wasm_i32_const(out, offset);
        wasm_i32_add(out);
        wasm_i64_load(out, 3, 0);
        return;
    };
    if d == 11 {
        // FieldAssign
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        let sname = type_struct_name(hir, e.ty);
        let offset = struct_field_offset(hir, sname, e.name);
        wasm_i32_const(out, offset);
        wasm_i32_add(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 12 {
        // If — block type determined by e.ty (set in lower.th):
        // ty > 0 means branches produce values → i64 (0x7E=126)
        // ty == 0 means branches don't produce values → void (0x40=64)
        compile_expr(ctx, out, hir, e.cond);
        let mut bt: i64 = 64;
        if e.alt > 0 && e.ty > 0 {
            bt = 126;
        };
        wasm_if(out, bt);
        // Track if depth inside loops so break/continue emit correct br depth
        if ctx.in_loop == 1 {
            ctx.if_depth = ctx.if_depth + 1;
        };
        compile_expr(ctx, out, hir, e.body);
        if e.alt > 0 {
            wasm_else(out);
            compile_expr(ctx, out, hir, e.alt);
        };
        wasm_end(out);
        if ctx.in_loop == 1 {
            ctx.if_depth = ctx.if_depth - 1;
        };
        return;
    };
    if d == 13 {
        // Block — compile statements, then final expr
        if e.stmts_count > 0 {
            for s in e.stmts_start..(e.stmts_start + e.stmts_count) {
                compile_stmt(ctx, out, hir, hir.stmt_list[s - 1]);
            };
        };
        return;
    };
    if d == 21 {
        // Return
        if e.left > 0 { compile_expr(ctx, out, hir, e.left); }
        else { wasm_i64_const(out, 0); };
        wasm_return(out);
        return;
    };
    if d == 7 {
        // Call — route to import or local function
        let func_name = hir.expr_nodes[e.left - 1].name;
        if func_name == "println" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 0); // import 0: env.println
            return;
        };
        if func_name == "Vec::new" || func_name == "HashMap::new" {
            wasm_call(out, 1); // import 1: env.vec_new
            return;
        };
        if func_name == "read_file" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 5); // import 5: env.read_file
            return;
        };
        if func_name == "write_bytes" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 6); // import 6: env.write_bytes
            return;
        };
        if func_name == "str_add" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 7); // import 7: env.str_add
            return;
        };
        if func_name == "str_eq" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 8); // import 8: env.str_eq
            return;
        };
        if func_name == "str_int" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 9); // import 9: env.str_int
            return;
        };
        if func_name == "tenth_alloc" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 10); // import 10: env.tenth_alloc
            return;
        };
        if func_name == "compile_host" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 11); // import 11: env.compile_host
            return;
        };
        if func_name == "str_len" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 12); // import 12: env.str_len
            return;
        };
        if func_name == "str_at" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 13); // import 13: env.str_at
            return;
        };
        if func_name == "str_cmp" {
            if e.args_count > 0 {
                for ai in e.args_start..(e.args_start + e.args_count) {
                    compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                };
            };
            wasm_call(out, 14); // import 14: env.str_cmp
            return;
        };
        // Regular function call (indices offset by 15 imports)
        let mut call_idx: i64 = 15;
        for fi in 0..hir.fns.len() {
            if hir.fns[fi].name == func_name { call_idx = 15 + fi; break; };
        };
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
            };
        };
        wasm_call(out, call_idx);
        return;
    };
    if d == 22 {
        // ArrayLiteral — compile elements and drop, return 0
        if e.args_count > 0 {
            for ai in e.args_start..(e.args_start + e.args_count) {
                compile_expr(ctx, out, hir, hir.arg_list[ai - 1]);
                wasm_drop(out);
            };
        };
        wasm_i64_const(out, 0);
        return;
    };
    if d == 17 {
        // Match — scrutinee in e.left, arms in match_arms[stmts_start..stmts_start+stmts_count]
        let scrut_idx = e.left;
        // Allocate temp local for scrutinee
        let scrut_local = ctx.temp_local + 1 + ctx.local_count;
        ctx.local_count = ctx.local_count + 1;
        compile_expr(ctx, out, hir, scrut_idx);
        wasm_local_set(out, scrut_local);
        // Outer block (result type i64 = blocktype 0x7e)
        wasm_block(out, 126);
        let arms_start = e.stmts_start;
        let arms_count = e.stmts_count;
        let mut ai = 0;
        while ai < arms_count {
            let arm_idx = arms_start + ai;
            if arm_idx > 0 && arm_idx <= hir.match_arms.len() {
                let arm = hir.match_arms[arm_idx - 1];
                if arm.pat_disc == 1 {
                    // Wildcard — compile body, br to outer
                    compile_expr(ctx, out, hir, arm.body_expr);
                    wasm_br(out, 0);
                } else {
                    // Literal/variant — inner block, br_if to skip if NOT equal
                    wasm_block(out, 64);
                    wasm_local_get(out, scrut_local);
                    // Parse variant name as i64 literal
                    let vname = arm.pat_variant;
                    let mut variant_val: i64 = 0;
                    let mut parsed = false;
                    let mut vi = 0;
                    let vlen = vname.len();
                    let mut neg = false;
                    if vlen > 0 && vname[0] == "-" { neg = true; vi = 1; };
                    let mut val: i64 = 0;
                    let mut ok = true;
                    while vi < vlen {
                        let c = vname[vi];
                        if c == "0" { val = val * 10; }
                        else if c == "1" { val = val * 10 + 1; }
                        else if c == "2" { val = val * 10 + 2; }
                        else if c == "3" { val = val * 10 + 3; }
                        else if c == "4" { val = val * 10 + 4; }
                        else if c == "5" { val = val * 10 + 5; }
                        else if c == "6" { val = val * 10 + 6; }
                        else if c == "7" { val = val * 10 + 7; }
                        else if c == "8" { val = val * 10 + 8; }
                        else if c == "9" { val = val * 10 + 9; }
                        else { ok = false; break; };
                        vi = vi + 1;
                    };
                    if ok && vi > (if neg { 1 } else { 0 }) {
                        if neg { val = -val; };
                        variant_val = val;
                        parsed = true;
                    };
                    if parsed {
                        wasm_i64_const(out, variant_val);
                        wasm_i64_eq(out);
                        wasm_i32_eqz(out); // invert: i64.eq returns i32, use i32.eqz; br_if skips body if NOT equal
                        wasm_br_if(out, 0); // skip inner block if not matching
                        compile_expr(ctx, out, hir, arm.body_expr);
                        wasm_br(out, 1); // jump to outer block end with result
                    };
                    wasm_end(out); // end inner block
                };
            };
            ai = ai + 1;
        };
        // No arm matched — push default 0
        wasm_i64_const(out, 0);
        wasm_end(out); // end outer block
        return;
    };
    if d == 23 {
        // Closure — not representable in WASM, push 0 placeholder
        wasm_i64_const(out, 0);
        return;
    };
    if d == 24 {
        // AssignOp (x += y) — load current value, compile rhs, apply op, store
        let name = e.name;
        let mut local_idx: i64 = 0;
        let mut found: bool = false;
        // Search let bindings first (backward for shadowing)
        let mut li: i64 = ctx.local_names.len() - 1;
        while li >= 0 {
            if ctx.local_names[li] == name {
                local_idx = ctx.local_indices[li];
                found = true;
                break;
            };
            li = li - 1;
        };
        // Fall back to current function's params
        if !found {
            let func = hir.fns[ctx.current_fn_idx];
            for pi in 0..func.params.len() {
                if func.params[pi].name == name {
                    local_idx = pi;
                    found = true;
                    break;
                };
            };
        };
        // local.get → compile rhs → apply op → local.set
        wasm_local_get(out, local_idx);
        compile_expr(ctx, out, hir, e.right);
        let op = e.op;
        if op == "+" { wasm_i64_add(out); }
        else if op == "-" { wasm_i64_sub(out); }
        else if op == "*" { wasm_i64_mul(out); }
        else if op == "/" { wasm_i64_div_s(out); };
        wasm_local_set(out, local_idx);
        return;
    };
    if d == 26 {
        // DerefAssign — compile target address, compile value, i64.store (same as disc 11)
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 27 {
        // DerefAssignOp (*p += y) — load current value via i64.load, compile rhs, apply op, i64.store
        compile_expr(ctx, out, hir, e.left);
        wasm_i32_wrap_i64(out);
        // Duplicate address for later store (use a temp local)
        let addr_local = ctx.temp_local + 1 + ctx.local_count;
        ctx.local_count = ctx.local_count + 1;
        wasm_local_set(out, addr_local);
        wasm_local_get(out, addr_local);
        wasm_i64_load(out, 3, 0);
        compile_expr(ctx, out, hir, e.right);
        let op = e.op;
        if op == "+" { wasm_i64_add(out); }
        else if op == "-" { wasm_i64_sub(out); }
        else if op == "*" { wasm_i64_mul(out); }
        else if op == "/" { wasm_i64_div_s(out); };
        wasm_local_get(out, addr_local);
        wasm_i64_store(out, 3, 0);
        return;
    };
    if d == 29 {
        // TensorLiteral — not representable in WASM, push 0
        wasm_i64_const(out, 0);
        return;
    };
    if d == 30 {
        // Move — pass through (same as disc 18/19/20)
        compile_expr(ctx, out, hir, e.left);
        return;
    };
    if d == 31 {
        // Slice s[a..b] — placeholder: compile target+start+end (for side effects), return 0
        // TODO: needs host str_slice import for proper implementation
        compile_expr(ctx, out, hir, e.left);
        wasm_drop(out);
        compile_expr(ctx, out, hir, e.right);
        wasm_drop(out);
        compile_expr(ctx, out, hir, e.extra_start);
        wasm_drop(out);
        wasm_i32_const(out, 0); // empty string pointer
        return;
    };
    // Default: unreachable
    wasm_unreachable(out);
}

fn compile_stmt(ctx: &mut WasmCtx, out: &mut Vec<i64>, hir: HirProgram, idx: i64) {
    if idx <= 0 || idx > hir.stmt_nodes.len() { return; };
    let s = hir.stmt_nodes[idx - 1];
    let d = s.disc;

    if d == 2 {
        // Return
        if s.expr > 0 { compile_expr(ctx, out, hir, s.expr); }
        else { wasm_i64_const(out, 0); };
        wasm_return(out);
        return;
    };
    if d == 3 {
        // While — WASM: block $break { loop $continue { cond; i32.eqz; br_if $break; body; br $continue; } }
        wasm_block(out, 64);
        wasm_loop(out, 64);
        let saved_if_depth = ctx.if_depth;
        let saved_in_loop = ctx.in_loop;
        ctx.if_depth = 0;
        ctx.in_loop = 1;
        if s.cond > 0 {
            compile_expr(ctx, out, hir, s.cond);
            wasm_i32_eqz(out);
            wasm_br_if(out, 1); // break to block (label idx 1 = outer block)
        };
        if s.body_count > 0 {
            for bi in s.body_start..(s.body_start + s.body_count) {
                compile_stmt(ctx, out, hir, hir.body_list[bi - 1]);
            };
        };
        wasm_br(out, 0); // continue loop
        wasm_end(out);   // end loop
        wasm_end(out);   // end block
        ctx.if_depth = saved_if_depth;
        ctx.in_loop = saved_in_loop;
        return;
    };
    if d == 7 {
        // Loop — WASM: block $break { loop $continue { body; br $continue; } }
        wasm_block(out, 64);
        wasm_loop(out, 64);
        let saved_if_depth = ctx.if_depth;
        let saved_in_loop = ctx.in_loop;
        ctx.if_depth = 0;
        ctx.in_loop = 1;
        if s.body_count > 0 {
            for bi in s.body_start..(s.body_start + s.body_count) {
                compile_stmt(ctx, out, hir, hir.body_list[bi - 1]);
            };
        };
        wasm_br(out, 0); // continue loop
        wasm_end(out);   // end loop
        wasm_end(out);   // end block
        ctx.if_depth = saved_if_depth;
        ctx.in_loop = saved_in_loop;
        return;
    };
    if d == 4 {
        // For — for name in iterable { body }
        // Currently supports Range (disc 28): for i in start..end
        let iter_idx = s.expr;
        if iter_idx > 0 && iter_idx <= hir.expr_nodes.len() {
            let iter = hir.expr_nodes[iter_idx - 1];
            if iter.disc == 28 {
                // Range: allocate locals for loop var ($i) and end ($end)
                let slot_i = ctx.temp_local + 1 + ctx.local_count;
                let slot_end = ctx.temp_local + 1 + ctx.local_count + 1;
                ctx.local_count = ctx.local_count + 2;
                ctx.local_names.push(s.name);
                ctx.local_indices.push(slot_i);

                // Compile start → local.set $i
                compile_expr(ctx, out, hir, iter.left);
                wasm_local_set(out, slot_i);
                // Compile end → local.set $end
                compile_expr(ctx, out, hir, iter.right);
                wasm_local_set(out, slot_end);

                // block { loop { cond; br_if 1; body; i++; br 0; } }
                wasm_block(out, 64);
                wasm_loop(out, 64);
                let saved_if_depth = ctx.if_depth;
                let saved_in_loop = ctx.in_loop;
                ctx.if_depth = 0;
                ctx.in_loop = 1;
                // cond: i < end (or i <= end for inclusive)
                wasm_local_get(out, slot_i);
                wasm_local_get(out, slot_end);
                if iter.range_inclusive {
                    wasm_i64_le_s(out);
                } else {
                    wasm_i64_lt_s(out);
                };
                wasm_i32_eqz(out);
                wasm_br_if(out, 1); // break if !(cond)
                // body
                if s.body_count > 0 {
                    for bi in s.body_start..(s.body_start + s.body_count) {
                        compile_stmt(ctx, out, hir, hir.body_list[bi - 1]);
                    };
                };
                // i += 1
                wasm_local_get(out, slot_i);
                wasm_i64_const(out, 1);
                wasm_i64_add(out);
                wasm_local_set(out, slot_i);
                wasm_br(out, 0); // continue loop
                wasm_end(out);   // end loop
                wasm_end(out);   // end block
                ctx.if_depth = saved_if_depth;
                ctx.in_loop = saved_in_loop;
                return;
            };
        };
        // Non-range iterable: no-op for now
        return;
    };
    if d == 0 {
        // Let — 分配新 local 并记录变量名
        if s.init > 0 {
            compile_expr(ctx, out, hir, s.init);
            // 分配新 local: params + temp(1) + local_count
            let slot = ctx.temp_local + 1 + ctx.local_count;
            wasm_local_set(out, slot);
            ctx.local_count = ctx.local_count + 1;
            ctx.local_names.push(s.name);
            ctx.local_indices.push(slot);
        };
        return;
    };
    if d == 5 {
        // Break — branch to enclosing loop's block
        // depth = 1 (loop's block) + number of intervening if blocks
        wasm_br(out, 1 + ctx.if_depth);
        return;
    };
    if d == 6 {
        // Continue — branch to enclosing loop's loop start
        // depth = number of intervening if blocks
        wasm_br(out, ctx.if_depth);
        return;
    };
    if d == 1 {
        // Expr statement
        if s.expr > 0 { compile_expr(ctx, out, hir, s.expr); };
        return;
    };
}

// ── Main compilation entry ──

fn compile_to_wasm(hir: HirProgram) -> Vec<i64> {
    let mut ctx = ctx_new();
    let num_funcs = hir.fns.len();
    ctx.func_count = num_funcs;

    // Import count
    let num_imports: i64 = 15;

    // ---- Build type section ----
    // Import types come first: 10 signatures
    // Type 0: (i64) -> ()    — println
    // Type 1: () -> i64      — vec_new
    // Type 2: (i64) -> i64   — vec_len, read_file
    // Type 3: (i64,i64) -> () — vec_push
    // Type 4: (i64,i64) -> i64 — vec_get, write_bytes
    // Type 5: (i32,i32) -> i32 — str_add, str_eq, compile_host
    // Type 6: (i64) -> i32    — str_int
    // Type 7: (i32) -> i32    — tenth_alloc, str_len
    // Type 8: (i32,i64) -> i32 — str_at
    // Type 9: (i32,i32,i32) -> i32 — str_cmp
    let mut types: Vec<i64> = Vec::new();
    leb128_u(10 + num_funcs, &mut types); // total type count

    // Type 0: (i64) -> ()
    types.push(96); leb128_u(1, &mut types); types.push(126); // params
    leb128_u(0, &mut types); // results

    // Type 1: () -> i64
    types.push(96); leb128_u(0, &mut types); // params
    leb128_u(1, &mut types); types.push(126); // results

    // Type 2: (i64) -> i64
    types.push(96); leb128_u(1, &mut types); types.push(126);
    leb128_u(1, &mut types); types.push(126);

    // Type 3: (i64,i64) -> ()
    types.push(96); leb128_u(2, &mut types); types.push(126); types.push(126);
    leb128_u(0, &mut types);

    // Type 4: (i64,i64) -> i64
    types.push(96); leb128_u(2, &mut types); types.push(126); types.push(126);
    leb128_u(1, &mut types); types.push(126);

    // Type 5: (i32,i32) -> i32
    types.push(96); leb128_u(2, &mut types); types.push(127); types.push(127);
    leb128_u(1, &mut types); types.push(127);

    // Type 6: (i64) -> i32
    types.push(96); leb128_u(1, &mut types); types.push(126);
    leb128_u(1, &mut types); types.push(127);

    // Type 7: (i32) -> i32
    types.push(96); leb128_u(1, &mut types); types.push(127);
    leb128_u(1, &mut types); types.push(127);

    // Type 8: (i32,i64) -> i32
    types.push(96); leb128_u(2, &mut types); types.push(127); types.push(126);
    leb128_u(1, &mut types); types.push(127);

    // Type 9: (i32,i32,i32) -> i32
    types.push(96); leb128_u(3, &mut types); types.push(127); types.push(127); types.push(127);
    leb128_u(1, &mut types); types.push(127);

    // Function types (type index 10+)
    for fi in 0..num_funcs {
        let f = hir.fns[fi];
        types.push(96);
        leb128_u(f.params.len(), &mut types);
        for pi in 0..f.params.len() { types.push(126); };
        leb128_u(1, &mut types); types.push(126); // 1 result: i64
    };
    let mut type_sec: Vec<i64> = Vec::new();
    for ti in 0..types.len() { type_sec.push(types[ti]); };

    // ---- Build import section ----
    let mut import_sec: Vec<i64> = Vec::new();
    leb128_u(num_imports, &mut import_sec);

    // Import 0: env.println (type 0)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(112);import_sec.push(114);import_sec.push(105);import_sec.push(110);import_sec.push(116);import_sec.push(108);import_sec.push(110);
    import_sec.push(0); leb128_u(0, &mut import_sec); // func, type 0

    // Import 1: env.vec_new (type 1)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(110);import_sec.push(101);import_sec.push(119);
    import_sec.push(0); leb128_u(1, &mut import_sec);

    // Import 2: env.vec_len (type 2)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(108);import_sec.push(101);import_sec.push(110);
    import_sec.push(0); leb128_u(2, &mut import_sec);

    // Import 3: env.vec_push (type 3)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(8);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(112);import_sec.push(117);import_sec.push(115);import_sec.push(104);
    import_sec.push(0); leb128_u(3, &mut import_sec);

    // Import 4: env.vec_get (type 4)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(7);
    import_sec.push(118);import_sec.push(101);import_sec.push(99);import_sec.push(95);import_sec.push(103);import_sec.push(101);import_sec.push(116);
    import_sec.push(0); leb128_u(4, &mut import_sec);

    // Import 5: env.read_file (type 2 — same as vec_len: (i64)->i64)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(9);
    import_sec.push(114);import_sec.push(101);import_sec.push(97);import_sec.push(100);import_sec.push(95);import_sec.push(102);import_sec.push(105);import_sec.push(108);import_sec.push(101);
    import_sec.push(0); leb128_u(2, &mut import_sec);

    // Import 6: env.write_bytes (type 4 — same as vec_get: (i64,i64)->i64)
    import_sec.push(3); import_sec.push(101); import_sec.push(110); import_sec.push(118);
    import_sec.push(11);
    import_sec.push(119);import_sec.push(114);import_sec.push(105);import_sec.push(116);import_sec.push(101);import_sec.push(95);import_sec.push(98);import_sec.push(121);import_sec.push(116);import_sec.push(101);import_sec.push(115);
    import_sec.push(0); leb128_u(4, &mut import_sec);

    // Import 7: env.str_add (type 5: (i32,i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(7, &mut import_sec); push_str_bytes(&mut import_sec, "str_add");
    import_sec.push(0); leb128_u(5, &mut import_sec);

    // Import 8: env.str_eq (type 5: (i32,i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(6, &mut import_sec); push_str_bytes(&mut import_sec, "str_eq");
    import_sec.push(0); leb128_u(5, &mut import_sec);

    // Import 9: env.str_int (type 6: (i64)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(7, &mut import_sec); push_str_bytes(&mut import_sec, "str_int");
    import_sec.push(0); leb128_u(6, &mut import_sec);

    // Import 10: env.tenth_alloc (type 7: (i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(11, &mut import_sec); push_str_bytes(&mut import_sec, "tenth_alloc");
    import_sec.push(0); leb128_u(7, &mut import_sec);

    // Import 11: env.compile_host (type 5: (i32,i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(12, &mut import_sec); push_str_bytes(&mut import_sec, "compile_host");
    import_sec.push(0); leb128_u(5, &mut import_sec);

    // Import 12: env.str_len (type 7: (i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(7, &mut import_sec); push_str_bytes(&mut import_sec, "str_len");
    import_sec.push(0); leb128_u(7, &mut import_sec);

    // Import 13: env.str_at (type 8: (i32,i64)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(6, &mut import_sec); push_str_bytes(&mut import_sec, "str_at");
    import_sec.push(0); leb128_u(8, &mut import_sec);

    // Import 14: env.str_cmp (type 9: (i32,i32,i32)->i32)
    import_sec.push(3); push_str_bytes(&mut import_sec, "env");
    leb128_u(7, &mut import_sec); push_str_bytes(&mut import_sec, "str_cmp");
    import_sec.push(0); leb128_u(9, &mut import_sec);

    // ---- Build function section ----
    let mut func_sec: Vec<i64> = Vec::new();
    leb128_u(num_funcs, &mut func_sec);
    for idx in 0..num_funcs { leb128_u(idx + 10, &mut func_sec); };

    // ---- Build global section ----
    let mut glob_sec: Vec<i64> = Vec::new();
    leb128_u(1, &mut glob_sec); // 1 global
    glob_sec.push(127); // type: i32
    glob_sec.push(1); // mutable: true
    // init: i32.const 4
    glob_sec.push(65); // i32.const
    leb128_s(4, &mut glob_sec);
    glob_sec.push(11); // end

    // ---- Build memory section ----
    let mut mem_sec: Vec<i64> = Vec::new();
    leb128_u(1, &mut mem_sec); // 1 memory
    mem_sec.push(0); // flags: no max
    leb128_u(1, &mut mem_sec); // min: 1 page (64KB)

    // ---- Build code section ----
    leb128_u(num_funcs, &mut ctx.code_out);
    for fi in 0..num_funcs {
        compile_fn_body(&mut ctx, hir, fi);
    };

    // ---- Build export section ----
    let mut export_sec: Vec<i64> = Vec::new();
    leb128_u(num_funcs, &mut export_sec);
    for fi in 0..num_funcs {
        let f = hir.fns[fi];
        // Export name — use char_to_ascii for full A-Z, a-z, 0-9, _ support
        leb128_u(f.name.len(), &mut export_sec);
        for ci in 0..f.name.len() {
            export_sec.push(char_to_ascii(f.name[ci]));
        };
        export_sec.push(0); // export kind: function
        leb128_u(fi + 15, &mut export_sec);
    };

    // ---- Build data section (字符串驻留数据) ----
    let mut data_sec: Vec<i64> = Vec::new();
    if ctx.string_data.len() > 0 {
        leb128_u(1, &mut data_sec); // 1 data segment
        leb128_u(0, &mut data_sec); // memory index 0
        // init expr: i32.const 4 (跳过 bump pointer global)
        data_sec.push(65); // i32.const
        leb128_s(4, &mut data_sec);
        data_sec.push(11); // end
        // data bytes
        leb128_u(ctx.string_data.len(), &mut data_sec);
        for i in 0..ctx.string_data.len() {
            data_sec.push(ctx.string_data[i]);
        };
    };

    // ---- Assemble module ----
    // Magic header
    ctx.out.push(0); ctx.out.push(97); ctx.out.push(115); ctx.out.push(109);
    // Version
    ctx.out.push(1); ctx.out.push(0); ctx.out.push(0); ctx.out.push(0);

    // Type section (1)
    emit_section(&mut ctx.out, 1, type_sec);
    // Import section (2)
    emit_section(&mut ctx.out, 2, import_sec);
    // Function section (3)
    emit_section(&mut ctx.out, 3, func_sec);
    // Memory section (5)
    emit_section(&mut ctx.out, 5, mem_sec);
    // Global section (6)
    emit_section(&mut ctx.out, 6, glob_sec);
    // Export section (7)
    emit_section(&mut ctx.out, 7, export_sec);
    // Code section (10)
    emit_section(&mut ctx.out, 10, ctx.code_out);
    // Data section (11) — 仅当有字符串数据时
    if data_sec.len() > 0 {
        emit_section(&mut ctx.out, 11, data_sec);
    };

    ctx.out
}
