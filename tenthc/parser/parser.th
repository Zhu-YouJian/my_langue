// Self-hosting Parser — v0.3.1 recursive descent

struct Expr { kind: str, ival: i64, fval: f64, sval: str, left: i64, right: i64, arg_start: i64, arg_count: i64, extra_start: i64, extra_count: i64 }
struct Stmt { kind: str, name: str, expr_idx: i64, body_start: i64, body_count: i64, else_start: i64, else_count: i64 }
struct Param { name: str, type_ann: str }
struct StructField { name: str, type_ann: str }
struct EnumVariant { name: str, fields: Vec<StructField> }
struct FnDef { name: str, params: Vec<Param>, return_type: str, body_start: i64, body_count: i64 }
struct StructDef { name: str, fields: Vec<StructField> }
struct EnumDef { name: str, variants: Vec<EnumVariant> }
struct MatchArm { pat_kind: str, pat_name: str, pat_bind: str, body_expr: i64 }
struct Program { structs: Vec<StructDef>, enums: Vec<EnumDef>, fns: Vec<FnDef>, main_stmts_start: i64, main_stmts_count: i64, expr_nodes: Vec<Expr>, stmt_nodes: Vec<Stmt>, match_arms: Vec<MatchArm> }

struct Parser { tokens: Vec<Token>, pos: i64, expr_nodes: Vec<Expr>, stmt_nodes: Vec<Stmt>, match_arms: Vec<MatchArm> }

fn parser_new(tokens: Vec<Token>) -> Parser {
    Parser {
        tokens: tokens,
        pos: 0,
        expr_nodes: Vec::new(),
        stmt_nodes: Vec::new(),
        match_arms: Vec::new(),
    }
}

// ── Token access ──

fn parser_peek(p: &Parser) -> Token {
    if p.pos < p.tokens.len() { p.tokens[p.pos] }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 }, disc: 61, ival: 0, sval: "" } }
}

fn parser_at_eof(p: &Parser) -> bool {
    p.pos >= p.tokens.len()
}

fn parser_advance(p: &mut Parser) -> Token {
    if p.pos < p.tokens.len() { let t = p.tokens[p.pos]; p.pos = p.pos + 1; t }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 }, disc: 61, ival: 0, sval: "" } }
}

// ── Helper: add expr node, return index (1-based, 0 = nil) ──

fn add_expr(p: &mut Parser, kind: str) -> i64 {
    let e = Expr {
        kind: kind, ival: 0, fval: 0.0, sval: "",
        left: 0, right: 0, arg_start: 0, arg_count: 0,
        extra_start: 0, extra_count: 0,
    };
    p.expr_nodes.push(e);
    p.expr_nodes.len()
}

fn add_stmt(p: &mut Parser, kind: str) -> i64 {
    let s = Stmt {
        kind: kind, name: "", expr_idx: 0,
        body_start: 0, body_count: 0,
        else_start: 0, else_count: 0,
    };
    p.stmt_nodes.push(s);
    p.stmt_nodes.len()
}

// ── Expression parsing ──

fn parse_primary(p: &mut Parser) -> i64 {
    let tok = parser_advance(p);
    let d = tok.disc;

    // IntLiteral (0)
    if d == 0 {
        let n = tok.ival;
        let idx = add_expr(p, "int");
        p.expr_nodes[idx - 1].ival = n;
        return idx;
    };
    // FloatLiteral (1)
    if d == 1 {
        let idx = add_expr(p, "float");
        p.expr_nodes[idx - 1].fval = tok.ival;
        return idx;
    };
    // StringLiteral (2)
    if d == 2 {
        let idx = add_expr(p, "str");
        p.expr_nodes[idx - 1].sval = tok.sval;
        return idx;
    };
    // Identifier (3)
    if d == 3 {
        let idx = add_expr(p, "ident");
        p.expr_nodes[idx - 1].sval = tok.sval;
        return idx;
    };
    // True (22)
    if d == 22 {
        let idx = add_expr(p, "bool");
        p.expr_nodes[idx - 1].ival = 1;
        return idx;
    };
    // False (23)
    if d == 23 {
        let idx = add_expr(p, "bool");
        p.expr_nodes[idx - 1].ival = 0;
        return idx;
    };
    // Self_ (25)
    if d == 25 {
        let idx = add_expr(p, "ident");
        p.expr_nodes[idx - 1].sval = "self";
        return idx;
    };
    // LParen (47)
    if d == 47 {
        let expr_idx = parse_expr(p);
        parser_advance(p); // expect RParen
        return expr_idx;
    };
    // LBrace (49)
    if d == 49 { return parse_block_expr(p); };
    // If (7)
    if d == 7 { return parse_if_expr(p); };
    // Match (9)
    if d == 9 { return parse_match_expr(p); };
    // Ampersand (40)
    if d == 40 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "ref");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Star (28) — deref
    if d == 28 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "deref");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Minus (27)
    if d == 27 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "unary");
        p.expr_nodes[idx - 1].sval = "-";
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Not (39)
    if d == 39 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "unary");
        p.expr_nodes[idx - 1].sval = "!";
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Default
    let idx = add_expr(p, "int");
    p.expr_nodes[idx - 1].ival = 0;
    return idx;
}

fn parse_unary(p: &mut Parser) -> i64 {
    parse_primary(p)
}

fn parse_postfix(p: &mut Parser) -> i64 {
    let mut expr_idx = parse_unary(p);

    loop {
        let tok = parser_peek(p);
        let d = tok.disc;

        // LParen (47) — function call
        if d == 47 {
            parser_advance(p); // skip (
            let start = p.expr_nodes.len() + 1;
            let count = parse_arg_list(p);
            p.expr_nodes[expr_idx - 1].kind = "call";
            p.expr_nodes[expr_idx - 1].arg_start = start;
            p.expr_nodes[expr_idx - 1].arg_count = count;
        } else if d == 56 {
            // Dot (56) — field access
            parser_advance(p); // skip .
            let field_tok = parser_advance(p);
            let field_name = field_tok.sval;
            let idx = add_expr(p, "field");
            p.expr_nodes[idx - 1].left = expr_idx;
            p.expr_nodes[idx - 1].sval = field_name;
            expr_idx = idx;
        } else {
            break;
        };
    };

    expr_idx
}

fn parse_arg_list(p: &mut Parser) -> i64 {
    let mut count: i64 = 0;
    loop {
        let tok = parser_peek(p);
        let d = tok.disc;
        if d == 48 { break; };
        if d == 61 { break; };
        parse_expr(p);
        count = count + 1;
        let tok2 = parser_peek(p);
        if tok2.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip )
    count
}

fn binop_prec(op: str) -> i64 {
    if op == "*" || op == "/" || op == "%" { 5 }
    else if op == "+" || op == "-" { 4 }
    else if op == "<" || op == ">" || op == "<=" || op == ">=" { 3 }
    else if op == "==" || op == "!=" { 2 }
    else if op == "&&" { 1 }
    else if op == "||" { 0 }
    else { -1 }
}

fn token_to_binop_str(tok: Token) -> str {
    let d = tok.disc;
    if d == 26 { "+" }
    else if d == 27 { "-" }
    else if d == 28 { "*" }
    else if d == 29 { "/" }
    else if d == 30 { "%" }
    else if d == 31 { "==" }
    else if d == 32 { "!=" }
    else if d == 33 { "<" }
    else if d == 34 { ">" }
    else if d == 35 { "<=" }
    else if d == 36 { ">=" }
    else if d == 37 { "&&" }
    else if d == 38 { "||" }
    else { "" }
}

fn is_binop(tok: Token) -> bool {
    let d = tok.disc;
    d == 26 || d == 27 || d == 28 || d == 29 || d == 30 || d == 31 || d == 32 || d == 33 || d == 34 || d == 35 || d == 36 || d == 37 || d == 38
}

fn parse_binary(p: &mut Parser, min_prec: i64) -> i64 {
    let mut left = parse_postfix(p);

    loop {
        let tok = parser_peek(p);
        if !is_binop(tok) { break; };
        let op = token_to_binop_str(tok);
        let prec = binop_prec(op);
        if prec < min_prec { break; };

        parser_advance(p); // consume operator
        let right = parse_binary(p, prec + 1);

        let idx = add_expr(p, "binary");
        p.expr_nodes[idx - 1].sval = op;
        p.expr_nodes[idx - 1].left = left;
        p.expr_nodes[idx - 1].right = right;
        left = idx;
    };

    left
}

fn parse_expr(p: &mut Parser) -> i64 {
    // Check for assignment
    let tok = parser_peek(p);
    // Simple: just parse binary
    let expr = parse_binary(p, 0);

    // Check for =
    let tok2 = parser_peek(p);
    if tok2.disc == 42 {
        parser_advance(p);
        let rhs = parse_expr(p);
        let idx = add_expr(p, "assign");
        p.expr_nodes[idx - 1].left = expr;
        p.expr_nodes[idx - 1].right = rhs;
        idx
    } else { expr }
}

fn parse_block_expr(p: &mut Parser) -> i64 {
    let body_start = p.stmt_nodes.len() + 1;
    let mut count: i64 = 0;
    loop {
        let tok = parser_peek(p);
        let d = tok.disc;
        if d == 50 { break; };
        if d == 61 { break; };
        parse_stmt(p);
        count = count + 1;
    };
    parser_advance(p); // skip }
    let idx = add_expr(p, "block");
    p.expr_nodes[idx - 1].extra_start = body_start;
    p.expr_nodes[idx - 1].extra_count = count;
    idx
}

fn parse_if_expr(p: &mut Parser) -> i64 {
    // if cond then-expr [else else-expr]
    let cond = parse_expr(p);
    let then_expr = parse_expr(p);

    let mut else_idx: i64 = 0;
    let tok = parser_peek(p);
    if tok.disc == 8 {
        parser_advance(p);
        else_idx = parse_expr(p);
    };

    let idx = add_expr(p, "if");
    p.expr_nodes[idx - 1].left = cond;
    p.expr_nodes[idx - 1].right = then_expr;
    p.expr_nodes[idx - 1].extra_start = else_idx;
    idx
}

fn parse_match_expr(p: &mut Parser) -> i64 {
    let scrutinee = parse_expr(p);
    parser_advance(p); // skip {

    let arm_start = p.match_arms.len() + 1;
    let mut arm_count: i64 = 0;

    loop {
        let tok = parser_peek(p);
        let d = tok.disc;
        if d == 50 { break; };
        if d == 61 { break; };

        // Parse pattern
        let pat_tok = parser_advance(p);
        let mut pat_kind = "wildcard";
        let mut pat_name = "";
        let mut pat_bind = "";

        if pat_tok.disc == 3 {
            pat_kind = "enum_variant";
            pat_name = pat_tok.sval;
            // Check for ::Variant
            let next = parser_peek(p);
            if next.disc == 60 {
                parser_advance(p);
                let variant_tok = parser_advance(p);
                if variant_tok.disc == 3 { pat_name = variant_tok.sval; };
            };
        };

        parser_advance(p); // skip =>
        let body = parse_expr(p);

        let arm = MatchArm {
            pat_kind: pat_kind, pat_name: pat_name,
            pat_bind: pat_bind, body_expr: body,
        };
        p.match_arms.push(arm);
        arm_count = arm_count + 1;

        let t = parser_peek(p);
        if t.disc == 53 { parser_advance(p); };
    };

    parser_advance(p); // skip }

    let idx = add_expr(p, "match");
    p.expr_nodes[idx - 1].left = scrutinee;
    p.expr_nodes[idx - 1].extra_start = arm_start;
    p.expr_nodes[idx - 1].extra_count = arm_count;
    idx
}

// ── Statement parsing ──

fn parse_stmt(p: &mut Parser) -> i64 {
    let tok = parser_peek(p);
    let disc = tok.disc;

    // Let (5)
    if disc == 5 {
        parser_advance(p); // skip let
        let mut mutable = false;
        let t2 = parser_peek(p);
        if t2.disc == 6 { parser_advance(p); mutable = true; };
        let name_tok = parser_advance(p);
        let mut name = name_tok.sval;
        // skip optional : Type
        let t3 = parser_peek(p);
        if t3.disc == 55 { parser_advance(p); parser_advance(p); }; // skip : and type
        // =
        let t4 = parser_peek(p);
        if t4.disc == 42 {
            parser_advance(p);
            let init = parse_expr(p);
            let idx = add_stmt(p, "let");
            p.stmt_nodes[idx - 1].name = name;
            p.stmt_nodes[idx - 1].expr_idx = init;
            return idx;
        };
        let idx = add_stmt(p, "let");
        p.stmt_nodes[idx - 1].name = name;
        return idx;
    };

    // Return (10)
    if disc == 10 {
        parser_advance(p);
        let t2 = parser_peek(p);
        let mut expr_idx: i64 = 0;
        if !is_stmt_end(t2) { expr_idx = parse_expr(p); };
        let idx = add_stmt(p, "return");
        p.stmt_nodes[idx - 1].expr_idx = expr_idx;
        return idx;
    };

    // While (11)
    if disc == 11 {
        parser_advance(p);
        let cond = parse_expr(p);
        parser_advance(p); // skip {
        let body_start = p.stmt_nodes.len() + 1;
        let mut body_count: i64 = 0;
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            parse_stmt(p);
            body_count = body_count + 1;
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let idx = add_stmt(p, "while");
        p.stmt_nodes[idx - 1].expr_idx = cond;
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Break (14)
    if disc == 14 {
        parser_advance(p);
        return add_stmt(p, "break");
    };

    // Continue (15)
    if disc == 15 {
        parser_advance(p);
        return add_stmt(p, "continue");
    };

    // Loop (13)
    if disc == 13 {
        parser_advance(p);
        parser_advance(p); // skip {
        let body_start = p.stmt_nodes.len() + 1;
        let mut body_count: i64 = 0;
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            parse_stmt(p);
            body_count = body_count + 1;
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let idx = add_stmt(p, "loop");
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Expression statement (default)
    let expr = parse_expr(p);
    let idx = add_stmt(p, "expr");
    p.stmt_nodes[idx - 1].expr_idx = expr;
    return idx;
}

// ── Top-level parsing ──

fn parse_fn(p: &mut Parser) -> FnDef {
    parser_advance(p); // skip fn
    let name_tok = parser_advance(p);
    let name = name_tok.sval;
    parser_advance(p); // skip (
    let mut params = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_paren(t) { break; };
        let pname_tok = parser_advance(p);
        let pname = pname_tok.sval;
        parser_advance(p); // skip :
        // Skip type tokens until , or ) (handles &Vec<Expr>, &mut Lexer, etc.)
        let mut ptype = "";
        loop {
            let tt = parser_peek(p);
            if tt.disc == 53 || tt.disc == 48 || tt.disc == 61 { break; }; // Comma/RParen/Eof
            let type_tok = parser_advance(p);
            if ptype != "" { ptype = ptype + " "; };
            ptype = ptype + type_tok.sval;
        };
        params.push(Param { name: pname, type_ann: ptype });
        let t2 = parser_peek(p);
        if t2.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip )

    let mut return_type = "";
    let t3 = parser_peek(p);
    if t3.disc == 58 {
        parser_advance(p);
        // Skip return type tokens until { (handles &Vec<Expr>, etc.)
        loop {
            let tt = parser_peek(p);
            if tt.disc == 49 || tt.disc == 61 { break; }; // LBrace or Eof
            let ret_tok = parser_advance(p);
            if return_type != "" { return_type = return_type + " "; };
            return_type = return_type + ret_tok.sval;
        };
    };

    parser_advance(p); // skip {
    let body_start = p.stmt_nodes.len() + 1;
    let mut body_count: i64 = 0;
    loop {
        let t4 = parser_peek(p);
        if is_end_of_block(t4) { break; };
        parse_stmt(p);
        body_count = body_count + 1;
        // skip optional semicolon
        let ts = parser_peek(p);
        if ts.disc == 54 { parser_advance(p); };
    };
    parser_advance(p); // skip }

    FnDef { name: name, params: params, return_type: return_type, body_start: body_start, body_count: body_count }
}

fn parse_struct_def(p: &mut Parser) -> StructDef {
    parser_advance(p); // skip struct
    let name_tok = parser_advance(p);
    let mut name = name_tok.sval;
    parser_advance(p); // skip {
    let mut fields = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let fname_tok = parser_advance(p);
        let fname = fname_tok.sval;
        parser_advance(p); // skip :
        // Skip type tokens until , or } (handles &Vec<Expr>, etc.)
        let mut ftype = "";
        loop {
            let tt = parser_peek(p);
            if tt.disc == 53 || tt.disc == 50 || tt.disc == 61 { break; }; // Comma/RBrace/Eof
            let type_tok = parser_advance(p);
            if ftype != "" { ftype = ftype + " "; };
            ftype = ftype + type_tok.sval;
        };
        fields.push(StructField { name: fname, type_ann: ftype });
        let t2 = parser_peek(p);
        if t2.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip }
    StructDef { name: name, fields: fields }
}

fn parse_enum_def(p: &mut Parser) -> EnumDef {
    parser_advance(p); // skip enum
    let name_tok = parser_advance(p);
    let name = name_tok.sval;
    parser_advance(p); // skip {
    let mut variants = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let vname_tok = parser_advance(p);
        let vname = vname_tok.sval;
        let mut vfields = Vec::new();
        let t2 = parser_peek(p);
        if t2.disc == 47 {
                parser_advance(p);
                loop {
                    let t3 = parser_peek(p);
                    if is_end_of_paren(t3) { break; };
                    let fname_tok = parser_advance(p);
                    let fname = fname_tok.sval;
                    parser_advance(p); // skip :
                    let ftype_tok = parser_advance(p);
                    let ftype = ftype_tok.sval;
                    vfields.push(StructField { name: fname, type_ann: ftype });
                    let t4 = parser_peek(p);
                    if t4.disc == 53 { parser_advance(p); }
                    else { break; };
                };
                parser_advance(p); // skip )
        };
        variants.push(EnumVariant { name: vname, fields: vfields });
        let t5 = parser_peek(p);
        if t5.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip }
    EnumDef { name: name, variants: variants }
}

// ── Pattern helpers (avoids OR-patterns) ──

fn is_end_of_block(tok: Token) -> bool {
    let d = tok.disc;
    d == 50 || d == 61  // RBrace(50) or Eof(61)
}

fn is_end_of_paren(tok: Token) -> bool {
    let d = tok.disc;
    d == 48 || d == 61  // RParen(48) or Eof(61)
}

fn is_stmt_end(tok: Token) -> bool {
    let d = tok.disc;
    d == 54 || d == 50 || d == 61  // Semicolon(54), RBrace(50), Eof(61)
}

fn parse_program(tokens: Vec<Token>) -> Program {
    let mut p = parser_new(tokens);

    let mut structs = Vec::new();
    let mut enums = Vec::new();
    let mut fns = Vec::new();
    let mut main_stmts_start: i64 = 1;
    let mut main_count: i64 = 0;

    loop {
        if parser_at_eof(&p) { break; };
        let tok = parser_peek(&p);
        let d = tok.disc;

        // Struct (16)
        if d == 16 {
            structs.push(parse_struct_def(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 17 {
            // Enum (17)
            enums.push(parse_enum_def(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 4 {
            // Fn (4)
            fns.push(parse_fn(&mut p));
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        } else if d == 61 {
            // Eof (61)
            break;
        } else {
            // Top-level expression statement
            if main_stmts_start == 1 { main_stmts_start = p.stmt_nodes.len() + 1; };
            parse_stmt(&mut p);
            main_count = main_count + 1;
            let t2 = parser_peek(&p);
            if t2.disc == 54 { parser_advance(&mut p); };
        };
    };

    Program {
        structs: structs,
        enums: enums,
        fns: fns,
        main_stmts_start: main_stmts_start,
        main_stmts_count: main_count,
        expr_nodes: p.expr_nodes,
        stmt_nodes: p.stmt_nodes,
        match_arms: p.match_arms,
    }
}
