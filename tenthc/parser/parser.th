// Self-hosting Parser — v0.3.1 simplified: no peek, advance-only

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
}

struct Expr { kind: str, ival: i64, sval: str, op: str, left: i64, right: i64 }
struct Stmt { kind: str, name: str, ival: i64, sval: str }
struct Param { name: str, type_ann: str }
struct FnDef { name: str, params: Vec<Param>, return_type: str, body: Vec<Stmt> }
struct StructDef { name: str, fields: Vec<Param> }
struct Program { structs: Vec<StructDef>, fns: Vec<FnDef>, main_stmts: Vec<Stmt> }

fn parser_new(tokens: Vec<Token>) -> Parser { Parser { tokens: tokens, pos: 0 } }

fn parser_next(p: &mut Parser) -> Token {
    if p.pos < p.tokens.len() { let t = p.tokens[p.pos]; p.pos = p.pos + 1; t }
    else { make_token(KIND_EOF(), "", 0, 0) }
}

fn parse_expr(p: &mut Parser) -> Expr {
    let t = parser_next(p);
    if t.kind == KIND_INT() { Expr { kind: "int", ival: 0, sval: t.value, op: "", left: 0, right: 0 } }
    else if t.kind == KIND_IDENT() {
        let name = t.value;
        Expr { kind: "ident", ival: 0, sval: name, op: "", left: 0, right: 0 }
    } else { Expr { kind: "int", ival: 0, sval: "0", op: "", left: 0, right: 0 } }
}

fn parse_stmt(p: &mut Parser) -> Stmt {
    let t = parser_next(p);
    if t.kind == KIND_LET() {
        let name = parser_next(p).value;
        parser_next(p); // =
        let val = parse_expr(p);
        parser_next(p); // ;
        Stmt { kind: "let", name: name, ival: val.ival, sval: val.sval }
    } else if t.kind == KIND_RETURN() {
        let val = parse_expr(p);
        parser_next(p); // ;
        Stmt { kind: "return", name: "", ival: val.ival, sval: val.sval }
    } else {
        parser_next(p); // ;
        Stmt { kind: "expr", name: "", ival: 0, sval: "" }
    }
}

fn parse_fn(p: &mut Parser) -> FnDef {
    let name = parser_next(p).value;
    parser_next(p); // (
    let mut params = Vec::new();
    let mut tok = parser_next(p);
    while tok.kind != KIND_RPAREN() {
        let pname = tok.value;
        parser_next(p); // :
        let ptype = parser_next(p).value;
        params.push(Param { name: pname, type_ann: ptype });
        tok = parser_next(p);
        if tok.kind == KIND_COMMA() { tok = parser_next(p); };
    };
    // skip -> return type if present
    tok = parser_next(p);
    if tok.kind == KIND_ARROW() { parser_next(p); tok = parser_next(p); };
    // tok is now { — skip it
    let mut body = Vec::new();
    tok = parser_next(p);
    while tok.kind != KIND_RBRACE() {
        // Put the token "back" — we consumed it already but need it for parse_stmt
        // Simplified: just push a placeholder
        body.push(Stmt { kind: "expr", name: "", ival: 0, sval: "" });
        tok = parser_next(p);
    };
    FnDef { name: name, params: params, return_type: "", body: body }
}

fn parse_struct(p: &mut Parser) -> StructDef {
    let name = parser_next(p).value;
    parser_next(p); // {
    let mut fields = Vec::new();
    let mut tok = parser_next(p);
    while tok.kind != KIND_RBRACE() {
        let fname = tok.value;
        parser_next(p); // :
        let ftype = parser_next(p).value;
        fields.push(Param { name: fname, type_ann: ftype });
        tok = parser_next(p);
        if tok.kind == KIND_COMMA() { tok = parser_next(p); };
    };
    StructDef { name: name, fields: fields }
}

fn parse_program(tokens: Vec<Token>) -> Program {
    let mut p = parser_new(tokens);
    let mut structs = Vec::new();
    let mut fns = Vec::new();
    let mut main_stmts = Vec::new();
    loop {
        if p.pos >= p.tokens.len() { break; };
        if p.tokens[p.pos].kind == KIND_EOF() { break; };
        if p.tokens[p.pos].kind == KIND_STRUCT() { structs.push(parse_struct(&mut p)); }
        else if p.tokens[p.pos].kind == KIND_FN() { fns.push(parse_fn(&mut p)); }
        else { main_stmts.push(parse_stmt(&mut p)); };
    }
    Program { structs: structs, fns: fns, main_stmts: main_stmts }
}
