// Self-hosting Parser — v0.3.3 recursive descent
// Uses v0.3.3 idioms: `..` defaults, for-in, tuple variants

struct Expr { kind: str, ival: i64, fval: f64, sval: str, left: i64, right: i64, arg_start: i64, arg_count: i64, extra_start: i64, extra_count: i64, name: str, variant: str, dtype: i64 }
struct Stmt { kind: str, name: str, expr_idx: i64, body_start: i64, body_count: i64, else_start: i64, else_count: i64 }
struct Param { name: str, type_ann: str }
struct StructField { name: str, type_ann: str }
struct EnumVariant { name: str, fields: Vec<StructField> }
struct FnDef { name: str, params: Vec<Param>, return_type: str, body_start: i64, body_count: i64, generics: Vec<str>, is_async: bool }
struct StructDef { name: str, fields: Vec<StructField>, generics: Vec<str> }
struct EnumDef { name: str, variants: Vec<EnumVariant> }
struct TraitMethodSig { name: str, params: Vec<Param>, return_type: str }
struct TraitDef { name: str, methods: Vec<TraitMethodSig> }
struct ImplBlock { trait_name: str, type_name: str, fns: Vec<FnDef> }
struct MatchArm { pat_kind: str, pat_name: str, pat_bind: str, body_expr: i64 }
struct Program { structs: Vec<StructDef>, enums: Vec<EnumDef>, fns: Vec<FnDef>, trait_defs: Vec<TraitDef>, impls: Vec<ImplBlock>, main_stmts_start: i64, main_stmts_count: i64, expr_nodes: Vec<Expr>, stmt_nodes: Vec<Stmt>, match_arms: Vec<MatchArm>, block_idxs: Vec<i64>, loop_idxs: Vec<i64> }

struct Parser { tokens: Vec<Token>, pos: i64, expr_nodes: Vec<Expr>, stmt_nodes: Vec<Stmt>, match_arms: Vec<MatchArm>, no_struct_literal: bool, block_idxs: Vec<i64>, loop_idxs: Vec<i64>, errors: Vec<str> }

fn parser_new(tokens: Vec<Token>) -> Parser {
    Parser {
        tokens: tokens,
        pos: 0,
        expr_nodes: Vec::new(),
        stmt_nodes: Vec::new(),
        match_arms: Vec::new(),
        no_struct_literal: false,
        block_idxs: Vec::new(),
        loop_idxs: Vec::new(),
        errors: Vec::new(),
    }
}

// ── Token access ──

fn parser_peek(p: &Parser) -> Token {
    if p.pos < p.tokens.len() { p.tokens[p.pos] }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 }, disc: 61, .. } }
}

fn parser_at_eof(p: &Parser) -> bool {
    p.pos >= p.tokens.len()
}

fn parser_advance(p: &mut Parser) -> Token {
    if p.pos < p.tokens.len() { let t = p.tokens[p.pos]; p.pos = p.pos + 1; t }
    else { Token { kind: TokenKind::Eof, span: Span { line: 0, col: 0 }, disc: 61, .. } }
}

// Expect `>` to close a generic type parameter list.
// Handles `>>` (Shr, disc=63) by splitting: consume the `>>` and insert a
// synthetic Gt token at current position so the outer generic context sees
// its closing `>`. Mirrors Rust-side parser.rs:54-86 expect_gt.
// Returns true if consumed, false if next token is neither Gt nor Shr.
fn expect_gt(p: &mut Parser) -> bool {
    let t = parser_peek(p);
    if t.disc == 34 {
        // Gt — consume directly
        parser_advance(p);
        return true;
    };
    if t.disc == 63 {
        // Shr (>>) — consume and insert synthetic Gt at current pos
        let line = t.span.line;
        let col = t.span.col;
        parser_advance(p); // consume >>
        // Rebuild tokens array with synthetic Gt inserted at current pos
        // (Tenth Vec has no insert method, so we rebuild via push)
        let mut new_tokens: Vec<Token> = Vec::new();
        let insert_at = p.pos;
        let mut i: i64 = 0;
        let old_len = p.tokens.len();
        while i < old_len {
            if i == insert_at {
                let synth = Token { kind: TokenKind::Gt, span: Span { line: line, col: col + 1 }, disc: 34, .. };
                new_tokens.push(synth);
            };
            new_tokens.push(p.tokens[i]);
            i = i + 1;
        };
        if insert_at >= old_len {
            let synth = Token { kind: TokenKind::Gt, span: Span { line: line, col: col + 1 }, disc: 34, .. };
            new_tokens.push(synth);
        };
        p.tokens = new_tokens;
        return true;
    };
    false
}

// ── Panic-mode error recovery (mirrors Rust-side parser.rs:15-137) ──
// SYNC_TOKENS: Fn(4), Struct(16), Enum(17), Trait(19), Impl(18), Mod(21), Use(20), RBrace(50), Eof(61)
// We skip to these after a parse error to resume parsing.

fn is_sync_token(disc: i64) -> bool {
    disc == 4 || disc == 16 || disc == 17 || disc == 19 || disc == 18 || disc == 21 || disc == 20 || disc == 50 || disc == 61
}

// Loop consume until we reach a SYNC_TOKEN or Eof.
fn synchronize(p: &mut Parser) {
    loop {
        let t = parser_peek(p);
        if is_sync_token(t.disc) { break; };
        if parser_at_eof(p) { break; };
        parser_advance(p);
    };
}

// Record a parse error message and attempt to recover by synchronizing.
fn record_error_and_recover(p: &mut Parser, msg: str) {
    p.errors.push(msg);
    synchronize(p);
}

// Check if token disc is a legal expression-start token (handled by parse_primary).
// Used by parse_program to distinguish expression statements from error tokens.
fn is_expr_start_token(disc: i64) -> bool {
    // IntLiteral(0), FloatLiteral(1), StringLiteral(2), Identifier(3)
    disc == 0 || disc == 1 || disc == 2 || disc == 3 || disc == 67 ||
    // If(7), Match(9)
    disc == 7 || disc == 9 ||
    // True(22), False(23), Move(24), Self_(25), Await(65), Spawn(66)
    disc == 22 || disc == 23 || disc == 24 || disc == 25 ||
    disc == 65 || disc == 66 ||
    // Minus(27), Star(28), Not(39), Ampersand(40), Pipe(41)
    disc == 27 || disc == 28 || disc == 39 || disc == 40 || disc == 41 ||
    // LParen(47), LBrace(49), LBracket(51)
    disc == 47 || disc == 49 || disc == 51 ||
    // DotDot(57), DotDotEq(62)
    disc == 57 || disc == 62
}

// ── Helper: add expr node, return index (1-based, 0 = nil) ──

fn add_expr(p: &mut Parser, kind: str) -> i64 {
    let e = Expr { kind: kind, .. };
    p.expr_nodes.push(e);
    p.expr_nodes.len()
}

fn add_stmt(p: &mut Parser, kind: str) -> i64 {
    let s = Stmt { kind: kind, .. };
    p.stmt_nodes.push(s);
    p.stmt_nodes.len()
}

// ── Expression parsing ──

fn parse_primary(p: &mut Parser) -> i64 {
    let tok = parser_advance(p);
    let d = tok.disc;

    // IntLiteral (0) — value in ival, dtype in dtype (hir.th BaseType encoding)
    if d == 0 {
        let n = tok.ival;
        let dt = tok.dtype;
        let idx = add_expr(p, "int");
        p.expr_nodes[idx - 1].ival = n;
        p.expr_nodes[idx - 1].dtype = dt;
        return idx;
    };
    // FloatLiteral (1)
    if d == 1 {
        let idx = add_expr(p, "float");
        p.expr_nodes[idx - 1].fval = tok.fval;
        // Phase 5.2 step 2：保留 token 的 dtype（ival: 0=F64, 1=F32）
        p.expr_nodes[idx - 1].ival = tok.ival;
        return idx;
    };
    // StringLiteral (2), InterpolatedString (67), or FString (89) — may be interpolated
    if d == 2 || d == 67 || d == 89 {
        let s = tok.sval;
        // Check for interpolation: scan for '{'
        let mut has_brace = false;
        let mut scan = 0;
        while scan < s.len() {
            if s[scan] == "{" { has_brace = true; break; };
            scan = scan + 1;
        };
        if !has_brace {
            let idx = add_expr(p, "str");
            p.expr_nodes[idx - 1].sval = s;
            return idx;
        };
        // Interpolated string: split into parts
        let parts_start = p.expr_nodes.len() + 1;
        let mut parts_count = 0;
        scan = 0;
        let mut lit_start = 0;
        while scan < s.len() {
            if s[scan] == "{" {
                // Flush literal part before '{'
                if scan > lit_start {
                    let lit = s[lit_start..scan];
                    let idx = add_expr(p, "str");
                    p.expr_nodes[idx - 1].sval = lit;
                    parts_count = parts_count + 1;
                };
                // Find closing '}'
                scan = scan + 1;
                let name_start = scan;
                while scan < s.len() && s[scan] != "}" { scan = scan + 1; };
                let name = s[name_start..scan];
                if scan < s.len() { scan = scan + 1; }; // skip '}'
                lit_start = scan;
                // Add ident part
                let idx = add_expr(p, "ident");
                p.expr_nodes[idx - 1].sval = name;
                parts_count = parts_count + 1;
            } else {
                scan = scan + 1;
            };
        };
        // Flush trailing literal
        if lit_start < s.len() {
            let lit = s[lit_start..s.len()];
            let idx = add_expr(p, "str");
            p.expr_nodes[idx - 1].sval = lit;
            parts_count = parts_count + 1;
        };
        // d==89 → "fstring"（编译为 format() 调用）；d==67 → "interp"（字符串拼接）
        let node_kind = if d == 89 { "fstring" } else { "interp" };
        let idx = add_expr(p, node_kind);
        p.expr_nodes[idx - 1].extra_start = parts_start;
        p.expr_nodes[idx - 1].extra_count = parts_count;
        return idx;
    };
    // Identifier (3)
    if d == 3 {
        let name = tok.sval;
        // Check for :: (enum variant path, ColonColon disc 60)
        let next = parser_peek(p);
        if next.disc == 60 {
            parser_advance(p); // skip ::
            let variant_tok = parser_advance(p);
            let variant_name = variant_tok.sval;
            // Check for ( (tuple variant with fields, LParen disc 47)
            let next2 = parser_peek(p);
            if next2.disc == 47 {
                parser_advance(p); // skip (
                // Collect arg indices locally, then emit contiguous "arg" reference nodes.
                // Same fix as parse_postfix call/method_call: parse_arg_list discards
                // parse_expr's return value, so arg_start would point to an intermediate
                // node instead of the final node for expressions like `Some(n - 1)`.
                let mut arg_idxs: Vec<i64> = Vec::new();
                loop {
                    let t = parser_peek(p);
                    if t.disc == 48 { break; }; // RParen
                    if t.disc == 61 { break; }; // Eof
                    let arg_idx = parse_expr(p);
                    arg_idxs.push(arg_idx);
                    let t2 = parser_peek(p);
                    if t2.disc == 53 { parser_advance(p); } // skip ,
                    else { break; };
                };
                parser_advance(p); // skip )
                let start = p.expr_nodes.len() + 1;
                let count = arg_idxs.len();
                for i in 0..count {
                    let aidx = add_expr(p, "arg");
                    p.expr_nodes[aidx - 1].left = arg_idxs[i];
                };
                let idx = add_expr(p, "enum_literal");
                p.expr_nodes[idx - 1].name = name;
                p.expr_nodes[idx - 1].variant = variant_name;
                p.expr_nodes[idx - 1].arg_start = start;
                p.expr_nodes[idx - 1].arg_count = count;
                return idx;
            };
            // Unit variant — no fields
            let idx = add_expr(p, "enum_literal");
            p.expr_nodes[idx - 1].name = name;
            p.expr_nodes[idx - 1].variant = variant_name;
            return idx;
        };
        // Check for { (struct literal, LBrace disc 49) — unless suppressed (e.g. in for/if/while condition)
        if next.disc == 49 && !p.no_struct_literal {
            parser_advance(p); // skip {
            // First pass: parse all fields, store names and value expr indices
            let mut field_names: Vec<str> = Vec::new();
            let mut field_vals: Vec<i64> = Vec::new();
            loop {
                let t = parser_peek(p);
                if t.disc == 50 { break; }; // RBrace
                if t.disc == 61 { break; }; // Eof
                // Skip .. (DotDot disc 57) — default field marker
                if t.disc == 57 {
                    parser_advance(p); // skip ..
                    let t2 = parser_peek(p);
                    if t2.disc == 53 { parser_advance(p); }; // skip ,
                    break;
                };
                // Parse field: name : value
                let field_tok = parser_advance(p);
                let field_name = field_tok.sval;
                let colon_tok = parser_peek(p);
                if colon_tok.disc == 55 { parser_advance(p); }; // skip :
                let val_idx = parse_expr(p);
                field_names.push(field_name);
                field_vals.push(val_idx);
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); } // skip ,
                else { break; };
            };
            parser_advance(p); // skip }
            // Second pass: push field_init nodes contiguously so arg_start..arg_start+arg_count
            // contains only field_init nodes (lowerer relies on this)
            let start = p.expr_nodes.len() + 1;
            let count = field_names.len();
            for i in 0..count {
                let fidx = add_expr(p, "field_init");
                p.expr_nodes[fidx - 1].sval = field_names[i];
                p.expr_nodes[fidx - 1].left = field_vals[i];
            };
            let idx = add_expr(p, "struct_literal");
            p.expr_nodes[idx - 1].name = name;
            p.expr_nodes[idx - 1].arg_start = start;
            p.expr_nodes[idx - 1].arg_count = count;
            return idx;
        };
        // Plain identifier
        let idx = add_expr(p, "ident");
        p.expr_nodes[idx - 1].sval = name;
        return idx;
    };
    // True (22)
    if d == 22 {
        let idx = add_expr(p, "bool");
        p.expr_nodes[idx - 1].ival = 1;
        return idx;
    };
    // False (23)
    if d == 23 {
        let idx = add_expr(p, "bool");
        p.expr_nodes[idx - 1].ival = 0;
        return idx;
    };
    // Self_ (25)
    if d == 25 {
        let idx = add_expr(p, "ident");
        p.expr_nodes[idx - 1].sval = "self";
        return idx;
    };
    // LParen (47) — parenthesized expr, empty tuple (), or tuple (a, b, c)
    if d == 47 {
        // Check for empty tuple: ()
        let next = parser_peek(p);
        if next.disc == 48 {
            // RParen — empty tuple ()
            parser_advance(p); // skip )
            let idx = add_expr(p, "tuple");
            p.expr_nodes[idx - 1].arg_start = 0;
            p.expr_nodes[idx - 1].arg_count = 0;
            return idx;
        };
        // Parse first expression
        let first_expr = parse_expr(p);
        // Check for comma → tuple literal (a, b, c)
        let next2 = parser_peek(p);
        if next2.disc == 53 {
            // Comma — tuple
            let mut elem_idxs: Vec<i64> = Vec::new();
            elem_idxs.push(first_expr);
            loop {
                let t = parser_peek(p);
                if t.disc != 53 { break; }; // not Comma
                parser_advance(p); // skip ,
                let t2 = parser_peek(p);
                if t2.disc == 48 { break; }; // RParen — trailing comma
                let elem_idx = parse_expr(p);
                elem_idxs.push(elem_idx);
            };
            parser_advance(p); // skip )
            // Create contiguous "arg" nodes for tuple elements
            let start = p.expr_nodes.len() + 1;
            let count = elem_idxs.len();
            for i in 0..count {
                let aidx = add_expr(p, "arg");
                p.expr_nodes[aidx - 1].left = elem_idxs[i];
            };
            let idx = add_expr(p, "tuple");
            p.expr_nodes[idx - 1].arg_start = start;
            p.expr_nodes[idx - 1].arg_count = count;
            return idx;
        };
        // Single parenthesized expression
        parser_advance(p); // expect RParen
        return first_expr;
    };
    // LBrace (49)
    if d == 49 { return parse_block_expr(p); };
    // If (7)
    if d == 7 { return parse_if_expr(p); };
    // Match (9)
    if d == 9 { return parse_match_expr(p); };
    // Ampersand (40) — ref or mut_ref (&mut)
    if d == 40 {
        let next = parser_peek(p);
        if next.disc == 6 {
            // &mut — exclusive borrow
            parser_advance(p); // skip mut
            let inner = parse_unary(p);
            let idx = add_expr(p, "mut_ref");
            p.expr_nodes[idx - 1].left = inner;
            return idx;
        };
        let inner = parse_unary(p);
        let idx = add_expr(p, "ref");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Star (28) — deref
    if d == 28 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "deref");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Minus (27)
    if d == 27 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "unary");
        p.expr_nodes[idx - 1].sval = "-";
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Not (39)
    if d == 39 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "unary");
        p.expr_nodes[idx - 1].sval = "!";
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Pipe (41) — closure: |params| body
    // Note: parse_primary already consumed the opening `|` via parser_advance above.
    if d == 41 {
        let mut closure_param_names = Vec::new();
        loop {
            let t = parser_peek(p);
            if t.disc == 41 { parser_advance(p); break; }; // closing |
            let pname_tok = parser_advance(p);
            let pname = pname_tok.sval;
            // skip optional : Type
            let t2 = parser_peek(p);
            if t2.disc == 55 { parser_advance(p); parser_advance(p); }; // skip : and type
            closure_param_names.push(pname);
            let t3 = parser_peek(p);
            if t3.disc == 53 { parser_advance(p); } // skip ,
            else if t3.disc == 41 { parser_advance(p); break; }; // closing |
        };
        let body = parse_expr(p);
        let idx = add_expr(p, "closure");
        // Store params as a sub-expression list
        p.expr_nodes[idx - 1].left = body;
        p.expr_nodes[idx - 1].extra_start = p.expr_nodes.len() + 1;
        p.expr_nodes[idx - 1].extra_count = closure_param_names.len();
        let mut pi: i64 = 0;
        while pi < closure_param_names.len() {
            let pidx = add_expr(p, "ident");
            p.expr_nodes[pidx - 1].sval = closure_param_names[pi];
            pi = pi + 1;
        };
        return idx;
    };

    // LBracket (51) — array literal or tensor literal
    // Note: parse_primary already consumed the opening `[` via parser_advance above.
    if d == 51 {
        let next = parser_peek(p);
        if next.disc == 51 {
            // Tensor literal: [[...], [...]]
            parser_advance(p); // skip inner [
            // Collect element indices locally; emit contiguous "arg" nodes at the end.
            let mut arg_idxs: Vec<i64> = Vec::new();
            loop {
                let t = parser_peek(p);
                if t.disc == 52 { break; }; // ]
                let arg_idx = parse_expr(p);
                arg_idxs.push(arg_idx);
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); }; // ,
            };
            parser_advance(p); // skip inner ]
            // Check for more rows
            let mut rows: i64 = 1;
            let t3 = parser_peek(p);
            if t3.disc == 53 {
                // Multiple rows
                loop {
                    let t4 = parser_peek(p);
                    if t4.disc == 52 { break; }; // ]
                    if t4.disc == 53 { parser_advance(p); }; // ,
                    let t5 = parser_peek(p);
                    if t5.disc == 51 {
                        parser_advance(p); // skip [
                        loop {
                            let t6 = parser_peek(p);
                            if t6.disc == 52 { break; };
                            let arg_idx = parse_expr(p);
                            arg_idxs.push(arg_idx);
                            let t7 = parser_peek(p);
                            if t7.disc == 53 { parser_advance(p); };
                        };
                        parser_advance(p); // skip ]
                        rows = rows + 1;
                    } else { break; };
                };
            };
            parser_advance(p); // skip outer ]
            let total_count = arg_idxs.len();
            let start = p.expr_nodes.len() + 1;
            for i in 0..total_count {
                let aidx = add_expr(p, "arg");
                p.expr_nodes[aidx - 1].left = arg_idxs[i];
            };
            let idx = add_expr(p, "tensor");
            p.expr_nodes[idx - 1].arg_start = start;
            p.expr_nodes[idx - 1].arg_count = total_count;
            p.expr_nodes[idx - 1].ival = rows;
            return idx;
        };
        // Array literal: [1, 2, 3]
        let mut arg_idxs: Vec<i64> = Vec::new();
        loop {
            let t = parser_peek(p);
            if t.disc == 52 { break; }; // ]
            if t.disc == 61 { break; }; // Eof
            let arg_idx = parse_expr(p);
            arg_idxs.push(arg_idx);
            let t2 = parser_peek(p);
            if t2.disc == 53 { parser_advance(p); }
            else { break; };
        };
        parser_advance(p); // skip ]
        let start = p.expr_nodes.len() + 1;
        let count = arg_idxs.len();
        for i in 0..count {
            let aidx = add_expr(p, "arg");
            p.expr_nodes[aidx - 1].left = arg_idxs[i];
        };
        let idx = add_expr(p, "array");
        p.expr_nodes[idx - 1].arg_start = start;
        p.expr_nodes[idx - 1].arg_count = count;
        return idx;
    };

    // Move (24) — move expression
    if d == 24 {
        parser_advance(p);
        let inner = parse_unary(p);
        let idx = add_expr(p, "move");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };

    // Await (65) — await expression (prefix unary)
    if d == 65 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "await");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Spawn (66) — spawn expression (prefix unary)
    if d == 66 {
        let inner = parse_unary(p);
        let idx = add_expr(p, "spawn");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Yield (82) — yield expression (optional inner)
    // 无值形式：`yield;` / `yield)` / `yield}` / `yield,` / `yield <EOF>`
    // 带值形式：`yield expr`（expr 由 parse_unary 解析）
    // 与 Rust 侧 expr.rs:699-712 语义对齐。
    if d == 82 {
        let next = parser_peek(p);
        // 54=; 48=) 50=} 53=, 61=Eof → 无值形式
        let no_value = next.disc == 54 || next.disc == 48 || next.disc == 50 || next.disc == 53 || next.disc == 61;
        let inner: i64 = if no_value { 0 } else { parse_unary(p) };
        let idx = add_expr(p, "yield");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };
    // Try (69) — try block: try { ... }
    if d == 69 {
        let inner = parse_expr(p);
        let idx = add_expr(p, "try_block");
        p.expr_nodes[idx - 1].left = inner;
        return idx;
    };

    // DotDot (57) — standalone open-start range: ..end
    if d == 57 {
        let end = parse_unary(p);
        let idx = add_expr(p, "range");
        p.expr_nodes[idx - 1].right = end;
        p.expr_nodes[idx - 1].ival = 0; // exclusive
        return idx;
    };
    // DotDotEq (62) — standalone open-start inclusive range: ..=end
    if d == 62 {
        let end = parse_unary(p);
        let idx = add_expr(p, "range");
        p.expr_nodes[idx - 1].right = end;
        p.expr_nodes[idx - 1].ival = 1; // inclusive
        return idx;
    };

    // Default
    let idx = add_expr(p, "int");
    p.expr_nodes[idx - 1].ival = 0;
    return idx;
}

fn parse_unary(p: &mut Parser) -> i64 {
    parse_primary(p)
}

// Heuristic: check if `<` at current position starts a generic call.
// Scans `<Ident, Ident, ..., >` and checks if `(` follows.
// Saves and restores parser position.
fn looks_like_generic_call(p: &mut Parser) -> bool {
    let saved_pos = p.pos;
    let mut ok = true;
    // Expect <
    let t0 = parser_peek(p);
    if t0.disc != 33 { ok = false; };
    if ok {
        parser_advance(p); // skip <
        // Collect type args
        loop {
            let t = parser_peek(p);
            if t.disc == 34 || t.disc == 63 { break; }; // > or >>
            // Expect identifier (disc=1) or keyword-like ident
            if t.disc != 1 && t.sval == "" { ok = false; break; };
            parser_advance(p); // skip ident
            let t2 = parser_peek(p);
            if t2.disc == 53 { parser_advance(p); } // skip ,
            else { break; };
        };
        // Expect > or >>
        let tg = parser_peek(p);
        if tg.disc != 34 && tg.disc != 63 { ok = false; };
        if ok {
            parser_advance(p); // skip >
            // Expect (
            let tp = parser_peek(p);
            if tp.disc != 47 { ok = false; };
        };
    };
    // Restore position
    p.pos = saved_pos;
    ok
}

fn parse_postfix(p: &mut Parser) -> i64 {
    let mut expr_idx = parse_unary(p);

    loop {
        let tok = parser_peek(p);
        let d = tok.disc;

        // Lt (33) — generic call foo<T, U>(args), if it looks like one
        if d == 33 {
            if looks_like_generic_call(p) {
                // Parse generic type args <T, U>
                parser_advance(p); // skip <
                let mut type_arg_idxs: Vec<i64> = Vec::new();
                loop {
                    let t = parser_peek(p);
                    if t.disc == 34 || t.disc == 63 { break; }; // > or >>
                    let type_tok = parser_advance(p);
                    let type_name = type_tok.sval;
                    // Create ident node for type arg
                    let tidx = add_expr(p, "ident");
                    p.expr_nodes[tidx - 1].sval = type_name;
                    type_arg_idxs.push(tidx);
                    let t2 = parser_peek(p);
                    if t2.disc == 53 { parser_advance(p); } // skip ,
                    else { break; };
                };
                // Consume > (or split >> into two > via expect_gt)
                expect_gt(p);
                // Now expect ( for call args
                let next = parser_peek(p);
                if next.disc == 47 {
                    parser_advance(p); // skip (
                    let mut arg_idxs: Vec<i64> = Vec::new();
                    loop {
                        let t = parser_peek(p);
                        if t.disc == 48 { break; }; // RParen
                        if t.disc == 61 { break; }; // Eof
                        let arg_idx = parse_expr(p);
                        arg_idxs.push(arg_idx);
                        let t2 = parser_peek(p);
                        if t2.disc == 53 { parser_advance(p); } // skip ,
                        else { break; };
                    };
                    parser_advance(p); // skip )
                    // Create contiguous "arg" nodes for call args
                    let arg_start = p.expr_nodes.len() + 1;
                    let arg_count = arg_idxs.len();
                    for i in 0..arg_count {
                        let aidx = add_expr(p, "arg");
                        p.expr_nodes[aidx - 1].left = arg_idxs[i];
                    };
                    // Create contiguous ident nodes for type args (extra)
                    let extra_start = p.expr_nodes.len() + 1;
                    let extra_count = type_arg_idxs.len();
                    for i in 0..extra_count {
                        let aidx = add_expr(p, "ident");
                        p.expr_nodes[aidx - 1].sval = p.expr_nodes[type_arg_idxs[i] - 1].sval;
                    };
                    // Create generic_call node
                    let fn_name = p.expr_nodes[expr_idx - 1].sval;
                    let idx = add_expr(p, "generic_call");
                    p.expr_nodes[idx - 1].sval = fn_name;
                    p.expr_nodes[idx - 1].arg_start = arg_start;
                    p.expr_nodes[idx - 1].arg_count = arg_count;
                    p.expr_nodes[idx - 1].extra_start = extra_start;
                    p.expr_nodes[idx - 1].extra_count = extra_count;
                    expr_idx = idx;
                } else {
                    // < followed by type args but no ( — not a generic call after all
                    // This shouldn't happen if looks_like_generic_call is correct
                    break;
                };
            } else {
                break;
            };
        } else if d == 47 {
            // LParen (47) — function call
            parser_advance(p); // skip (
            // Collect argument expression indices in a local Vec first.
            // parse_expr pushes intermediate nodes (ident, int, etc.) before
            // the final node, so arg_start would point to an intermediate node.
            // We create contiguous "arg" reference nodes after collecting all args.
            let mut arg_idxs: Vec<i64> = Vec::new();
            loop {
                let t = parser_peek(p);
                if t.disc == 48 { break; }; // RParen
                if t.disc == 61 { break; }; // Eof
                let arg_idx = parse_expr(p);
                arg_idxs.push(arg_idx);
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); } // skip ,
                else { break; };
            };
            parser_advance(p); // skip )
            // Create contiguous "arg" nodes that reference the actual expressions
            let start = p.expr_nodes.len() + 1;
            let count = arg_idxs.len();
            for i in 0..count {
                let aidx = add_expr(p, "arg");
                p.expr_nodes[aidx - 1].left = arg_idxs[i];
            };
            p.expr_nodes[expr_idx - 1].kind = "call";
            p.expr_nodes[expr_idx - 1].arg_start = start;
            p.expr_nodes[expr_idx - 1].arg_count = count;
        } else if d == 51 {
            // LBracket (51) — index expression s[i] or slice s[a..b]
            parser_advance(p); // skip [
            let first_expr = parse_expr(p);
            parser_advance(p); // skip ]
            // Check if first_expr is a range (s[a..b] parsed as s[range(a,b)])
            if p.expr_nodes[first_expr - 1].kind == "range" {
                // Slice s[a..b] — extract start/end from range node
                let start_expr = p.expr_nodes[first_expr - 1].left;
                let end_expr = p.expr_nodes[first_expr - 1].right;
                let inclusive = p.expr_nodes[first_expr - 1].ival;
                let idx = add_expr(p, "slice");
                p.expr_nodes[idx - 1].left = expr_idx;
                p.expr_nodes[idx - 1].right = start_expr;
                p.expr_nodes[idx - 1].extra_start = end_expr;
                p.expr_nodes[idx - 1].ival = inclusive;
                expr_idx = idx;
            } else {
                // Plain index s[i]
                let idx = add_expr(p, "index");
                p.expr_nodes[idx - 1].left = expr_idx;
                p.expr_nodes[idx - 1].right = first_expr;
                expr_idx = idx;
            };
        } else if d == 56 {
            // Dot (56) — field access or method call
            parser_advance(p); // skip .
            let field_tok = parser_advance(p);
            let field_name = field_tok.sval;
            // Check if next is ( → method call
            let next = parser_peek(p);
            if next.disc == 47 {
                parser_advance(p); // skip (
                // Collect arg indices locally, then emit contiguous "arg" reference nodes.
                // parse_arg_list discards parse_expr's return value, so arg_start would
                // point to an intermediate node (e.g. ident) instead of the final node
                // (e.g. binary) for expressions like `vec.push(n - 1)`.
                let mut arg_idxs: Vec<i64> = Vec::new();
                loop {
                    let t = parser_peek(p);
                    if t.disc == 48 { break; }; // RParen
                    if t.disc == 61 { break; }; // Eof
                    let arg_idx = parse_expr(p);
                    arg_idxs.push(arg_idx);
                    let t2 = parser_peek(p);
                    if t2.disc == 53 { parser_advance(p); } // skip ,
                    else { break; };
                };
                parser_advance(p); // skip )
                let start = p.expr_nodes.len() + 1;
                let count = arg_idxs.len();
                for i in 0..count {
                    let aidx = add_expr(p, "arg");
                    p.expr_nodes[aidx - 1].left = arg_idxs[i];
                };
                let idx = add_expr(p, "method_call");
                p.expr_nodes[idx - 1].sval = field_name;
                p.expr_nodes[idx - 1].left = expr_idx;
                p.expr_nodes[idx - 1].arg_start = start;
                p.expr_nodes[idx - 1].arg_count = count;
                expr_idx = idx;
            } else {
                let idx = add_expr(p, "field");
                p.expr_nodes[idx - 1].left = expr_idx;
                p.expr_nodes[idx - 1].sval = field_name;
                expr_idx = idx;
            };
        } else if d == 81 {
            // QuestionMark (81) — Try postfix: expr?
            parser_advance(p); // skip ?
            let idx = add_expr(p, "unary");
            p.expr_nodes[idx - 1].sval = "?";
            p.expr_nodes[idx - 1].left = expr_idx;
            expr_idx = idx;
        } else {
            break;
        };
    };

    expr_idx
}

fn binop_prec(op: str) -> i64 {
    if op == "*" || op == "/" || op == "%" { 5 }
    else if op == "+" || op == "-" || op == ">>" { 4 }
    else if op == "<" || op == ">" || op == "<=" || op == ">=" { 3 }
    else if op == "==" || op == "!=" { 2 }
    else if op == "&&" { 1 }
    else if op == "||" { 0 }
    else { -1 }
}

fn token_to_binop_str(tok: Token) -> str {
    let d = tok.disc;
    if d == 26 { "+" }
    else if d == 27 { "-" }
    else if d == 28 { "*" }
    else if d == 29 { "/" }
    else if d == 30 { "%" }
    else if d == 31 { "==" }
    else if d == 32 { "!=" }
    else if d == 33 { "<" }
    else if d == 34 { ">" }
    else if d == 35 { "<=" }
    else if d == 36 { ">=" }
    else if d == 37 { "&&" }
    else if d == 38 { "||" }
    else if d == 63 { ">>" }
    else { "" }
}

fn is_binop(tok: Token) -> bool {
    let d = tok.disc;
    d == 26 || d == 27 || d == 28 || d == 29 || d == 30 || d == 31 || d == 32 || d == 33 || d == 34 || d == 35 || d == 36 || d == 37 || d == 38 || d == 63
}

fn parse_binary(p: &mut Parser, min_prec: i64) -> i64 {
    let mut left = parse_postfix(p);

    loop {
        let tok = parser_peek(p);
        if !is_binop(tok) { break; };
        let op = token_to_binop_str(tok);
        let prec = binop_prec(op);
        if prec < min_prec { break; };

        parser_advance(p); // consume operator
        let right = parse_binary(p, prec + 1);

        let idx = add_expr(p, "binary");
        p.expr_nodes[idx - 1].sval = op;
        p.expr_nodes[idx - 1].left = left;
        p.expr_nodes[idx - 1].right = right;
        left = idx;
    };

    left
}

fn parse_expr(p: &mut Parser) -> i64 {
    // Check for assignment
    let tok = parser_peek(p);
    // Simple: just parse binary
    let expr = parse_binary(p, 0);

    // Check for range: .. or ..=
    let tok_r = parser_peek(p);
    if tok_r.disc == 57 {
        // DotDot — exclusive range: start..end
        parser_advance(p);
        let end = parse_binary(p, 0);
        let idx = add_expr(p, "range");
        p.expr_nodes[idx - 1].left = expr;
        p.expr_nodes[idx - 1].right = end;
        p.expr_nodes[idx - 1].ival = 0; // exclusive
        return idx;
    };
    if tok_r.disc == 62 {
        // DotDotEq — inclusive range: start..=end
        parser_advance(p);
        let end = parse_binary(p, 0);
        let idx = add_expr(p, "range");
        p.expr_nodes[idx - 1].left = expr;
        p.expr_nodes[idx - 1].right = end;
        p.expr_nodes[idx - 1].ival = 1; // inclusive
        return idx;
    };

    // Check for = or +=, -=, *=, /=
    let tok2 = parser_peek(p);
    if tok2.disc == 42 {
        // Simple assignment
        parser_advance(p);
        let rhs = parse_expr(p);
        let idx = add_expr(p, "assign");
        p.expr_nodes[idx - 1].left = expr;
        p.expr_nodes[idx - 1].right = rhs;
        idx
    } else if tok2.disc == 43 || tok2.disc == 44 || tok2.disc == 45 || tok2.disc == 46 {
        // Compound assignment: +=, -=, *=, /=
        let op_str = if tok2.disc == 43 { "+=" }
                     else if tok2.disc == 44 { "-=" }
                     else if tok2.disc == 45 { "*=" }
                     else { "/=" };
        parser_advance(p);
        let rhs = parse_expr(p);
        let idx = add_expr(p, "assign_op");
        p.expr_nodes[idx - 1].left = expr;
        p.expr_nodes[idx - 1].right = rhs;
        p.expr_nodes[idx - 1].sval = op_str;
        idx
    } else { expr }
}

fn parse_block_expr(p: &mut Parser) -> i64 {
    // Collect statements in a LOCAL Vec first, then push to shared block_idxs
    // AFTER the loop. This prevents nested block expressions from interleaving
    // their statements with this block's statements in the shared array.
    let mut local_idxs: Vec<i64> = Vec::new();
    loop {
        let tok = parser_peek(p);
        let d = tok.disc;
        if d == 50 { break; };
        if d == 61 { break; };
        // Skip semicolons between statements
        if d == 54 { parser_advance(p); } else {
            let sidx = parse_stmt(p);
            local_idxs.push(sidx);
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
    };
    parser_advance(p); // skip }
    // NOW push all collected statements contiguously to the shared array
    let body_start = p.block_idxs.len() + 1;
    let count = local_idxs.len();
    for i in 0..count {
        p.block_idxs.push(local_idxs[i]);
    };
    let idx = add_expr(p, "block");
    p.expr_nodes[idx - 1].extra_start = body_start;
    p.expr_nodes[idx - 1].extra_count = count;
    idx
}

fn parse_if_expr(p: &mut Parser) -> i64 {
    // if cond then-expr [else else-expr]
    p.no_struct_literal = true;
    let cond = parse_expr(p);
    p.no_struct_literal = false;
    let then_expr = parse_expr(p);

    let mut else_idx: i64 = 0;
    let tok = parser_peek(p);
    if tok.disc == 8 {
        parser_advance(p);
        else_idx = parse_expr(p);
    };

    let idx = add_expr(p, "if");
    p.expr_nodes[idx - 1].left = cond;
    p.expr_nodes[idx - 1].right = then_expr;
    p.expr_nodes[idx - 1].extra_start = else_idx;
    idx
}

fn int_to_str(n: i64) -> str {
    if n == 0 { return "0"; };
    let mut v = n;
    let mut neg = "";
    if v < 0 { neg = "-"; v = 0 - v; };
    let mut digits: Vec<str> = Vec::new();
    while v > 0 {
        let d = v % 10;
        if d == 0 { digits.push("0"); }
        else if d == 1 { digits.push("1"); }
        else if d == 2 { digits.push("2"); }
        else if d == 3 { digits.push("3"); }
        else if d == 4 { digits.push("4"); }
        else if d == 5 { digits.push("5"); }
        else if d == 6 { digits.push("6"); }
        else if d == 7 { digits.push("7"); }
        else if d == 8 { digits.push("8"); }
        else { digits.push("9"); };
        v = v / 10;
    };
    let mut result = neg;
    let mut i = digits.len() - 1;
    while i >= 0 {
        result = result + digits[i];
        i = i - 1;
    };
    result
}

fn parse_match_expr(p: &mut Parser) -> i64 {
    let scrutinee = parse_expr(p);
    parser_advance(p); // skip {

    let arm_start = p.match_arms.len() + 1;
    let mut arm_count: i64 = 0;

    loop {
        let tok = parser_peek(p);
        let d = tok.disc;
        if d == 50 { break; };
        if d == 61 { break; };

        // Parse pattern
        let pat_tok = parser_advance(p);
        let mut pat_kind = "wildcard";
        let mut pat_name = "";
        let mut pat_bind = "";

        if pat_tok.disc == 3 {
            // Identifier
            if pat_tok.sval == "_" {
                pat_kind = "wildcard";
            } else {
                pat_name = pat_tok.sval;
                let next = parser_peek(p);
                if next.disc == 60 {
                    // ::Variant — enum variant path: EnumName::Variant
                    parser_advance(p); // skip ::
                    let variant_tok = parser_advance(p);
                    pat_kind = "enum_variant";
                    pat_bind = pat_name; // store enum name in pat_bind
                    if variant_tok.disc == 3 { pat_name = variant_tok.sval; };
                    // Check for ( (tuple variant with fields): Some(x)
                    let next2 = parser_peek(p);
                    if next2.disc == 47 {
                        parser_advance(p); // skip (
                        // Parse field bindings (positional identifiers)
                        let mut first_field = true;
                        loop {
                            let t = parser_peek(p);
                            if t.disc == 48 { break; }; // RParen
                            if t.disc == 61 { break; }; // Eof
                            let field_tok = parser_advance(p);
                            // Store first field name in pat_bind (appended to enum name)
                            if first_field {
                                pat_bind = pat_bind + ":" + field_tok.sval;
                                first_field = false;
                            };
                            let t2 = parser_peek(p);
                            if t2.disc == 53 { parser_advance(p); } // skip ,
                            else { break; };
                        };
                        parser_advance(p); // skip )
                    };
                } else if next.disc == 47 {
                    // LParen — short-form enum variant with fields: Variant(x)
                    pat_kind = "enum_variant";
                    pat_bind = ""; // no enum name
                    parser_advance(p); // skip (
                    let mut first_field = true;
                    loop {
                        let t = parser_peek(p);
                        if t.disc == 48 { break; }; // RParen
                        if t.disc == 61 { break; }; // Eof
                        let field_tok = parser_advance(p);
                        if first_field {
                            pat_bind = ":" + field_tok.sval;
                            first_field = false;
                        };
                        let t2 = parser_peek(p);
                        if t2.disc == 53 { parser_advance(p); } // skip ,
                        else { break; };
                    };
                    parser_advance(p); // skip )
                } else if next.disc == 49 {
                    // LBrace — struct destructuring: Point { x, y } or Point { x: a, y: b }
                    pat_kind = "struct";
                    parser_advance(p); // skip {
                    // Parse field bindings (skip for now, just consume)
                    loop {
                        let t = parser_peek(p);
                        if t.disc == 50 { break; }; // RBrace
                        if t.disc == 61 { break; }; // Eof
                        parser_advance(p); // skip field name
                        let t2 = parser_peek(p);
                        if t2.disc == 55 {
                            // : bind_name
                            parser_advance(p); // skip :
                            parser_advance(p); // skip bind_name
                        };
                        let t3 = parser_peek(p);
                        if t3.disc == 53 { parser_advance(p); } // skip ,
                        else { break; };
                    };
                    parser_advance(p); // skip }
                } else {
                    // Plain identifier — binding pattern (binds value to variable)
                    pat_kind = "binding";
                };
            };
        } else if pat_tok.disc == 0 {
            // IntLiteral — literal pattern, check for range
            pat_kind = "literal";
            pat_name = int_to_str(pat_tok.ival);
            let next = parser_peek(p);
            if next.disc == 57 || next.disc == 62 {
                // DotDot (57) or DotDotEq (62) — range pattern: start..end or start..=end
                let inclusive = next.disc == 62;
                parser_advance(p); // skip .. or ..=
                let end_tok = parser_advance(p);
                if end_tok.disc == 0 {
                    pat_kind = "range";
                    let end_str = int_to_str(end_tok.ival);
                    if inclusive {
                        pat_bind = pat_name + "..=" + end_str;
                    } else {
                        pat_bind = pat_name + ".." + end_str;
                    };
                };
            };
        } else if pat_tok.disc == 22 {
            // True — literal pattern
            pat_kind = "literal";
            pat_name = "true";
        } else if pat_tok.disc == 23 {
            // False — literal pattern
            pat_kind = "literal";
            pat_name = "false";
        } else if pat_tok.disc == 47 {
            // LParen — tuple pattern: (a, b, c)
            pat_kind = "tuple";
            parser_advance(p); // skip (
            let mut bind_names: Vec<str> = Vec::new();
            loop {
                let t = parser_peek(p);
                if t.disc == 48 || t.disc == 61 { break; }; // ) or Eof
                if t.disc == 53 { parser_advance(p); continue; }; // skip ,
                if t.disc == 3 {
                    // Identifier — 简单绑定
                    let sub_tok = parser_advance(p);
                    if sub_tok.sval == "_" {
                        bind_names.push("_");
                    } else {
                        bind_names.push(sub_tok.sval);
                    };
                } else if t.disc == 47 {
                    // 嵌套 LParen：用 depth 跳过整个嵌套（保守，占位 _）
                    let mut nd: i64 = 1;
                    parser_advance(p);
                    while nd > 0 {
                        let nt = parser_peek(p);
                        if nt.disc == 61 { break; };
                        if nt.disc == 47 { nd = nd + 1; };
                        if nt.disc == 48 { nd = nd - 1; };
                        if nd > 0 { parser_advance(p); };
                    };
                    bind_names.push("_");
                } else {
                    // 字面量等其他 token：跳过，占位 _
                    parser_advance(p);
                    bind_names.push("_");
                };
            };
            if parser_peek(p).disc == 48 { parser_advance(p); }; // skip )
            // 将变量名列表存入 pat_bind（逗号分隔）
            let mut bi: i64 = 0;
            while bi < bind_names.len() {
                if bi == 0 {
                    pat_bind = bind_names[bi];
                } else {
                    pat_bind = pat_bind + "," + bind_names[bi];
                };
                bi = bi + 1;
            };
        };

        parser_advance(p); // skip =>
        let body = parse_expr(p);

        let arm = MatchArm {
            pat_kind: pat_kind, pat_name: pat_name,
            pat_bind: pat_bind, body_expr: body,
        };
        p.match_arms.push(arm);
        arm_count = arm_count + 1;

        let t = parser_peek(p);
        if t.disc == 53 { parser_advance(p); };
    };

    parser_advance(p); // skip }

    let idx = add_expr(p, "match");
    p.expr_nodes[idx - 1].left = scrutinee;
    p.expr_nodes[idx - 1].extra_start = arm_start;
    p.expr_nodes[idx - 1].extra_count = arm_count;
    idx
}

// ── Statement parsing ──

fn parse_stmt(p: &mut Parser) -> i64 {
    let tok = parser_peek(p);
    let disc = tok.disc;

    // Let (5)
    if disc == 5 {
        parser_advance(p); // skip let
        let mut mutable = false;
        let t2 = parser_peek(p);
        if t2.disc == 6 { parser_advance(p); mutable = true; };

        // Check for tuple destructuring: let (a, b, c) = expr
        let t_after_mut = parser_peek(p);
        if t_after_mut.disc == 47 {
            // LParen — tuple destructuring
            parser_advance(p); // skip (
            let mut name_strs: Vec<str> = Vec::new();
            loop {
                let t = parser_peek(p);
                if t.disc == 48 { break; }; // RParen
                if t.disc == 61 { break; }; // Eof
                let pname_tok = parser_advance(p);
                name_strs.push(pname_tok.sval);
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); } // skip ,
                else { break; };
            };
            parser_advance(p); // skip )
            // Optional type annotation (rare for tuple destructure, but support syntax)
            let t3 = parser_peek(p);
            if t3.disc == 55 {
                parser_advance(p); // skip :
                parse_type_annotation(p, 42, 54, -1);
            };
            // Expect = init
            let t4 = parser_peek(p);
            let mut init: i64 = 0;
            if t4.disc == 42 {
                parser_advance(p);
                init = parse_expr(p);
            };
            // Create contiguous ident expr nodes for the variable names
            let names_start = p.expr_nodes.len() + 1;
            let names_count = name_strs.len();
            for i in 0..names_count {
                let nidx = add_expr(p, "ident");
                p.expr_nodes[nidx - 1].sval = name_strs[i];
            };
            let idx = add_stmt(p, "let_tuple");
            p.stmt_nodes[idx - 1].expr_idx = init;
            p.stmt_nodes[idx - 1].else_start = names_start;
            p.stmt_nodes[idx - 1].else_count = names_count;
            return idx;
        };

        let name_tok = parser_advance(p);
        let mut name = name_tok.sval;
        // Phase 5.2 step 4：检测类型注解是否为 f32（单 token 类型）
        // 用于在 `let x: f32 = <float_literal>` 时把字面量 dtype 提升为 F32，
        // 复用 step 2 已建立的 ival 通道（1=F32），下游 lower.th step 1 据此降级为 F32 类型。
        // Stage 7：用 parse_type_annotation 收集完整类型注解（支持复合类型如
        // Tensor[T, ..]），但 f32 字面量提升仅在类型注解恰好为 "f32" 时触发。
        let mut type_ann_is_f32 = false;
        let t3 = parser_peek(p);
        if t3.disc == 55 {
            parser_advance(p); // skip :
            // Collect full type annotation. Terminators: Assign(42), Semicolon(54).
            let ty_str = parse_type_annotation(p, 42, 54, -1);
            if ty_str == "f32" {
                type_ann_is_f32 = true;
            };
        };
        // =
        let t4 = parser_peek(p);
        if t4.disc == 42 {
            parser_advance(p);
            let init = parse_expr(p);
            // Phase 5.2 step 4：若类型注解为 f32 且初始表达式是直接 FloatLiteral，
            // 把字面量 dtype 改为 F32（ival=1）。
            if type_ann_is_f32 && init > 0 && init <= p.expr_nodes.len() {
                if p.expr_nodes[init - 1].kind == "float" {
                    p.expr_nodes[init - 1].ival = 1;
                };
            };
            let idx = add_stmt(p, "let");
            p.stmt_nodes[idx - 1].name = name;
            p.stmt_nodes[idx - 1].expr_idx = init;
            return idx;
        };
        let idx = add_stmt(p, "let");
        p.stmt_nodes[idx - 1].name = name;
        return idx;
    };

    // Return (10)
    if disc == 10 {
        parser_advance(p);
        let t2 = parser_peek(p);
        let mut expr_idx: i64 = 0;
        if !is_stmt_end(t2) { expr_idx = parse_expr(p); };
        let idx = add_stmt(p, "return");
        p.stmt_nodes[idx - 1].expr_idx = expr_idx;
        return idx;
    };

    // While (11)
    if disc == 11 {
        parser_advance(p);
        p.no_struct_literal = true;
        let cond = parse_expr(p);
        p.no_struct_literal = false;
        parser_advance(p); // skip {
        // Collect statements locally first, then push to shared loop_idxs AFTER
        let mut local_idxs: Vec<i64> = Vec::new();
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            let sidx = parse_stmt(p);
            local_idxs.push(sidx);
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let body_start = p.loop_idxs.len() + 1;
        let body_count = local_idxs.len();
        for i in 0..body_count {
            p.loop_idxs.push(local_idxs[i]);
        };
        let idx = add_stmt(p, "while");
        p.stmt_nodes[idx - 1].expr_idx = cond;
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // For (12) — for-in loop
    if disc == 12 {
        parser_advance(p); // skip for
        let name_tok = parser_advance(p);
        let name = name_tok.sval;
        parser_advance(p); // skip in
        // Suppress struct literal parsing for iterable — { belongs to for body
        p.no_struct_literal = true;
        let iterable = parse_expr(p);
        p.no_struct_literal = false;
        parser_advance(p); // skip {
        // Collect statements locally first, then push to shared loop_idxs AFTER
        let mut local_idxs: Vec<i64> = Vec::new();
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            let sidx = parse_stmt(p);
            local_idxs.push(sidx);
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let body_start = p.loop_idxs.len() + 1;
        let body_count = local_idxs.len();
        for i in 0..body_count {
            p.loop_idxs.push(local_idxs[i]);
        };
        let idx = add_stmt(p, "for");
        p.stmt_nodes[idx - 1].name = name;
        p.stmt_nodes[idx - 1].expr_idx = iterable;
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Break (14)
    if disc == 14 {
        parser_advance(p);
        return add_stmt(p, "break");
    };

    // Continue (15)
    if disc == 15 {
        parser_advance(p);
        return add_stmt(p, "continue");
    };

    // Loop (13)
    if disc == 13 {
        parser_advance(p);
        parser_advance(p); // skip {
        // Collect statements locally first, then push to shared loop_idxs AFTER
        let mut local_idxs: Vec<i64> = Vec::new();
        loop {
            let t2 = parser_peek(p);
            if is_end_of_block(t2) { break; };
            let sidx = parse_stmt(p);
            local_idxs.push(sidx);
            let ts = parser_peek(p); if ts.disc == 54 { parser_advance(p); };
        };
        parser_advance(p); // skip }
        let body_start = p.loop_idxs.len() + 1;
        let body_count = local_idxs.len();
        for i in 0..body_count {
            p.loop_idxs.push(local_idxs[i]);
        };
        let idx = add_stmt(p, "loop");
        p.stmt_nodes[idx - 1].body_start = body_start;
        p.stmt_nodes[idx - 1].body_count = body_count;
        return idx;
    };

    // Expression statement (default)
    let expr = parse_expr(p);
    let idx = add_stmt(p, "expr");
    p.stmt_nodes[idx - 1].expr_idx = expr;
    return idx;
}

// ── Top-level parsing ──

// Stage 7: Map a token to its string representation for composite type
// annotations. Operator/punctuation tokens (LBracket, Comma, DotDot, etc.)
// have empty `sval` in the lexer, so we map by `disc` to recover the source
// spelling. Identifier/keyword/literal tokens keep their `sval`.
fn token_type_str(t: Token) -> str {
    if t.sval != "" { return t.sval; };
    if t.disc == 51 { return "["; };
    if t.disc == 52 { return "]"; };
    if t.disc == 53 { return ","; };
    if t.disc == 57 { return ".."; };
    if t.disc == 56 { return "."; };
    if t.disc == 55 { return ":"; };
    if t.disc == 60 { return "::"; };
    if t.disc == 33 { return "<"; };
    if t.disc == 34 { return ">"; };
    if t.disc == 40 { return "&"; };        // Ampersand (batch 1: disc=40)
    if t.disc == 54 { return ";"; };        // Semicolon (for array types [T; N])
    if t.disc == 58 { return "->"; };       // Arrow
    if t.disc == 59 { return "=>"; };       // FatArrow
    if t.disc == 62 { return "..="; };      // DotDotEq
    if t.disc == 47 { return "("; };
    if t.disc == 48 { return ")"; };
    if t.disc == 49 { return "{"; };
    if t.disc == 50 { return "}"; };
    if t.disc == 63 { return ">>"; };
    ""
}

// Stage 7 + Problem 21 batch 2: Collect a type annotation that may include
// composite types like `Tensor[T, ..]`, `Vec<i64>`, `[T; N]`, `fn(i64) -> i64`.
// Returns the type as a canonical string (e.g., "Tensor[T,..]", "Vec<i64>",
// "fn(i64)->i64"). lower.th's parse_type recognizes these patterns.
//
// term1/term2/term3 are up to 3 terminator token discs that END the
// surrounding context at top level (pass -1 for unused slots).
// Inside `[...]`, `<...>`, or `(...)`, only Eof terminates — terminators are
// part of the type.
//
// All tokens use `token_type_str` for rendering (handles punctuation tokens
// with empty sval). Inside any bracket/angle/paren, tokens are joined without
// spaces (compact mode). At top level, tokens are joined with single spaces.
fn parse_type_annotation(p: &mut Parser, term1: i64, term2: i64, term3: i64) -> str {
    let mut result = "";
    let mut bracket_depth: i64 = 0;  // [ ]
    let mut angle_depth: i64 = 0;    // < >
    let mut paren_depth: i64 = 0;    // ( )
    loop {
        let t = parser_peek(p);
        if t.disc == 61 { break; };  // Eof always terminates
        // Terminators only apply at top level (all depths 0)
        if bracket_depth == 0 && angle_depth == 0 && paren_depth == 0 {
            if term1 >= 0 && t.disc == term1 { break; };
            if term2 >= 0 && t.disc == term2 { break; };
            if term3 >= 0 && t.disc == term3 { break; };
        };
        // Determine if we're inside any bracket/angle/paren (for compact joining)
        let in_bracket = bracket_depth > 0 || t.disc == 51;
        let in_angle = angle_depth > 0 || t.disc == 33;
        let in_paren = paren_depth > 0 || t.disc == 47;
        let compact = in_bracket || in_angle || in_paren;
        // Update depths BEFORE consuming
        if t.disc == 51 {
            bracket_depth = bracket_depth + 1;
        } else if t.disc == 52 {
            bracket_depth = bracket_depth - 1;
            if bracket_depth < 0 { bracket_depth = 0; };
        } else if t.disc == 33 {
            angle_depth = angle_depth + 1;
        } else if t.disc == 34 {
            angle_depth = angle_depth - 1;
            if angle_depth < 0 { angle_depth = 0; };
        } else if t.disc == 63 {
            // >> — close two angle levels
            angle_depth = angle_depth - 2;
            if angle_depth < 0 { angle_depth = 0; };
        } else if t.disc == 47 {
            paren_depth = paren_depth + 1;
        } else if t.disc == 48 {
            paren_depth = paren_depth - 1;
            if paren_depth < 0 { paren_depth = 0; };
        };
        let tok = parser_advance(p);
        // At top level (compact=false), use tok.sval so punctuation tokens are
        // dropped — this preserves backward compatibility with existing type
        // strings (e.g. `&str` → "str", `fn(i64) -> i64` → "fn i64 i64").
        // Inside brackets/angles/parens (compact=true), use token_type_str so
        // composite types like `Vec<i64>`, `[T;N]`, `fn(i64)` render correctly.
        let s = if compact { token_type_str(tok) } else { tok.sval };
        if compact {
            result = result + s;
        } else {
            if s != "" {
                if result != "" { result = result + " "; };
                result = result + s;
            };
        };
    };
    result
}

// Parse optional generic params `<T, U>` after a name. Returns Vec<str>.
// If next token is not `<` (disc=33), returns empty Vec.
fn parse_generic_params(p: &mut Parser) -> Vec<str> {
    let mut generics = Vec::new();
    let t = parser_peek(p);
    if t.disc != 33 { return generics; }; // not `<`
    parser_advance(p); // skip `<`
    loop {
        let t2 = parser_peek(p);
        if t2.disc == 34 || t2.disc == 63 { break; }; // `>` or `>>`
        let name_tok = parser_advance(p);
        generics.push(name_tok.sval);
        let t3 = parser_peek(p);
        if t3.disc == 53 { parser_advance(p); } // skip `,`
        else { break; };
    };
    // Consume `>` (or split `>>` into two `>` via expect_gt, mirroring Rust side)
    expect_gt(p);
    generics
}

fn parse_fn(p: &mut Parser, is_async: bool) -> FnDef {
    parser_advance(p); // skip fn
    // async already consumed by caller (parse_program / parse_impl_block)
    let name_tok = parser_advance(p);
    let name = name_tok.sval;
    // Parse optional generic params `<T, U>`
    let generics = parse_generic_params(p);
    parser_advance(p); // skip (
    let mut params = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_paren(t) { break; };
        // Handle self/&self/&mut self params (for impl methods)
        if t.sval == "self" {
            parser_advance(p); // skip self
            params.push(Param { name: "self", type_ann: "self" });
            let t2 = parser_peek(p);
            if t2.disc == 53 { parser_advance(p); }
            else { break; };
        } else if t.disc == 38 {
            // &self or &mut self
            parser_advance(p); // skip &
            let mut ptype = "&";
            let t3 = parser_peek(p);
            if t3.sval == "mut" {
                parser_advance(p); // skip mut
                ptype = "&mut ";
            };
            let t4 = parser_peek(p);
            if t4.sval == "self" {
                parser_advance(p); // skip self
                ptype = ptype + "self";
                params.push(Param { name: "self", type_ann: ptype });
                let t5 = parser_peek(p);
                if t5.disc == 53 { parser_advance(p); }
                else { break; };
            } else {
                // Not a self param — & is part of type, backtrack not possible
                // Treat as normal param with & prefix (shouldn't happen in practice)
                let pname_tok = parser_advance(p);
                let pname = pname_tok.sval;
                parser_advance(p); // skip :
                // Stage 7: collect type annotation via parse_type_annotation
                // to support composite types. Terminators: Comma(53), RParen(48).
                let rest = parse_type_annotation(p, 53, 48, -1);
                let ptype2 = ptype + " " + rest;
                params.push(Param { name: pname, type_ann: ptype2 });
                let t6 = parser_peek(p);
                if t6.disc == 53 { parser_advance(p); }
                else { break; };
            };
        } else {
            let pname_tok = parser_advance(p);
            let pname = pname_tok.sval;
            parser_advance(p); // skip :
            // Stage 7: collect type annotation via parse_type_annotation to
            // support composite types like `Tensor[T, ..]`. Terminators at
            // top level: Comma(53), RParen(48). Eof(61) handled internally.
            let ptype = parse_type_annotation(p, 53, 48, -1);
            params.push(Param { name: pname, type_ann: ptype });
            let t2 = parser_peek(p);
            if t2.disc == 53 { parser_advance(p); }
            else { break; };
        };
    };
    parser_advance(p); // skip )

    let mut return_type = "";
    let t3 = parser_peek(p);
    if t3.disc == 58 {
        parser_advance(p);
        // Stage 7: collect return type via parse_type_annotation.
        // Terminators: LBrace(49). Eof(61) handled internally.
        return_type = parse_type_annotation(p, 49, -1, -1);
    };

    parser_advance(p); // skip {
    // Collect statements in a LOCAL Vec first, then push to shared block_idxs
    // AFTER the loop. This prevents nested block expressions (e.g. if expressions)
    // from interleaving their statements with the function body in the shared array.
    let mut local_idxs: Vec<i64> = Vec::new();
    loop {
        let t4 = parser_peek(p);
        if is_end_of_block(t4) { break; };
        let sidx = parse_stmt(p);
        local_idxs.push(sidx);
        // skip optional semicolon
        let ts = parser_peek(p);
        if ts.disc == 54 { parser_advance(p); };
    };
    parser_advance(p); // skip }
    // NOW push all collected statements contiguously to the shared array
    let body_start = p.block_idxs.len() + 1;
    let body_count = local_idxs.len();
    for i in 0..body_count {
        p.block_idxs.push(local_idxs[i]);
    };

    FnDef { name: name, params: params, return_type: return_type, body_start: body_start, body_count: body_count, generics: generics, is_async: is_async }
}

fn parse_struct_def(p: &mut Parser) -> StructDef {
    parser_advance(p); // skip struct
    let name_tok = parser_advance(p);
    let mut name = name_tok.sval;
    // Parse optional generic params `<T, U>`
    let generics = parse_generic_params(p);
    parser_advance(p); // skip {
    let mut fields = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let fname_tok = parser_advance(p);
        let fname = fname_tok.sval;
        parser_advance(p); // skip :
        // Stage 7: collect type annotation via parse_type_annotation.
        // Terminators: Comma(53), RBrace(50). Eof(61) handled internally.
        let ftype = parse_type_annotation(p, 53, 50, -1);
        fields.push(StructField { name: fname, type_ann: ftype });
        let t2 = parser_peek(p);
        if t2.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip }
    StructDef { name: name, fields: fields, generics: generics }
}

fn parse_enum_def(p: &mut Parser) -> EnumDef {
    parser_advance(p); // skip enum
    let name_tok = parser_advance(p);
    let name = name_tok.sval;
    parser_advance(p); // skip {
    let mut variants = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        let vname_tok = parser_advance(p);
        let vname = vname_tok.sval;
        let mut vfields = Vec::new();
        let t2 = parser_peek(p);
        if t2.disc == 47 {
                parser_advance(p);
                let mut fidx: i64 = 0;
                loop {
                    let t3 = parser_peek(p);
                    if is_end_of_paren(t3) { break; };
                    let fname_tok = parser_advance(p);
                    let fname = fname_tok.sval;
                    // Check if next is : (named field) or ,/) (tuple field)
                    let t_after = parser_peek(p);
                    if t_after.disc == 55 {
                        // Named field: name: type
                        parser_advance(p); // skip :
                        // Stage 7: collect type annotation via parse_type_annotation.
                        // Terminators: Comma(53), RParen(48). Eof(61) handled internally.
                        let ftype = parse_type_annotation(p, 53, 48, -1);
                        vfields.push(StructField { name: fname, type_ann: ftype });
                    } else {
                        // Tuple field: type only (fname is actually the type)
                        vfields.push(StructField { name: fname, type_ann: fname });
                    };
                    fidx = fidx + 1;
                    let t4 = parser_peek(p);
                    if t4.disc == 53 { parser_advance(p); }
                    else { break; };
                };
                parser_advance(p); // skip )
        };
        variants.push(EnumVariant { name: vname, fields: vfields });
        let t5 = parser_peek(p);
        if t5.disc == 53 { parser_advance(p); }
        else { break; };
    };
    parser_advance(p); // skip }
    EnumDef { name: name, variants: variants }
}

// ── Trait definition parsing ──
// trait Name { fn method(params) -> ret; fn method2(params) -> ret; }
fn parse_trait_def(p: &mut Parser) -> TraitDef {
    parser_advance(p); // skip trait
    let name_tok = parser_advance(p);
    let name = name_tok.sval;
    parser_advance(p); // skip {
    let mut methods = Vec::new();
    loop {
        let t = parser_peek(p);
        if is_end_of_block(t) { break; };
        // Expect fn (disc 4)
        if t.disc != 4 { break; };
        parser_advance(p); // skip fn
        let mname_tok = parser_advance(p);
        let mname = mname_tok.sval;
        parser_advance(p); // skip (
        // Parse params (same pattern as parse_fn, with self support)
        let mut params = Vec::new();
        loop {
            let pt = parser_peek(p);
            if is_end_of_paren(pt) { break; };
            // Handle self/&self/&mut self
            if pt.sval == "self" {
                parser_advance(p);
                params.push(Param { name: "self", type_ann: "self" });
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); }
                else { break; };
            } else if pt.disc == 38 {
                parser_advance(p); // skip &
                let mut ptype = "&";
                let t3 = parser_peek(p);
                if t3.sval == "mut" { parser_advance(p); ptype = "&mut "; };
                let t4 = parser_peek(p);
                if t4.sval == "self" {
                    parser_advance(p);
                    ptype = ptype + "self";
                    params.push(Param { name: "self", type_ann: ptype });
                    let t5 = parser_peek(p);
                    if t5.disc == 53 { parser_advance(p); }
                    else { break; };
                } else {
                    break;
                };
            } else {
                let pname_tok = parser_advance(p);
                let pname = pname_tok.sval;
                parser_advance(p); // skip :
                // Stage 7: collect type annotation via parse_type_annotation.
                // Terminators: Comma(53), RParen(48). Eof(61) handled internally.
                let ptype = parse_type_annotation(p, 53, 48, -1);
                params.push(Param { name: pname, type_ann: ptype });
                let t2 = parser_peek(p);
                if t2.disc == 53 { parser_advance(p); }
                else { break; };
            };
        };
        parser_advance(p); // skip )
        // Optional return type
        let mut return_type = "";
        let t3 = parser_peek(p);
        if t3.disc == 58 {
            parser_advance(p); // skip :
            // Stage 7: collect return type via parse_type_annotation.
            // Terminators: Semicolon(54), RBrace(50). Eof(61) handled internally.
            return_type = parse_type_annotation(p, 54, 50, -1);
        };
        // Skip semicolon (method signature, no body)
        let t4 = parser_peek(p);
        if t4.disc == 54 { parser_advance(p); };
        methods.push(TraitMethodSig { name: mname, params: params, return_type: return_type });
    };
    parser_advance(p); // skip }
    TraitDef { name: name, methods: methods }
}

// ── Impl block parsing ──
// impl Trait for Type { fn method(...) {...} }  or  impl Type { fn method(...) {...} }
fn parse_impl_block(p: &mut Parser) -> ImplBlock {
    parser_advance(p); // skip impl
    let name1_tok = parser_advance(p);
    let name1 = name1_tok.sval;
    let mut trait_name = "";
    let mut type_name = name1;
    // Check for `for` (disc 12)
    let t = parser_peek(p);
    if t.disc == 12 {
        trait_name = name1;
        parser_advance(p); // skip for
        let type_tok = parser_advance(p);
        type_name = type_tok.sval;
    };
    parser_advance(p); // skip {
    let mut fns = Vec::new();
    loop {
        let t2 = parser_peek(p);
        if is_end_of_block(t2) { break; };
        if t2.disc != 4 && t2.disc != 64 { break; }; // expect fn or async fn
        let is_async = (t2.disc == 64);
        if is_async { parser_advance(p); }; // skip async
        fns.push(parse_fn(p, is_async));
        let t3 = parser_peek(p);
        if t3.disc == 54 { parser_advance(p); };
    };
    parser_advance(p); // skip }
    ImplBlock { trait_name: trait_name, type_name: type_name, fns: fns }
}

// ── Pattern helpers (avoids OR-patterns) ──

fn is_end_of_block(tok: Token) -> bool {
    let d = tok.disc;
    d == 50 || d == 61  // RBrace(50) or Eof(61)
}

fn is_end_of_paren(tok: Token) -> bool {
    let d = tok.disc;
    d == 48 || d == 61  // RParen(48) or Eof(61)
}

fn is_stmt_end(tok: Token) -> bool {
    let d = tok.disc;
    d == 54 || d == 50 || d == 61  // Semicolon(54), RBrace(50), Eof(61)
}

fn parse_program(tokens: Vec<Token>) -> Program {
    let mut p = parser_new(tokens);

    let mut structs = Vec::new();
    let mut enums = Vec::new();
    let mut fns = Vec::new();
    let mut trait_defs = Vec::new();
    let mut impls = Vec::new();
    // Collect main statements in a LOCAL Vec first, then push to shared block_idxs
    // AFTER the loop. This prevents nested block expressions from interleaving.
    let mut main_local_idxs: Vec<i64> = Vec::new();

    loop {
        if parser_at_eof(&p) { break; };
        let d = parser_peek(&p).disc;

        // Struct (16)
        if d == 16 {
            structs.push(parse_struct_def(&mut p));
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 17 {
            // Enum (17)
            enums.push(parse_enum_def(&mut p));
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 4 || d == 64 {
            // Fn (4) or async fn (Async=64, consume async then parse_fn)
            let is_async = (d == 64);
            if is_async { parser_advance(&mut p); };
            fns.push(parse_fn(&mut p, is_async));
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 19 {
            // Trait (19)
            trait_defs.push(parse_trait_def(&mut p));
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 18 {
            // Impl (18)
            impls.push(parse_impl_block(&mut p));
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 70 {
            // Pub (70) — visibility modifier, skip and let next iteration handle the declaration
            parser_advance(&mut p);
        } else if d == 20 {
            // Use (20) — use path::to::item; or use path::*;
            // Parse and discard (tenthc has no module system yet)
            parser_advance(&mut p); // skip use
            loop {
                let t = parser_peek(&p);
                if t.disc == 54 || t.disc == 61 { break; }; // ; or Eof
                parser_advance(&mut p);
            };
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 21 {
            // Mod (21) — mod name; or mod name { items }
            // Parse and discard (tenthc has no module system yet)
            parser_advance(&mut p); // skip mod
            parser_advance(&mut p); // skip name
            let t = parser_peek(&p);
            if t.disc == 49 {
                // { — skip to matching }
                let mut depth: i64 = 1;
                parser_advance(&mut p); // skip {
                loop {
                    let t2 = parser_peek(&p);
                    if t2.disc == 61 { break; }; // Eof
                    if t2.disc == 49 { depth = depth + 1; };
                    if t2.disc == 50 {
                        depth = depth - 1;
                        if depth == 0 { parser_advance(&mut p); break; };
                    };
                    parser_advance(&mut p);
                };
            };
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else if d == 61 {
            // Eof (61)
            break;
        } else if is_expr_start_token(d) {
            // Top-level expression statement (legal expression-start token)
            let sidx = parse_stmt(&mut p);
            main_local_idxs.push(sidx);
            if parser_peek(&p).disc == 54 { parser_advance(&mut p); };
        } else {
            // Unrecognized top-level token — record error and recover via synchronize
            // (panic-mode recovery: skip to next SYNC_TOKEN or Eof)
            record_error_and_recover(&mut p, "unrecognized top-level token disc=" + int_to_str(d));
        };
    };
    // NOW push all collected main statements contiguously to the shared array
    let main_stmts_start = p.block_idxs.len() + 1;
    let main_count = main_local_idxs.len();
    for i in 0..main_count {
        p.block_idxs.push(main_local_idxs[i]);
    };

    Program {
        structs: structs,
        enums: enums,
        fns: fns,
        trait_defs: trait_defs,
        impls: impls,
        main_stmts_start: main_stmts_start,
        main_stmts_count: main_count,
        expr_nodes: p.expr_nodes,
        stmt_nodes: p.stmt_nodes,
        match_arms: p.match_arms,
        block_idxs: p.block_idxs,
        loop_idxs: p.loop_idxs,
    }
}
