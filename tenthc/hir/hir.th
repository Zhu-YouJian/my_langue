// HIR data structures — v0.3.3 compact flat representation
// Based on tenth/src/hir/hir.rs + types.rs, adapted for Tenth's type system
// Uses `..` default field syntax for zero-value initialization

// ── Base type discriminants ──
// 0:I64 1:I32 2:F64 3:F32 4:Bool 5:Str 6:Unit 7:Char
// 8:I8 9:I16 10:U8 11:U16 12:U32 13:U64 14:F16 15:BF16

// ── HirType (flattened) ──
// disc: 0=Base 1=Tensor 2=Array 3=FnType 4=TypeParam 5=Generic 6=Ref 7=MutRef
//       8=Struct 9=Enum 10=Unknown 11=Unit
// Problem 21 batch 3 新增（追加 disc，不改已有值）:
//       12=Never   13=Tuple  14=Future  15=Range
//
// 字段复用约定（与 Rust 侧 types.rs 对齐）：
//   Never  (disc=12): 无字段（发散类型 `!`，unify 时统一到任何类型 T）
//   Tuple  (disc=13): params_start/params_count 指向 type_args 中的元素类型索引
//   Future (disc=14): sub = inner type index（Future<T> 的 T）
//   Range  (disc=15): sub = inner type index（Range<T> 的 T）
//                     dim0 = inclusive 标志（0=false 半开区间 `a..b`，1=true 闭区间 `a..=b`）
struct HirType {
    disc: i64,
    sub: i64,         // BaseType discriminant, or inner type index
    name: str,        // for TypeParam/Struct/Enum
    params_start: i64, // start in type_args / type_params flat arrays
    params_count: i64,
    ret_ty: i64,      // return type index (for FnType)
    // ── Shape info (Phase 4: tenthc shape check) ──
    // For Tensor (disc=1): tracks Known dims for compile-time shape checking.
    // dim_count=0 → unknown/Any/Symbol (skip check); 1 → 1D (dim0); 2 → 2D (dim0=M, dim1=K/N)
    // For Range (disc=15): dim0 复用为 inclusive 标志（0=false, 1=true）。
    // Non-Tensor types: always 0. Uses `..` default for zero-init.
    dim_count: i64,
    dim0: i64,
    dim1: i64,
    // ── Stage 7: Tensor dtype as type index ──
    // For Tensor (disc=1): 0 = dtype is BaseType (use `sub` field),
    // non-0 = index into type_nodes (e.g., TypeParam node for generic T).
    // Lets `Tensor[T, ..]` annotations carry a TypeParam dtype, mirroring
    // Rust side `Type::Tensor.dtype: Box<Type>` (types.rs:22-25).
    // Non-Tensor types: always 0. Uses `..` default for zero-init.
    dtype_ty: i64,
}

// ── HirExpr node (flat, all fields) ──
// disc values:
//   0: IntLiteral   1: FloatLiteral  2: BoolLiteral  3: StringLiteral
//   4: Var          5: Binary        6: Unary         7: Call
//   8: MethodCall   9: Index        10: Field        11: FieldAssign
//  12: If          13: Block        14: Assign       15: StructLiteral
//  16: EnumLiteral 17: Match        18: Ref          19: MutRef
//  20: Deref       21: Return       22: ArrayLiteral 23: Closure
//  24: AssignOp    25: GenericCall  26: DerefAssign  27: DerefAssignOp
//  28: Range       29: TensorLiteral 30: Move
//  31: Slice       32: Await         33: Spawn
// Problem 21 batch 3 新增（追加 disc，不改已有值）:
//  34: Try         35: As           36: Tuple
//
// 字段复用约定：
//   Try (disc=34): left = inner expr；ty = inner 的类型（Try 解包 Result/Option，类似 ?）
//   As  (disc=35): left = inner expr；ty = 目标类型索引（expr as T 中的 T）
//   Tuple (disc=36): args_start/args_count 指向 arg_list 中的元素 expr 索引；
//                    ty 为 Tuple 类型索引（disc=13）
//   注：parser 当前对 tuple 字面量产出 kind="tuple"，原 lower.th 复用 disc=22
//   (ArrayLiteral) 编码。本批次新增 disc=36 以区分语义（Tuple vs Array），
//   但 wasm 后端处理仍与 ArrayLiteral 一致（逐元素 lower 后打包）。
struct HirExpr {
    disc: i64,
    // Literal values
    lit_ival: i64,
    lit_fval: f64,
    lit_sval: str,
    lit_bval: bool,
    // References to other exprs (1-based, 0=nil)
    left: i64,
    right: i64,
    cond: i64,
    body: i64,
    alt: i64,        // else_branch
    // Flat sub-arrays
    args_start: i64,
    args_count: i64,
    stmts_start: i64,
    stmts_count: i64,
    fields_start: i64,
    fields_count: i64,
    generics_start: i64,
    generics_count: i64,
    params_start: i64,
    params_count: i64,
    // Closure captures (flat array of name indices)
    captures_start: i64,
    captures_count: i64,
    // Names
    op: str,         // Binary/Unary operator
    name: str,       // Var name, field name, method name, struct name
    variant: str,    // Enum variant name
    // Range flags
    range_inclusive: bool,
    // Type
    ty: i64,         // type index in program.type_nodes (1-based, 0=unknown)
}

// ── HirStmt (flattened) ──
// disc: 0=Let 1=Expr 2=Return 3=While 4=For 5=Break 6=Continue 7=Loop
struct HirStmt {
    disc: i64,
    name: str,       // let variable name / for loop var
    expr: i64,       // expr index
    cond: i64,       // while condition expr index
    body_start: i64, // start in stmt_nodes for While/For/Loop body
    body_count: i64,
    init: i64,       // let initializer expr index
    mutable: bool,
}

// ── Fn param ──
struct HirParam { name: str, ty: i64 }

// ── Match arm ──
// pat_disc 编码（与 Rust 侧 hir.rs HirPattern 对齐）：
//   0=EnumVariant  1=Wildcard  2=Literal
// Problem 21 batch 3 新增（追加 disc，不改已有值）:
//   3=Struct       4=Binding    5=Range     6=Tuple
//
// 字段复用约定：
//   EnumVariant (0): pat_enum=枚举名, pat_variant=变体名, pat_bind=字段绑定串
//   Wildcard    (1): 无字段
//   Literal     (2): pat_variant=字面量字符串
//   Struct      (3): pat_enum=结构体名, pat_bind=字段绑定串（"x: a, y: b" 格式）
//                    穷尽性检查视为通配（覆盖所有）
//   Binding     (4): pat_bind=绑定变量名；穷尽性检查视为通配（覆盖所有）
//   Range       (5): pat_bind=范围串（如 "1..10" 或 "1..=10"）；穷尽性检查视为不覆盖
//   Tuple       (6): pat_bind=子模式描述；穷尽性检查视为通配（覆盖所有）
//                    parser 当前不记录子模式细节，lower 时按通配处理
struct HirMatchArm {
    pat_disc: i64,   // 0=EnumVariant 1=Wildcard 2=Literal 3=Struct 4=Binding 5=Range 6=Tuple
    pat_enum: str,
    pat_variant: str,
    pat_bind: str,
    body_expr: i64,  // expr index
}

// ── HirFnDef ──
struct HirFnDef {
    name: str,
    params: Vec<HirParam>,
    return_type: i64,  // type index
    body: i64,         // expr index
    generics: Vec<str>,
    is_async: bool,    // async fn flag (Phase 1: stored, not yet affecting codegen)
}

// ── Struct field definition ──
struct HirStructField { name: str, ty: i64 }

// ── Struct definition ──
struct HirStructDef { name: str, fields: Vec<HirStructField>, generics: Vec<str> }

// ── Enum variant definition (for enum literal layout) ──
struct HirEnumVariantDef { name: str, fields: Vec<HirStructField> }

// ── Enum definition ──
struct HirEnumDef { name: str, variants: Vec<HirEnumVariantDef> }

// ── Trait method signature (in trait definition) ──
struct HirTraitMethod {
    name: str,
    params_start: i64,   // 扁平索引 → trait_method_params
    params_count: i64,
    return_type: i64,    // 类型索引
}

// ── Trait definition ──
struct HirTraitDef {
    name: str,
    methods_start: i64,  // 扁平索引 → trait_methods
    methods_count: i64,
}

// ── Trait implementation (trait_name for type_name) ──
struct HirTraitImpl {
    trait_name: str,     // 空字符串 = inherent impl（impl Type { ... }）
    type_name: str,
    fn_indices_start: i64,  // 扁平索引 → impl_fn_indices（指向 p.fns 的 1-based 索引）
    fn_indices_count: i64,
}

// ── Capture name entry (for closure captures) ──
struct HirCapture { name: str }

// ── Variable type entry (for type inference) ──
struct HirVarType { name: str, ty: i64 }

// ── Ownership state entry (for borrow checking) ──
// state encoding: 0=Owned, 100+n=SharedRef(n), 2=ExclusiveRef, 3=Moved
struct HirOwnership { name: str, state: i64 }

// ── Borrow holder entry (AUDIT-11.1.1 / T19 B6 修复) ──
// 记录持久借用关系：holder 持有 borrowed 的引用。
// 由 `let r = &x;` / `let m = &mut x;` / `let r = if c { &x } else { &y };` 触发，
// 让 release_borrows 在 holder 仍活跃（Owned/SharedRef/ExclusiveRef，未 Moved）
// 时保留 borrowed 的借用状态，防止跨语句借用被偷走。
struct HirBorrowHolder { holder: str, borrowed: str }

// ── Borrow check error (collected during lowering, does not abort) ──
struct HirError { message: str }

// ── HirProgram ──
struct HirProgram {
    fns: Vec<HirFnDef>,
    main_expr: i64,     // 0 = none
    expr_nodes: Vec<HirExpr>,
    stmt_nodes: Vec<HirStmt>,
    type_nodes: Vec<HirType>,
    type_args: Vec<i64>,    // flat: type indices referenced by HirType.params
    type_params: Vec<i64>,  // flat: type indices for FnType params
    match_arms: Vec<HirMatchArm>,
    structs: Vec<HirStructDef>,
    enums: Vec<HirEnumDef>,  // enum definitions for enum literal layout
    captures: Vec<HirCapture>,  // flat: closure capture names
    var_types: Vec<HirVarType>, // variable name → type index (for type inference)
    arg_list: Vec<i64>,   // flat: actual expr indices for Call/StructLiteral/EnumLiteral/MethodCall args
    stmt_list: Vec<i64>,  // flat: actual stmt indices for Block bodies
    body_list: Vec<i64>,  // flat: actual stmt indices for For/While/Loop bodies
    block_idxs: Vec<i64>, // parser: actual stmt indices for block scopes (fn body, block expr)
    loop_idxs: Vec<i64>,  // parser: actual stmt indices for loop scopes (for/while/loop body)
    trait_defs: Vec<HirTraitDef>,
    trait_impls: Vec<HirTraitImpl>,
    trait_methods: Vec<HirTraitMethod>,       // 扁平：所有 trait 方法签名
    trait_method_params: Vec<HirParam>,       // 扁平：所有 trait 方法参数
    impl_fn_indices: Vec<i64>,                // 扁平：impl 方法的 p.fns 索引（1-based）
    impl_method_names: Vec<str>,              // 扁平：impl 方法原始名（与 impl_fn_indices 并行）
    generic_funcs: Vec<HirFnDef>,             // 泛型函数模板（不输出到 WASM，仅用于实例化）
    ownership: Vec<HirOwnership>,             // 借用检查：变量所有权状态
    borrow_holders: Vec<HirBorrowHolder>,     // 跨语句借用跟踪（AUDIT-11.1.1/T19 B6）
    errors: Vec<HirError>,                    // 借用检查错误（不中断编译）
    // Problem 21 批次4：编译期 warning（与 Rust 侧 TenthWarning 对齐）
    // 用于内存/FLOPs 预估等不中断编译的提示信息。
    warnings: Vec<HirError>,
}
