// Logging utilities
//
// Provides simple logging with levels: DEBUG, INFO, WARN, ERROR
//
// ⚠️ 已知限制（2026-08-02 记录）：本模块依赖顶层 `let` 绑定（LEVEL_* 常量与
// 可变 log_level 状态），而当前语言中**顶层 let 对函数不可见**（含同文件内），
// 且模块级状态不随 `use` 导入带入——因此本模块的 debug/info/warn/error/set_level
// 当前无法被调用（编译期报“未定义变量 LEVEL_*”）。
// 待语言层修复（顶层 let 作用域 + 模块状态导入）后本模块即可使用；
// 在此之前请参考 `Tenth实例/日志系统/logging_demo.th` 的无状态显式级别实现。
//
// Usage:
//   use std::logging::logging

/// Log levels
let LEVEL_DEBUG: i32 = 0;
let LEVEL_INFO: i32 = 1;
let LEVEL_WARN: i32 = 2;
let LEVEL_ERROR: i32 = 3;

/// Current minimum log level (only messages at or above this level are shown)
let mut log_level: i32 = LEVEL_INFO;

/// Format a log message with level prefix
fn format_message(level: i32, msg: String) -> String {
    if level == LEVEL_DEBUG {
        "[DEBUG] " + msg
    } else if level == LEVEL_INFO {
        "[INFO] " + msg
    } else if level == LEVEL_WARN {
        "[WARN] " + msg
    } else {
        "[ERROR] " + msg
    }
}

/// Log a debug message
fn debug(msg: String) {
    if log_level <= LEVEL_DEBUG {
        println(format_message(LEVEL_DEBUG, msg));
    }
}

/// Log an info message
fn info(msg: String) {
    if log_level <= LEVEL_INFO {
        println(format_message(LEVEL_INFO, msg));
    }
}

/// Log a warning message
fn warn(msg: String) {
    if log_level <= LEVEL_WARN {
        println(format_message(LEVEL_WARN, msg));
    }
}

/// Log an error message
fn error(msg: String) {
    if log_level <= LEVEL_ERROR {
        println(format_message(LEVEL_ERROR, msg));
    }
}

/// Set the minimum log level
fn set_level(level: i32) {
    log_level = level;
}
