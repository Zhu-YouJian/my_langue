// DataLoader — batch iteration over datasets
//
// Since Tenth doesn't yet support generators/iterators, this module
// provides a struct-based API where the caller manually advances the
// cursor.
//
// L2.2 修复：next_batch 本身不推进 cursor（返回切片不更新状态），
// 迭代需配合 advance() 手动推进。正确迭代模式：
//   let mut loader = new(data, batch_sz);
//   while loader.has_next() {
//       let batch = next_batch(loader);
//       let loader = advance(loader);   // 值语义：返回推进后的新 DataLoader
//       // 处理 batch ...
//   }
//
// M4.3 增强：shuffled() 打乱数据顺序（Fisher-Yates，需随机种子可复现）。
// 实现注记（M4.3）：不使用 `use std::random::random::shuffle`——编译器的 use
// 作用域在多模块通配导入时会互相污染内部 use 符号（M4.3 实测：先 use 的模块
// 内部 use 被后 use 模块覆盖，导致 shuffle 解析成 Unit 或未定义）。故此处直接
// 调用内置 native `random_int` 内联实现 Fisher-Yates，与 std::random::random
// 中 shuffle 语义一致（含端点、确定性 seed 复现）。

// Create a DataLoader struct with dataset and batch configuration.
// Fields:
//   data     — the full dataset (Vec of samples)
//   batch_sz — number of samples per batch
//   cursor   — current position in the dataset
//   len      — total number of samples
struct DataLoader {
    data: Vec,
    batch_sz: i32,
    cursor: i32,
    len: i32,
}

// Construct a new DataLoader
fn new(data: Vec, batch_sz: i32) -> DataLoader {
    DataLoader {
        data: data,
        batch_sz: batch_sz,
        cursor: 0,
        len: data.len(),
    }
}

// Check if there are more batches available
fn has_next(loader: DataLoader) -> bool {
    loader.cursor < loader.len
}

// Get the next batch (slice from cursor to cursor+batch_sz)
// Returns a Vec of samples. Does NOT advance the cursor (value semantics);
// call advance() to move to the next batch. If remaining samples < batch_sz,
// returns whatever is left.
fn next_batch(loader: DataLoader) -> Vec {
    let start = loader.cursor;
    let end = if start + loader.batch_sz > loader.len {
        loader.len
    } else {
        start + loader.batch_sz
    };
    // Note: Vec slicing requires index range — using get() in a loop
    let mut batch = Vec::new();
    let mut i = start;
    while i < end {
        batch.push(loader.data.get(i));
        i = i + 1;
    }
    batch
}

// Advance the cursor by one batch (value semantics: returns a new DataLoader).
// L2.2 修复：原 next_batch 不推进 cursor 导致无法迭代（死循环）；
// 本函数提供手动推进，与 next_batch 配合实现多 batch 迭代。
fn advance(loader: DataLoader) -> DataLoader {
    let start = loader.cursor;
    let end = if start + loader.batch_sz > loader.len {
        loader.len
    } else {
        start + loader.batch_sz
    };
    DataLoader {
        data: loader.data,
        batch_sz: loader.batch_sz,
        cursor: end,
        len: loader.len,
    }
}

// Reset the cursor to the beginning
fn reset(loader: DataLoader) -> DataLoader {
    DataLoader {
        data: loader.data,
        batch_sz: loader.batch_sz,
        cursor: 0,
        len: loader.len,
    }
}

// Get the number of batches
fn num_batches(loader: DataLoader) -> i32 {
    (loader.len + loader.batch_sz - 1) / loader.batch_sz
}

// Shuffle the dataset order (Fisher-Yates, via 内置 native random_int).
// Returns a NEW DataLoader with shuffled data and cursor reset to 0.
// M4.3 新增：每 epoch 前调用实现随机 batch 顺序（配合 rand_seed 可复现）。
// 注：就地打乱传入副本（值语义）避免影响原 loader。
fn shuffled(loader: DataLoader) -> DataLoader {
    // 内部 Fisher-Yates（与 std::random::random::shuffle 语义一致，避免 use 符号污染）
    let data = loader.data;
    let len = data.len();
    let mut i = len - 1;
    while i > 0 {
        let j = random_int(0, i);
        let tmp = data.get(i);
        data.set(i, data.get(j));
        data.set(j, tmp);
        i = i - 1;
    }
    DataLoader {
        data: data,
        batch_sz: loader.batch_sz,
        cursor: 0,
        len: loader.len,
    }
}
