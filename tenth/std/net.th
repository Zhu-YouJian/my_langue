// TCP networking primitives
//
// Usage:
//   use std::net

fn connect(host: String, port: i64) -> Result<i64> {
    tcp_connect(host, port)
}

fn read(handle: i64, n: i64) -> Result<Vec<i64>> {
    tcp_read(handle, n)
}

fn write(handle: i64, data: Vec<i64>) -> Result<i64> {
    tcp_write(handle, data)
}

fn close(handle: i64) {
    tcp_close(handle)
}

fn set_timeout(handle: i64, ms: i64) {
    tcp_set_timeout(handle, ms)
}

// TCP 服务端原语（句柄表模式，handle 1-based，0 表示无效）
// listen 返回 listener handle；accept 返回 stream handle（可用 read/write/close）
// listener_close 关闭监听器，drop 自动释放资源

fn listen(addr: String) -> Result<i64> {
    tcp_listen(addr)
}

fn accept(listener_handle: i64) -> Result<i64> {
    tcp_accept(listener_handle)
}

fn listener_close(listener_handle: i64) {
    tcp_listener_close(listener_handle)
}

// ── UDP networking primitives（基本功核查第 69 项） ──
//
// UDP 无连接：bind 后用 send_to/recv_from 携带对端地址。
// handle 表与 TCP 独立（避免类型混淆），索引+1 即句柄（1-based，0 表示无效）。
//
// 与 TCP 不同，UDP native 直接以 `udp_*` 前缀对外暴露（无简短 wrapper），
// 因为 `close`/`set_timeout` 与 TCP wrapper 同名会冲突，且 native 名已足够清晰。
// 用户可直接调用 `udp_bind(addr)` 等，与 tests/udp_test.rs 中的调用方式一致。
//
// 返回值约定：
//   udp_bind(addr)              -> Result<i64>                       — Ok(handle) 或 Err(msg)
//   udp_recv_from(sock, n)      -> Result<Tuple<Vec<i64>, String>>   — Ok((bytes, peer_addr)) 或 Err(msg)
//   udp_send_to(sock, data, addr)-> Result<i64>                      — Ok(bytes_sent) 或 Err(msg)
//   udp_close(sock)             -> Unit
//   udp_set_timeout(sock, ms)   -> Unit
