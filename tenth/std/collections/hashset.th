// HashSet — 基于 HashMap 的集合（无序不重复元素）
//
// Usage:
//   use std::collections::hashset::*
//   let set = HashSet::new();
//   set.contains("hello")   // false
//   let set = set.insert("hello");
//   set.contains("hello")   // true
//   set.len()               // 1
//   let set = set.remove("hello");
//   set.is_empty()          // true
//   set.to_array()          // Vec of keys (strings, order undefined)
//
// 底层用 HashMap 实现。键为 String（由 HashMap 自动转换）。

struct HashSet {
    inner: HashMap,
}

// 创建一个新的空 HashSet。
fn new() -> HashSet {
    HashSet { inner: HashMap::new() }
}

// 插入一个值。如果值已存在，不做任何事。
// 返回 HashSet 自身以支持链式调用：set = set.insert(v1).insert(v2)
fn insert(set: HashSet, value) -> HashSet {
    set.inner.insert(value, ());
    set
}

// 检查是否包含某个值。
fn contains(set: HashSet, value) -> bool {
    set.inner.contains_key(value)
}

// 移除一个值（如果存在）。返回更新后的 HashSet。
fn remove(set: HashSet, value) -> HashSet {
    set.inner.remove(value);
    set
}

// 返回元素数量。
fn len(set: HashSet) -> i64 {
    set.inner.len()
}

// 检查是否为空。
fn is_empty(set: HashSet) -> bool {
    set.inner.is_empty()
}

// 转换为 Array（元素为 String 键，顺序不确定）。
fn to_array(set: HashSet) -> Vec {
    set.inner.keys()
}

// 清空集合。
fn clear(set: HashSet) -> HashSet {
    HashSet { inner: HashMap::new() }
}

// ── 集合运算（返回新 HashSet，不修改输入） ──

// 从 Vec 创建 HashSet（自动去重）。
fn from_array(arr: Vec) -> HashSet {
    let n = arr.len();
    let mut set = new();
    for i in 0..n {
        set = insert(set, arr.get(i));
    };
    set
}

// 并集（a ∪ b）。返回新 HashSet。
// 注：Tenth 中 `union` 是保留关键字，故使用 `set_union`。
fn set_union(a: HashSet, b: HashSet) -> HashSet {
    let arr_a = to_array(a);
    let arr_b = to_array(b);
    let mut result = new();
    let na = arr_a.len();
    for i in 0..na {
        result = insert(result, arr_a.get(i));
    };
    let nb = arr_b.len();
    for i in 0..nb {
        result = insert(result, arr_b.get(i));
    };
    result
}

// 交集（a ∩ b）。返回新 HashSet。
fn intersection(a: HashSet, b: HashSet) -> HashSet {
    let arr_a = to_array(a);
    let na = arr_a.len();
    let mut result = new();
    for i in 0..na {
        let v = arr_a.get(i);
        if contains(b, v) {
            result = insert(result, v);
        };
    };
    result
}

// 差集（a - b）。返回新 HashSet。
fn difference(a: HashSet, b: HashSet) -> HashSet {
    let arr_a = to_array(a);
    let na = arr_a.len();
    let mut result = new();
    for i in 0..na {
        let v = arr_a.get(i);
        if !contains(b, v) {
            result = insert(result, v);
        };
    };
    result
}

// 子集判断（a ⊆ b）。
fn is_subset(a: HashSet, b: HashSet) -> bool {
    let arr_a = to_array(a);
    let na = arr_a.len();
    let mut all_in = true;
    for i in 0..na {
        if !contains(b, arr_a.get(i)) {
            all_in = false;
        };
    };
    all_in
}
