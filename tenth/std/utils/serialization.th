// Model serialization utilities
//
// Uses the built-in save_weights / load_weights functions for
// binary tensor serialization (.thw format).
//
// Binary format (.thw = Tenth Weights):
//   [num_tensors: i32]
//   for each tensor:
//     [ndim: i32] [shape[0..ndim]: i32*ndim] [data: f64*size]
//
// Usage:
//   save_weights("model.thw", [w1, b1, w2, b2])
//   let [w1, b1, w2, b2] = load_weights("model.thw")

// Save model parameters to a binary file.
// Wraps the built-in save_weights for a more descriptive API.
// L2.2 修复：save_weights 返回 Unit（types.rs 白名单确认），原注解 i32 错误。
// 注：不写返回注解（默认 Unit）——`-> Unit` 会被类型系统解析为 TypeParam("Unit")
// 而非 Unit base 类型，导致返回检查报“声明返回 Unit 但未返回值”。
fn save_model(path: str, params: Vec) {
    save_weights(path, params)
}

// Load model parameters from a binary file.
// Returns a Vec of tensors in the same order they were saved.
// L2.2 修复：load_weights 运行时返回 Vec<张量>，types.rs 白名单已同步为
// Vec 返回类型（原误标 Unit 导致本函数编译失败）。
fn load_model(path: str) -> Vec {
    load_weights(path)
}

// Checkpoint: save training state (model params + optimizer state)
// This is a higher-level API that saves both model and optimizer
// parameters in separate files.
// L2.2 修复：同 save_model——返回 Unit（不写注解，默认 Unit）。
fn save_checkpoint(
    path_prefix: str,
    model_params: Vec,
    optim_params: Vec,
) {
    let model_path = path_prefix + ".model.thw";
    let optim_path = path_prefix + ".optim.thw";
    save_weights(model_path, model_params);
    save_weights(optim_path, optim_params);
}
