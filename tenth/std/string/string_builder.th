// StringBuilder — 高效的字符串构建器
//
// 底层用 Array<Str> 积累片段，build() 时一次性拼接。
// 避免反复拼接大字符串的 O(n²) 开销。
//
// Usage:
//   use std::string::string_builder::*
//   let sb = StringBuilder::new();
//   let sb = sb.append("Hello, ");
//   let sb = sb.append("World!");
//   build(sb)      // "Hello, World!"
//   len(sb)        // 13
//   clear(sb);
//   is_empty(sb)   // true
//
// L2.2 修复：
//   - append 去掉 `s.clone()`（String 无 clone 方法，值语义直接传）
//   - 原 `to_string` 与内置 native `to_string`（通用值→字符串）同名冲突——
//     运行时 natives 优先于 user function，导致模块函数永远无法被调用，
//     故改名为 `build`。

struct StringBuilder {
    parts: Vec,
    total_len: i64,
}

// 创建一个新的空 StringBuilder。
fn new() -> StringBuilder {
    StringBuilder {
        parts: Vec::new(),
        total_len: 0,
    }
}

// 追加一个字符串片段。
// 返回 StringBuilder 自身以支持链式调用。
// L2.2 修复：String 是值语义，去掉 `s.clone()`（String 无 clone 方法），
// 直接 push（值复制进入 Vec，s 仍可用以计算 total_len）。
fn append(sb: StringBuilder, s: Str) -> StringBuilder {
    sb.parts.push(s);
    StringBuilder {
        parts: sb.parts,
        total_len: sb.total_len + s.len(),
    }
}

// 将积累的片段拼接为一个完整的字符串。
// 使用 join 一次性拼接所有片段。
// L2.2 改名：原 to_string 与内置 native 同名冲突，改名为 build。
fn build(sb: StringBuilder) -> Str {
    sb.parts.join("")
}

// 返回当前已积累的内容长度（字符数）。
fn len(sb: StringBuilder) -> i64 {
    sb.total_len
}

// 检查 StringBuilder 是否为空（没有任何片段）。
fn is_empty(sb: StringBuilder) -> bool {
    sb.total_len == 0
}

// 清空 StringBuilder，重置为空状态。
fn clear(sb: StringBuilder) -> StringBuilder {
    StringBuilder {
        parts: Vec::new(),
        total_len: 0,
    }
}
