// Environment variables and process control
//
// Usage:
//   use std::env

/// 获取环境变量，不存在时返回 default
fn get(name: String, default: String) -> String {
    let r = env_get(name);
    match r {
        Result::Ok(v) => v,
        Result::Err(_) => default,
    }
}

/// 获取环境变量，返回 Result<String>
fn get_result(name: String) -> Result<String> {
    env_get(name)
}

/// 获取环境变量，不存在时返回空串
fn get_or_empty(name: String) -> String {
    get(name, "")
}

/// 设置环境变量
fn set(name: String, value: String) { env_set(name, value) }

/// 退出进程
fn exit(code: i64) { exit(code) }
