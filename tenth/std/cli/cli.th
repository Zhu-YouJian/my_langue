// Command-line argument utilities
//
// Provides functions for reading command-line arguments.
//
// Usage:
//   use std::cli::cli

/// Get the number of command-line arguments (including program name)
fn args_count() -> i32 {
    cli_args_count()
}

/// Get command-line argument at index (0 = program name)
fn arg(index: i32) -> String {
    cli_arg(index)
}

/// Get all command-line arguments as a Vec of strings
fn args() -> Vec {
    let count = cli_args_count();
    let mut result = Vec::new();
    let mut i = 0;
    while i < count {
        result.push(cli_arg(i));
        i = i + 1;
    }
    result
}

/// Get command-line arguments excluding the program name
fn args_tail() -> Vec {
    let count = cli_args_count();
    let mut result = Vec::new();
    let mut i = 1;
    while i < count {
        result.push(cli_arg(i));
        i = i + 1;
    }
    result
}

/// Check if a flag exists in the arguments
fn has_flag(flag: String) -> bool {
    let count = cli_args_count();
    let mut i = 1;
    while i < count {
        if cli_arg(i) == flag {
            return true;
        }
        i = i + 1;
    }
    false
}

/// Get the value after a flag, e.g. --lr 0.01 => flag_value("--lr")
fn flag_value(flag: String) -> String {
    let count = cli_args_count();
    let mut i = 1;
    while i < count - 1 {
        if cli_arg(i) == flag {
            return cli_arg(i + 1);
        }
        i = i + 1;
    }
    ""
}
