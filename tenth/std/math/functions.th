// Math functions
//
// Scalar math (builtins):
//   abs(x)   — absolute value (Int → Int, Float → Float)
//   sqrt(x)  — square root (Float → Float)
//   sin(x)   — sine (Float → Float)
//   cos(x)   — cosine (Float → Float)
//   ln(x)    — natural log, x > 0
//   pow(b,e) — b^e (Float → Float)
//
// Tensor creation:
//   zeros(d0, d1, ...)  — tensor of zeros
//   ones(d0, d1, ...)   — tensor of ones
//   rand(d0, d1, ...)   — uniform [0, 1)
//   randn(d0, d1, ...)  — normal(0, 1)
//
// Tensor math (methods):
//   x.abs(), x.sqrt(), x.exp(), x.log()
//   x.relu(), x.sigmoid(), x.tanh(), x.softmax()
//   x.sum(), x.mean(), x.sum_axis(axis)
//   x.matmul(y), x.transpose()
