// Basic statistics functions for scalar lists (Vec of numbers).
//
// Operates on Vec containing i64 or f64 values.
// All results are f64 for precision.
//
// Usage:
//   use std::math::stats::mean
//   use std::math::stats::stddev

// ── Central tendency ──

// Arithmetic mean of a numeric Vec.
// Returns 0.0 for empty Vec.
fn mean(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    let mut total = 0.0;
    for i in 0..n {
        total = total + to_f64(items.get(i));
    };
    total / to_f64(n)
}

// Median value of a numeric Vec.
// For odd-length Vec, returns the middle element.
// For even-length Vec, returns the average of the two middle elements.
// Returns 0.0 for empty Vec.
fn median(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    // Sort a copy (bubble sort for simplicity — works for small lists)
    let sorted = sort_copy(items);
    if n % 2 == 1 {
        // Odd: middle element
        to_f64(sorted.get(n / 2))
    } else {
        // Even: average of two middle elements
        let hi = n / 2;
        let lo = hi - 1;
        (to_f64(sorted.get(lo)) + to_f64(sorted.get(hi))) / 2.0
    }
}

// ── Dispersion ──

// Population variance of a numeric Vec.
// Uses the formula: E[(X - μ)²] = E[X²] - (E[X])²
// Returns 0.0 for empty Vec.
fn variance(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    let mu = mean(items);
    let mut total = 0.0;
    for i in 0..n {
        let diff = to_f64(items.get(i)) - mu;
        total = total + diff * diff;
    };
    total / to_f64(n)
}

// Population standard deviation.
// Square root of variance.
fn stddev(items: Vec) -> f64 {
    let v = variance(items);
    let result = v.sqrt();
    result
}

// Sample variance (Bessel's correction: divide by n-1).
// Returns 0.0 for n < 2.
fn variance_sample(items: Vec) -> f64 {
    let n = items.len();
    if n < 2 { return 0.0; };
    let mu = mean(items);
    let mut total = 0.0;
    for i in 0..n {
        let diff = to_f64(items.get(i)) - mu;
        total = total + diff * diff;
    };
    total / to_f64(n - 1)
}

// Sample standard deviation.
fn stddev_sample(items: Vec) -> f64 {
    let v = variance_sample(items);
    let result = v.sqrt();
    result
}

// ── Internal: sort a copy of a numeric Vec (ascending) ──

// Bubble sort returning a new sorted Vec.
fn sort_copy(items: Vec) -> Vec {
    let n = items.len();
    let mut result = Vec::new();
    for j in 0..n {
        result.push(items.get(j));
    };
    // Bubble sort pass
    for i in 0..n {
        for j in 0..(n - i - 1) {
            let a = to_f64(result.get(j));
            let b = to_f64(result.get(j + 1));
            if a > b {
                let tmp = result.get(j);
                result.set(j, result.get(j + 1));
                result.set(j + 1, tmp);
            };
        };
    };
    result
}

// ── Extrema ──

// Minimum value of a numeric Vec.
// Returns 0.0 for empty Vec.
fn min(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    let mut m = to_f64(items.get(0));
    for i in 1..n {
        let v = to_f64(items.get(i));
        if v < m { m = v; };
    };
    m
}

// Maximum value of a numeric Vec.
// Returns 0.0 for empty Vec.
fn max(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    let mut m = to_f64(items.get(0));
    for i in 1..n {
        let v = to_f64(items.get(i));
        if v > m { m = v; };
    };
    m
}

// Range (max - min) of a numeric Vec.
// Returns 0.0 for empty Vec.
fn range(items: Vec) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    max(items) - min(items)
}

// ── Aggregation ──

// Sum of a numeric Vec.
// Returns 0.0 for empty Vec.
fn sum(items: Vec) -> f64 {
    let n = items.len();
    let mut total = 0.0;
    for i in 0..n {
        total = total + to_f64(items.get(i));
    };
    total
}

// Product of a numeric Vec.
// Returns 1.0 (multiplicative identity) for empty Vec.
fn product(items: Vec) -> f64 {
    let n = items.len();
    let mut total = 1.0;
    for i in 0..n {
        total = total * to_f64(items.get(i));
    };
    total
}

// ── Quantile ──

// Percentile of a numeric Vec using linear interpolation
// (consistent with numpy.percentile default).
// p is in [0, 100]; p=50 is equivalent to median.
// Returns 0.0 for empty Vec or p out of [0, 100].
fn percentile(items: Vec, p: f64) -> f64 {
    let n = items.len();
    if n == 0 { return 0.0; };
    if p < 0.0 || p > 100.0 { return 0.0; };
    let sorted = sort_copy(items);
    if n == 1 { return to_f64(sorted.get(0)); };
    let rank = (p / 100.0) * to_f64(n - 1);
    let lo_f = math_floor(rank);
    let hi_f = math_ceil(rank);
    // Vec.get() 在运行时通过 as_int() 接受 f64 索引
    let lo_val = to_f64(sorted.get(lo_f));
    let hi_val = to_f64(sorted.get(hi_f));
    lo_val + (rank - lo_f) * (hi_val - lo_val)
}
