// Mathematical constants and advanced functions
//
// Provides commonly used mathematical constants and functions
// beyond the built-in abs, sqrt, sin, cos, ln, pow.
//
// Usage:
//   use std::math::constants::*

/// The ratio of a circle's circumference to its diameter
let PI: f64 = 3.14159265358979323846;

/// Euler's number
let E: f64 = 2.71828182845904523536;

/// The ratio of a circle's circumference to its radius (2π)
let TAU: f64 = 6.28318530717958647692;

/// The golden ratio φ = (1 + √5) / 2
let PHI: f64 = 1.61803398874989484820;

/// Natural logarithm of 2
let LN2: f64 = 0.69314718055994530942;

/// Natural logarithm of 10
let LN10: f64 = 2.30258509299404568402;

/// Base-2 logarithm of e
let LOG2E: f64 = 1.44269504088896340736;

/// Base-10 logarithm of e
let LOG10E: f64 = 0.43429448190325182765;

/// 1/π
let INV_PI: f64 = 0.31830988618379067154;

/// 2/π
let INV_SQRT_PI: f64 = 0.56418958354775628695;

/// √2
let SQRT2: f64 = 1.41421356237309504880;

/// 1/√2
let INV_SQRT2: f64 = 0.70710678118654752440;

/// Convert degrees to radians
fn deg2rad(deg: f64) -> f64 {
    deg * PI / 180.0
}

/// Convert radians to degrees
fn rad2deg(rad: f64) -> f64 {
    rad * 180.0 / PI
}

/// Compute the tangent of x (radians)
fn tan(x: f64) -> f64 {
    math_tan(x)
}

/// Compute the arcsine of x (returns radians)
fn asin(x: f64) -> f64 {
    math_asin(x)
}

/// Compute the arccosine of x (returns radians)
fn acos(x: f64) -> f64 {
    math_acos(x)
}

/// Compute the arctangent of x (returns radians)
fn atan(x: f64) -> f64 {
    math_atan(x)
}

/// Compute the 2-argument arctangent of y/x (returns radians)
fn atan2(y: f64, x: f64) -> f64 {
    math_atan2(y, x)
}

/// Compute the hyperbolic sine of x
fn sinh(x: f64) -> f64 {
    math_sinh(x)
}

/// Compute the hyperbolic cosine of x
fn cosh(x: f64) -> f64 {
    math_cosh(x)
}

/// Compute the hyperbolic tangent of x
fn tanh_scalar(x: f64) -> f64 {
    math_tanh(x)
}

/// Compute the base-10 logarithm of x
fn log10(x: f64) -> f64 {
    math_log10(x)
}

/// Compute the base-2 logarithm of x
fn log2(x: f64) -> f64 {
    math_log2(x)
}

/// Compute e^x
fn exp(x: f64) -> f64 {
    math_exp(x)
}

/// Compute x^y for scalar values
fn pow_scalar(base: f64, exp: f64) -> f64 {
    math_pow(base, exp)
}

/// Compute the floor of x
fn floor(x: f64) -> f64 {
    math_floor(x)
}

/// Compute the ceiling of x
fn ceil(x: f64) -> f64 {
    math_ceil(x)
}

/// Round x to the nearest integer
fn round(x: f64) -> f64 {
    math_round(x)
}

/// Compute the absolute value of x
fn fabs(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

/// Compute the sign of x: -1, 0, or 1
fn signum(x: f64) -> f64 {
    if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }
}

/// Linearly interpolate between a and b by t
fn lerp(a: f64, b: f64, t: f64) -> f64 {
    a + (b - a) * t
}

/// Clamp x to the range [lo, hi]
fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

/// Compute the minimum of two values
fn fmin(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

/// Compute the maximum of two values
fn fmax(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}
