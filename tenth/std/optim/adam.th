// Adam optimizer
// Adaptive moment estimation — combines momentum (m) and RMSProp (v).
//
// Usage (in training loop):
//   stop_grad();
//   let gw = grad(w);
//   m_w = beta1 * m_w + (1.0 - beta1) * gw;         // first moment
//   v_w = beta2 * v_w + (1.0 - beta2) * gw * gw;     // second moment
//   let m_hat = m_w / (1.0 - beta1_t);               // bias correction
//   let v_hat = v_w / (1.0 - beta2_t);               // bias correction
//   w = w - lr * m_hat / (v_hat.sqrt() + eps);        // update
//
// After each step, increment: beta1_t = beta1_t * beta1, beta2_t = beta2_t * beta2
// Hyperparams: lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8

// Single Adam step for one parameter tensor.
// Returns (updated_w, updated_m, updated_v).
//
// Phase 3 DRY 清理：泛型化 <T>（f32/f64 通吃）。
// 注：1.0 - beta1 等标量运算在 T=f32 时会按 G4 规则提升到 f64（精度更高），
// 但最终乘以 Tensor[T] 仍保持 Tensor[T] dtype。
fn adam_step<T>(
    w: Tensor[T, ..],
    m: Tensor[T, ..],
    v: Tensor[T, ..],
    lr: T,
    beta1: T,
    beta2: T,
    eps: T,
    beta1_t: T,
    beta2_t: T,
) -> (Tensor[T, ..], Tensor[T, ..], Tensor[T, ..]) {
    let gw = grad(w);
    let new_m = beta1 * m + (1.0 - beta1) * gw;
    let new_v = beta2 * v + (1.0 - beta2) * gw * gw;
    let m_hat = new_m / (1.0 - beta1_t);
    let v_hat = new_v / (1.0 - beta2_t);
    let new_w = w - lr * m_hat / (v_hat.sqrt() + eps);
    (new_w, new_m, new_v)
}
