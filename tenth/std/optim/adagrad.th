// AdaGrad optimizer
// Accumulates squared gradients and adapts learning rate per-parameter.
// Good for sparse features, less used in deep learning now.
//
// Usage (in training loop):
//   stop_grad();
//   let gw = grad(w);
//   g2_w = g2_w + gw * gw;                      // accumulate squared grad
//   w = w - lr * gw / (g2_w.sqrt() + eps);       // update
//
// Hyperparams: lr=0.01, eps=1e-8

// Single AdaGrad step for one parameter tensor.
// Returns (updated_w, updated_g2).
//
// Phase 3 DRY 清理：泛型化 <T>（f32/f64 通吃）。
fn adagrad_step<T>(
    w: Tensor[T, ..],
    g2: Tensor[T, ..],
    lr: T,
    eps: T,
) -> (Tensor[T, ..], Tensor[T, ..]) {
    let gw = grad(w);
    let new_g2 = g2 + gw * gw;
    let new_w = w - lr * gw / (new_g2.sqrt() + eps);
    (new_w, new_g2)
}
