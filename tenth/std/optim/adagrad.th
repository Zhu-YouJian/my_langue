// AdaGrad optimizer
// Accumulates squared gradients and adapts learning rate per-parameter.
// Good for sparse features, less used in deep learning now.
//
// Usage (in training loop):
//   stop_grad();
//   let gw = grad(w);
//   g2_w = g2_w + gw * gw;                      // accumulate squared grad
//   w = w - lr * gw / (g2_w.sqrt() + eps);       // update
//
// Hyperparams: lr=0.01, eps=1e-8

// Single AdaGrad step for one parameter tensor.
// Returns (updated_w, updated_g2).
fn adagrad_step(
    w: Tensor[f64, ..],
    g2: Tensor[f64, ..],
    lr: f64,
    eps: f64,
) -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gw = grad(w);
    let new_g2 = g2 + gw * gw;
    let new_w = w - lr * gw / (new_g2.sqrt() + eps);
    (new_w, new_g2)
}

// ── Phase 5.4：f32 副本（标量参数改 f32，字面量加 f32 后缀，保持 f32 路径不提升为 f64）──
// Tensor 参数仍标注 Tensor[f64, ..]（类型系统硬约束，Phase 5.0 调研结论），
// 但传入 f32 tensor 时运行时按 dtype 分支自动走 f32 路径。

// Single AdaGrad step for one parameter tensor (f32).
// Returns (updated_w, updated_g2).
fn adagrad_step_f32(
    w: Tensor[f64, ..],
    g2: Tensor[f64, ..],
    lr: f32,
    eps: f32,
) -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gw = grad(w);
    let new_g2 = g2 + gw * gw;
    let new_w = w - lr * gw / (new_g2.sqrt() + eps);
    (new_w, new_g2)
}
