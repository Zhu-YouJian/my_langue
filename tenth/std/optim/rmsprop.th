// RMSProp optimizer
// Moving average of squared gradients, similar to AdaGrad
// but with decay to prevent learning rate from vanishing.
//
// Usage (in training loop):
//   stop_grad();
//   let gw = grad(w);
//   g2_w = decay * g2_w + (1.0 - decay) * gw * gw;  // moving avg
//   w = w - lr * gw / (g2_w.sqrt() + eps);
//
// Hyperparams: lr=0.001, decay=0.9, eps=1e-8

// Single RMSProp step for one parameter tensor.
// Returns (updated_w, updated_g2).
fn rmsprop_step(
    w: Tensor[f64, ..],
    g2: Tensor[f64, ..],
    lr: f64,
    decay: f64,
    eps: f64,
) -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gw = grad(w);
    let new_g2 = decay * g2 + (1.0 - decay) * gw * gw;
    let new_w = w - lr * gw / (new_g2.sqrt() + eps);
    (new_w, new_g2)
}
