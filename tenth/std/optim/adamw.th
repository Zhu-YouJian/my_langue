// AdamW optimizer
// Adam with decoupled weight decay (Loshchilov & Hutter, 2019).
//
// 与 std::optim::adam::adam_step 的区别：
//   - 原 Adam：weight decay 加在梯度上（gw = grad + decay * w），与 momentum 耦合
//   - AdamW  ：weight decay 直接作用于参数（w = w * (1 - lr * decay)），与 momentum 解耦
//
// 解耦权重衰减对 Transformer 训练尤其重要（学习率大时原 Adam 的 L2 正则会被扭曲）。
//
// Usage:
//   stop_grad();
//   let gw = grad(w);
//   let new_m = beta1 * m + (1.0 - beta1) * gw;
//   let new_v = beta2 * v + (1.0 - beta2) * gw * gw;
//   let m_hat = new_m / (1.0 - beta1_t);
//   let v_hat = new_v / (1.0 - beta2_t);
//   let new_w = w * (1.0 - lr * decay) - lr * m_hat / (v_hat.sqrt() + eps);  // 解耦
//
// Hyperparams: lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8, decay=0.01

// Single AdamW step for one parameter tensor.
// Returns (updated_w, updated_m, updated_v).
//
// Phase 3 DRY 清理：泛型化 <T>（f32/f64 通吃）。
// 注：1.0 - beta1 等标量运算在 T=f32 时会按 G4 规则提升到 f64（精度更高），
// 但最终乘以 Tensor[T] 仍保持 Tensor[T] dtype。
fn adamw_step<T>(
    w: Tensor[T, ..],
    m: Tensor[T, ..],
    v: Tensor[T, ..],
    lr: T,
    beta1: T,
    beta2: T,
    eps: T,
    decay: T,
    beta1_t: T,
    beta2_t: T,
) -> (Tensor[T, ..], Tensor[T, ..], Tensor[T, ..]) {
    let gw = grad(w);
    let new_m = beta1 * m + (1.0 - beta1) * gw;
    let new_v = beta2 * v + (1.0 - beta2) * gw * gw;
    let m_hat = new_m / (1.0 - beta1_t);
    let v_hat = new_v / (1.0 - beta2_t);
    // 解耦权重衰减：直接衰减参数，不污染梯度
    let decayed_w = w * (1.0 - lr * decay);
    let new_w = decayed_w - lr * m_hat / (v_hat.sqrt() + eps);
    (new_w, new_m, new_v)
}
