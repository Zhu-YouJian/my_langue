// Gradient accumulation
// 当 batch 太大无法一次装入显存时，将大 batch 拆成多个小 micro-batch，
// 分别前向+反向累积梯度，最后统一更新参数。
//
// 用法（手动累积模式）：
//   let accum_steps = 4;
//   for step in 0..accum_steps {
//       new_grad();
//       let x_micro = ...;  // 取第 step 个 micro-batch
//       let loss = forward(x_micro);
//       backward(loss / accum_steps);  // 除以累积步数使梯度等价于大 batch 平均
//       // 这里不调 zero_grad，让梯度累积
//   };
//   // 累积完成后，调 optimizer step 更新参数
//   w = sgd_step(w, lr);
//   zero_grad();
//
// 本模块提供便捷封装，减少样板代码。

// ── Phase 3 DRY 清理：泛型化 <T>（f32/f64 通吃）──

// 累积辅助：将当前梯度按累积步数缩放后返回。
// 用于 backward(loss) 后、optimizer step 前的梯度归一化。
// 输入：参数 w（用于读 grad）、累积步数 accum_steps；返回：归一化后的梯度。
//
// 注：accum_steps 为 i64，内部用 to_f64() 转为 f64 再做标量除法（Tensor / i64
// 无原生支持，Tensor / Float 才有；与 clip.th 的 to_f64 模式一致）。
fn accumulate_grad<T>(w: Tensor[T, ..], accum_steps: i64) -> Tensor[T, ..] {
    let gw = grad(w);
    let scale = to_f64(accum_steps);
    gw / scale
}

// 累积循环：对多个 micro_batch 执行 forward+backward，梯度自动累积。
// 用法：
//   accumulate_loop<T>(|x| model_loss(x), micro_batches, accum_steps)
//   // 之后调 optimizer.step() + zero_grad()
//
// 设计说明：
//   - forward_fn 用 closure 传递（Tenth 闭包语法 |x| expr，参考
//     std::collections::iter::map 的写法）。高阶函数参数不写显式 FnType 注解
//     （Tenth 惯例）。
//   - 每个 micro_batch 调用 new_grad() 重置本次反向的临时记录（但不调 zero_grad，
//     让参数 .grad 跨 micro_batch 累积）。
//   - 反向时 loss / accum_steps 使累积后梯度等价于大 batch 平均。
//   - accum_steps 类型为 i64（与 accumulate_grad 一致）。
//   - 返回 ()：本函数只负责累积梯度，参数更新由调用方在循环外执行。
//
// 注：closure 参数 forward_fn 不写类型注解（与 iter.th::map 一致），调用方需保证
//   forward_fn: fn(Tensor[T, ..]) -> Tensor[T, ..]。
//
// 注：forward_fn 内部应对参数调用 param() 重新注册到当前 tape。accumulate_loop
//   每轮调 new_grad() 重置 tape，若参数在外部仅 param 一次，其 tape_id 会变陈旧
//   导致梯度流向错误节点。正确用法：forward_fn 内 `let wp = param(w); ...` 每轮
//   重新注册（param 修改的是共享 Tensor 的 tape_id，.grad 跨轮累积不受影响）。
//
// 注：accum_steps 为 i64，内部用 to_f64() 转为 f64 再做标量除法（Tensor / i64
// 无原生支持；与 accumulate_grad / clip.th 的 to_f64 模式一致）。
fn accumulate_loop<T>(
    forward_fn,
    micro_batches: Vec,
    accum_steps: i64,
) -> () {
    let n = micro_batches.len();
    let scale = to_f64(accum_steps);
    for i in 0..n {
        new_grad();
        let x = micro_batches[i];
        let loss = forward_fn(x);
        backward(loss / scale);
    };
}
