// Stochastic Gradient Descent optimizer using autodiff

// Performs one SGD step: reads gradients from the parameter tensors,
// updates them in-place, then clears gradients.
fn sgd_step(w: &mut Tensor[f64, ..], b: &mut Tensor[f64, ..], lr: f64) {
    let gw = grad(w);
    let gb = grad(b);
    *w = *w - lr * gw;
    *b = *b - lr * gb;
}
