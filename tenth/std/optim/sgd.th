// SGD optimizer variants

// Vanilla SGD step (reading gradients via autodiff)
fn sgd_step(w: Tensor[f64, ..], lr: f64) -> Tensor[f64, ..] {
    let gw = grad(w);
    w - lr * gw
}

// SGD with momentum
// m = momentum * m + lr * gw
// w = w - m
fn sgd_momentum(w: Tensor[f64, ..], m: Tensor[f64, ..], lr: f64, momentum: f64)
    -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gw = grad(w);
    let new_m = momentum * m + lr * gw;
    let new_w = w - new_m;
    (new_w, new_m)
}

// SGD with weight decay (L2 regularization)
// gw = grad(w) + decay * w
// w = w - lr * gw
fn sgd_weight_decay(w: Tensor[f64, ..], lr: f64, decay: f64) -> Tensor[f64, ..] {
    let gw = grad(w) + decay * w;
    w - lr * gw
}

// ── Phase 5.4：f32 副本（标量参数改 f32，字面量加 f32 后缀，保持 f32 路径不提升为 f64）──
// Tensor 参数仍标注 Tensor[f64, ..]（类型系统硬约束，Phase 5.0 调研结论），
// 但传入 f32 tensor 时运行时按 dtype 分支自动走 f32 路径。

// Vanilla SGD step (f32)
fn sgd_step_f32(w: Tensor[f64, ..], lr: f32) -> Tensor[f64, ..] {
    let gw = grad(w);
    w - lr * gw
}

// SGD with momentum (f32)
fn sgd_momentum_f32(w: Tensor[f64, ..], m: Tensor[f64, ..], lr: f32, momentum: f32)
    -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gw = grad(w);
    let new_m = momentum * m + lr * gw;
    let new_w = w - new_m;
    (new_w, new_m)
}

// SGD with weight decay (f32)
fn sgd_weight_decay_f32(w: Tensor[f64, ..], lr: f32, decay: f32) -> Tensor[f64, ..] {
    let gw = grad(w) + decay * w;
    w - lr * gw
}
