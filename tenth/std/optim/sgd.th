// SGD optimizer variants
//
// Phase 3 DRY 清理：所有 SGD 变体已泛型化 <T>（f32/f64 通吃）。
// 标量 lr/momentum/decay 类型为 T，与 tensor dtype 一致。
// grad(w) 按 w 的 dtype 分发，返回同 dtype 张量。

// Vanilla SGD step (reading gradients via autodiff)
fn sgd_step<T>(w: Tensor[T, ..], lr: T) -> Tensor[T, ..] {
    let gw = grad(w);
    w - lr * gw
}

// SGD with momentum
// m = momentum * m + lr * gw
// w = w - m
fn sgd_momentum<T>(w: Tensor[T, ..], m: Tensor[T, ..], lr: T, momentum: T)
    -> (Tensor[T, ..], Tensor[T, ..]) {
    let gw = grad(w);
    let new_m = momentum * m + lr * gw;
    let new_w = w - new_m;
    (new_w, new_m)
}

// SGD with weight decay (L2 regularization)
// gw = grad(w) + decay * w
// w = w - lr * gw
fn sgd_weight_decay<T>(w: Tensor[T, ..], lr: T, decay: T) -> Tensor[T, ..] {
    let gw = grad(w) + decay * w;
    w - lr * gw
}
