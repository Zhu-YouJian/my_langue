// Random number utilities
//
// Provides random number generation for non-tensor types.
// For tensor random, use the built-in rand() and randn() functions.
//
// Usage:
//   use std::random::random
//
// M1-S4a 修复：`shuffle` 现为真正的 Fisher-Yates 就地洗牌（此前仅生成随机下标
// 未写回）；新增 `rand_seed(n)` 使随机序列可确定性复现（同 seed 同结果）。
// L2.5 修复：`choice` 改为返回随机**元素**（与注释/教程一致）；返回随机索引
// 的行为改名为 `choice_index`。

/// Generate a random integer in [lo, hi] (inclusive)
fn rand_int(lo: i32, hi: i32) -> i32 {
    random_int(lo, hi)
}

/// 设置确定性随机种子（线程局部）。设置后 `rand_int`/`rand_float`/`shuffle` 等
/// 产生可复现序列（同 seed 两次结果一致）；换 seed 得不同序列。
/// 未调用时使用系统 CSPRNG（不可预测，与既有行为一致）。M1-S4a 新增。
fn rand_seed(seed: i32) {
    random_seed(seed)
}

/// Generate a random float in [0.0, 1.0)
fn rand_float() -> f64 {
    random_float()
}

/// Generate a random float in [lo, hi)
fn rand_range(lo: f64, hi: f64) -> f64 {
    lo + random_float() * (hi - lo)
}

/// 返回随机**元素**（0-based 索引对应）；空 Vec 返回 -1（哨兵）。
/// L2.5 修复：此前实现返回随机索引而非元素（与注释/教程语义不符），
/// 现返回 `v.get(idx)`；返回索引的行为已改名为 `choice_index`。
/// L2.2 修复：旧语法 `fn choice(v: Vec) i32`（无 `->`）改为 `-> i32`，
/// 整模块恢复编译（其余 6 个函数连带可用）。
fn choice(v: Vec) -> i32 {
    let len = v.len();
    if len == 0 {
        return -1;
    }
    let idx = random_int(0, len - 1);
    v.get(idx)
}

/// 返回随机**索引**（0-based，含端点）；空 Vec 返回 -1。
/// L2.5 新增：承接原 `choice` 的“返回索引”行为，供 `sample` 等内部使用。
fn choice_index(v: Vec) -> i32 {
    let len = v.len();
    if len == 0 {
        return -1;
    }
    let idx = random_int(0, len - 1);
    idx
}

/// Shuffle a Vec in place（Fisher-Yates，就地交换），返回洗牌后的同一 Vec。
/// M1-S4a 修复：此前仅生成随机下标未写回（未真正交换），现用 `set` 就地交换。
/// 配合 `rand_seed(n)` 可确定性复现（同 seed 同结果，便于测试）。
/// 空 Vec / 单元素 Vec 原样返回。
fn shuffle(v: Vec) -> Vec {
    let len = v.len();
    let mut i = len - 1;
    while i > 0 {
        // 从 [0, i] 均匀选 j，交换 v[i] 与 v[j]（Fisher-Yates 后半段，等价洗牌）
        let j = random_int(0, i);
        let tmp = v.get(i);
        v.set(i, v.get(j));
        v.set(j, tmp);
        i = i - 1;
    }
    v
}

/// Generate a random boolean
fn rand_bool() -> bool {
    random_float() < 0.5
}

/// Sample n elements from a Vec with replacement
/// L2.5：改用 `choice_index`（`choice` 已改为返回元素）。
fn sample(v: Vec, n: i32) -> Vec {
    let mut result = Vec::new();
    let mut i = 0;
    while i < n {
        let idx = choice_index(v);
        result.push(v.get(idx));
        i = i + 1;
    }
    result
}
