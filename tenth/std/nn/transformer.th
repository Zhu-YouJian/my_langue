// Transformer Encoder Block (Pre-Norm architecture)
// x = x + MultiHeadAttention(LayerNorm(x))
// x = x + FeedForward(LayerNorm(x))
//
// Uses pre-norm (LayerNorm before each sub-layer) which is more stable
// for training deep Transformers.
//
// 符号维度标注（Phase 2 短期规划方向 3）：
//   x: [S, D]                输入（seq_len, d_model）
//   w_q/w_k/w_v/w_o: [D, D]   MHA 投影矩阵（d_model, d_model）
//   ln1_gamma/ln1_beta: [D]    第一层 LayerNorm 参数（d_model,）
//   w1: [D, D_ff]             FFN 第一层权重（d_model, d_ff）
//   b1: [D_ff]                FFN 第一层偏置
//   w2: [D_ff, D]             FFN 第二层权重（d_ff, d_model）
//   b2: [D]                   FFN 第二层偏置
//   ln2_gamma/ln2_beta: [D]    第二层 LayerNorm 参数
//   返回: [S, D]               与 x 同 shape（residual 保持）

fn transformer_encoder_block<T>(
    x: Tensor[T, S, D],
    w_q: Tensor[T, D, D],
    w_k: Tensor[T, D, D],
    w_v: Tensor[T, D, D],
    w_o: Tensor[T, D, D],
    ln1_gamma: Tensor[T, D],
    ln1_beta: Tensor[T, D],
    w1: Tensor[T, D, D_ff],
    b1: Tensor[T, D_ff],
    w2: Tensor[T, D_ff, D],
    b2: Tensor[T, D],
    ln2_gamma: Tensor[T, D],
    ln2_beta: Tensor[T, D],
    seq_len: i64,
    d_model: i64,
    n_heads: i64,
    dropout_p: T,
) -> Tensor[T, S, D] {
    // Pre-norm: LayerNorm before attention
    let x_norm = layer_norm<T>(x, ln1_gamma, ln1_beta, 1e-5);
    let mask = zeros(1);  // no mask for encoder (mask is metadata, kept as f64)
    let attn = multihead_attention<T>(x_norm, w_q, w_k, w_v, w_o, mask, seq_len, d_model, n_heads, dropout_p);
    let x = x + attn;  // residual connection

    // Pre-norm: LayerNorm before feed-forward
    let x_norm2 = layer_norm<T>(x, ln2_gamma, ln2_beta, 1e-5);
    let ffn_out = feedforward<T>(x_norm2, w1, b1, w2, b2);
    x + ffn_out  // residual connection
}

// Convenience: initialize all parameters for a Transformer encoder block
// 保留 f64：内部依赖 randn native + make_layer_norm/make_feedforward_params（均 f64），
// native 构造函数不支持泛型实例化（见 hir/lower/lower_expr.rs + docs/f32-f64-parity-roadmap.md）。
//
// 返回 shape 与 transformer_encoder_block 签名对应：
//   w_q/w_k/w_v/w_o: [D, D]
//   ln1_gamma/ln1_beta/ln2_gamma/ln2_beta/b2: [D]
//   w1: [D, D_ff], b1: [D_ff], w2: [D_ff, D]
// 注：d_model/d_ff 是运行时参数，类型层面用 `..` 通配维度。
fn make_transformer_block_params(d_model: i64, n_heads: i64, d_ff: i64) -> (
    Tensor[f64, ..], Tensor[f64, ..], Tensor[f64, ..], Tensor[f64, ..],  // w_q, w_k, w_v, w_o
    Tensor[f64, ..], Tensor[f64, ..],  // ln1_gamma, ln1_beta
    Tensor[f64, ..], Tensor[f64, ..], Tensor[f64, ..], Tensor[f64, ..],  // w1, b1, w2, b2
    Tensor[f64, ..], Tensor[f64, ..],  // ln2_gamma, ln2_beta
) {
    let scale = sqrt(2.0 / d_model);
    let w_q = randn(d_model, d_model) * scale;
    let w_k = randn(d_model, d_model) * scale;
    let w_v = randn(d_model, d_model) * scale;
    let w_o = randn(d_model, d_model) * scale;
    let (ln1_gamma, ln1_beta) = make_layer_norm(d_model);
    let (w1, b1, w2, b2) = make_feedforward_params(d_model, d_ff);
    let (ln2_gamma, ln2_beta) = make_layer_norm(d_model);
    (w_q, w_k, w_v, w_o, ln1_gamma, ln1_beta, w1, b1, w2, b2, ln2_gamma, ln2_beta)
}
