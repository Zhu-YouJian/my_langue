// Loss functions
//
// Phase 3 DRY 清理：mse/mse_loss/l1_loss/huber_loss/huber_loss_train 已泛型化 <T>。
// binary_cross_entropy 保留 f64（标量函数，无 trait bound；按任务要求保留）。
//
// 符号维度说明（Phase 2 短期规划方向 3）：
//   所有 loss 函数的 shape 规则：
//     pred   : [..]   任意 shape（与 target 同 shape）
//     target : [..]   任意 shape（与 pred 同 shape）
//     返回    : 标量 T（mse / huber_loss）或与 pred 同 shape（mse_loss / l1_loss / huber_loss_train）
//   注：Tenth 类型注解无法表达"两参数同 shape"约束，保留 `..` 并通过 pred - target
//   的运行时广播检查捕获 shape 不匹配。

// Mean Squared Error (returns scalar)
fn mse<T>(pred: Tensor[T, ..], target: Tensor[T, ..]) -> T {
    let diff = pred - target;
    (diff * diff).mean()
}

// Mean Squared Error (returns scalar tensor for autodiff)
fn mse_loss<T>(pred: Tensor[T, ..], target: Tensor[T, ..]) -> Tensor[T, ..] {
    let diff = pred - target;
    diff * diff
}

// Binary Cross Entropy (scalar inputs)
// 注：保留 f64（标量函数，无 trait bound）。
fn binary_cross_entropy(pred: f64, target: f64) -> f64 {
    -(target * pred.log() + (1.0 - target) * (1.0 - pred).log())
}

// L1 Loss (Mean Absolute Error)
fn l1_loss<T>(pred: Tensor[T, ..], target: Tensor[T, ..]) -> Tensor[T, ..] {
    let diff = pred - target;
    diff.abs()
}

// Huber Loss (smooth L1) — 使用 select 原语实现（论文 T48 LF3 解锁）
// L_δ(a) = 0.5 * a²              if |a| ≤ δ
// L_δ(a) = δ * (|a| - 0.5 * δ)   otherwise
// cond = (|a| > δ) 的数值近似：sign(|a|-δ) = (|a|-δ) / (||a|-δ| + eps)
//   cond ≈ 1 → select linear (δ*(|a|-0.5δ))
//   cond ≈ 0 → select quadratic (0.5*a²)
// 返回标量（mean），用于评估（不可微路径）
fn huber_loss<T>(pred: Tensor[T, ..], target: Tensor[T, ..], delta: T) -> T {
    let a = pred - target;
    let abs_a = a.abs();
    let eps = 1e-12;
    let diff = abs_a - delta;
    let sign = diff / (diff.abs() + eps);
    let cond = (sign + 1.0) * 0.5;
    let quad = 0.5 * a * a;
    let linear = delta * (abs_a - 0.5 * delta);
    let loss = select(cond, linear, quad);
    loss.mean()
}

// huber_loss_train：返回 tensor（不 mean），用于 autodiff 训练
// 与 mse / mse_loss 的双形式 API 设计模式一致
fn huber_loss_train<T>(pred: Tensor[T, ..], target: Tensor[T, ..], delta: T) -> Tensor[T, ..] {
    let a = pred - target;
    let abs_a = a.abs();
    let eps = 1e-12;
    let diff = abs_a - delta;
    let sign = diff / (diff.abs() + eps);
    let cond = (sign + 1.0) * 0.5;
    let quad = 0.5 * a * a;
    let linear = delta * (abs_a - 0.5 * delta);
    select(cond, linear, quad)
}
