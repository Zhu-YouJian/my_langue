// Embedding layer
// Lookup table that maps integer indices to dense vectors.
//
// Usage:
//   let weight = randn(vocab_size, dim) * 0.01   // init
//   let e = embedding(weight, indices)            // forward
//
// weight: (vocab_size, dim) — embedding matrix
// indices: (N,) — integer tensor of token IDs
// Returns: (N, dim) — embedded vectors
//
// Autodiff: gradient flows back to the weight matrix.
// 实现：基于 index_select native（AUDIT-11.4.11；base=weight 可微，梯度通过
//       scatter-add 传播；index=indices 不可微，符合 embedding 语义）。
// index_select 已接入 TapeOp::IndexSelect（runtime/natives.rs + interpreter/natives.rs
// + runtime/autodiff/{tape_op,backward,mod,grad}.rs）。
// Sparse gradient updates are not yet supported; full dense update is used.
//
// 原 L2.2 运行时限制已消失：旧实现要求 index.ndim() == base.ndim()（gather 语义），
// 必须把 indices [S] 手工扩成 [S, D] 的 f64 索引张量（reshape + 加法广播），
// 额外付出 O(S·D) 的索引内存与 2 个 tape 节点（Reshape + 广播 Add）。
// index_select 接受 **1-D** index，out.shape = weight.shape 的 dim 槽替换为
// index.len()，即 weight [V,D] + indices [S] → [S,D]（PyTorch embedding 语义），
// 1 个 tape 节点、O(S) 索引。
//
// 符号维度标注（Phase 2 短期规划方向 3）：
//   weight: [V, D]      embedding 矩阵（vocab_size, dim）
//   indices: [S]         token ID 序列（seq_len）—— 元数据语义，按整数索引处理
//   返回: [S, D]         每个 ID 选一行 → (seq_len, dim)

// Embedding lookup: weight[indices]
// Each index selects a row from the weight matrix.
//
// seq_len/dim 参数保留（签名不变，零破坏）：运行时无 shape()/to_vec()，
// 与 multihead_attention.th 模式的 4 参形态一致；index_select 本身不需要它们。
// 注：indices 类型保留 f64（元数据语义，非数据；index_select 内部按整数校验，
//     NaN/非整数会**响亮报错**而非静默截断）。
fn embedding<T>(
    weight: Tensor[T, ..],
    indices: Tensor[f64, ..],
    seq_len: i64,
    dim: i64,
) -> Tensor[T, ..] {
    index_select(weight, 0, indices)
}
