// Layer Normalization
// Normalizes across the last dimension.
// Supports autodiff via TapeOp::LayerNorm (once interpreter adds support).

fn layer_norm(
    x: Tensor[f64, ..],
    gamma: Tensor[f64, ..],
    beta: Tensor[f64, ..],
    eps: f64,
) -> Tensor[f64, ..] {
    // TODO: requires interpreter support for x.layer_norm(gamma, beta, eps)
    x.layer_norm(gamma, beta, eps)
}

// Convenience: create learnable layer norm parameters
// gamma initialized to ones, beta initialized to zeros
fn make_layer_norm(dim: i64) -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gamma = ones(dim);
    let beta = zeros(dim);
    (gamma, beta)
}

// ── Phase 5.4：f32 副本（标量参数改 f32 + 构造函数调用 ones_f32/zeros_f32）──
fn layer_norm_f32(
    x: Tensor[f64, ..],
    gamma: Tensor[f64, ..],
    beta: Tensor[f64, ..],
    eps: f32,
) -> Tensor[f64, ..] {
    x.layer_norm(gamma, beta, eps)
}

fn make_layer_norm_f32(dim: i64) -> (Tensor[f64, ..], Tensor[f64, ..]) {
    let gamma = ones_f32(dim);
    let beta = zeros_f32(dim);
    (gamma, beta)
}
