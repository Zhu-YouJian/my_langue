// Layer Normalization
// Normalizes across the last dimension.
// Supports autodiff via TapeOp::LayerNorm (once interpreter adds support).

fn layer_norm<T>(
    x: Tensor[T, ..],
    gamma: Tensor[T, ..],
    beta: Tensor[T, ..],
    eps: T,
) -> Tensor[T, ..] {
    x.layer_norm(gamma, beta, eps)
}

// Convenience: create learnable layer norm parameters
// gamma initialized to ones, beta initialized to zeros.
// 泛型版：make_layer_norm<f32>(dim) 返回 f32 张量，make_layer_norm<f64>(dim) 返回 f64。
fn make_layer_norm<T>(dim: i64) -> (Tensor[T, ..], Tensor[T, ..]) {
    let gamma = ones<T>(dim);
    let beta = zeros<T>(dim);
    (gamma, beta)
}
