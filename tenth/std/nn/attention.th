// Scaled Dot-Product Attention
// Q: (seq_q, d_k), K: (seq_k, d_k), V: (seq_k, d_v)
// mask: optional attention mask
//
// 符号维度标注（Phase 2 短期规划）：
//   q: [S_q, D_k]     query  (seq_q, d_k)
//   k: [S_k, D_k]     key    (seq_k, d_k)
//   v: [S_k, D_v]     value  (seq_k, d_v)
//   mask: [..]         灵活 shape（通常 [S_q, S_k] 或 [1, S_k]）
//   返回: [S_q, D_v]
//
// k.transpose() → [D_k, S_k]
// q @ k^T → [S_q, D_k] @ [D_k, S_k] = [S_q, S_k]
// scores * scale → [S_q, S_k]
// masked_fill(mask, -1e9) → [S_q, S_k]
// softmax → [S_q, S_k]
// dropout → [S_q, S_k]
// weights @ v → [S_q, S_k] @ [S_k, D_v] = [S_q, D_v]
//
// 2D 版本（本文件）：用于单头 attention 或 MHA 内部未拆头时的简化路径
// Batched 版本：见下方 scaled_dot_product_attention_batched<T>，使用 bmm
// 支持 3D 输入 [B, S, D]，与 multihead_attention.th 的 per-head 计算路径一致

fn scaled_dot_product_attention<T>(
    q: Tensor[T, S_q, D_k],
    k: Tensor[T, S_k, D_k],
    v: Tensor[T, S_k, D_v],
    mask: Tensor[f64, ..],  // mask is metadata (indices/boolean), kept as f64
    dropout_p: T,
) -> Tensor[T, S_q, D_v] {
    let d_k = shape(q)[1];
    let scale = 1.0 / sqrt(d_k);
    // scores = Q @ K^T * scale
    let kT = k.transpose();
    let scores = q.matmul(kT) * scale;
    // Apply mask: fill masked positions with -inf so softmax yields ~0
    let masked_scores = scores.masked_fill(mask, -1e9);
    let weights = masked_scores.softmax();
    let dropped = weights.dropout(dropout_p);
    dropped.matmul(v)
}

// Scaled Dot-Product Attention (batched)
// 3D 输入：Q/K/V shape [B, S, D]
//   - B: batch 维（在 MHA 中即 n_heads）
//   - S: 序列长度
//   - D: 特征维度（per-head 时为 d_k）
//
// 数据流：
//   k.transpose() → [B, D, S]  (transpose 仅转最后两维，对 3D 张量正好)
//   scores = Q.bmm(K^T) * scale → [B, S_q, S_k]
//   weights = softmax(masked_fill(scores, mask, -1e9))
//   out = weights.bmm(V) → [B, S_q, D_v]
//
// Autodiff：bmm/transpose/softmax/dropout 均在 Tape 上记录，可微；
//           masked_fill 当前未记录（与 2D 版本相同的限制）
//
// 使用场景：
//   - True Multi-Head Attention（multihead_attention.th 内部计算 per-head attention）
//   - batched 推理（多条序列并行）
//
// 符号维度标注（Phase 2 短期规划方向 3）：
//   q: [B, S_q, D_k]   query  (batch, seq_q, d_k)
//   k: [B, S_k, D_k]   key    (batch, seq_k, d_k)  —— S_k 可与 S_q 不同
//   v: [B, S_k, D_v]   value  (batch, seq_k, d_v)  —— D_v 可与 D_k 不同
//   mask: [..]          灵活 shape（通常 [B, S_q, S_k] 或 [S_q, S_k]）
//   返回: [B, S_q, D_v]

fn scaled_dot_product_attention_batched<T>(
    q: Tensor[T, B, S_q, D_k],
    k: Tensor[T, B, S_k, D_k],
    v: Tensor[T, B, S_k, D_v],
    mask: Tensor[f64, ..],  // mask 沿最后一维应用，shape 通常 (B, S_q, S_k) 或 (S_q, S_k)
    dropout_p: T,
) -> Tensor[T, B, S_q, D_v] {
    let d_k = shape(q)[2];
    let scale = 1.0 / sqrt(d_k);
    // scores = Q @ K^T * scale  →  (B, S_q, S_k)
    let k_t = k.transpose();              // (B, D_k, S_k)
    let scores = q.bmm(k_t) * scale;      // (B, S_q, S_k)
    // Apply mask + softmax (沿最后一维) + dropout
    let masked_scores = scores.masked_fill(mask, -1e9);
    let weights = masked_scores.softmax();
    let dropped = weights.dropout(dropout_p);
    dropped.bmm(v)                        // (B, S_q, D_v)
}
