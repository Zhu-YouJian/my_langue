// NN: Linear layer
// y = x @ W^T + b
//
// 符号维度标注（Phase 2 短期规划）：
//   x: [M, K]   输入（batch/seq=M, in_features=K）
//   w: [N, K]   权重（out_features=N, in_features=K，PyTorch 风格）
//   b: [N]      偏置（out_features=N）
//   返回: [M, N]
//
// w.transpose() → [K, N]，x @ w^T → [M, K] @ [K, N] = [M, N]
// [M, N] + [N] → 广播 → [M, N]
//
// Phase 3 DRY 清理：泛型化 <T> 支持 f32/f64。
fn linear<T>(x: Tensor[T, M, K], w: Tensor[T, N, K], b: Tensor[T, N]) -> Tensor[T, M, N] {
    x.matmul(w.transpose()) + b
}
