// Activation functions
// Thin wrappers around tensor methods for clarity.
// All of these support autodiff (recorded via tensor methods).
//
// Phase 3 DRY 清理：所有激活函数已泛型化（f32/f64 通吃）。
// _default 变体因硬编码 0.01 字面量保留 f64（调用方需 f32 默认斜率时直接传 0.01f32）。
//
// 符号维度说明（Phase 2 短期规划方向 3）：
//   所有激活函数（relu/sigmoid/tanh/softmax/exp/log/gelu/leaky_relu/leaky_relu_select）
//   是 elementwise 运算（softmax 例外，沿最后一维归一化但 shape 保持）：
//     x: [..]   任意 shape
//     返回: [..] 与 x 同 shape（dtype 与 x 一致）
//   leaky_relu / leaky_relu_select 的 slope 是标量 T。
//   保留 `..` 因为 elementwise 函数对任意 rank 都成立，无法用具体符号维度表达"输出 = 输入"。

fn relu<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.relu() }
fn sigmoid<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.sigmoid() }
fn tanh<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.tanh() }
fn softmax<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.softmax() }
fn exp<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.exp() }
fn log<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.log() }

// GELU（tanh 近似）：x * 0.5 * (1 + tanh(sqrt(2/π) * (x + 0.044715 * x³)))
// Transformer 标配激活函数。底层 tensor.gelu() 方法已支持 autodiff。
fn gelu<T>(x: Tensor[T, ..]) -> Tensor[T, ..] { x.gelu() }

// LeakyReLU（标准语义）：f(x) = x if x > 0 else slope * x（负半轴取 slope*x 负值）
// 算术等价（Tenth 无 tensor 条件运算）：
//   leaky_relu(x, slope) = relu(x) - slope * relu(-x)
//   当 x>0: relu(x)=x, relu(-x)=0 → x ✓
//   当 x<0: relu(x)=0, relu(-x)=-x → -slope*(-x) = slope*x ✓
//   当 x=0: 0 ✓
// （L2.5 修复：旧实现 `relu(x) + slope * relu(-x)` 在 x<0 得 +slope*|x|（正值），
//   符号错误；见 docs/stdlib-可用性盘点.md §四(b) 与 docs/论文/T47 §10.1）
fn leaky_relu<T>(x: Tensor[T, ..], slope: T) -> Tensor[T, ..] {
    x.relu() - slope * (-x).relu()
}

// LeakyReLU 默认 slope=0.01
// 注：硬编码 0.01 字面量为 f64，故此便利函数仅支持 f64。
// f32 路径请直接调用 leaky_relu<f32>(x, 0.01f32)。
fn leaky_relu_default(x: Tensor[f64, ..]) -> Tensor[f64, ..] {
    leaky_relu<f64>(x, 0.01)
}

// leaky_relu_select：用 select 原语实现的可微 leaky relu（论文 T47 AE1 替代方案）
// 标准 leaky_relu：f(x) = x if x > 0 else slope * x
// cond = (x > 0) 的数值近似：sign(x) = x / (|x| + eps)，cond = (sign+1)/2
//   x>0 → cond≈1 → select then (x)
//   x<0 → cond≈0 → select else (slope*x)
//   x=0 → cond=0.5 → select else (slope*0=0)（与标准 leaky_relu(0)=0 一致）
// 与算术编码版本 leaky_relu 在 x≠0 处数值一致；x=0 处行为略有差异（算术版=0，select版=0）
fn leaky_relu_select<T>(x: Tensor[T, ..], slope: T) -> Tensor[T, ..] {
    let eps = 1e-12;
    let sign = x / (x.abs() + eps);
    let cond = (sign + 1.0) * 0.5;
    select(cond, x, slope * x)
}

// leaky_relu_select 默认 slope=0.01
// 注：硬编码 0.01 字面量为 f64，故此便利函数仅支持 f64。
// f32 路径请直接调用 leaky_relu_select<f32>(x, 0.01f32)。
fn leaky_relu_select_default(x: Tensor[f64, ..]) -> Tensor[f64, ..] {
    leaky_relu_select<f64>(x, 0.01)
}
