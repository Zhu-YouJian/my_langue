// Tenth Standard Library — Prelude
//
// Commonly used items.  Use with:
//   use std::prelude::*
//
// Currently Tenth doesn't support `use std::prelude::*` (module system is basic).
// This file serves as documentation of what's available.

// ── Built-in (always available, no import needed) ──
//   println, eprintln       — output
//   tensor[[...]]            — tensor literal
//   rand, randn              — random tensors (f64)
//   rand_f32, randn_f32      — random tensors (f32)
//   zeros_f32, ones_f32     — zero/one tensors (f32)
//   start_grad, new_grad     — autodiff control
//   param, grad, backward    — autodiff ops
//   stop_grad, zero_grad     — autodiff control
//   cross_entropy            — loss function
//   select                   — conditional select primitive (cond ? then : else)
//   Vec::new, HashMap::new   — collections
//   read_file, write_bytes, read_bytes — file I/O
//   save_weights, load_weights — model serialization
//   format, parse_int, parse_float — formatting & parsing
//   path_join, path_exists, path_is_file, path_is_dir — path operations
//   mkdir, list_dir, file_size, remove_file, copy_file, rename_file — filesystem
//   print                    — output without newline

// ── Time (built-in native functions) ──
//   time_now()               — current Unix timestamp (f64, seconds)
//   time_now_ms()            — current Unix timestamp (f64, milliseconds)
//   time_date()              — current date string "YYYY-MM-DD"
//   time_time()              — current time string "HH:MM:SS"
//   time_datetime()          — current datetime string "YYYY-MM-DD HH:MM:SS"
//   time_sleep_ms(ms)        — sleep for ms milliseconds

// ── Random (built-in native functions) ──
//   random_int(lo, hi)       — random integer in [lo, hi]
//   random_float()           — random float in [0.0, 1.0)

// ── Math (built-in native functions) ──
//   abs, sqrt, sin, cos, ln, pow  — basic math
//   math_tan, math_asin, math_acos, math_atan, math_atan2 — trig
//   math_sinh, math_cosh, math_tanh — hyperbolic
//   math_log10, math_log2, math_exp — logarithmic/exponential
//   math_pow, math_floor, math_ceil, math_round — rounding/power

// ── CLI (built-in native functions) ──
//   cli_args_count()         — number of command-line arguments
//   cli_arg(index)           — get argument by index

// ── JSON (built-in native functions) ──
//   json_encode(value)       — encode value to JSON string
//   json_encode_pretty(value) — encode with indentation
//   json_decode(string)      — decode JSON string to value

// ── I/O (built-in native functions) ──
//   eprint(value)            — write value to stderr (no trailing newline)
//   eprintln(value)          — write value to stderr with trailing newline
//   read_line()              — read a line from stdin -> Result<String>
//                              (Err on EOF or read error)

// ── Environment & Process (built-in native functions) ──
//   env_get(name)            — get environment variable -> Result<String>
//                              (Err if not found)
//   env_set(name, value)     — set environment variable -> Unit
//   exit(code)               — terminate process with exit code (never returns)

// ── TCP (built-in native functions) ──
//   tcp_connect(host, port)  — connect to host:port -> Result<i64> (handle)
//   tcp_read(handle, n)      — read up to n bytes -> Result<Vec<i64>>
//   tcp_write(handle, data)  — write byte vec -> Result<i64> (bytes written)
//   tcp_close(handle)        — close connection -> Unit
//   tcp_set_timeout(handle, ms) — set read/write timeout -> Unit

// ── HTTP (built-in native functions) ──
//   http_get(url)            — HTTP/1.1 GET request -> Result<String>
//   http_post(url, body)     — HTTP/1.1 POST request -> Result<String>
//                              (manual HTTP/1.1 implementation, no HTTPS)

// ── Async I/O (built-in native functions, Phase 2 Step 5) ──
//   async_sleep_ms(ms)       — schedule timer -> Future<Unit> (await resolves after ms)
//   async_tcp_read(h, n)     — async read up to n bytes -> Future<Result<Vec<i64>>>
//   async_tcp_write(h, data) — async write byte vec -> Future<Result<i64>> (bytes written)
//   Design: std::thread + mpsc + thread_local; VM scheduler polls in run_scheduler.

// ── Regex (built-in native functions) ──
//   regex_compile(pattern)        — compile regex -> Result<i64> (handle, >0 on success)
//   regex_match(handle, input)    — full-match check -> bool
//   regex_find(handle, input)     — find first match -> String ("" if none)
//   regex_find_all(handle, input) — find all matches -> Vec<String>
//   regex_replace(handle, input, replacement) — replace all -> String
//   regex_split(handle, input)    — split by regex -> Vec<String>
//   (handle table pattern, same as tcp_* / regex object table in runtime)

// ── Std lib (use path::to::function) ──
//   std::nn::linear::linear<T>
//   std::nn::loss::mse<T>, mse_loss<T>, binary_cross_entropy, l1_loss<T>, huber_loss<T>, huber_loss_train<T>  // binary_cross_entropy 仍 f64
//   std::nn::activations::relu<T>, sigmoid<T>, tanh<T>, softmax<T>, exp<T>, log<T>, gelu<T>, leaky_relu<T>, leaky_relu_default, leaky_relu_select<T>, leaky_relu_select_default  // *_default 仍 f64
//   std::nn::dropout::dropout<T>                      // 泛型（f64/f32 通吃）
//   std::nn::batchnorm::batchnorm<T>
//   std::nn::conv::conv2d<T>
//   std::nn::embedding::embedding<T>
//   std::nn::attention::scaled_dot_product_attention<T>, scaled_dot_product_attention_batched<T>  // 2D / 3D(bmm) 版本
//   std::nn::multihead_attention::multihead_attention<T>
//   std::nn::layer_norm::layer_norm<T>, make_layer_norm       // make_* 仍 f64（依赖 randn native）
//   std::nn::positional_encoding::positional_encoding         // 仍 f64（依赖 randn native）
//   std::nn::feedforward::feedforward<T>, make_feedforward_params
//   std::nn::transformer::transformer_encoder_block<T>, make_transformer_block_params
//   std::optim::sgd::sgd_step<T>, sgd_momentum<T>, sgd_weight_decay<T>
//   std::optim::adam::adam_step<T>
//   std::optim::adamw::adamw_step<T>       // 解耦权重衰减（Transformer 训练推荐）
//   std::optim::adamw::adamw_step_w<T>, adamw_step_m<T>, adamw_step_v<T>  // JIT 路径友好（单值返回，避免 tuple 解构）
//   std::optim::adagrad::adagrad_step<T>
//   std::optim::rmsprop::rmsprop_step<T>
//   std::optim::clip::clip_grad_by_value<T>, clip_grad_by_norm<T>  // 梯度裁剪（clip_grad_by_norm 已修复 JIT 路径 tensor-float 比较问题）
//   std::optim::accumulate::accumulate_grad<T>  // 梯度累积辅助
//   std::optim::accumulate::accumulate_loop<T>  // 梯度累积循环（高阶函数，对多个 micro_batch 自动 forward+backward）
//   std::data::dataloader::new, has_next, next_batch, reset, num_batches
//   std::data::mnist::parse_images, parse_labels, one_hot, normalize_pixel, read_i32_be
//   std::utils::serialization::save_model, load_model, save_checkpoint
//   std::init::initializers::xavier_uniform<T>, xavier_normal<T>, he_normal<T>, he_uniform<T>, zeros_init<T>, constant_init<T>
//   std::math::functions::abs, sqrt, sin, cos, ln, pow, exp
//   std::math::stats::mean, median, variance, stddev, variance_sample, stddev_sample
//   std::math::constants::PI, E, TAU, PHI, LN2, LN10, SQRT2, deg2rad, rad2deg, tan, asin, acos, atan, atan2, sinh, cosh, tanh_scalar, log10, log2, floor, ceil, round, lerp, clamp
//   std::collections::iter::map, filter, reduce, range, concat, reverse, take, skip, zip, enumerate, any, all, sum, find, count_if
//   std::collections::collections::flat_map, any, all, find, count_if, partition, sum, product, from_entries, map_values, filter_map
//   std::string::string::join_lines, join_comma, repeat_sep, indent, word_wrap, is_blank, capitalize, count
//   std::string::string_builder::new, append, to_string, len, is_empty, clear
//   std::utils::math::min, max, clamp, abs, fmin, fmax, fclamp, fabs, signum
//   std::time::time::now, now_ms, date, time_of_day, datetime, sleep_ms, start_timer, elapsed, elapsed_ms
//   std::random::random::rand_int, rand_float, rand_range, choice, shuffle, rand_bool, sample
//   std::cli::cli::args_count, arg, args, args_tail, has_flag, flag_value
//   std::logging::logging::debug, info, warn, error, set_level, LEVEL_DEBUG, LEVEL_INFO, LEVEL_WARN, LEVEL_ERROR
//   std::fs::fs::exists, is_file, is_dir, join, mkdir_all, list_dir, size, remove, copy, rename, read_text, read_bytes, write_text, write_bytes, read_lines, extension, filename, parent
//   std::io::io::eprint, eprintln, read_line, read_line_result   // stderr/stdin I/O（包装 eprint/eprintln/read_line native）
//   std::env::env::get, get_result, get_or_empty, set, exit      // 环境变量与进程退出（包装 env_get/env_set/exit native）
//   std::net::net::connect, read, write, close, set_timeout      // TCP 客户端（包装 tcp_* native，handle table 模式）
//   std::http::http::get, post                                    // HTTP/1.1 客户端（手写协议，无 HTTPS）
//   std::async                                                  // 异步 I/O 文档（async_sleep_ms/async_tcp_read/async_tcp_write 为 built-in native）
//   std::json::json::encode, decode, encode_pretty, load, save
//   std::runtime::run_with_limit, limit_or_default, run_with_timeout, timeout_or_default
//   (built-in, no import needed) with_step_limit, with_timeout_ms, is_timeout
//
// ── B批：字符串/文本处理（built-in native, no import needed） ──
//   unicode_nfc(s)              — Unicode NFC 规范化（组合形式）
//   unicode_nfd(s)              — Unicode NFD 规范化（分解形式）
//   str_to_utf16(s)             — UTF-8 字符串 → UTF-16 码元数组
//   utf16_to_str(arr)           — UTF-16 码元数组 → UTF-8 字符串
//   str_to_bytes(s)             — 字符串 → UTF-8 字节数组
//   bytes_to_str(arr)           — UTF-8 字节数组 → 字符串
//   to_utf8(s)                  — str_to_bytes 别名
//   to_utf16(s)                 — str_to_utf16 别名
//   from_utf16(arr)             — utf16_to_str 别名
//   to_gbk(s)                   — 字符串 → GBK 字节数组
//   from_gbk(arr)               — GBK 字节数组 → 字符串
//   base64_encode(data)         — 字节数组 → Base64 字符串
//   base64_decode(s)            — Base64 字符串 → Result<Vec>
//   hex_encode(data)            — 字节数组 → 十六进制字符串
//   hex_decode(s)               — 十六进制字符串 → Result<Vec>
//   url_encode(s)               — 字符串 → URL 编码
//   url_decode(s)               — URL 编码 → Result<String>
//   f"..."                      — 模板字符串字面量（编译为 format() 调用）
//
// ── New in this batch (E批) ──
//   #3 assert, assert_eq (built-in native function, no import needed)
//   std::collections::hashset::new, insert, contains, remove, len, is_empty, to_array, clear
//   std::string::string_builder::new, append, to_string, len, is_empty, clear
//   std::curry::partial, curry, compose
