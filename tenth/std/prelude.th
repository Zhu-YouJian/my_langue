// Tenth Standard Library — Prelude
//
// Commonly used items.  Use with:
//   use std::prelude::*
//
// Currently Tenth doesn't support `use std::prelude::*` (module system is basic).
// This file serves as documentation of what's available.

// ── Built-in (always available, no import needed) ──
//   println, eprintln       — output
//   tensor[[...]]            — tensor literal
//   rand, randn              — random tensors (f64)
//   rand_f32, randn_f32      — random tensors (f32)
//   zeros_f32, ones_f32     — zero/one tensors (f32)
//   start_grad, new_grad     — autodiff control
//   param, grad, backward    — autodiff ops
//   stop_grad, zero_grad     — autodiff control
//   cross_entropy            — loss function
//   Vec::new, HashMap::new   — collections
//   read_file, write_bytes, read_bytes — file I/O
//   save_weights, load_weights — model serialization
//   format, parse_int, parse_float — formatting & parsing
//   path_join, path_exists, path_is_file, path_is_dir — path operations
//   mkdir, list_dir, file_size, remove_file, copy_file, rename_file — filesystem
//   print                    — output without newline

// ── Time (built-in native functions) ──
//   time_now()               — current Unix timestamp (f64, seconds)
//   time_now_ms()            — current Unix timestamp (f64, milliseconds)
//   time_date()              — current date string "YYYY-MM-DD"
//   time_time()              — current time string "HH:MM:SS"
//   time_datetime()          — current datetime string "YYYY-MM-DD HH:MM:SS"
//   time_sleep_ms(ms)        — sleep for ms milliseconds

// ── Random (built-in native functions) ──
//   random_int(lo, hi)       — random integer in [lo, hi]
//   random_float()           — random float in [0.0, 1.0)

// ── Math (built-in native functions) ──
//   abs, sqrt, sin, cos, ln, pow  — basic math
//   math_tan, math_asin, math_acos, math_atan, math_atan2 — trig
//   math_sinh, math_cosh, math_tanh — hyperbolic
//   math_log10, math_log2, math_exp — logarithmic/exponential
//   math_pow, math_floor, math_ceil, math_round — rounding/power

// ── CLI (built-in native functions) ──
//   cli_args_count()         — number of command-line arguments
//   cli_arg(index)           — get argument by index

// ── JSON (built-in native functions) ──
//   json_encode(value)       — encode value to JSON string
//   json_encode_pretty(value) — encode with indentation
//   json_decode(string)      — decode JSON string to value

// ── Std lib (use path::to::function) ──
//   std::nn::linear::linear
//   std::nn::loss::mse, mse_loss, binary_cross_entropy, binary_cross_entropy_f32, l1_loss
//   std::nn::activations::relu, sigmoid, tanh, softmax, exp, log
//   std::nn::dropout::dropout, dropout_f32
//   std::nn::batchnorm::batchnorm, batchnorm_f32
//   std::nn::conv::conv2d
//   std::nn::embedding::embedding
//   std::nn::attention::scaled_dot_product_attention, scaled_dot_product_attention_f32
//   std::nn::multihead_attention::multihead_attention, multihead_attention_f32
//   std::nn::layer_norm::layer_norm, layer_norm_f32, make_layer_norm, make_layer_norm_f32
//   std::nn::positional_encoding::positional_encoding, positional_encoding_f32
//   std::nn::feedforward::feedforward, make_feedforward_params, make_feedforward_params_f32
//   std::nn::transformer::transformer_encoder_block, transformer_encoder_block_f32, make_transformer_block_params, make_transformer_block_params_f32
//   std::optim::sgd::sgd_step, sgd_step_f32, sgd_momentum, sgd_momentum_f32, sgd_weight_decay, sgd_weight_decay_f32
//   std::optim::adam::adam_step, adam_step_f32
//   std::optim::adagrad::adagrad_step, adagrad_step_f32
//   std::optim::rmsprop::rmsprop_step, rmsprop_step_f32
//   std::data::dataloader::new, has_next, next_batch, reset, num_batches
//   std::data::mnist::parse_images, parse_labels, one_hot, normalize_pixel, read_i32_be
//   std::utils::serialization::save_model, load_model, save_checkpoint
//   std::init::initializers::xavier_uniform, xavier_uniform_f32, xavier_normal, xavier_normal_f32, he_normal, he_normal_f32, he_uniform, he_uniform_f32, zeros_init, zeros_init_f32, constant_init, constant_init_f32
//   std::math::functions::abs, sqrt, sin, cos, ln, pow, exp
//   std::math::constants::PI, E, TAU, PHI, LN2, LN10, SQRT2, deg2rad, rad2deg, tan, asin, acos, atan, atan2, sinh, cosh, tanh_scalar, log10, log2, floor, ceil, round, lerp, clamp
//   std::collections::iter::map, filter, reduce, range, concat, reverse, take, skip, zip, enumerate, any, all, sum, find, count_if
//   std::collections::collections::flat_map, any, all, find, count_if, partition, sum, product, from_entries, map_values, filter_map
//   std::string::string::join_lines, join_comma, repeat_sep, indent, word_wrap, is_blank, capitalize, count
//   std::utils::math::min, max, clamp, abs, fmin, fmax, fclamp, fabs, signum
//   std::time::time::now, now_ms, date, time_of_day, datetime, sleep_ms, start_timer, elapsed, elapsed_ms
//   std::random::random::rand_int, rand_float, rand_range, choice, shuffle, rand_bool, sample
//   std::cli::cli::args_count, arg, args, args_tail, has_flag, flag_value
//   std::logging::logging::debug, info, warn, error, set_level, LEVEL_DEBUG, LEVEL_INFO, LEVEL_WARN, LEVEL_ERROR
//   std::fs::fs::exists, is_file, is_dir, join, mkdir_all, list_dir, size, remove, copy, rename, read_text, read_bytes, write_text, write_bytes, read_lines, extension, filename, parent
//   std::json::json::encode, decode, encode_pretty, load, save
//   std::runtime::run_with_limit, limit_or_default, run_with_timeout, timeout_or_default
//   (built-in, no import needed) with_step_limit, with_timeout_ms, is_timeout
